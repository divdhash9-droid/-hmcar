<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/analytics.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<%- include('../partials/header') %>
<style>
  .analytics-hero {
    background: var(--gold-gradient);
    color: #fff;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  .metric-card {
    border: none;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    background: #ffffff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .metric-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0,0,0,0.12); }
  .metric-value { font-size: 28px; font-weight: 700; }
  .metric-sub { color: #6b7280; font-size: 13px; }
  .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; background: rgba(255, 255, 255, 0.12); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.18); }
</style>

<div class="container" style="padding:20px;">
  <div class="analytics-hero">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h2 style="margin:0;">لوحة الإحصائيات</h2>
        <div class="pill" title="آخر تحديث">آخر تحديث: <%= new Date(stats.generatedAt).toLocaleString('ar-SA') %></div>
      </div>
      <div class="d-flex gap-3" style="flex-wrap: wrap;">
        <div class="pill">مزايدات 24h: <%= stats.bidsLast24h %></div>
        <div class="pill">إيراد 7 أيام: <%= stats.revenueLast7 %></div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-3 col-sm-6">
      <div class="card metric-card p-3">
        <div class="metric-sub">المستخدمون</div>
        <div class="metric-value" id="metric-users"><%= stats.totalUsers %></div>
        <div class="metric-sub">جلسات نشطة غير متوفرة حالياً</div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card metric-card p-3">
        <div class="metric-sub">السيارات</div>
        <div class="metric-value" id="metric-cars"><%= stats.totalCars %></div>
        <div class="metric-sub">مباعة: <span id="metric-cars-sold"><%= stats.carsSold %></span></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card metric-card p-3">
        <div class="metric-sub">المزادات</div>
        <div class="metric-value" id="metric-auctions"><%= stats.totalAuctions %></div>
        <div class="metric-sub">جارية: <span id="metric-auctions-running"><%= stats.runningAuctions %></span> | مجدولة: <span id="metric-auctions-scheduled"><%= stats.scheduledAuctions %></span></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card metric-card p-3">
        <div class="metric-sub">المزايدات</div>
        <div class="metric-value" id="metric-bids"><%= stats.totalBids %></div>
        <div class="metric-sub">متوسط: <span id="metric-avg-bid"><%= stats.avgBid %></span> | 24h: <span id="metric-bids-24h"><%= stats.bidsLast24h %></span></div>
      </div>
    </div>
  </div>

  <div class="row g-3" style="margin-top:15px;">
    <div class="col-lg-8">
      <div class="card p-3 metric-card">
        <div class="metric-sub mb-2">الأداء السريع</div>
        <canvas id="chartPerformance" height="160"></canvas>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card p-3 metric-card">
        <div class="metric-sub mb-2">توزيع المزادات</div>
        <canvas id="chartAuctions" height="160"></canvas>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let charts = { perf: null, auctions: null };

  const getThemeVar = (name, fallback) => {
    try {
      const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return value || fallback;
    } catch (e) {
      return fallback;
    }
  };

  const themePrimary = getThemeVar('--primary-color', '#0f172a');
  const themePrimaryLight = getThemeVar('--primary-color-light', '#133b6b');
  const themeAccent = getThemeVar('--accent-color', '#eef3fb');
  const themeTextSecondary = getThemeVar('--text-color-secondary', 'rgba(11, 31, 58, 0.72)');

  const formatNumber = (n) => {
    const num = Number(n || 0);
    if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
    if (num >= 1_000) return (num / 1_000).toFixed(1) + 'K';
    return num;
  };

  const buildCharts = (data) => {
    const perfCtx = document.getElementById('chartPerformance');
    const auctionCtx = document.getElementById('chartAuctions');

    const perfData = [data.avgBid, data.bidsLast24h, data.ordersLast7, data.revenueLast7];
    const auctionData = [data.runningAuctions, data.scheduledAuctions, Math.max(0, data.totalAuctions - data.runningAuctions - data.scheduledAuctions)];

    if (!charts.perf) {
      charts.perf = new Chart(perfCtx, {
        type: 'bar',
        data: {
          labels: ['Avg Bid', 'Bids 24h', 'Orders 7d', 'Revenue 7d'],
          datasets: [{
            label: 'القيمة',
            data: perfData,
            backgroundColor: [themePrimary, themePrimaryLight, themeAccent, themeTextSecondary]
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    } else {
      charts.perf.data.datasets[0].data = perfData;
      charts.perf.update();
    }

    if (!charts.auctions) {
      charts.auctions = new Chart(auctionCtx, {
        type: 'doughnut',
        data: {
          labels: ['جارية', 'مجدولة', 'منتهية'],
          datasets: [{
            data: auctionData,
            backgroundColor: ['#22c55e', themePrimary, '#94a3b8']
          }]
        },
        options: {
          plugins: { legend: { position: 'bottom' } }
        }
      });
    } else {
      charts.auctions.data.datasets[0].data = auctionData;
      charts.auctions.update();
    }
  };

  const updateMetricsDom = (data) => {
    const setText = (id, value) => {
      const el = document.getElementById(id);
      if (el) el.textContent = formatNumber(value);
    };
    setText('metric-users', data.totalUsers);
    setText('metric-cars', data.totalCars);
    setText('metric-cars-sold', data.carsSold);
    setText('metric-auctions', data.totalAuctions);
    setText('metric-auctions-running', data.runningAuctions);
    setText('metric-auctions-scheduled', data.scheduledAuctions);
    setText('metric-bids', data.totalBids);
    setText('metric-avg-bid', data.avgBid);
    setText('metric-bids-24h', data.bidsLast24h);
  };

  const fetchAnalytics = async () => {
    try {
      const res = await fetch('/api/v2/analytics');
      if (!res.ok) throw new Error('Failed to load analytics');
      const json = await res.json();
      if (!json.success) throw new Error('API error');
      const stats = json.stats || {};
      updateMetricsDom(stats);
      buildCharts(stats);
    } catch (err) {
      console.warn('Analytics refresh failed:', err.message);
    }
  };

  // Initial render using server data, then periodic refresh
  buildCharts(<%- JSON.stringify(stats) %>);
  setInterval(fetchAnalytics, 30000);
</script>
</script>

<%- include('../partials/footer') %>
