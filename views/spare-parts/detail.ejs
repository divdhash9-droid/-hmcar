<!-- [[ARABIC_HEADER]] هذا الملف (views/spare-parts/detail.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% var hideNavbar = (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'buyer'); %>
<% layout('layout') -%>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="تفاصيل قطعة الغيار" style="min-height:auto; padding: 26px 18px;">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title"><i class="fas fa-cog" style="margin-left:10px;"></i><%= part.name %></h1>
            <div class="hm-hero__subtitle"><%= part.partType || 'قطعة غيار' %></div>
          </div>
        </div>
        <nav class="hm-hero__actions" aria-label="إجراءات">
          <a class="hm-pill" href="/spare-parts" aria-label="العودة لقطع الغيار"><i class="fas fa-arrow-right"></i><span>العودة</span></a>
          <% if (currentUser && currentUser.role === 'buyer') { %>
            <a class="hm-pill" href="/spare-parts/cart" aria-label="سلة المشتريات"><i class="fas fa-shopping-cart"></i><span>السلة</span></a>
          <% } %>
        </nav>
      </div>
    </header>

    <section class="hm-section" aria-label="التفاصيل" style="margin-top: 16px;">
      <div class="row g-3">
        <div class="col-lg-6">
          <div class="hm-card" style="overflow:hidden;">
            <% if (part.images && part.images[0]) { %>
              <img src="<%= part.images[0] %>" class="w-100 hm-part-main-img" alt="" loading="lazy" decoding="async" />
            <% } else { %>
              <div class="hm-part-placeholder hm-part-placeholder--360" style="border-radius:0;">
                <img class="hm-part-placeholder__img" src="/public/images/spare-parts.png" alt="" width="88" height="88" loading="lazy" decoding="async" />
                <div class="hm-part-placeholder__text">صورة القطعة غير متوفرة</div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="hm-card" style="padding: 16px;">
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="badge <%= part.inStock ? 'bg-success' : 'bg-secondary' %>"><%= part.inStock ? 'متوفر' : 'غير متوفر' %></span>
              <div class="text-muted">المخزون: <strong><%= Number(part.stockQty || 0) %></strong></div>
            </div>

            <hr />

            <div class="mb-2">المركبة: <strong><%= [part.carMake, part.carModel, part.carYear].filter(Boolean).join(' - ') || 'عام' %></strong></div>
            <div class="mb-2">الوصف: <span class="text-muted"><%= part.description || '-' %></span></div>

            <div class="fw-semibold mt-3">
              السعر:
              <% const sar = (part.priceSar !== undefined && part.priceSar !== null) ? part.priceSar : null; %>
              <% const usd = (part.priceUsd !== undefined && part.priceUsd !== null) ? part.priceUsd : null; %>
              <% if (sar !== null || usd !== null) { %>
                <%= sar !== null ? sar.toLocaleString('en-US') + ' SAR' : '' %>
                <%= (sar !== null && usd !== null) ? ' | ' : '' %>
                <%= usd !== null ? usd.toLocaleString('en-US') + ' USD' : '' %>
              <% } else { %>
                <%= (part.price || 0).toLocaleString('en-US') %>
              <% } %>
            </div>

            <% if (currentUser && currentUser.role === 'buyer') { %>
              <hr />

              <div class="row g-2">
                <div class="col-12 col-md-4">
                  <form method="post" action="/spare-parts/cart/add/<%= part._id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="qty" value="1" />
                    <button class="btn btn-outline-primary w-100" type="submit" <%= part.inStock ? '' : 'disabled' %>>إضافة للسلة</button>
                  </form>
                  <% if (inCartQty) { %>
                    <div class="small text-muted mt-1">في السلة: <strong><%= inCartQty %></strong></div>
                  <% } %>
                </div>
                <div class="col-12 col-md-8">
                  <form method="post" action="/spare-parts/buy/<%= part._id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-success w-100" type="submit" <%= part.inStock ? '' : 'disabled' %>>شراء الآن</button>
                  </form>
                </div>
              </div>
            <% } else { %>
              <div class="alert alert-info mt-3 mb-0">سجّل دخول كعميل لطلب هذه القطعة.</div>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <% if (part.images && part.images.length > 1) { %>
      <section class="hm-section" aria-label="صور إضافية" style="margin-top: 12px;">
        <div class="hm-card" style="padding: 16px;">
          <div class="fw-semibold mb-2">صور إضافية</div>
          <div class="row g-2">
            <% part.images.slice(1).forEach(img => { %>
              <div class="col-6 col-md-3">
                <div class="hm-card" style="overflow:hidden;">
                  <img src="<%= img %>" class="w-100 hm-part-thumb-img" alt="" loading="lazy" decoding="async" />
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>
  </div>
</div>


