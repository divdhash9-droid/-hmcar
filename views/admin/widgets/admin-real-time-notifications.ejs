</style>

<script>
// Real-Time Notifications JavaScript
document.addEventListener('DOMContentLoaded', function() {
  const filterButtons = document.querySelectorAll('.enhanced-filter-btn');
  const notifications = document.querySelectorAll('.enhanced-notification');
  const markAllReadBtn = document.getElementById('markAllReadBtn');
  const clearAllBtn = document.getElementById('clearAllBtn');
  const notificationSettingsBtn = document.getElementById('notificationSettingsBtn');
  
  let currentFilter = 'all';
  
  // Filter functionality
  filterButtons.forEach(button => {
    button.addEventListener('click', function() {
      // Update active button
      filterButtons.forEach(btn => btn.classList.remove('enhanced-filter-btn--active'));
      this.classList.add('enhanced-filter-btn--active');
      
      // Update filter
      currentFilter = this.dataset.filter;
      filterNotifications();
    });
  });
  
  function filterNotifications() {
    notifications.forEach(notification => {
      const isRead = notification.dataset.read === 'true';
      const type = notification.dataset.type;
      const isImportant = notification.classList.contains('enhanced-notification--important');
      
      let show = false;
      
      switch (currentFilter) {
        case 'all':
          show = true;
          break;
        case 'unread':
          show = !isRead;
          break;
        case 'important':
          show = isImportant;
          break;
        case 'system':
          show = type === 'system';
          break;
        default:
          show = true;
      }
      
      if (show) {
        notification.classList.remove('hidden');
      } else {
        notification.classList.add('hidden');
      }
    });
  }
  
  // Mark all as read
  if (markAllReadBtn) {
    markAllReadBtn.addEventListener('click', function() {
      notifications.forEach(notification => {
        notification.dataset.read = 'true';
        notification.classList.remove('enhanced-notification--important');
      });
      updateFilterCounts();
      console.log('All notifications marked as read');
    });
  }
  
  // Clear all
  if (clearAllBtn) {
    clearAllBtn.addEventListener('click', function() {
      if (confirm('هل أنت متأكد من مسح كل الإشعارات؟')) {
        notifications.forEach(notification => {
          notification.remove();
        });
        updateFilterCounts();
        console.log('All notifications cleared');
      }
    });
  }
  
  // Individual notification actions
  notifications.forEach(notification => {
    const actions = notification.querySelectorAll('.enhanced-notification__action');
    
    actions.forEach((action, index) => {
      action.addEventListener('click', function() {
        if (index === 0) {
          // Mark as read
          notification.dataset.read = 'true';
          notification.classList.remove('enhanced-notification--important');
          updateFilterCounts();
          console.log('Notification marked as read');
        } else {
          // Delete notification
          notification.remove();
          updateFilterCounts();
          console.log('Notification deleted');
        }
      });
    });
  });
  
  // Update filter counts
  function updateFilterCounts() {
    const allCount = document.querySelectorAll('.enhanced-notification').length;
    const unreadCount = document.querySelectorAll('.enhanced-notification[data-read="false"]').length;
    const importantCount = document.querySelectorAll('.enhanced-notification--important').length;
    const systemCount = document.querySelectorAll('.enhanced-notification[data-type="system"]').length;
    
    // Update counts in filter buttons
    const filterCounts = document.querySelectorAll('.enhanced-filter__count');
    if (filterCounts[0]) filterCounts[0].textContent = allCount;
    if (filterCounts[1]) filterCounts[1].textContent = unreadCount;
    if (filterCounts[2]) filterCounts[2].textContent = importantCount;
    if (filterCounts[3]) filterCounts[3].textContent = systemCount;
  }
  
  // Notification settings
  if (notificationSettingsBtn) {
    notificationSettingsBtn.addEventListener('click', function() {
      alert('إعدادات الإشعارات - قيد التطوير');
      console.log('Notification settings clicked');
    });
  }
  
  // Simulate new notification
  function addNewNotification() {
    const list = document.getElementById('notificationsList');
    const types = ['user', 'car', 'auction', 'system', 'purchase'];
    const type = types[Math.floor(Math.random() * types.length)];
    
    const notificationData = {
      type: type,
      title: 'إشعار جديد',
      message: 'هذا إشعار جديد من النظام',
      time: 'الآن',
      category: 'نظام'
    };
    
    const newNotification = createNotificationElement(notificationData);
    
    // Add to top of list
    if (list.firstChild) {
      list.insertBefore(newNotification, list.firstChild);
    } else {
      list.appendChild(newNotification);
    }
    
    // Remove old notifications if too many
    const allNotifications = list.querySelectorAll('.enhanced-notification');
    if (allNotifications.length > 10) {
      list.removeChild(allNotifications[allNotifications.length - 1]);
    }
    
    updateFilterCounts();
    filterNotifications();
  }
  
  function createNotificationElement(data) {
    const notification = document.createElement('div');
    notification.className = 'enhanced-notification';
    notification.dataset.type = data.type;
    notification.dataset.read = 'false';
    
    const iconClass = data.type === 'user' ? 'enhanced-notification__icon--user' : 
                       data.type === 'car' ? 'enhanced-notification__icon--car' : 
                       data.type === 'auction' ? 'enhanced-notification__icon--auction' : 
                       data.type === 'system' ? 'enhanced-notification__icon--system' : 
                       'enhanced-notification__icon--purchase';
    
    const icon = data.type === 'user' ? 'fa-user-plus' : 
                 data.type === 'car' ? 'fa-car' : 
                 data.type === 'auction' ? 'fa-gavel' : 
                 data.type === 'system' ? 'fa-cog' : 
                 'fa-shopping-cart';
    
    notification.innerHTML = `
      <div class="enhanced-notification__icon ${iconClass}">
        <i class="fas ${icon}"></i>
      </div>
      <div class="enhanced-notification__content">
        <div class="enhanced-notification__title">${data.title}</div>
        <div class="enhanced-notification__message">${data.message}</div>
        <div class="enhanced-notification__meta">
          <span class="enhanced-notification__time">${data.time}</span>
          <span class="enhanced-notification__category">${data.category}</span>
        </div>
      </div>
      <div class="enhanced-notification__actions">
        <button class="enhanced-notification__action" title="تعيين كمقروء">
          <i class="fas fa-check"></i>
        </button>
        <button class="enhanced-notification__action" title="حذف">
          <i class="fas fa-times"></i>
        </button>
      </div>
    `;
    
    // Add event listeners to new notification
    const actions = notification.querySelectorAll('.enhanced-notification__action');
    actions.forEach((action, index) => {
      action.addEventListener('click', function() {
        if (index === 0) {
          notification.dataset.read = 'true';
          updateFilterCounts();
        } else {
          notification.remove();
          updateFilterCounts();
        }
      });
    });
    
    return notification;
  }
  
  // Initialize
  updateFilterCounts();
  
  // Simulate new notification every 30 seconds
  setInterval(addNewNotification, 30000);
});
</script>
