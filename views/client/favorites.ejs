  .hm-page-title {
    font-size: 2rem;
  }
  
  .hm-header-stats {
    justify-content: center;
    margin-top: 2rem;
  }
  
  .hm-filters {
    flex-direction: column;
    align-items: stretch;
  }
  
  .hm-filter-actions {
    margin-left: 0;
    margin-top: 1rem;
