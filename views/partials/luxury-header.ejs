    }
    
    .luxury-header-content {
        gap: 20px;
    }
    
    .luxury-nav {
        display: none;
    }
    
    .luxury-search {
        display: none;
    }
    
    .luxury-mobile-menu-btn {
        display: flex;
    }
    
    .luxury-logo-text h1 {
        font-size: 20px;
    }
    
    .luxury-logo-icon {
        width: 40px;
        height: 40px;
