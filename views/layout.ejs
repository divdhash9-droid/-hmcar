<!-- [[ARABIC_HEADER]] هذا الملف (views/layout.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<!-- views/layout.ejs -->
<!--
  ملف التخطيط العام (Layout):
  - يحتوي الـ<head> المشترك (خطوط، أنماط، سكربتات) وفتحة الـ<body> العامة.
  - يستخدم لتغليف صفحات التطبيق عبر ejs-mate (layout('layout')).
  - يقدّم متغيرات عامة في `res.locals` مثل `currentUser`, `csrfToken`, و `adminNewNotificationsCount`.
  - ملاحظة: قم بتعديل الأنماط الحساسة هنا بعناية لأن بعضها مضمن inline لأغراض التوافر عند حجب CDN.
-->
<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
  <head>
    <!-- SEO Head -->
    <%- include('partials/seo-head-fixed') %>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/public/images/favicon.svg" />
    <link rel="alternate icon" href="/public/images/favicon.ico" />
    <link rel="apple-touch-icon" href="/public/images/logo.svg" />

    <!-- Responsive Viewport and Device Optimization -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0a1628" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="#0a1628" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Montserrat:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome (local) -->
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />

    <!-- Bootstrap Icons (local) -->
    <link
      rel="stylesheet"
      href="/vendor/bootstrap-icons/font/bootstrap-icons.css"
    />

    <% var safeCurrentUrl = (typeof currentUrl !== 'undefined') ? currentUrl :
    ''; %> <% var isAdminPage = !!(typeof currentUser !== 'undefined' &&
    currentUser && (currentUser.role === 'admin' || currentUser.role ===
    'super_admin' || currentUser.role === 'manager') && ( ((typeof bodyClass !==
    'undefined' && bodyClass) &&
    (String(bodyClass).indexOf('admin-dashboard-luxury') !== -1 ||
    String(bodyClass).indexOf('modern-admin-dashboard') !== -1 ||
    String(bodyClass).indexOf('admin-body') !== -1 ||
    String(bodyClass).indexOf('admin-modern-grid') !== -1)) || ((safeCurrentUrl
    || '').startsWith('/admin')) )); %>

    <!-- Stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="/public/css/design-system.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/modern-design.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/header-modern.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/footer-modern.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/rtl-support.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/modern-auth.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/client-dashboard.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/icons-fix.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/cars-list.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/car-card.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/auctions-live.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />

    <% if (typeof bodyClass !== 'undefined' && bodyClass ===
    'admin-modern-grid') { %>
    <link
      href="/public/css/admin-modern-grid.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/admin-modern-grid-sidebar.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <% } else if (isAdminPage) { %>
    <link
      href="/public/css/admin-enhancements.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <link
      href="/public/css/admin-ultra.css?v=<%= Date.now() %>"
      rel="stylesheet"
    />
    <% } %>
    <link rel="manifest" href="/manifest.json" />
  </head>

  <body
    class="<%= (typeof bodyClass !== 'undefined' && bodyClass) ? bodyClass : '' %>"
  >
    <% if (!(typeof hideSkipLink !== 'undefined' && hideSkipLink)) { %>
    <a class="skip-link" href="#main-content"
      ><%= __('accessibility.skipToContent') %></a
    >
    <% } %> <% if (!isAdminPage && !(typeof isEmbed !== 'undefined' && isEmbed)
    && !(typeof hideNavbar !== 'undefined' && hideNavbar)) { %> <%-
    include('partials/header-modern', { user: typeof currentUser !== 'undefined'
    ? currentUser : null }) %> <% } %>

    <main id="main-content">
      <% if (!(typeof isEmbed !== 'undefined' && isEmbed) && !(typeof
      hideBackButton !== 'undefined' && hideBackButton) && !(typeof bodyClass
      !== 'undefined' && bodyClass && bodyClass.includes('auth-page'))) { %> <%-
      include('partials/back-button') %> <% } %> <% if (!(typeof isEmbed !==
      'undefined' && isEmbed) && typeof flash !== 'undefined' && flash &&
      flash.message) { %>
      <div class="container mt-4">
        <div
          class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show"
          role="alert"
        >
          <%= flash.message %>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
          ></button>
        </div>
      </div>
      <% } %> <%- body %>
    </main>

    <% if (!isAdminPage && !(typeof isEmbed !== 'undefined' && isEmbed) &&
    !(typeof hideFooter !== 'undefined' && hideFooter)) { %> <%-
    include('partials/footer-modern') %> <% } %>

    <!-- Chat Components, Scripts, etc. -->
    <%- include('partials/chat-sidebar') %> <%- include('partials/chat-window')
    %> <%- include('partials/notification-center') %> <%-
    include('partials/payment-form') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/js/chat.js"></script>
    <script src="/public/js/language-switcher.js"></script>
    <script src="/public/js/notifications.js"></script>
    <script src="/public/js/payment.js"></script>
    <script src="/public/js/countdown.js"></script>

    <!-- Font Awesome Fallback Check -->
    <script>
      // Check if Font Awesome is loaded
      window.addEventListener("load", function () {
        setTimeout(function () {
          var testIcon = document.createElement("i");
          testIcon.className = "fas fa-home";
          testIcon.style.position = "absolute";
          testIcon.style.left = "-9999px";
          document.body.appendChild(testIcon);

          var computedStyle = window.getComputedStyle(testIcon);
          var fontFamily = computedStyle.fontFamily;

          // If Font Awesome is not loaded, show emoji fallbacks
          if (!fontFamily || fontFamily.indexOf("Font Awesome") === -1) {
            console.warn("Font Awesome not loaded, using emoji fallbacks");
            document.querySelectorAll(".icon-fallback").forEach(function (el) {
              el.style.display = "inline-block";
            });
            document.querySelectorAll('i[class*="fa-"]').forEach(function (el) {
              el.style.display = "none";
            });
          } else {
            console.log("Font Awesome loaded successfully");
          }

          document.body.removeChild(testIcon);
        }, 500);
      });
    </script>

    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role
    === 'admin') { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/public/js/admin-dashboard.js"></script>
    <% } %>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js")
            .then((reg) => console.log("Service Worker Registered!", reg))
            .catch((err) =>
              console.error("Service Worker Registration Failed:", err)
            );
        });
      }
    </script>

    <script>
      document.addEventListener(
        "click",
        function (e) {
          const btn =
            e.target && e.target.closest
              ? e.target.closest('[data-hm-back="1"]')
              : null;
          if (!btn) return;
          e.preventDefault();
          try {
            if (window.history && window.history.length > 1) {
              window.history.back();
            } else {
              window.location.href = "/";
            }
          } catch (err) {
            window.location.href = "/";
          }
        },
        { passive: false }
      );
    </script>
  </body>
</html>
