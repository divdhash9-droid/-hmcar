<!-- [[ARABIC_HEADER]] هذا الملف (views/partials/luxury-header.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->
<!-- هيدر فاخر مع تأثيرات تفاعلية -->

<header class="luxury-header">
    <div class="luxury-header-top">
        <div class="luxury-container">
            <div class="luxury-header-info">
                <div class="luxury-contact-item">
                    <i class="fas fa-phone"></i>
                    <span>+966 50 123 4567</span>
                </div>
                <div class="luxury-contact-item">
                    <i class="fas fa-envelope"></i>
                    <span>info@hmcar.com</span>
                </div>
                <div class="luxury-contact-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>الرياض، المملكة العربية السعودية</span>
                </div>
            </div>
            <div class="luxury-header-actions">
                <% if (currentUser) { %>
                    <div class="luxury-user-menu">
                        <div class="luxury-user-info" onclick="toggleUserMenu()">
                            <div class="luxury-user-avatar">
                                <% if (currentUser.profileImage) { %>
                                    <img src="<%= currentUser.profileImage %>" alt="<%= currentUser.name %>">
                                <% } else { %>
                                    <i class="fas fa-user"></i>
                                <% } %>
                            </div>
                            <span class="luxury-user-name"><%= currentUser.name || currentUser.email %></span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="luxury-user-dropdown" id="userDropdown">
                            <a href="/profile" class="luxury-dropdown-item">
                                <i class="fas fa-user-circle"></i>
                                الملف الشخصي
                            </a>
                            <% if (currentUser.role === 'admin' || currentUser.role === 'super_admin') { %>
                                <a href="/admin" class="luxury-dropdown-item">
                                    <i class="fas fa-cog"></i>
                                    لوحة التحكم
                                </a>
                            <% } %>
                            <a href="/favorites" class="luxury-dropdown-item">
                                <i class="fas fa-heart"></i>
                                المفضلة
                            </a>
                            <% if (currentUser.role === 'buyer' || currentUser.role === 'user') { %>
                                <a href="/spare-parts/cart" class="luxury-dropdown-item">
                                    <i class="fas fa-shopping-cart"></i>
                                    السلة
                                    <span class="cart-counter">0</span>
                                </a>
                            <% } %>
                            <a href="/auth/logout" class="luxury-dropdown-item luxury-dropdown-logout">
                                <i class="fas fa-sign-out-alt"></i>
                                تسجيل الخروج
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/login" class="luxury-btn luxury-btn-outline luxury-btn-sm">
                        <i class="fas fa-sign-in-alt"></i>
                        تسجيل الدخول
                    </a>
                    <a href="/auth/register" class="luxury-btn luxury-btn-primary luxury-btn-sm">
                        <i class="fas fa-user-plus"></i>
                        إنشاء حساب
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <div class="luxury-header-main">
        <div class="luxury-container">
            <div class="luxury-header-content">
                <!-- الشعار -->
                <div class="luxury-logo">
                    <a href="/" class="luxury-logo-link">
                        <div class="luxury-logo-icon">
                            <i class="fas fa-crown"></i>
                        </div>
                        <div class="luxury-logo-text">
                            <h1>HM CAR</h1>
                            <span>مزادات السيارات الفاخرة</span>
                        </div>
                    </a>
                </div>

                <!-- قائمة التنقل -->
                <nav class="luxury-nav">
                    <ul class="luxury-nav-list">
                        <li class="luxury-nav-item">
                            <a href="/" class="luxury-nav-link <%= typeof page !== 'undefined' && page === 'home' ? 'active' : '' %>">
                                <i class="fas fa-home"></i>
                                الرئيسية
                            </a>
                        </li>
                        <li class="luxury-nav-item">
                            <a href="/cars" class="luxury-nav-link <%= typeof page !== 'undefined' && page === 'cars' ? 'active' : '' %>">
                                <i class="fas fa-car"></i>
                                السيارات
                            </a>
                        </li>
                        <li class="luxury-nav-item">
                            <a href="/auctions" class="luxury-nav-link <%= typeof page !== 'undefined' && page === 'auctions' ? 'active' : '' %>">
                                <i class="fas fa-gavel"></i>
                                المزادات
                            </a>
                        </li>
                        <li class="luxury-nav-item">
                            <a href="/spare-parts" class="luxury-nav-link <%= typeof page !== 'undefined' && page === 'spare-parts' ? 'active' : '' %>">
                                <i class="fas fa-cogs"></i>
                                قطع الغيار
                            </a>
                        </li>
                        <li class="luxury-nav-item">
                            <a href="/about" class="luxury-nav-link <%= typeof page !== 'undefined' && page === 'about' ? 'active' : '' %>">
                                <i class="fas fa-info-circle"></i>
                                من نحن
                            </a>
                        </li>
                        <li class="luxury-nav-item">
                            <a href="/contact" class="luxury-nav-link <%= typeof page !== 'undefined' && page === 'contact' ? 'active' : '' %>">
                                <i class="fas fa-phone"></i>
                                اتصل بنا
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- البحث -->
                <div class="luxury-search">
                    <div class="luxury-search-container">
                        <input type="text" 
                               class="luxury-search-input" 
                               placeholder="ابحث عن سيارات، قطع غيار..."
                               id="luxurySearchInput">
                        <button class="luxury-search-btn" onclick="performSearch()">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>

                <!-- زر القائمة للجوال -->
                <button class="luxury-mobile-menu-btn" onclick="toggleMobileMenu()">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </div>

    <!-- القائمة الجانبية للجوال -->
    <div class="luxury-mobile-menu" id="mobileMenu">
        <div class="luxury-mobile-menu-header">
            <div class="luxury-logo">
                <a href="/" class="luxury-logo-link">
                    <div class="luxury-logo-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <div class="luxury-logo-text">
                        <h1>HM CAR</h1>
                    </div>
                </a>
            </div>
            <button class="luxury-mobile-menu-close" onclick="toggleMobileMenu()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <div class="luxury-mobile-menu-content">
            <nav class="luxury-mobile-nav">
                <ul class="luxury-mobile-nav-list">
                    <li>
                        <a href="/" class="luxury-mobile-nav-link">
                            <i class="fas fa-home"></i>
                            الرئيسية
                        </a>
                    </li>
                    <li>
                        <a href="/cars" class="luxury-mobile-nav-link">
                            <i class="fas fa-car"></i>
                            السيارات
                        </a>
                    </li>
                    <li>
                        <a href="/auctions" class="luxury-mobile-nav-link">
                            <i class="fas fa-gavel"></i>
                            المزادات
                        </a>
                    </li>
                    <li>
                        <a href="/spare-parts" class="luxury-mobile-nav-link">
                            <i class="fas fa-cogs"></i>
                            قطع الغيار
                        </a>
                    </li>
                    <li>
                        <a href="/about" class="luxury-mobile-nav-link">
                            <i class="fas fa-info-circle"></i>
                            من نحن
                        </a>
                    </li>
                    <li>
                        <a href="/contact" class="luxury-mobile-nav-link">
                            <i class="fas fa-phone"></i>
                            اتصل بنا
                        </a>
                    </li>
                </ul>
            </nav>
            
            <% if (!currentUser) { %>
                <div class="luxury-mobile-auth">
                    <a href="/auth/login" class="luxury-btn luxury-btn-outline luxury-btn-block">
                        تسجيل الدخول
                    </a>
                    <a href="/auth/register" class="luxury-btn luxury-btn-primary luxury-btn-block">
                        إنشاء حساب
                    </a>
                </div>
            <% } else { %>
                <div class="luxury-mobile-user">
                    <div class="luxury-mobile-user-info">
                        <div class="luxury-user-avatar">
                            <% if (currentUser.profileImage) { %>
                                <img src="<%= currentUser.profileImage %>" alt="<%= currentUser.name %>">
                            <% } else { %>
                                <i class="fas fa-user"></i>
                            <% } %>
                        </div>
                        <span><%= currentUser.name || currentUser.email %></span>
                    </div>
                    <ul class="luxury-mobile-user-menu">
                        <li>
                            <a href="/profile">
                                <i class="fas fa-user-circle"></i>
                                الملف الشخصي
                            </a>
                        </li>
                        <% if (currentUser.role === 'admin' || currentUser.role === 'super_admin') { %>
                            <li>
                                <a href="/admin">
                                    <i class="fas fa-cog"></i>
                                    لوحة التحكم
                                </a>
                            </li>
                        <% } %>
                        <li>
                            <a href="/favorites">
                                <i class="fas fa-heart"></i>
                                المفضلة
                            </a>
                        </li>
                        <li>
                            <a href="/auth/logout">
                                <i class="fas fa-sign-out-alt"></i>
                                تسجيل الخروج
                            </a>
                        </li>
                    </ul>
                </div>
            <% } %>
        </div>
    </div>
</header>

<!-- زر العودة للأعلى -->
<button class="luxury-back-to-top" onclick="scrollToTop()">
    <i class="fas fa-chevron-up"></i>
</button>

<script>
function toggleUserMenu() {
    const dropdown = document.getElementById('userDropdown');
    dropdown.classList.toggle('show');
}

function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobileMenu');
    mobileMenu.classList.toggle('show');
    
    // إيقاف التمرير عند فتح القائمة
    if (mobileMenu.classList.contains('show')) {
        document.body.style.overflow = 'hidden';
    } else {
        document.body.style.overflow = '';
    }
}

function performSearch() {
    const searchInput = document.getElementById('luxurySearchInput');
    const query = searchInput.value.trim();
    
    if (query) {
        window.location.href = `/search?q=${encodeURIComponent(query)}`;
    }
}

function scrollToTop() {
    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
}

// إغلاق القوائم عند النقر خارجها
document.addEventListener('click', (e) => {
    // إغلاق قائمة المستخدم
    const userDropdown = document.getElementById('userDropdown');
    const userInfo = document.querySelector('.luxury-user-info');
    
    if (userDropdown && userInfo && !userInfo.contains(e.target)) {
        userDropdown.classList.remove('show');
    }
    
    // إغلاق قائمة الجوال عند النقر خارجها
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileMenuBtn = document.querySelector('.luxury-mobile-menu-btn');
    
    if (mobileMenu && mobileMenuBtn && !mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
        mobileMenu.classList.remove('show');
        document.body.style.overflow = '';
    }
});

// البحث بالضغط على Enter
document.getElementById('luxurySearchInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
        performSearch();
    }
});

// تأثيرات التمرير
let lastScrollTop = 0;
window.addEventListener('scroll', () => {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const header = document.querySelector('.luxury-header');
    
    if (header) {
        if (scrollTop > lastScrollTop && scrollTop > 100) {
            header.classList.add('luxury-header-hidden');
        } else {
            header.classList.remove('luxury-header-hidden');
        }
    }
    
    lastScrollTop = scrollTop;
});
</script>

<style>
.luxury-header {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    color: white;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: transform 0.3s ease;
}

.luxury-header-hidden {
    transform: translateY(-100%);
}

.luxury-header-top {
    background: rgba(0, 0, 0, 0.3);
    padding: 8px 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.luxury-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.luxury-header-info {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
}

.luxury-contact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #ccc;
}

.luxury-contact-item i {
    color: #d4af37;
}

.luxury-header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
}

.luxury-user-menu {
    position: relative;
}

.luxury-user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: 25px;
    background: rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}

.luxury-user-info:hover {
    background: rgba(255, 255, 255, 0.2);
}

.luxury-user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    overflow: hidden;
    background: #d4af37;
    display: flex;
    align-items: center;
    justify-content: center;
}

.luxury-user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.luxury-user-avatar i {
    color: white;
    font-size: 14px;
}

.luxury-user-name {
    font-size: 14px;
    font-weight: 500;
}

.luxury-user-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
