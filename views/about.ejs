<!-- [[ARABIC_HEADER]] هذا الملف (views/about.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero hm-bg-gold" aria-label="من نحن">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title hm-text-white"><%= __('about.title') %></h1>
            <div class="hm-hero__subtitle hm-text-white"><%= __('about.subtitle') %></div>
          </div>
        </div>
      </div>
    </header>
    
    <section class="hm-section">
      <div class="hm-grid hm-grid--responsive">
        <div class="col-md-6">
          <div class="hm-card">
            <h2 class="hm-section__title hm-text-blue mb-4"><%= __('about.our_story') %></h2>
            <p class="mb-3">Founded with a passion for automobiles and a vision to revolutionize the car auction industry, CarAuction has become the trusted platform for buying and selling premium vehicles.</p>
            <p>We connect car enthusiasts, dealers, and collectors from around the world, providing a transparent, secure, and exciting auction experience.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="hm-card">
            <img src="/images/about-car.jpg" alt="Luxury car" onerror="this.src='/images/default-car.jpg'" style="width: 100%; height: auto; border-radius: var(--hm-radius-lg);">
          </div>
        </div>
      </div>
    </section>
    
    <section class="hm-section">
      <h2 class="hm-section__title hm-text-blue mb-4">مميزاتنا</h2>
      <div class="hm-grid hm-grid--responsive">
        <div class="hm-card hm-card-elevated text-center p-4">
          <div class="hm-icon-container hm-icon-container-gold hm-icon-container-md mx-auto mb-3">
            <i class="fas fa-shield-alt hm-icon-xl hm-icon-gold"></i>
          </div>
          <h3 class="hm-text-blue mb-2"><%= __('about.secure_transactions') %></h3>
          <p><%= __('about.secure_desc') %></p>
        </div>
        <div class="hm-card hm-card-elevated text-center p-4">
          <div class="hm-icon-container hm-icon-container-gold hm-icon-container-md mx-auto mb-3">
            <i class="fas fa-globe hm-icon-xl hm-icon-gold"></i>
          </div>
          <h3 class="hm-text-blue mb-2"><%= __('about.global_reach') %></h3>
          <p><%= __('about.global_desc') %></p>
        </div>
        <div class="hm-card hm-card-elevated text-center p-4">
          <div class="hm-icon-container hm-icon-container-gold hm-icon-container-md mx-auto mb-3">
            <i class="fas fa-clock hm-icon-xl hm-icon-gold"></i>
          </div>
          <h3 class="hm-text-blue mb-2"><%= __('about.support') %></h3>
          <p><%= __('about.support_desc') %></p>
        </div>
        <div class="hm-card hm-card-elevated text-center p-4">
          <div class="hm-icon-container hm-icon-container-gold hm-icon-container-md mx-auto mb-3">
            <i class="fas fa-star hm-icon-xl hm-icon-gold"></i>
          </div>
          <h3 class="hm-text-blue mb-2"><%= __('about.quality') %></h3>
          <p><%= __('about.quality_desc') %></p>
        </div>
      </div>
    </section>
  </div>
</div>