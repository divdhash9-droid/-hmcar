<!-- [[ARABIC_HEADER]] هذا الملف (views/auth/login-enhanced.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
  <% var hideNavbar=true; %>
    <% var bodyClass='auth-page modern-auth hm-login-v2' ; %>

      <!-- Cinematic Login Structure -->
      <link rel="stylesheet" href="/public/css/cinematic-login.css">

      <div class="cinematic-auth-wrapper">
        <!-- Background Video -->
        <video autoplay muted loop playsinline class="auth-bg-video">
          <source src="https://cdn.pixabay.com/video/2016/11/03/6185-190113840_large.mp4" type="video/mp4">
        </video>
        <div class="auth-overlay"></div>

        <!-- Login Card -->
        <div class="login-glass-container">
          <a href="/">
            <img src="/public/images/logo.png" alt="HM CAR" class="login-logo" style="filter: brightness(0) invert(1);">
          </a>

          <h2 class="login-title" data-ar="مرحباً بعودتك" data-en="Welcome Back">مرحباً بعودتك</h2>
          <p class="login-subtitle" data-ar="سجل دخولك إلى عالم الفخامة" data-en="Sign in to the world of luxury">سجل
            دخولك إلى عالم الفخامة</p>

          <!-- Messages -->
          <% if (typeof error !=='undefined' && error) { %>
            <div
              style="color: #ff6b6b; background: rgba(255,0,0,0.1); padding: 10px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(255,0,0,0.2);">
              <i class="fas fa-exclamation-circle"></i>
              <%= error %>
            </div>
            <% } %>
              <% if (typeof success !=='undefined' && success) { %>
                <div
                  style="color: #51cf66; background: rgba(0,255,0,0.1); padding: 10px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(0,255,0,0.2);">
                  <i class="fas fa-check-circle"></i>
                  <%= success %>
                </div>
                <% } %>

                  <form method="POST" action="/auth/login" class="auth-form">
                    <input type="hidden" name="loginRole" value="<%= isAdminLogin ? 'admin' : 'buyer' %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="cinematic-input-group">
                      <input type="text" id="name" name="name" class="cinematic-input"
                        placeholder="<%= isAdminLogin ? 'البريد الإلكتروني' : 'اسم المستخدم' %>" required>
                      <i class="fas fa-user input-icon"></i>
                    </div>

                    <div class="cinematic-input-group">
                      <input type="password" id="password" name="password" class="cinematic-input"
                        placeholder="كلمة المرور" required>
                      <i class="fas fa-lock input-icon"></i>
                    </div>

                    <div
                      style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; color: #888; font-size: 0.9rem;">
                      <label style="display: flex; align-items: center; gap: 5px; cursor: pointer;">
                        <input type="checkbox" name="remember" style="accent-color: var(--k-neon-blue);"> تذكرني
                      </label>
                      <a href="/auth/forgot-password" style="color: #aaa; text-decoration: none;">نسيت كلمة المرور؟</a>
                    </div>

                    <button type="submit" class="btn-login-cine">
                      <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
                    </button>

                    <div class="login-footer">
                      <% if (!isAdminLogin) { %>
                        <p>ليس لديك حساب؟ <a href="/auth/register">إنشاء حساب جديد</a></p>
                        <p style="margin-top: 10px;"><a href="/auth/login?admin=true"
                            style="color: #666; font-size: 0.8rem;">الدخول كمدير النظام</a></p>
                        <% } else { %>
                          <p><a href="/auth/login" style="color: var(--k-neon-blue);">العودة لتسجيل دخول العملاء</a></p>
                          <% } %>
                    </div>
                  </form>
        </div>
      </div>

      <style>
        /* Enhanced Login Page Styles */
        .hm-login2 {
          min-height: 100vh;
          position: relative;
          overflow: hidden;
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
          background: linear-gradient(135deg, #0b1f3a 0%, #1a3a52 50%, #0d2339 100%);
        }

        /* Language Switcher */
        .hm-lang-switcher {
          position: absolute;
          top: 20px;
          right: 20px;
          z-index: 1000;
        }

        .hm-lang-btn {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.75rem 1.25rem;
          background: rgba(255, 255, 255, 0.1);
          backdrop-filter: blur(10px);
          border: 1px solid rgba(212, 175, 55, 0.3);
          border-radius: 25px;
          color: #d4af37;
          font-size: 0.9rem;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.3s ease;
        }

        .hm-lang-btn:hover {
          background: rgba(212, 175, 55, 0.2);
          border-color: #d4af37;
          transform: translateY(-2px);
          box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
        }

        /* Background Particles */
        .hm-login2::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background-image:
            radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 40% 60%, rgba(212, 175, 55, 0.05) 0%, transparent 50%);
          animation: floatParticles 20s ease-in-out infinite;
        }

        @keyframes floatParticles {

          0%,
          100% {
            transform: translateY(0px) rotate(0deg);
          }

          50% {
            transform: translateY(-20px) rotate(180deg);
          }
        }

        /* Shell Layout */
        .hm-login2__shell {
          display: flex;
          min-height: 100vh;
          position: relative;
          z-index: 1;
        }

        /* Brand Section */
        .hm-login2__brand {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 3rem;
          background: rgba(11, 31, 58, 0.5);
          backdrop-filter: blur(10px);
          border-right: 1px solid rgba(212, 175, 55, 0.1);
        }

        .hm-login2__logoWrap {
          margin-bottom: 2rem;
        }

        .hm-login2__logo {
          width: 120px;
          height: 120px;
          object-fit: contain;
          filter: drop-shadow(0 8px 30px rgba(212, 175, 55, 0.4));
          transition: transform 0.3s ease;
        }

        .hm-login2__logo:hover {
          transform: scale(1.05) rotate(5deg);
        }

        .hm-login2__tag {
          text-align: center;
          margin-bottom: 3rem;
        }

        .hm-login2__name {
          font-size: 3.5rem;
          font-weight: 800;
          color: #d4af37;
          margin: 0 0 1rem 0;
          text-shadow: 0 4px 20px rgba(212, 175, 55, 0.5);
          letter-spacing: 2px;
          animation: glowText 2s ease-in-out infinite alternate;
        }

        @keyframes glowText {
          from {
            text-shadow: 0 4px 20px rgba(212, 175, 55, 0.5);
          }

          to {
            text-shadow: 0 4px 30px rgba(212, 175, 55, 0.8);
          }
        }

        .hm-login2__desc {
          font-size: 1.1rem;
          color: rgba(255, 255, 255, 0.8);
          line-height: 1.6;
          margin: 0;
        }

        .hm-login2__chips {
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          justify-content: center;
        }

        .hm-chip {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.75rem 1.25rem;
          background: rgba(212, 175, 55, 0.1);
          border: 1px solid rgba(212, 175, 55, 0.3);
          border-radius: 25px;
          color: #d4af37;
          font-size: 0.9rem;
          font-weight: 500;
          transition: all 0.3s ease;
          cursor: pointer;
        }

        .hm-chip:hover {
          background: rgba(212, 175, 55, 0.2);
          border-color: #d4af37;
          transform: translateY(-3px);
          box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        }

        .hm-chip i {
          font-size: 1rem;
        }

        /* Card Section */
        .hm-login2__card {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 3rem;
          background: rgba(255, 255, 255, 0.05);
          backdrop-filter: blur(10px);
        }

        .hm-login2__header {
          text-align: center;
          margin-bottom: 2.5rem;
        }

        .hm-login2__title {
          font-size: 2.5rem;
          font-weight: 700;
          color: #fff;
          margin: 0 0 0.5rem 0;
          text-shadow: 0 2px 10px rgba(255, 255, 255, 0.3);
        }

        .hm-login2__subtitle {
          font-size: 1.1rem;
          color: rgba(255, 255, 255, 0.7);
          margin: 0;
        }

        /* Alerts */
        .hm-alert {
          display: flex;
          align-items: center;
          padding: 1rem 1.5rem;
          border-radius: 12px;
          margin-bottom: 1.5rem;
          position: relative;
          animation: slideIn 0.3s ease-out;
        }

        .hm-alert--error {
          background: rgba(220, 53, 69, 0.1);
          border: 1px solid rgba(220, 53, 69, 0.3);
          color: #ff6b6b;
        }

        .hm-alert--success {
          background: rgba(40, 167, 69, 0.1);
          border: 1px solid rgba(40, 167, 69, 0.3);
          color: #51cf66;
        }

        .hm-alert i {
          margin-left: 0.75rem;
          font-size: 1.1rem;
        }

        .hm-alert__close {
          position: absolute;
          top: 0.5rem;
          left: 0.5rem;
          background: none;
          border: none;
          color: inherit;
          cursor: pointer;
          opacity: 0.7;
          transition: opacity 0.2s;
        }

        .hm-alert__close:hover {
          opacity: 1;
        }

        @keyframes slideIn {
          from {
            transform: translateY(-10px);
            opacity: 0;
          }

          to {
            transform: translateY(0);
            opacity: 1;
          }
        }

        /* Social Login */
        .hm-social-login {
          display: flex;
          flex-direction: column;
          gap: 1rem;
          margin-bottom: 1.5rem;
        }

        .hm-social-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.75rem;
          padding: 1rem;
          border: none;
          border-radius: 12px;
          font-size: 1rem;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.3s ease;
          text-decoration: none;
        }

        .hm-social-btn--google {
          background: #4285f4;
          color: white;
        }

        .hm-social-btn--google:hover {
          background: #357ae8;
          transform: translateY(-2px);
          box-shadow: 0 8px 25px rgba(66, 133, 244, 0.3);
        }

        .hm-social-btn--facebook {
          background: #1877f2;
          color: white;
        }

        .hm-social-btn--facebook:hover {
          background: #166fe5;
          transform: translateY(-2px);
          box-shadow: 0 8px 25px rgba(24, 119, 242, 0.3);
        }

        .hm-social-btn i {
          font-size: 1.2rem;
        }

        /* Divider */
        .hm-divider {
          display: flex;
          align-items: center;
          margin: 1.5rem 0;
          color: rgba(255, 255, 255, 0.5);
          font-size: 0.9rem;
        }

        .hm-divider::before,
        .hm-divider::after {
          content: '';
          flex: 1;
          height: 1px;
          background: rgba(255, 255, 255, 0.2);
        }

        .hm-divider span {
          padding: 0 1rem;
        }

        /* Form Groups */
        .hm-form-group {
          margin-bottom: 1.5rem;
        }

        .hm-input-wrapper {
          position: relative;
        }

        .hm-input-icon {
          position: absolute;
          right: 1rem;
          top: 50%;
          transform: translateY(-50%);
          color: #d4af37;
          font-size: 1.1rem;
          z-index: 2;
        }

        .hm-input {
          width: 100%;
          padding: 1rem 3rem 1rem 1rem;
          background: rgba(255, 255, 255, 0.1);
          border: 2px solid rgba(212, 175, 55, 0.2);
          border-radius: 12px;
          color: #fff;
          font-size: 1rem;
          transition: all 0.3s ease;
        }

        .hm-input:focus {
          outline: none;
          border-color: #d4af37;
          background: rgba(255, 255, 255, 0.15);
          box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
          transform: translateY(-2px);
        }

        .hm-input::placeholder {
          color: rgba(255, 255, 255, 0.5);
        }

        .hm-input-label {
          position: absolute;
          right: 3rem;
          top: 1rem;
          color: rgba(255, 255, 255, 0.7);
          font-size: 0.9rem;
          pointer-events: none;
          transition: all 0.3s ease;
        }

        .hm-input:focus~.hm-input-label,
        .hm-input:not(:placeholder-shown)~.hm-input-label {
          top: -0.5rem;
          right: 1rem;
          font-size: 0.8rem;
          background: #0b1f3a;
          padding: 0 0.5rem;
          color: #d4af37;
        }

        .hm-input-toggle {
          position: absolute;
          left: 1rem;
          top: 50%;
          transform: translateY(-50%);
          background: none;
          border: none;
          color: rgba(255, 255, 255, 0.7);
          cursor: pointer;
          transition: color 0.2s;
        }

        .hm-input-toggle:hover {
          color: #d4af37;
        }

        /* Biometric Section */
        .hm-biometric-section {
          margin-bottom: 1.5rem;
        }

        .hm-biometric-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.75rem;
          width: 100%;
          padding: 1rem;
          background: rgba(255, 255, 255, 0.1);
          border: 2px solid rgba(212, 175, 55, 0.2);
          border-radius: 12px;
          color: #d4af37;
          font-size: 0.9rem;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.3s ease;
        }

        .hm-biometric-btn:hover {
          background: rgba(212, 175, 55, 0.2);
          border-color: #d4af37;
          transform: translateY(-2px);
          box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
        }

        .hm-biometric-btn i {
          font-size: 1.2rem;
        }

        /* Form Options */
        .hm-form-options {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 2rem;
        }

        .hm-checkbox {
          display: flex;
          align-items: center;
        }

        .hm-checkbox-input {
          display: none;
        }

        .hm-checkbox-label {
          display: flex;
          align-items: center;
          color: rgba(255, 255, 255, 0.8);
          cursor: pointer;
          font-size: 0.9rem;
        }

        .hm-checkbox-checkmark {
          width: 20px;
          height: 20px;
          border: 2px solid rgba(212, 175, 55, 0.3);
          border-radius: 4px;
          margin-left: 0.5rem;
          position: relative;
          transition: all 0.3s ease;
        }

        .hm-checkbox-input:checked~.hm-checkbox-label .hm-checkbox-checkmark {
          background: #d4af37;
          border-color: #d4af37;
        }

        .hm-checkbox-input:checked~.hm-checkbox-label .hm-checkbox-checkmark::after {
          content: '✓';
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          color: #0b1f3a;
          font-weight: bold;
        }

        .hm-link {
          color: #d4af37;
          text-decoration: none;
          font-size: 0.9rem;
          transition: all 0.2s ease;
        }

        .hm-link:hover {
          color: #ffd700;
          text-decoration: underline;
          transform: translateY(-1px);
        }

        .hm-link--primary {
          font-weight: 600;
        }

        /* Buttons */
        .hm-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          padding: 1rem 2rem;
          border: none;
          border-radius: 12px;
          font-size: 1rem;
          font-weight: 600;
          text-decoration: none;
          cursor: pointer;
          transition: all 0.3s ease;
          gap: 0.5rem;
        }

        .hm-btn--primary {
          background: linear-gradient(135deg, #d4af37, #ffd700);
          color: #0b1f3a;
          box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
        }

        .hm-btn--primary:hover {
          transform: translateY(-3px);
          box-shadow: 0 12px 35px rgba(212, 175, 55, 0.4);
          background: linear-gradient(135deg, #ffd700, #d4af37);
        }

        .hm-btn--full {
          width: 100%;
        }

        /* Form Footer */
        .hm-form-footer {
          text-align: center;
          margin-top: 1.5rem;
        }

        .hm-form-footer p {
          color: rgba(255, 255, 255, 0.7);
          font-size: 0.9rem;
          margin: 0 0 0.5rem 0;
        }

        .hm-form-switch {
          text-align: center;
          margin-top: 1rem;
        }

        .hm-form-switch p {
          color: rgba(255, 255, 255, 0.7);
          font-size: 0.9rem;
          margin: 0;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
          .hm-login2__brand {
            padding: 2rem;
          }

          .hm-login2__card {
            padding: 2rem;
          }

          .hm-login2__name {
            font-size: 2.5rem;
          }

          .hm-login2__title {
            font-size: 2rem;
          }
        }

        @media (max-width: 768px) {
          .hm-login2__shell {
            flex-direction: column;
          }

          .hm-login2__brand {
            padding: 2rem;
            border-right: none;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
          }

          .hm-login2__card {
            padding: 1.5rem;
          }

          .hm-login2__name {
            font-size: 2rem;
          }

          .hm-login2__title {
            font-size: 1.8rem;
          }

          .hm-login2__chips {
            justify-content: center;
          }

          .hm-form-options {
            flex-direction: column;
            gap: 1rem;
            align-items: stretch;
          }

          .hm-social-login {
            gap: 0.75rem;
          }

          .hm-lang-switcher {
            top: 10px;
            right: 10px;
          }

          .hm-lang-btn {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
          }
        }

        @media (max-width: 480px) {
          .hm-login2__brand {
            padding: 1.5rem;
          }

          .hm-login2__card {
            padding: 1rem;
          }

          .hm-login2__name {
            font-size: 1.8rem;
          }

          .hm-login2__title {
            font-size: 1.5rem;
          }

          .hm-login2__desc {
            font-size: 1rem;
          }

          .hm-chip {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
          }

          .hm-btn {
            padding: 0.875rem 1.5rem;
          }

          .hm-input {
            padding: 0.875rem 2.5rem 0.875rem 0.875rem;
          }
        }

        /* Performance Optimizations */
        .hm-login2 {
          will-change: transform;
          backface-visibility: hidden;
        }

        .hm-login2__logo,
        .hm-chip,
        .hm-btn,
        .hm-input {
          will-change: transform;
          backface-visibility: hidden;
        }

        /* Smooth Animations */
        * {
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
        }

        /* Loading States */
        .hm-btn:active {
          transform: scale(0.98);
        }

        .hm-social-btn:active {
          transform: scale(0.98);
        }

        .hm-biometric-btn:active {
          transform: scale(0.98);
        }
      </style>

      <script>
        // Language Toggle
        let currentLanguage = 'ar';

        function toggleLanguage() {
          currentLanguage = currentLanguage === 'ar' ? 'en' : 'ar';
          updateLanguage();
          localStorage.setItem('preferredLanguage', currentLanguage);
        }

        function updateLanguage() {
          const elements = document.querySelectorAll('[data-ar][data-en]');
          const langBtn = document.getElementById('currentLang');

          elements.forEach(element => {
            const text = element.getAttribute(`data-${currentLanguage}`);
            if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
              element.placeholder = text;
            } else {
              element.textContent = text;
            }
          });

          langBtn.textContent = currentLanguage === 'ar' ? 'English' : 'العربية';

          // Update text direction
          document.documentElement.dir = currentLanguage === 'ar' ? 'rtl' : 'ltr';
          document.documentElement.lang = currentLanguage;
        }

        // Initialize language
        document.addEventListener('DOMContentLoaded', function () {
          const savedLang = localStorage.getItem('preferredLanguage');
          if (savedLang && savedLang !== currentLanguage) {
            currentLanguage = savedLang;
            updateLanguage();
          }
        });

        // Password Toggle
        function togglePassword(inputId) {
          const input = document.getElementById(inputId);
          const toggle = input.nextElementSibling;
          const icon = toggle.querySelector('i');

          if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
          } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
          }
        }

        // Social Login Functions
        function loginWithGoogle() {
          // Implement Google OAuth
          console.log('Google login initiated');
          // window.location.href = '/auth/google';
        }

        function loginWithFacebook() {
          // Implement Facebook OAuth
          console.log('Facebook login initiated');
          // window.location.href = '/auth/facebook';
        }

        // Biometric Login
        async function loginWithBiometric() {
          if (!window.PublicKeyCredential) {
            alert('Biometric authentication is not supported on this device');
            return;
          }

          try {
            // Check if biometric is available
            const available = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();

            if (available) {
              // Implement biometric authentication
              console.log('Biometric login initiated');
              // This would integrate with WebAuthn API
              alert('Biometric authentication will be implemented with WebAuthn API');
            } else {
              alert('Biometric authentication is not available on this device');
            }
          } catch (error) {
            console.error('Biometric authentication error:', error);
            alert('Biometric authentication failed');
          }
        }

        // Performance optimizations
        document.addEventListener('DOMContentLoaded', function () {
          // Lazy load images
          const images = document.querySelectorAll('img[loading="lazy"]');
          images.forEach(img => {
            img.src = img.dataset.src;
          });

          // Add smooth scrolling
          document.documentElement.style.scrollBehavior = 'smooth';

          // Optimize animations
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
          if (prefersReducedMotion.matches) {
            document.querySelectorAll('*').forEach(el => {
              el.style.animation = 'none';
              el.style.transition = 'none';
            });
          }
        });

        // Form validation enhancements
        document.querySelector('.auth-form').addEventListener('submit', function (e) {
          const submitBtn = this.querySelector('button[type="submit"]');
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تسجيل الدخول...';

          // Re-enable after 3 seconds if form doesn't submit
          setTimeout(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> <span>تسجيل الدخول</span>';
          }, 3000);
        });

        // Add input animations
        document.querySelectorAll('.hm-input').forEach(input => {
          input.addEventListener('focus', function () {
            this.parentElement.classList.add('focused');
          });

          input.addEventListener('blur', function () {
            if (!this.value) {
              this.parentElement.classList.remove('focused');
            }
          });
        });
      </script>