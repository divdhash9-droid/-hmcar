}

.hm-tab-content h2::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    background: #0ea5e9;
    border-radius: 50%;
    animation: titlePulse 2s ease-in-out infinite;
}

@keyframes titlePulse {
    0%, 100% { opacity: 0.5; transform: translateY(-50%) scale(1); }
