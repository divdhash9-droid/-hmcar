}

.hm-filter-select:focus {
  outline: none;
  border-color: #2366d1;
  box-shadow: 0 0 0 3px rgba(35, 102, 209, 0.1);
}

.hm-filter-actions {
  margin-left: auto;
  display: flex;
  gap: 1rem;
}

.hm-btn-outline {
  background: transparent;
  border: 2px solid #0a192f;
  color: #0a192f;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.hm-btn-outline:hover {
  background: #0a192f;
  color: white;
}

.hm-btn-primary {
  background: linear-gradient(135deg, #0a192f 0%, #2366d1 100%);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.hm-btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(10, 25, 47, 0.3);
}

/* Content Section */
.hm-cars-content {
  padding: 3rem 0;
}

/* Loading State */
.hm-loading {
  text-align: center;
  padding: 4rem 0;
}

.hm-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #e2e8f0;
  border-top: 4px solid #2366d1;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 1rem;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Empty State */
.hm-empty-state {
  text-align: center;
  padding: 4rem 0;
}

.hm-empty-icon {
  font-size: 4rem;
  color: #cbd5e1;
  margin-bottom: 2rem;
}

.hm-empty-state h3 {
  font-size: 1.5rem;
  color: #0a192f;
  margin-bottom: 1rem;
}

.hm-empty-state p {
  color: #64748b;
  margin-bottom: 2rem;
}

/* Cars Grid */
.hm-cars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

/* Car Card */
.hm-car-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  position: relative;
}

.hm-car-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

.hm-car-image {
  position: relative;
  height: 250px;
  overflow: hidden;
}

.hm-car-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.hm-car-card:hover .hm-car-img {
  transform: scale(1.05);
}

.hm-car-actions {
  position: absolute;
  top: 1rem;
  right: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  opacity: 0;
  transform: translateX(20px);
  transition: all 0.3s ease;
}

.hm-car-card:hover .hm-car-actions {
  opacity: 1;
  transform: translateX(0);
}

.hm-action-btn {
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.hm-btn-favorite {
  background: rgba(239, 68, 68, 0.9);
  color: white;
}

.hm-btn-favorite:hover {
  background: #dc2626;
  transform: scale(1.1);
}

.hm-btn-favorite.favorited {
  background: #dc2626;
}

.hm-btn-view {
  background: rgba(35, 102, 209, 0.9);
  color: white;
}

.hm-btn-view:hover {
  background: #1e40af;
  transform: scale(1.1);
}

.hm-btn-compare {
  background: rgba(34, 197, 94, 0.9);
  color: white;
}

.hm-btn-compare:hover {
  background: #16a34a;
  transform: scale(1.1);
}

.hm-car-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(255, 215, 0, 0.9);
  color: #0a192f;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.hm-car-details {
  padding: 1.5rem;
}

.hm-car-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 1rem;
}

.hm-car-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #0a192f;
  margin: 0;
  line-height: 1.3;
}

.hm-car-price {
  font-size: 1.5rem;
  font-weight: 800;
  color: #2366d1;
}

.hm-car-specs {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
}

.hm-spec {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: #64748b;
}

.hm-spec i {
  color: #94a3b8;
}

.hm-car-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1rem;
  border-top: 1px solid #e2e8f0;
  font-size: 0.875rem;
  color: #64748b;
}

.hm-car-location,
.hm-car-auction {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Pagination */
.hm-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  margin-top: 3rem;
}

.hm-page-btn {
  min-width: 40px;
  height: 40px;
  border: 2px solid #e2e8f0;
  background: white;
  color: #0a192f;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hm-page-btn:hover {
  border-color: #2366d1;
  color: #2366d1;
}

.hm-page-btn.active {
  background: linear-gradient(135deg, #0a192f 0%, #2366d1 100%);
  color: white;
  border-color: #0a192f;
