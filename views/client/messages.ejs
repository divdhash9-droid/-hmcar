<% layout('layout') -%>

<link rel="stylesheet" href="/css/luxury-auth.css" />

<div class="hm-messages-page">
  <!-- Header Section -->
  <div class="hm-page-header">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <div class="hm-header-content">
            <h1 class="hm-page-title">
              <i class="fas fa-envelope"></i>
              <span data-ar="الرسائل" data-en="Messages">الرسائل</span>
            </h1>
            <p class="hm-page-subtitle" data-ar="تواصل مع البائعين والمشترين" data-en="Communicate with sellers and buyers">
              تواصل مع البائعين والمشترين
            </p>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="hm-header-stats">
            <div class="hm-stat-card">
              <span class="hm-stat-number" id="totalMessages">0</span>
              <span class="hm-stat-label" data-ar="رسالة" data-en="Messages">رسالة</span>
            </div>
            <div class="hm-stat-card">
              <span class="hm-stat-number" id="unreadCount">0</span>
              <span class="hm-stat-label" data-ar="غير مقروءة" data-en="Unread">غير مقروءة</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Messages Content -->
  <div class="hm-messages-content">
    <div class="container">
      <div class="hm-messages-layout">
        <!-- Conversations List -->
        <div class="hm-conversations-list">
          <div class="hm-conversations-header">
            <h3 data-ar="المحادثات" data-en="Conversations">المحادثات</h3>
            <button class="hm-btn hm-btn-primary" id="newMessageBtn">
              <i class="fas fa-plus"></i>
              <span data-ar="رسالة جديدة" data-en="New Message">رسالة جديدة</span>
            </button>
          </div>
          
          <!-- Search -->
          <div class="hm-search-box">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="البحث عن محادثة..." id="searchConversations">
          </div>

          <!-- Conversations -->
          <div class="hm-conversations" id="conversationsList">
            <!-- Conversations will be loaded here -->
          </div>
        </div>

        <!-- Chat Area -->
        <div class="hm-chat-area">
          <!-- Empty State -->
          <div class="hm-empty-chat" id="emptyChat">
            <div class="hm-empty-icon">
              <i class="fas fa-comments"></i>
            </div>
            <h3 data-ar="اختر محادثة للبدء" data-en="Choose a conversation to start">اختر محادثة للبدء</h3>
            <p data-ar="اختر محادثة من القائمة لعرض الرسائل" data-en="Select a conversation from the list to view messages">
              اختر محادثة من القائمة لعرض الرسائل
            </p>
          </div>

          <!-- Chat Content -->
          <div class="hm-chat-content" id="chatContent" style="display: none;">
            <!-- Chat Header -->
            <div class="hm-chat-header">
              <div class="hm-chat-user">
                <img src="" alt="" class="hm-user-avatar" id="chatUserAvatar">
                <div class="hm-user-info">
                  <h4 id="chatUserName"></h4>
                  <span id="chatUserStatus"></span>
                </div>
              </div>
              <div class="hm-chat-actions">
                <button class="hm-action-btn" id="deleteConversation">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>

            <!-- Messages Area -->
            <div class="hm-messages-area" id="messagesArea">
              <!-- Messages will be loaded here -->
            </div>

            <!-- Message Input -->
            <div class="hm-message-input">
              <div class="hm-input-group">
                <button class="hm-attach-btn" id="attachBtn">
                  <i class="fas fa-paperclip"></i>
                </button>
                <input type="text" placeholder="اكتب رسالتك..." id="messageInput">
                <button class="hm-send-btn" id="sendBtn">
                  <i class="fas fa-paper-plane"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- New Message Modal -->
<div class="hm-modal" id="newMessageModal">
  <div class="hm-modal-content">
    <div class="hm-modal-header">
      <h3 data-ar="رسالة جديدة" data-en="New Message">رسالة جديدة</h3>
      <button class="hm-modal-close" id="closeModal">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="hm-modal-body">
      <div class="hm-form-group">
        <label data-ar="المستلم" data-en="Recipient">المستلم</label>
        <select class="hm-form-control" id="recipientSelect">
          <option value="">اختر المستلم...</option>
        </select>
      </div>
      <div class="hm-form-group">
        <label data-ar="السيارة (اختياري)" data-en="Car (Optional)">السيارة (اختياري)</label>
        <select class="hm-form-control" id="carSelect">
          <option value="">اختر سيارة...</option>
        </select>
      </div>
      <div class="hm-form-group">
        <label data-ar="الرسالة" data-en="Message">الرسالة</label>
        <textarea class="hm-form-control" id="newMessageText" rows="4" placeholder="اكتب رسالتك هنا..."></textarea>
      </div>
    </div>
    <div class="hm-modal-footer">
      <button class="hm-btn hm-btn-outline" id="cancelNewMessage">إلغاء</button>
      <button class="hm-btn hm-btn-primary" id="sendNewMessage">إرسال</button>
    </div>
  </div>
</div>

<style>
/* Messages Page Styles */
.hm-messages-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 50%, #f1f5f9 100%);
