<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-dashboard-luxury'; %>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="إدارة المشرفين والصلاحيات">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title">إدارة المشرفين والصلاحيات</h1>
            <div class="hm-hero__subtitle">تحكم كامل بالصلاحيات — Super Admin فقط</div>
          </div>
        </div>

        <nav class="hm-hero__actions" aria-label="روابط">
          <a class="hm-pill" href="/admin" aria-label="لوحة الإدارة"><i class="fas fa-tachometer-alt"></i><span>لوحة الإدارة</span></a>
          <a class="hm-pill" href="/admin/users" aria-label="المستخدمين"><i class="fas fa-users"></i><span>المستخدمين</span></a>
          <a class="hm-pill hm-pill--danger" href="/auth/logout" aria-label="خروج"><i class="fas fa-sign-out-alt"></i><span>خروج</span></a>
        </nav>
      </div>

      <section class="hm-kpis" aria-label="إحصائيات">
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">عدد المشرفين</div><div class="hm-kpi__value"><%= Array.isArray(users) ? users.length : 0 %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-user-shield"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">أدوار متاحة</div><div class="hm-kpi__value"><%= Array.isArray(roles) ? roles.length : 0 %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-id-badge"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">صلاحيات</div><div class="hm-kpi__value"><%= Array.isArray(permissions) ? permissions.length : 0 %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-key"></i></div></div></div>
        <div class="hm-kpi hm-kpi--security"><div class="hm-kpi__row"><div><div class="hm-kpi__label">الأمان</div><div class="hm-kpi__value">CSRF</div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-lock"></i></div></div></div>
      </section>
    </header>

    <% if (flash && flash.message) { %>
      <div class="mt-3">
        <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% } %>

    <section class="hm-section" aria-label="إنشاء مشرف">
      <h2 class="hm-section__title">إنشاء مشرف جديد</h2>
      <div class="hm-list">
        <div class="hm-list__item">
          <form id="createAdminForm" class="w-100">
            <input type="hidden" id="csrfToken" value="<%= csrfToken %>">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label text-light">الاسم</label>
                <input class="form-control" name="name" required>
              </div>
              <div class="col-md-4">
                <label class="form-label text-light">البريد</label>
                <input class="form-control" name="email" type="email" required>
              </div>
              <div class="col-md-4">
                <label class="form-label text-light">الهاتف</label>
                <input class="form-control" name="phone" required>
              </div>
              <div class="col-md-4">
                <label class="form-label text-light">كلمة المرور</label>
                <input class="form-control" name="password" type="password" required>
              </div>
              <div class="col-md-4">
                <label class="form-label text-light">الدور</label>
                <select class="form-select" name="role">
                  <% (roles || []).forEach(function(r){ %>
                    <option value="<%= r %>"><%= r %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label text-light">صلاحيات</label>
                <select class="form-select" name="permissions" multiple>
                  <% (permissions || []).forEach(function(p){ %>
                    <option value="<%= p %>"><%= p %></option>
                  <% }) %>
                </select>
                <div class="form-text text-light" style="opacity:.7">يمكن اختيار أكثر من صلاحية</div>
              </div>
              <div class="col-12">
                <button class="hm-embed__close" type="submit">إنشاء</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="hm-section" aria-label="قائمة المشرفين">
      <h2 class="hm-section__title">قائمة المشرفين</h2>
      <div class="hm-list" id="adminsList">
        <% if (users && users.length) { %>
          <% users.forEach(function(u){ %>
            <div class="hm-list__item">
              <div>
                <h3 class="hm-list__title"><%= u.name || 'مشرف' %></h3>
                <div class="hm-list__meta"><%= u.email || '' %><%= u.phone ? (' - ' + u.phone) : '' %></div>
              </div>
              <span class="hm-chip"><i class="fas fa-user-shield"></i><span><%= u.role || 'admin' %></span></span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="hm-list__item"><div><h3 class="hm-list__title">لا يوجد مشرفون</h3><div class="hm-list__meta">أنشئ مشرفاً من النموذج أعلاه</div></div></div>
        <% } %>
      </div>
    </section>
  </div>
</div>

<script>
  (function(){
    const form = document.getElementById('createAdminForm');
    if(!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const csrf = document.getElementById('csrfToken')?.value || '';
      const fd = new FormData(form);
      const payload = {
        name: fd.get('name'),
        email: fd.get('email'),
        phone: fd.get('phone'),
        password: fd.get('password'),
        role: fd.get('role'),
        permissions: fd.getAll('permissions')
      };

      try{
        const res = await fetch('/admin/users-management/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'csrf-token': csrf
          },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if(!data.success){
          alert(data.message || 'فشل إنشاء المشرف');
          return;
        }
        location.reload();
      }catch(err){
        alert('حدث خطأ أثناء إنشاء المشرف');
      }
    });
  })();
</script>
