<% layout('layout') -%>

<section class="hero">
    <div class="container">
        <h1>Find Your Dream Car</h1>
        <p>The best place for exclusive car auctions.</p>
        
        <!-- Quick Search Form -->
        <div class="hero-search">
            <form action="/search" method="GET" class="search-form">
                <div class="search-inputs">
                    <input type="text" name="q" placeholder="Search cars, brands, models..." class="search-input">
                    <select name="brand" class="search-select">
                        <option value="">All Brands</option>
                        <% if(locals.brands && brands.length) { %>
                            <% brands.forEach(brand => { %>
                                <option value="<%= brand._id %>"><%= brand.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <select name="minPrice" class="search-select">
                        <option value="">Min Price</option>
                        <option value="5000">$5,000</option>
                        <option value="10000">$10,000</option>
                        <option value="25000">$25,000</option>
                        <option value="50000">$50,000</option>
                    </select>
                    <select name="maxPrice" class="search-select">
                        <option value="">Max Price</option>
                        <option value="25000">$25,000</option>
                        <option value="50000">$50,000</option>
                        <option value="100000">$100,000</option>
                        <option value="200000">$200,000+</option>
                    </select>
                </div>
                <button type="submit" class="search-btn">
                    <i class="fas fa-search"></i> Search
                </button>
            </form>
        </div>
        
        <a href="/auctions" class="cta-button"><%= __('home.explore_auctions') %></a>
    </div>
</section>

<section class="featured-section">
    <div class="container">
        <h2><%= __('home.featured_cars') %></h2>
        <div class="car-grid">
            <% if(locals.cars && cars.length) { %>
                <% cars.slice(0, 6).forEach(car => { %>
                    <div class="car-card">
                        <img src="<%= car.images[0] ? car.images[0].url : '/images/default-car.jpg' %>" alt="<%= car.make %> <%= car.model %>">
                        <div class="car-card-content">
                            <h3><%= car.make %> <%= car.model %></h3>
                            <p><%= __('common.year') %>: <%= car.year %></p>
                            <p class="price"><%= __('common.starting_bid') %>: $<%= new Intl.NumberFormat().format(car.startPrice) %></p>
                            <a href="/cars/<%= car._id %>" class="btn"><%= __('home.view_details') %></a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p><%= __('home.no_featured_cars') %></p>
            <% } %>
        </div>
    </div>
</section>

<section class="stats-section">
    <div class="container">
        <h2><%= __('home.platform_stats') %></h2>
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-car"></i>
                <div class="stat-number"><%= locals.stats ? stats.totalCars : '500+' %></div>
                <div class="stat-label"><%= __('home.total_cars') %></div>
            </div>
            <div class="stat-card">
                <i class="fas fa-gavel"></i>
                <div class="stat-number"><%= locals.stats ? stats.activeAuctions : '50+' %></div>
                <div class="stat-label"><%= __('home.active_auctions') %></div>
            </div>
            <div class="stat-card">
                <i class="fas fa-users"></i>
                <div class="stat-number"><%= locals.stats ? stats.totalUsers : '1000+' %></div>
                <div class="stat-label"><%= __('home.happy_customers') %></div>
            </div>
            <div class="stat-card">
                <i class="fas fa-trophy"></i>
                <div class="stat-number"><%= locals.stats ? stats.completedAuctions : '200+' %></div>
                <div class="stat-label"><%= __('home.completed_auctions') %></div>
            </div>
        </div>
    </div>
</section>

<section class="live-auctions-section">
    <div class="container">
        <h2><%= __('home.live_auctions') %></h2>
        <div class="live-auctions-grid">
            <% if(locals.liveAuctions && liveAuctions.length) { %>
                <% liveAuctions.slice(0, 3).forEach(auction => { %>
                    <div class="auction-card live">
                        <div class="auction-status">LIVE</div>
                        <img src="<%= auction.car.images[0] ? auction.car.images[0].url : '/images/default-car.jpg' %>" alt="<%= auction.car.make %> <%= auction.car.model %>">
                        <div class="auction-content">
                            <h3><%= auction.car.make %> <%= auction.car.model %></h3>
                            <p><%= __('common.current_bid') %>: $<%= new Intl.NumberFormat().format(auction.currentBid || auction.startingPrice) %></p>
                            <div class="countdown" data-end="<%= auction.endDate %>">
                                <span class="time-remaining"><%= __('home.ends_in') %>: <span class="countdown-timer">Loading...</span></span>
                            </div>
                            <a href="/auctions/<%= auction._id %>" class="btn btn-live"><%= __('home.bid_now') %></a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p><%= __('home.no_live_auctions') %></p>
            <% } %>
        </div>
        <div class="text-center mt-4">
            <a href="/auctions" class="btn btn-secondary"><%= __('home.view_all_auctions') %></a>
        </div>
    </div>
</section>

<section class="reviews-section">
    <div class="container">
        <h2><%= __('home.what_customers_say') %></h2>
        <div class="reviews-grid">
            <% if(locals.recentReviews && recentReviews.length) { %>
                <% recentReviews.slice(0, 3).forEach(review => { %>
                    <div class="review-card">
                        <div class="review-header">
                            <div class="review-rating">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <i class="fas fa-star <%= i <= review.rating ? 'active' : '' %>"></i>
                                <% } %>
                            </div>
                            <div class="review-author">
                                <%= review.user ? review.user.name : 'Anonymous' %>
                            </div>
                        </div>
                        <div class="review-content">
                            <p><%= review.comment %></p>
                        </div>
                        <div class="review-car">
                            <small><%= __('common.reviewed') %>: <%= review.car ? `${review.car.make} ${review.car.model}` : 'Car' %></small>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="review-card placeholder">
                    <p><%= __('common.be_first_review') %></p>
                </div>
                <div class="review-card placeholder">
                    <p><%= __('common.share_experience') %></p>
                </div>
                <div class="review-card placeholder">
                    <p><%= __('common.help_others') %></p>
                </div>
            <% } %>
        </div>
        <div class="text-center mt-4">
            <a href="/reviews" class="btn btn-secondary"><%= __('home.view_all_reviews') %></a>
        </div>
    </div>
</section>
