<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>

<link href="/public/css/ultimate-luxury.css" rel="stylesheet">

<div class="main-container">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">HM CAR</h1>
      <p class="hero-subtitle">مزادات السيارات الفاخرة في المملكة العربية السعودية</p>
      
      <!-- Search Section -->
      <div class="search-section">
        <h2 class="search-title">
          <i class="fas fa-search"></i>
          ابحث عن سيارتك أحلامك
        </h2>
        <form action="/search" method="GET" class="search-form">
          <div class="search-grid">
            <div class="search-item">
              <i class="fas fa-search"></i>
              <input type="text" name="q" placeholder="اكتب اسم السيارة..." class="search-input">
            </div>
            <div class="search-item">
              <i class="fas fa-car"></i>
              <select name="brand" class="search-select">
                <option value="">اختر الماركة</option>
                <option value="toyota">تويوتا</option>
                <option value="mercedes">مرسيدس</option>
                <option value="bmw">بي إم دبليو</option>
                <option value="audi">أودي</option>
                <option value="lexus">لكزس</option>
                <option value="ferrari">فيراري</option>
                <option value="lamborghini">لامبورغيني</option>
                <option value="porsche">بورش</option>
              </select>
            </div>
            <div class="search-item">
              <i class="fas fa-money-bill-wave"></i>
              <select name="minPrice" class="search-select">
                <option value="">السعر من</option>
                <option value="50000">50,000 ريال</option>
                <option value="100000">100,000 ريال</option>
                <option value="200000">200,000 ريال</option>
                <option value="300000">300,000 ريال</option>
                <option value="500000">500,000 ريال</option>
              </select>
            </div>
            <div class="search-item">
              <i class="fas fa-money-bill-wave"></i>
              <select name="maxPrice" class="search-select">
                <option value="">السعر إلى</option>
                <option value="100000">100,000 ريال</option>
                <option value="200000">200,000 ريال</option>
                <option value="300000">300,000 ريال</option>
                <option value="500000">500,000 ريال</option>
                <option value="1000000">1,000,000 ريال</option>
              </select>
            </div>
          </div>
          <button type="submit" class="search-button">
            <i class="fas fa-search"></i>
            بحث متقدم
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <h2 class="stats-title">أرقامنا تتحدث عنا</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <i class="fas fa-car"></i>
          <span class="stat-number">500+</span>
          <span class="stat-label">سيارة فاخرة</span>
        </div>
        <div class="stat-item">
          <i class="fas fa-gavel"></i>
          <span class="stat-number">50+</span>
          <span class="stat-label">مزاد أسبوعياً</span>
        </div>
        <div class="stat-item">
          <i class="fas fa-users"></i>
          <span class="stat-number">10,000+</span>
          <span class="stat-label">مشتري راضٍ</span>
        </div>
        <div class="stat-item">
          <i class="fas fa-heart"></i>
          <span class="stat-number">98%</span>
          <span class="stat-label">رضا العملاء</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Cars Section -->
  <section class="cars-section">
    <div class="container">
      <h2 class="cars-title">
        <i class="fas fa-star"></i>
        سيارات مميزة
      </h2>
      <p class="cars-subtitle">أجمل السيارات الفاخرة بانتظارك</p>
      
      <div class="car-grid">
        <% if (cars && cars.length > 0) { %>
          <% cars.forEach(car => { %>
            <div class="car-card">
              <div class="car-image-container">
                <img src="<%= car.image || '/images/car-placeholder.jpg' %>" alt="<%= car.make %> <%= car.model %>" class="car-image">
                <div class="car-badge">
                  <i class="fas fa-crown"></i>
                  مميزة
                </div>
              </div>
              <div class="car-info">
                <h3 class="car-title">
                  <i class="fas fa-car"></i>
                  <%= car.make %> <%= car.model %>
                </h3>
                <div class="car-price">
                  <i class="fas fa-tag"></i>
                  <%= car.price ? car.price.toLocaleString() + ' ريال' : 'عند الطلب' %>
                </div>
                <div class="car-details">
                  <span><i class="fas fa-calendar-alt"></i> <%= car.year || '2024' %></span>
                  <span><i class="fas fa-tachometer-alt"></i> <%= car.mileage || '0' %> كم</span>
                  <span><i class="fas fa-gas-pump"></i> بنزين</span>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="no-cars-message">
            <i class="fas fa-car-side"></i>
            <h3>لا توجد سيارات مميزة حالياً</h3>
            <p>سيتم إضافة سيارات فاخرة جديدة قريباً. تابعنا للحصول على أحدث التحديثات!</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-content">
      <h2>انضم إلى عالم المزادات الفاخرة</h2>
      <p>اكتشف أفضل السيارات الفاخرة بأفضل الأسعار في المملكة العربية السعودية</p>
      <div class="cta-buttons">
        <a href="/auth/login" class="cta-button">
          <i class="fas fa-sign-in-alt"></i>
          تسجيل الدخول
        </a>
      </div>
    </div>
  </section>
</div>
