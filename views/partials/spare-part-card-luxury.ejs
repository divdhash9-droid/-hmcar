<!-- [[ARABIC_HEADER]] هذا الملف (views/partials/spare-part-card-luxury.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->
<!-- بطاقة قطعة غيار فاخرة مع صور محسّنة وتأثيرات تفاعلية -->

<div class="luxury-part-card-container" data-part-id="<%= part._id %>">
    <div class="luxury-part-card">
        <!-- رأس البطاقة مع الصورة المحسّنة -->
        <div class="luxury-part-header">
            <a href="/spare-parts/<%= part._id %>" class="luxury-part-image-link">
                <div class="luxury-part-image-wrapper">
                    <% if (part.images && part.images.length > 0) { %>
                        <img src="<%= part.images[0] %>" 
                             alt="<%= part.name %>" 
                             class="luxury-part-main-image"
                             loading="lazy">
                        
                        <!-- شعار المخزون -->
                        <% if (part.inStock && part.stockQty > 0) { %>
                            <div class="luxury-part-stock-badge">
                                <i class="fas fa-check-circle"></i>
                                متوفر
                            </div>
                        <% } else { %>
                            <div class="luxury-part-out-of-stock">
                                <i class="fas fa-times-circle"></i>
                                نفد المخزون
                            </div>
                        <% } %>
                    <% } else { %>
                        <!-- صورة نائبة فاخرة -->
                        <div class="luxury-part-placeholder">
                            <div class="luxury-part-placeholder-content">
                                <i class="fas fa-cogs luxury-part-placeholder-icon"></i>
                                <h4>قطعة غيار</h4>
                                <p><%= part.name %></p>
                            </div>
                        </div>
                    <% } %>
                    
                    <!-- تأثيرات التفاعل -->
                    <div class="luxury-part-overlay">
                        <div class="luxury-part-overlay-content">
                            <button class="luxury-part-overlay-btn">
                                <i class="fas fa-search-plus"></i>
                                عرض سريع
                            </button>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        
        <!-- محتوى البطاقة -->
        <div class="luxury-part-body">
            <!-- العنوان والنوع -->
            <div class="luxury-part-title-section">
                <div class="luxury-part-type-icon">
                    <% 
                    const typeIcons = {
                        'engine': 'fa-cogs',
                        'transmission': 'fa-cog',
                        'brakes': 'fa-compact-disc',
                        'suspension': 'fa-wrench',
                        'electrical': 'fa-bolt',
                        'interior': 'fa-chair',
                        'exterior': 'fa-car-side',
                        'other': 'fa-tools'
                    };
                    const icon = typeIcons[part.partType] || 'fa-tools';
                    %>
                    <i class="fas <%= icon %>"></i>
                </div>
                <div class="luxury-part-title-info">
                    <h3 class="luxury-part-title">
                        <a href="/spare-parts/<%= part._id %>"><%= part.name %></a>
                    </h3>
                    <p class="luxury-part-type">
                        <% 
                        const typeNames = {
                            'engine': 'محرك',
                            'transmission': 'ناقل حركة',
                            'brakes': 'فرامل',
                            'suspension': 'تعليق',
                            'electrical': 'كهرباء',
                            'interior': 'داخلية',
                            'exterior': 'خارجية',
                            'other': 'أخرى'
                        };
                        %>
                        <%= typeNames[part.partType] || part.partType || 'قطعة غيار' %>
                    </p>
                </div>
            </div>
            
            <!-- معلومات السيارة المتوافقة -->
            <% if (part.carMake || part.carModel) { %>
                <div class="luxury-part-compatibility">
                    <div class="luxury-part-compatibility-header">
                        <i class="fas fa-car"></i>
                        <span>متوافق مع</span>
                    </div>
                    <div class="luxury-part-compatibility-info">
                        <% if (part.carMake) { %>
                            <span class="luxury-part-make"><%= part.carMake %></span>
                        <% } %>
                        <% if (part.carModel) { %>
                            <span class="luxury-part-model"><%= part.carModel %></span>
                        <% } %>
                        <% if (part.carYear) { %>
                            <span class="luxury-part-year"><%= part.carYear %></span>
                        <% } %>
                    </div>
                </div>
            <% } %>
            
            <!-- العلامة التجارية -->
            <% if (part.spareBrand) { %>
                <div class="luxury-part-brand">
                    <div class="luxury-part-brand-label">العلامة التجارية</div>
                    <div class="luxury-part-brand-name">
                        <% if (part.spareBrand.logo) { %>
                            <img src="<%= part.spareBrand.logo %>" 
                                 alt="<%= part.spareBrand.name %>" 
                                 class="luxury-part-brand-logo"
                                 loading="lazy">
                        <% } %>
                        <%= part.spareBrand.name %>
                    </div>
                </div>
            <% } %>
            
            <!-- السعر -->
            <div class="luxury-part-price-section">
                <div class="luxury-part-price-main">
                    <% if (part.priceSar) { %>
                        <span class="luxury-part-price-amount"><%= part.priceSar.toLocaleString() %></span>
                        <span class="luxury-part-price-currency">ريال سعودي</span>
                    <% } else if (part.price) { %>
                        <span class="luxury-part-price-amount"><%= part.price.toLocaleString() %></span>
                        <span class="luxury-part-price-currency">ريال</span>
                    <% } else { %>
                        <span class="luxury-part-price-contact">السعر عند الطلب</span>
                    <% } %>
                </div>
                
                <% if (part.priceUsd) { %>
                    <div class="luxury-part-price-secondary">
                        ≈ <%= part.priceUsd.toLocaleString() %> USD
                    </div>
                <% } %>
            </div>
            
            <!-- معلومات المخزون -->
            <% if (part.inStock && part.stockQty > 0) { %>
                <div class="luxury-part-stock-info">
                    <i class="fas fa-box"></i>
                    <span>الكمية المتاحة: <%= part.stockQty %></span>
                </div>
            <% } %>
        </div>
        
        <!-- أزرار الإجراءات -->
        <div class="luxury-part-footer">
            <a href="/spare-parts/<%= part._id %>" class="luxury-part-btn luxury-part-btn-primary">
                <i class="fas fa-eye"></i>
                <span>التفاصيل</span>
            </a>
            
            <% if (currentUser && (currentUser.role === 'buyer' || currentUser.role === 'user')) { %>
                <% if (part.inStock && part.stockQty > 0) { %>
                    <button class="luxury-part-btn luxury-part-btn-cart" 
                            data-part-id="<%= part._id %>" 
                            onclick="addToCartLuxury(this)">
                        <i class="fas fa-shopping-cart"></i>
                    </button>
                <% } else { %>
                    <button class="luxury-part-btn luxury-part-btn-disabled" disabled>
                        <i class="fas fa-times"></i>
                    </button>
                <% } %>
            <% } %>
            
            <% if (currentUser && currentUser.role === 'admin') { %>
                <a href="/admin/spare-parts/<%= part._id %>/edit" class="luxury-part-btn luxury-part-btn-edit">
                    <i class="fas fa-edit"></i>
                </a>
            <% } %>
        </div>
    </div>
</div>

<script>
function addToCartLuxury(button) {
    const partId = button.getAttribute('data-part-id');
    const icon = button.querySelector('i');
    
    // تأثير إضافة للسلة
    button.classList.add('adding');
    icon.className = 'fas fa-spinner fa-spin';
    
    // إرسال طلب إلى الخادم
    fetch('/spare-parts/cart/add', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
        },
        body: JSON.stringify({ partId, quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            button.classList.remove('adding');
            button.classList.add('added');
            icon.className = 'fas fa-check';
            
            // تحديث عداد السلة
            updateCartCounter(data.cartCount);
            
            // إعادة تعيين بعد ثانيتين
            setTimeout(() => {
                button.classList.remove('added');
                icon.className = 'fas fa-shopping-cart';
            }, 2000);
        } else {
            throw new Error(data.message || 'Failed to add to cart');
        }
    })
    .catch(error => {
        console.error('Error adding to cart:', error);
        button.classList.remove('adding');
        icon.className = 'fas fa-shopping-cart';
        
        // إشعار خطأ
        showNotification('حدث خطأ أثناء إضافة المنتج للسلة', 'error');
    });
}

function updateCartCounter(count) {
    const counter = document.querySelector('.cart-counter');
    if (counter) {
        counter.textContent = count;
        counter.classList.add('updated');
        setTimeout(() => counter.classList.remove('updated'), 500);
    }
}

function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `luxury-notification luxury-notification-${type}`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.add('show');
    }, 100);
    
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

// تأثيرات حركية عند التمرير
document.addEventListener('DOMContentLoaded', function() {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('luxury-part-card-visible');
            }
        });
    }, {
        threshold: 0.1
    });
    
    document.querySelectorAll('.luxury-part-card-container').forEach(card => {
        observer.observe(card);
    });
});
</script>

