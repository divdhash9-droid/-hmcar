<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/client-permissions.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>

<div class="hm-admin-layout">
  <div class="hm-admin-bg">
    <div class="hm-admin-bg-gradient"></div>
    <div class="hm-admin-bg-glow"></div>
  </div>

  <button class="hm-mobile-toggle" type="button" onclick="toggleSidebar()">
    <i class="fas fa-bars"></i>
  </button>

  <%- include('../partials/admin-sidebar') %>

  <main class="hm-admin-main">
    <header class="hm-admin-header">
      <div class="hm-header-title">
        <div>
          <h1>صلاحيات العملاء</h1>
          <div class="hm-header-breadcrumb">
            <a href="/admin">الرئيسية</a>
            <i class="fas fa-chevron-left"></i>
            <span>صلاحيات العملاء</span>
          </div>
        </div>
      </div>
      <div class="hm-header-actions">
        <div class="hm-header-chip">
          <i class="fas fa-users"></i>
          <span><%= Array.isArray(clients) ? clients.length : 0 %> عميل</span>
        </div>
      </div>
    </header>

    <section class="hm-admin-content">
      <div class="hm-dashboard-card">
        <div class="hm-card-header">
          <h3 class="hm-card-title">
            <i class="fas fa-search"></i>
            البحث والفلترة
          </h3>
        </div>
        <div class="hm-card-body">
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>البحث عن عميل</label>
                <input type="text" id="searchClient" class="form-control" placeholder="ابحث بالاسم أو البريد الإلكتروني" oninput="filterClients()" />
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label>الحالة</label>
                <select id="filterStatus" class="form-control" onchange="filterClients()">
                  <option value="">الكل</option>
                  <option value="active">نشط</option>
                  <option value="suspended">معلق</option>
                </select>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label>الجهاز</label>
                <select id="filterDevice" class="form-control" onchange="filterClients()">
                  <option value="">الكل</option>
                  <option value="linked">مرتبط</option>
                  <option value="unlinked">غير مرتبط</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="hm-dashboard-card">
        <div class="hm-card-header">
          <h3 class="hm-card-title">
            <i class="fas fa-users"></i>
            العملاء
          </h3>
        </div>
        <div class="hm-card-body">
          <div class="table-responsive">
            <table class="table" id="clientsTable" style="width:100%">
              <thead>
                <tr>
                  <th>العميل</th>
                  <th>الحالة</th>
                  <th>الجهاز</th>
                  <th>آخر دخول</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody id="clientsTableBody">
                <% if (Array.isArray(clients) && clients.length) { %>
                  <% clients.forEach(function(client) { %>
                    <tr data-client-id="<%= client._id %>" data-status="<%= client.status || '' %>" data-device="<%= client.deviceFingerprint ? 'linked' : 'unlinked' %>">
                      <td>
                        <div style="display:flex; flex-direction:column; gap:2px;">
                          <strong><%= client.name || '—' %></strong>
                          <small style="opacity:.75"><%= client.email || '—' %></small>
                        </div>
                      </td>
                      <td>
                        <% if ((client.status || '') === 'active') { %>
                          <span class="badge" style="background: rgba(46, 204, 113, 0.15); color: #2ecc71; padding: 6px 10px; border-radius: 999px;">نشط</span>
                        <% } else { %>
                          <span class="badge" style="background: rgba(231, 76, 60, 0.12); color: #e74c3c; padding: 6px 10px; border-radius: 999px;">معلق</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge" style="background: rgba(52, 152, 219, 0.10); color: #3498db; padding: 6px 10px; border-radius: 999px;">
                          <%= client.deviceFingerprint ? 'مرتبط' : 'غير مرتبط' %>
                        </span>
                      </td>
                      <td>
                        <% if (client.lastLogin) { %>
                          <div style="display:flex; flex-direction:column; gap:2px;">
                            <span><%= new Date(client.lastLogin).toLocaleDateString('ar-SA') %></span>
                            <small style="opacity:.75"><%= new Date(client.lastLogin).toLocaleTimeString('ar-SA') %></small>
                          </div>
                        <% } else { %>
                          <span>لم يسجل دخول</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="d-flex flex-wrap gap-2">
                          <a class="hm-btn-admin hm-btn-admin-secondary" href="/admin/clients/<%= client._id %>">
                            <i class="fas fa-eye"></i>
                            عرض
                          </a>
                          <button class="hm-btn-admin hm-btn-admin-primary" type="button" onclick="openPermissions('<%= client._id %>')">
                            <i class="fas fa-key"></i>
                            صلاحيات
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" style="text-align:center; opacity:.8; padding: 18px;">لا يوجد عملاء</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<!-- بيانات العملاء كـ JSON آمن -->
<script type="application/json" id="hmClientsJson"><%- JSON.stringify(Array.isArray(clients) ? clients : []) %></script>

<!-- نافذة الصلاحيات (مبسطة) -->
<div id="hmPermissionsModal" class="hm-modal" style="display:none;">
  <div class="hm-modal-content">
    <div class="hm-modal-header">
      <h3 id="hmPermissionsTitle">صلاحيات العميل</h3>
      <button class="hm-modal-close" type="button" onclick="closePermissions()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="hm-modal-body">
      <input type="hidden" id="hmClientId" />

      <div class="permission-section">
        <h4>الصلاحيات الأساسية</h4>
        <div class="permission-list">
          <label class="permission-item"><input type="checkbox" id="p-canViewCars" /> <span>مشاهدة السيارات</span></label>
          <label class="permission-item"><input type="checkbox" id="p-canViewAuctions" /> <span>مشاهدة المزادات</span></label>
          <label class="permission-item"><input type="checkbox" id="p-canViewProfile" /> <span>مشاهدة الملف الشخصي</span></label>
        </div>
      </div>

      <div class="permission-section">
        <h4>التفاعل</h4>
        <div class="permission-list">
          <label class="permission-item"><input type="checkbox" id="p-canPlaceBids" /> <span>وضع المزايدات</span></label>
          <label class="permission-item"><input type="checkbox" id="p-canEditProfile" /> <span>تعديل الملف الشخصي</span></label>
          <label class="permission-item"><input type="checkbox" id="p-canContactAdmin" /> <span>التواصل مع الإدارة</span></label>
        </div>
      </div>

      <div class="permission-section">
        <h4>المتقدم</h4>
        <div class="permission-list">
          <label class="permission-item"><input type="checkbox" id="p-canUploadFiles" /> <span>رفع الملفات</span></label>
          <label class="permission-item"><input type="checkbox" id="p-canCreateAuctions" /> <span>إنشاء مزادات</span></label>
          <label class="permission-item"><input type="checkbox" id="p-canViewReports" /> <span>مشاهدة التقارير</span></label>
        </div>
      </div>

      <div class="permission-section">
        <h4>إعدادات الجهاز</h4>
        <div class="permission-list">
          <label class="permission-item"><input type="checkbox" id="p-deviceLockEnabled" /> <span>قفل الجهاز</span></label>
          <label class="permission-item" style="align-items:center; gap:10px;">
            <span style="min-width: 170px;">الحد الأقصى للحسابات للجهاز</span>
            <input type="number" id="p-deviceAccountLimit" class="form-control" min="1" max="10" value="1" style="max-width: 120px;" />
          </label>
        </div>
      </div>
    </div>
    <div class="hm-modal-footer" style="display:flex; gap:10px; justify-content:flex-end;">
      <button class="hm-btn-admin hm-btn-admin-secondary" type="button" onclick="closePermissions()">إلغاء</button>
      <button class="hm-btn-admin hm-btn-admin-primary" type="button" onclick="savePermissions()">
        <i class="fas fa-save"></i>
        حفظ
      </button>
    </div>
  </div>
</div>

<script>
  const hmClients = (() => {
    try {
      const el = document.getElementById('hmClientsJson');
      return el ? JSON.parse(el.textContent || '[]') : [];
    } catch (_) {
      return [];
    }
  })();

  function filterClients() {
    const q = String(document.getElementById('searchClient')?.value || '').trim().toLowerCase();
    const status = String(document.getElementById('filterStatus')?.value || '').trim();
    const device = String(document.getElementById('filterDevice')?.value || '').trim();
    const rows = document.querySelectorAll('#clientsTableBody tr[data-client-id]');
    rows.forEach((row) => {
      const name = (row.querySelector('strong')?.textContent || '').toLowerCase();
      const email = (row.querySelector('small')?.textContent || '').toLowerCase();
      const rowStatus = row.getAttribute('data-status') || '';
      const rowDevice = row.getAttribute('data-device') || '';
      const matchQ = !q || name.includes(q) || email.includes(q);
      const matchStatus = !status || rowStatus === status;
      const matchDevice = !device || rowDevice === device;
      row.style.display = (matchQ && matchStatus && matchDevice) ? '' : 'none';
    });
  }

  function openPermissions(clientId) {
    const modal = document.getElementById('hmPermissionsModal');
    const client = hmClients.find((c) => String(c._id) === String(clientId));
    if (!modal || !client) return;

    document.getElementById('hmClientId').value = clientId;
    document.getElementById('hmPermissionsTitle').textContent = `صلاحيات العميل: ${client.name || ''}`;

    const permissions = client.permissions || {};
    document.getElementById('p-canViewCars').checked = !!permissions.canViewCars;
    document.getElementById('p-canViewAuctions').checked = !!permissions.canViewAuctions;
    document.getElementById('p-canViewProfile').checked = !!permissions.canViewProfile;
    document.getElementById('p-canPlaceBids').checked = !!permissions.canPlaceBids;
    document.getElementById('p-canEditProfile').checked = !!permissions.canEditProfile;
    document.getElementById('p-canContactAdmin').checked = !!permissions.canContactAdmin;
    document.getElementById('p-canUploadFiles').checked = !!permissions.canUploadFiles;
    document.getElementById('p-canCreateAuctions').checked = !!permissions.canCreateAuctions;
    document.getElementById('p-canViewReports').checked = !!permissions.canViewReports;

    document.getElementById('p-deviceLockEnabled').checked = !!client.deviceLockEnabled;
    document.getElementById('p-deviceAccountLimit').value = Number(client.deviceAccountLimit || 1);

    modal.style.display = 'block';
  }

  function closePermissions() {
    const modal = document.getElementById('hmPermissionsModal');
    if (modal) modal.style.display = 'none';
  }

  async function savePermissions() {
    const clientId = document.getElementById('hmClientId')?.value;
    if (!clientId) return;

    const permissions = {
      canViewCars: document.getElementById('p-canViewCars').checked,
      canViewAuctions: document.getElementById('p-canViewAuctions').checked,
      canViewProfile: document.getElementById('p-canViewProfile').checked,
      canPlaceBids: document.getElementById('p-canPlaceBids').checked,
      canEditProfile: document.getElementById('p-canEditProfile').checked,
      canContactAdmin: document.getElementById('p-canContactAdmin').checked,
      canUploadFiles: document.getElementById('p-canUploadFiles').checked,
      canCreateAuctions: document.getElementById('p-canCreateAuctions').checked,
      canViewReports: document.getElementById('p-canViewReports').checked
    };

    const deviceSettings = {
      deviceLockEnabled: document.getElementById('p-deviceLockEnabled').checked,
      deviceAccountLimit: parseInt(document.getElementById('p-deviceAccountLimit').value || '1', 10)
    };

    try {
      const res = await fetch(`/admin/clients/${clientId}/permissions`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ permissions, deviceSettings })
      });
      const data = await res.json();
      if (data && data.success) {
        closePermissions();
        location.reload();
      } else {
        alert((data && data.message) ? data.message : 'فشل حفظ الصلاحيات');
      }
    } catch (e) {
      alert('حدث خطأ أثناء الحفظ');
    }
  }
</script>
