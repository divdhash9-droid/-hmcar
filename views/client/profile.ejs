<!-- [[ARABIC_HEADER]] هذا الملف (views/client/profile.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>

<style>
.hm-pro-home {
    min-height: 100vh;
    background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 25%, #0ea5e9 50%, #1e3a8a 75%, #1e293b 100%);
    position: relative;
    overflow: hidden;
}

.hm-pro-home::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 20% 50%, rgba(248, 250, 252, 0.4) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(14, 165, 233, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 20%, rgba(255, 255, 255, 0.6) 0%, transparent 50%);
    animation: neuralPulse 8s ease-in-out infinite;
    z-index: -1;
}

.hm-pro-home::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(2px 2px at 20px 30px, #0ea5e9, transparent),
        radial-gradient(2px 2px at 40px 70px, #1e3a8a, transparent),
        radial-gradient(1px 1px at 50px 50px, #f8fafc, transparent),
        radial-gradient(1px 1px at 80px 10px, #ffffff, transparent),
        radial-gradient(2px 2px at 130px 80px, #0ea5e9, transparent);
    background-repeat: repeat;
    background-size: 200px 200px;
    animation: particlesFloat 20s linear infinite;
    z-index: -1;
    opacity: 0.3;
}

@keyframes neuralPulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.1); }
}

@keyframes particlesFloat {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-200px, -200px); }
}

.hm-hero {
    position: relative;
    padding: 4rem 2rem 3rem;
    background: transparent;
}

.hm-hero__content {
    max-width: 1200px;
    margin: 0 auto;
}

.profile-header-card {
    background: linear-gradient(135deg, rgba(248, 250, 252, 0.95) 0%, rgba(255, 255, 255, 0.9) 50%, rgba(240, 249, 255, 0.95) 100%);
    backdrop-filter: blur(20px);
    border-radius: 30px;
    padding: 3rem;
    box-shadow: 
        0 25px 50px rgba(14, 165, 233, 0.15),
        0 15px 35px rgba(30, 58, 138, 0.1),
        0 5px 15px rgba(0, 0, 0, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.9),
        inset 0 -1px 0 rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(248, 250, 252, 0.5);
    transform: perspective(1000px) rotateY(0deg) rotateX(2deg);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
}

.profile-header-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(248, 250, 252, 0.8), transparent);
    animation: cardShimmer 3s ease-in-out infinite;
}

.profile-header-card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: conic-gradient(from 0deg, transparent, rgba(14, 165, 233, 0.03), transparent);
    animation: cardRotate 20s linear infinite;
    pointer-events: none;
}

@keyframes cardShimmer {
    0%, 100% { opacity: 0.3; transform: translateX(-100%); }
    50% { opacity: 0.8; transform: translateX(100%); }
}

@keyframes cardRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.profile-header-card:hover {
    transform: perspective(1000px) rotateY(2deg) rotateX(0deg) translateY(-5px);
    box-shadow: 
        0 35px 70px rgba(14, 165, 233, 0.2),
        0 20px 40px rgba(30, 58, 138, 0.15),
        0 8px 20px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        inset 0 -1px 0 rgba(0, 0, 0, 0.03);
}

.profile-avatar-section {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
}

#profileAvatarWrap {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0ea5e9, #1e3a8a);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 
        0 8px 25px rgba(14, 165, 233, 0.3),
        0 4px 15px rgba(30, 58, 138, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
    border: 3px solid rgba(248, 250, 252, 0.5);
    transition: all 0.3s ease;
    position: relative;
}

#profileAvatarWrap::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, #0ea5e9, #1e3a8a, #0ea5e9);
    border-radius: 50%;
    z-index: -1;
    animation: avatarGlow 2s ease-in-out infinite;
}

@keyframes avatarGlow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
}

#profileAvatarWrap:hover {
    transform: scale(1.05) rotate(5deg);
    box-shadow: 
        0 12px 35px rgba(14, 165, 233, 0.4),
        0 6px 20px rgba(30, 58, 138, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

#profileAvatarWrap:hover::before {
    animation-duration: 1s;
}

.profile-info h1 {
    color: #1e3a8a;
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
    background: linear-gradient(45deg, #1e3a8a, #0ea5e9, #64748b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.profile-info p {
    color: rgba(30, 58, 138, 0.7);
    font-size: 1.1rem;
    margin: 0.5rem 0 0;
    font-weight: 500;
}

.profile-nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
}

.hm-btn-3d {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(248, 250, 252, 0.2) 100%);
    border: 2px solid rgba(14, 165, 233, 0.3);
    color: #1e3a8a;
    text-decoration: none;
    border-radius: 15px;
    font-weight: 600;
    font-size: 1rem;
    box-shadow: 
        0 4px 15px rgba(14, 165, 233, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.5),
        inset 0 -1px 0 rgba(0, 0, 0, 0.05);
    transform: perspective(50px) rotateX(2deg);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.hm-btn-3d::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(248, 250, 252, 0.4), transparent);
    transition: left 0.5s ease;
}

.hm-btn-3d::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%, rgba(0, 0, 0, 0.05) 100%);
    border-radius: inherit;
}

.hm-btn-3d:hover::before {
    left: 100%;
}

.hm-btn-3d:hover {
    transform: perspective(50px) rotateX(0deg) translateY(-2px);
    box-shadow: 
        0 8px 25px rgba(14, 165, 233, 0.2),
        0 4px 15px rgba(30, 58, 138, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.7),
        inset 0 -1px 0 rgba(0, 0, 0, 0.02);
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.2) 0%, rgba(248, 250, 252, 0.3) 100%);
    border-color: rgba(14, 165, 233, 0.5);
}

.hm-btn-3d:active {
    transform: perspective(50px) rotateX(5deg) translateY(-1px);
    box-shadow: 
        0 2px 8px rgba(14, 165, 233, 0.15),
        0 1px 4px rgba(30, 58, 138, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.6),
        inset 0 -1px 0 rgba(0, 0, 0, 0.08);
}

.hm-btn-3d i {
    transition: transform 0.3s ease;
}

.hm-btn-3d:hover i {
    transform: translateX(-3px);
}

.hm-featured-cars {
    padding: 2rem 0;
}

.hm-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
}

.hm-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
