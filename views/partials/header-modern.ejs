<!-- [[ARABIC_HEADER]] هذا الملف (views/partials/header-modern.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<header class="main-header">
    <div class="container">
        <a href="/" class="logo" aria-label="HM CAR">
            <img class="logo-img" src="/public/images/logo.svg" alt="HM CAR" loading="eager" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            <span class="logo-text" style="display:none; font-size:1.8rem; font-weight:700; color:#fff; font-family:'Montserrat',sans-serif;">🚗 HM CAR</span>
        </a>
        <nav class="main-nav">
            <ul>
                <li>
                    <a href="/" class="<%= (typeof bodyClass !== 'undefined' && bodyClass === 'hm-home') ? 'active' : '' %>">
                        <i class="fas fa-home"></i><span class="icon-fallback">🏠</span> <%= __('navigation.home') %>
                    </a>
                </li>
                <li>
                    <a href="/auctions">
                        <i class="fas fa-gavel"></i><span class="icon-fallback">🔨</span> <%= __('navigation.auctions') %>
                    </a>
                </li>
                <li>
                    <a href="/cars">
                        <i class="fas fa-car"></i><span class="icon-fallback">🚗</span> <%= __('navigation.cars') %>
                    </a>
                </li>
                <li>
                    <a href="/about">
                        <i class="fas fa-info-circle"></i><span class="icon-fallback">ℹ️</span> <%= __('navigation.about') %>
                    </a>
                </li>
                <li>
                    <a href="/contact">
                        <i class="fas fa-envelope"></i><span class="icon-fallback">✉️</span> <%= __('navigation.contact') %>
                    </a>
                </li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <% if (user.role === 'admin' || user.role === 'super_admin' || user.role === 'manager') { %>
                        <li>
                            <a href="/admin/notifications">
                                <i class="fas fa-bell"></i><span class="icon-fallback">🔔</span> <%= __('navigation.notifications') %>
                            </a>
                        </li>
                    <% } %>
                <% } %>
            </ul>
        </nav>
        <div class="header-actions">
            <!-- Language Switcher -->
            <div class="language-switcher">
                <% if (typeof locale !== 'undefined' && locale === 'ar') { %>
                    <a href="?lang=en" class="lang-btn" title="<%= __('ui.switch_to_english') %>">
                        <i class="fas fa-globe"></i><span class="icon-fallback">🌐</span> EN
                    </a>
                <% } else { %>
                    <a href="?lang=ar" class="lang-btn" title="<%= __('ui.switch_to_arabic') %>">
                        <i class="fas fa-globe"></i><span class="icon-fallback">🌐</span> عر
                    </a>
                <% } %>
            </div>
            <div class="auth-buttons">
                <% if (typeof user !== 'undefined' && user) { %>
                    <% if (user.role === 'buyer') { %>
                        <a href="/client/profile" class="profile-btn">
                            <i class="fas fa-user"></i><span class="icon-fallback">👤</span>
                            <%= __('navigation.profile') %>
                        </a>
                        <a href="/client/dashboard" class="dashboard-btn">
                            <i class="fas fa-tachometer-alt"></i><span class="icon-fallback">📊</span>
                            <%= __('navigation.dashboard') %>
                        </a>
                    <% } else { %>
                        <% const dash = (user.role === 'admin' || user.role === 'super_admin' || user.role === 'manager') ? '/admin' : '/cars'; %>
                        <a href="<%= dash %>" class="login-btn">
                            <i class="fas fa-tachometer-alt"></i><span class="icon-fallback">📊</span>
                            <%= __('navigation.dashboard') %>
                        </a>
                    <% } %>
                    <a href="/auth/logout" class="signup-btn">
                        <i class="fas fa-sign-out-alt"></i><span class="icon-fallback">🚪</span>
                        <%= __('navigation.logout') %>
                    </a>
                <% } else { %>
                    <% const loginPrimaryLabel = (typeof locale !== 'undefined' && locale === 'ar') ? 'تسجيل الدخول' : __('navigation.login'); %>
                    <% const loginSecondaryLabel = (typeof locale !== 'undefined' && locale === 'ar') ? 'دخول آمن وفاخر' : 'Secure Luxury Access'; %>
                    <a href="/auth/login" class="login-btn hm-login-pill">
                        <span class="hm-login-pill__glow" aria-hidden="true"></span>
                        <span class="hm-login-pill__icon" aria-hidden="true">
                            <i class="fas fa-sign-in-alt"></i>
                        </span>
                        <span class="hm-login-pill__text">
                            <strong><%= loginPrimaryLabel %></strong>
                            <small><%= loginSecondaryLabel %></small>
                        </span>
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</header>
