<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>

<link href="/public/css/luxury-home.css" rel="stylesheet">

<div class="hero">
  <div class="hero-content">
    <h1 class="hero-title">HM CAR</h1>
    <p class="hero-subtitle">مزادات السيارات الفاخرة في المملكة العربية السعودية</p>
    
    <div class="hero-search">
      <form action="/search" method="GET" class="search-form">
        <div class="search-inputs">
          <div class="search-input-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" name="q" placeholder="ابحث عن سيارتك أحلامك..." class="search-input">
          </div>
          <div class="search-select-wrapper">
            <i class="fas fa-car"></i>
            <select name="brand" class="search-select">
              <option value="">جميع الماركات</option>
              <option value="toyota">تويوتا</option>
              <option value="mercedes">مرسيدس</option>
              <option value="bmw">بي إم دبليو</option>
              <option value="audi">أودي</option>
              <option value="lexus">لكزس</option>
            </select>
          </div>
          <div class="search-select-wrapper">
            <i class="fas fa-money-bill-wave"></i>
            <select name="minPrice" class="search-select">
              <option value="">السعر الأدنى</option>
              <option value="50000">50,000 ريال</option>
              <option value="100000">100,000 ريال</option>
              <option value="200000">200,000 ريال</option>
              <option value="300000">300,000 ريال</option>
            </select>
          </div>
          <div class="search-select-wrapper">
            <i class="fas fa-money-bill-wave"></i>
            <select name="maxPrice" class="search-select">
              <option value="">السعر الأعلى</option>
              <option value="100000">100,000 ريال</option>
              <option value="200000">200,000 ريال</option>
              <option value="300000">300,000 ريال</option>
              <option value="500000">500,000+ ريال</option>
            </select>
          </div>
        </div>
        <button type="submit" class="search-btn">
          <i class="fas fa-search"></i>
          بحث
        </button>
      </form>
    </div>
    
    <a href="/auctions" class="cta-button">استكشف المزادات</a>
  </div>
</div>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <i class="fas fa-car"></i>
        <span class="stat-number">500+</span>
        <span class="stat-label">سيارة فاخرة</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-gavel"></i>
        <span class="stat-number">50+</span>
        <span class="stat-label">مزاد أسبوعياً</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-users"></i>
        <span class="stat-number">10,000+</span>
        <span class="stat-label">مشتري راضٍ</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-heart"></i>
        <span class="stat-number">98%</span>
        <span class="stat-label">رضا العملاء</span>
      </div>
    </div>
  </div>
</section>

<section class="featured-section">
  <div class="container">
    <h2 class="section-title">
      <i class="fas fa-star"></i> سيارات مميزة
    </h2>
    <div class="car-grid">
      <% if (cars && cars.length > 0) { %>
        <% cars.forEach(car => { %>
          <div class="car-card">
            <div class="car-image-container">
              <img src="<%= car.image || '/images/car-placeholder.jpg' %>" alt="<%= car.make %> <%= car.model %>" class="car-image">
              <div class="car-badge">
                <i class="fas fa-crown"></i> مميزة
              </div>
            </div>
            <div class="car-info">
              <h3 class="car-title">
                <i class="fas fa-car"></i> <%= car.make %> <%= car.model %>
              </h3>
              <div class="car-price">
                <i class="fas fa-tag"></i> <%= car.price ? car.price.toLocaleString() + ' ريال' : 'عند الطلب' %>
              </div>
              <div class="car-details">
                <span><i class="fas fa-calendar-alt"></i> <%= car.year || '2024' %></span>
                <span><i class="fas fa-tachometer-alt"></i> <%= car.mileage || '0' %> كم</span>
                <span><i class="fas fa-gas-pump"></i> بنزين</span>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="no-cars-message">
          <i class="fas fa-car-side"></i>
          <h3>لا توجد سيارات مميزة حالياً</h3>
          <p>سيتم إضافة سيارات جديدة قريباً</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-content">
      <h2>انضم إلى مجتمع المزادات الفاخرة</h2>
      <p>اكتشف أفضل السيارات الفاخرة بأفضل الأسعار في المملكة العربية السعودية</p>
      <div class="cta-buttons">
        <a href="/auth/register" class="cta-button">إنشاء حساب</a>
        <a href="/auth/login" class="cta-button secondary">تسجيل الدخول</a>
      </div>
    </div>
  </div>
</section>

<style>
.cta-section {
  padding: 6rem 0;
  background: var(--gold-gradient);
  text-align: center;
}

.cta-content h2 {
  font-size: 2.5rem;
  color: var(--text-color);
  margin-bottom: 1rem;
  font-weight: 700;
}

.cta-content p {
  font-size: 1.2rem;
  color: var(--text-color);
  margin-bottom: 2rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.cta-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-button.secondary {
  background: transparent;
  border: 2px solid var(--text-color);
  color: var(--text-color);
}

.cta-button.secondary:hover {
  background: var(--text-color);
  color: var(--primary-color);
}

@media (max-width: 768px) {
  .cta-content h2 {
    font-size: 2rem;
  }
  
  .cta-buttons {
    flex-direction: column;
    align-items: center;
  }
  
  .cta-button {
    width: 250px;
    text-align: center;
  }
}
</style>
