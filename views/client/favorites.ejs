<% layout('layout') -%>

<link rel="stylesheet" href="/css/luxury-auth.css" />

<div class="hm-favorites-page">
  <!-- Header Section -->
  <div class="hm-page-header">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <div class="hm-header-content">
            <h1 class="hm-page-title">
              <i class="fas fa-heart"></i>
              <span data-ar="المفضلة" data-en="Favorites">المفضلة</span>
            </h1>
            <p class="hm-page-subtitle" data-ar="سياراتك المفضلة في مكان واحد" data-en="Your favorite cars in one place">
              سياراتك المفضلة في مكان واحد
            </p>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="hm-header-stats">
            <div class="hm-stat-card">
              <span class="hm-stat-number" id="favoritesCount">0</span>
              <span class="hm-stat-label" data-ar="سيارة" data-en="Cars">سيارة</span>
            </div>
            <div class="hm-stat-card">
              <span class="hm-stat-number" id="totalValue">$0</span>
              <span class="hm-stat-label" data-ar="القيمة الإجمالية" data-en="Total Value">القيمة الإجمالية</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters Section -->
  <div class="hm-filters-section">
    <div class="container">
      <div class="hm-filters">
        <div class="hm-filter-group">
          <label data-ar="الترتيب حسب" data-en="Sort by">الترتيب حسب</label>
          <select class="hm-filter-select" id="sortSelect">
            <option value="newest" data-ar="الأحدث" data-en="Newest">الأحدث</option>
            <option value="price-low" data-ar="السعر: من الأقل للأعلى" data-en="Price: Low to High">السعر: من الأقل للأعلى</option>
            <option value="price-high" data-ar="السعر: من الأعلى للأقل" data-en="Price: High to Low">السعر: من الأعلى للأقل</option>
            <option value="name" data-ar="الاسم" data-en="Name">الاسم</option>
          </select>
        </div>
        <div class="hm-filter-group">
          <label data-ar="الفئة" data-en="Category">الفئة</label>
          <select class="hm-filter-select" id="categoryFilter">
            <option value="" data-ar="جميع الفئات" data-en="All Categories">جميع الفئات</option>
            <option value="sedan" data-ar="سيدان" data-en="Sedan">سيدان</option>
            <option value="suv" data-ar="SUV" data-en="SUV">SUV</option>
            <option value="sports" data-ar="رياضية" data-en="Sports">رياضية</option>
            <option value="luxury" data-ar="فاخرة" data-en="Luxury">فاخرة</option>
          </select>
        </div>
        <div class="hm-filter-actions">
          <button class="hm-btn hm-btn-outline" id="clearFilters">
            <i class="fas fa-times"></i>
            <span data-ar="مسح الفلاتر" data-en="Clear Filters">مسح الفلاتر</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Favorites Grid -->
  <div class="hm-favorites-content">
    <div class="container">
      <!-- Loading State -->
      <div class="hm-loading" id="loadingState" style="display: none;">
        <div class="hm-spinner"></div>
        <p data-ar="جاري التحميل..." data-en="Loading...">جاري التحميل...</p>
      </div>

      <!-- Empty State -->
      <div class="hm-empty-state" id="emptyState" style="display: none;">
        <div class="hm-empty-icon">
          <i class="fas fa-heart"></i>
        </div>
        <h3 data-ar="لا توجد سيارات في المفضلة" data-en="No cars in favorites">لا توجد سيارات في المفضلة</h3>
        <p data-ar="ابدأ بإضافة السيارات التي تعجبك إلى المفضلة" data-en="Start adding cars you like to favorites">
          ابدأ بإضافة السيارات التي تعجبك إلى المفضلة
        </p>
        <a href="/cars/available" class="hm-btn hm-btn-primary">
          <i class="fas fa-search"></i>
          <span data-ar="استكشف السيارات" data-en="Explore Cars">استكشف السيارات</span>
        </a>
      </div>

      <!-- Cars Grid -->
      <div class="hm-cars-grid" id="favoritesGrid">
        <!-- Cars will be loaded here dynamically -->
      </div>
    </div>
  </div>
</div>

<!-- Car Card Template -->
<template id="carCardTemplate">
  <div class="hm-car-card">
    <div class="hm-car-image">
      <img src="" alt="" class="hm-car-img">
      <div class="hm-car-actions">
        <button class="hm-action-btn hm-btn-remove" data-car-id="">
          <i class="fas fa-heart"></i>
        </button>
        <button class="hm-action-btn hm-btn-view" data-car-id="">
          <i class="fas fa-eye"></i>
        </button>
        <button class="hm-action-btn hm-btn-compare" data-car-id="">
          <i class="fas fa-balance-scale"></i>
        </button>
      </div>
      <div class="hm-car-badge">
        <span class="hm-badge-text"></span>
      </div>
    </div>
    <div class="hm-car-details">
      <div class="hm-car-header">
        <h3 class="hm-car-title"></h3>
        <div class="hm-car-price"></div>
      </div>
      <div class="hm-car-specs">
        <div class="hm-spec">
          <i class="fas fa-calendar"></i>
          <span class="hm-year"></span>
        </div>
        <div class="hm-spec">
          <i class="fas fa-tachometer-alt"></i>
          <span class="hm-mileage"></span>
        </div>
        <div class="hm-spec">
          <i class="fas fa-gas-pump"></i>
          <span class="hm-fuel"></span>
        </div>
      </div>
      <div class="hm-car-footer">
        <div class="hm-car-location">
          <i class="fas fa-map-marker-alt"></i>
          <span class="hm-location"></span>
        </div>
        <div class="hm-car-date">
          <i class="fas fa-clock"></i>
          <span class="hm-added-date"></span>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
/* Favorites Page Styles */
.hm-favorites-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 50%, #f1f5f9 100%);
}

/* Header Section */
.hm-page-header {
  background: linear-gradient(135deg, #0a192f 0%, #112240 50%, #2366d1 100%);
  color: white;
  padding: 4rem 0 3rem;
  position: relative;
  overflow: hidden;
}

.hm-page-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.03"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.03"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
  opacity: 0.3;
}

.hm-header-content {
  position: relative;
  z-index: 1;
}

.hm-page-title {
  font-size: 3rem;
