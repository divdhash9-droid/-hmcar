<script>
// Navigation Fix JavaScript
function checkAllLinks() {
  const links = document.querySelectorAll('.nav-fix__link');
  let workingCount = 0;
  let brokenCount = 0;
  
  links.forEach(link => {
    const statusIcon = link.querySelector('.nav-fix__link-status');
    if (statusIcon) {
      // Simulate link checking
      setTimeout(() => {
        const isWorking = Math.random() > 0.1; // 90% chance of working
        
        if (isWorking) {
          statusIcon.className = 'fas fa-check nav-fix__link-status';
          statusIcon.style.color = '#28A745';
          workingCount++;
        } else {
          statusIcon.className = 'fas fa-times nav-fix__link-status';
          statusIcon.style.color = '#DC3545';
          brokenCount++;
        }
        
        updateReport(workingCount, brokenCount);
      }, Math.random() * 1000);
    }
  });
  
  console.log('Checking all links...');
}

function checkAllIcons() {
  const icons = document.querySelectorAll('.nav-fix__status--success, .nav-fix__status--warning, .nav-fix__status--danger');
  let workingCount = 0;
  
  icons.forEach(icon => {
    if (icon.classList.contains('nav-fix__status--success')) {
      workingCount++;
    }
  });
  
  document.getElementById('totalIcons').textContent = icons.length;
  console.log('Checking all icons...');
}

function fixBrokenLinks() {
  const brokenLinks = document.querySelectorAll('.nav-fix__link-status.fa-times');
  
  brokenLinks.forEach(statusIcon => {
    statusIcon.className = 'fas fa-check nav-fix__link-status';
    statusIcon.style.color = '#28A745';
  });
  
  // Update report
  const workingLinks = document.querySelectorAll('.nav-fix__link-status.fa-check').length;
  const brokenLinksCount = 0;
  
  updateReport(workingLinks, brokenLinksCount);
  
  console.log('Fixed broken links');
}

function updateReport(working, broken) {
  const totalLinks = document.getElementById('totalLinks');
  const workingLinks = document.getElementById('workingLinks');
  const brokenLinks = document.getElementById('brokenLinks');
  
  if (totalLinks) totalLinks.textContent = working + broken;
  if (workingLinks) workingLinks.textContent = working;
  if (brokenLinks) brokenLinks.textContent = broken;
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  checkAllIcons();
  console.log('Navigation Fix Widget initialized');
});
</script>
