<!-- [[ARABIC_HEADER]] هذا الملف (views/single-home.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>

<!-- PWA Meta Tags -->
<meta name="theme-color" content="#0b1f3a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="HM CAR">
<meta name="application-name" content="HM CAR">
<meta name="msapplication-TileColor" content="#0b1f3a">
<meta name="msapplication-config" content="/browserconfig.xml">

<!-- PWA Icons -->
<link rel="apple-touch-icon" sizes="180x180" href="/public/images/icons/icon-192x192.png">
<link rel="icon" type="image/png" sizes="32x32" href="/public/images/icons/icon-192x192.png">
<link rel="icon" type="image/png" sizes="16x16" href="/public/images/icons/icon-192x192.png">
<link rel="manifest" href="/manifest.json">

<link href="/public/css/single-section.css" rel="stylesheet">
<!-- Add design system CSS for consistent variables -->
<link href="/public/css/design-system.css" rel="stylesheet">

<% const isLoggedIn = !!(typeof currentUser !== 'undefined' && currentUser); %>
<% const loginWithReturnTo = (path) => `/auth/login?returnTo=${encodeURIComponent(path)}`; %>

<div class="main-container hm-landing" data-is-logged-in="<%= isLoggedIn ? 'true' : 'false' %>">
  <div class="single-section hm-shell">
    <!-- Top Bar -->
    <div class="hm-topbar" aria-label="Top bar">
      <div class="hm-topbar__left">
        <a class="hm-topbar__logoLink" href="/" aria-label="HM CAR">
          <img class="hm-topbar__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
        </a>
      </div>
      <div class="hm-topbar__right">
        <div class="hm-topbar__lang">
          <% if (typeof locale !== 'undefined' && locale === 'ar') { %>
            <a class="hm-topbar__langBtn" href="?lang=en" title="English">EN</a>
          <% } else { %>
            <a class="hm-topbar__langBtn" href="?lang=ar" title="العربية">عر</a>
          <% } %>
        </div>
        <a href="/auth/login" class="hm-topbar__login">
          <i class="fas fa-right-to-bracket"></i>
          <span>تسجيل الدخول / Login</span>
        </a>
      </div>
    </div>

    <!-- Hero / Brand -->
    <section class="hm-hero hm-hero--v2" aria-label="HM CAR">
      <div class="hm-hero2">
        <div class="hm-hero2__brand">
          <div class="hm-hero2__logoWrap">
            <img class="hm-hero2__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          </div>
          <div class="hm-hero2__text">
            <h1 class="hm-hero2__title">HM CAR</h1>
            <p class="hm-hero2__subtitle">
              تصدير السيارات وقطع الغيار من كوريا إلى جميع دول العالم<br>
              <span class="hm-hero2__subtitleEn">Exporting cars and spare parts from Korea to all countries of the world</span>
            </p>
          </div>
        </div>

        <div class="hm-hero2__cta">
          <div class="hm-hero2__cards" aria-label="Main categories">
            <a class="hm-card" href="<%= isLoggedIn ? '/auctions' : loginWithReturnTo('/auctions') %>">
              <div class="hm-card__icon"><i class="fas fa-gavel"></i></div>
              <div class="hm-card__title">المزاد / Auctions</div>
              <div class="hm-card__text">MZادات مباشرة وعروض مميزة</div>
            </a>
            <a class="hm-card" href="<%= isLoggedIn ? '/cars' : loginWithReturnTo('/cars') %>">
              <div class="hm-card__icon"><i class="fas fa-car"></i></div>
              <div class="hm-card__title">السيارات / Cars</div>
              <div class="hm-card__text">سيارات مختارة للتصدير والفحص</div>
            </a>
            <a class="hm-card" href="<%= isLoggedIn ? '/spare-parts' : loginWithReturnTo('/spare-parts') %>">
              <div class="hm-card__icon"><i class="fas fa-gears"></i></div>
              <div class="hm-card__title">قطع الغيار / Spare Parts</div>
              <div class="hm-card__text">بحث حسب الموديل والسنة</div>
            </a>
          </div>

          <div class="hm-hero2__highlights" aria-label="Highlights">
            <div class="hm-chip"><i class="fas fa-plane"></i><span>تصدير دولي / Export</span></div>
            <div class="hm-chip"><i class="fas fa-clipboard-check"></i><span>فحص وتجهيز / Inspection</span></div>
            <div class="hm-chip"><i class="fas fa-shield-halved"></i><span>دفع آمن / Secure</span></div>
            <div class="hm-chip"><i class="fas fa-headset"></i><span>دعم / Support</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="hm-steps" aria-label="How it works">
      <div class="hm-sectionHead">
        <h2 class="hm-sectionHead__title">كيف نعمل / How it works</h2>
        <p class="hm-sectionHead__text">خطوات واضحة من اختيار السيارة إلى الشحن والتسليم</p>
      </div>
      <div class="hm-steps__grid">
        <div class="hm-step">
          <div class="hm-step__num">1</div>
          <div class="hm-step__icon"><i class="fas fa-magnifying-glass"></i></div>
          <div class="hm-step__title">اختيار / Select</div>
          <div class="hm-step__text">اختر سيارة أو قطعة غيار أو مزاد</div>
        </div>
        <div class="hm-step">
          <div class="hm-step__num">2</div>
          <div class="hm-step__icon"><i class="fas fa-clipboard-check"></i></div>
          <div class="hm-step__title">فحص / Inspect</div>
          <div class="hm-step__text">تجهيز وفحص حسب الطلب قبل الشحن</div>
        </div>
        <div class="hm-step">
          <div class="hm-step__num">3</div>
          <div class="hm-step__icon"><i class="fas fa-file-signature"></i></div>
          <div class="hm-step__title">إجراءات / Documents</div>
          <div class="hm-step__text">تجهيز الأوراق والتخليص بوضوح</div>
        </div>
        <div class="hm-step">
          <div class="hm-step__num">4</div>
          <div class="hm-step__icon"><i class="fas fa-ship"></i></div>
          <div class="hm-step__title">شحن / Ship</div>
          <div class="hm-step__text">شحن وتحديثات حتى وصول الطلب</div>
        </div>
      </div>
    </section>

    <!-- Search Section -->
    <div class="search-section" aria-label="Search">
      <h2 class="search-title">
        <i class="fas fa-search"></i>
        ابحث بسرعة
      </h2>
      <form action="/search" method="GET" class="search-form">
        <div class="search-grid">
          <div class="search-item">
            <i class="fas fa-search"></i>
            <input type="text" name="q" placeholder="اكتب كلمة البحث (مثال: Sonata / Hyundai)" class="search-input">
          </div>
          <div class="search-item">
            <i class="fas fa-car"></i>
            <select name="make" class="search-select">
              <option value="">الماركة (اختياري)</option>
              <% if (brands && brands.length > 0) { %>
                <% brands.forEach(brand => { %>
                  <option value="<%= brand.name %>"><%= brand.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="search-item">
            <i class="fas fa-car-side"></i>
            <input type="text" name="model" placeholder="الموديل (اختياري)" class="search-input">
          </div>
          <div class="search-item">
            <i class="fas fa-money-bill-wave"></i>
            <select name="minPrice" class="search-select">
              <option value="">السعر من</option>
              <option value="50000">50,000 ريال</option>
              <option value="100000">100,000 ريال</option>
              <option value="200000">200,000 ريال</option>
              <option value="300000">300,000 ريال</option>
              <option value="500000">500,000 ريال</option>
            </select>
          </div>
          <div class="search-item">
            <i class="fas fa-money-bill-wave"></i>
            <select name="maxPrice" class="search-select">
              <option value="">السعر إلى</option>
              <option value="100000">100,000 ريال</option>
              <option value="200000">200,000 ريال</option>
              <option value="300000">300,000 ريال</option>
              <option value="500000">500,000 ريال</option>
              <option value="1000000">1,000,000 ريال</option>
            </select>
          </div>
        </div>
        <button type="submit" class="search-button">
          <i class="fas fa-search"></i>
          بحث
        </button>
      </form>
    </div>

    <!-- Live auctions preview -->
    <section class="hm-live" aria-label="Live auctions">
      <div class="hm-sectionHead hm-sectionHead--row">
        <h2 class="hm-sectionHead__title">MZادات مباشرة / Live auctions</h2>
        <a class="hm-linkBtn" href="<%= isLoggedIn ? '/auctions' : loginWithReturnTo('/auctions') %>">
          مشاهدة الكل / View all
          <i class="fas fa-arrow-left"></i>
        </a>
      </div>

      <% if (liveAuctions && liveAuctions.length > 0) { %>
        <div class="hm-live__grid">
          <% liveAuctions.slice(0, 3).forEach(a => { %>
            <a class="hm-liveCard" href="<%= isLoggedIn ? ('/auctions/' + a._id) : loginWithReturnTo('/auctions/' + a._id) %>">
              <div class="hm-liveCard__thumb">
                <img src="<%= (a.car && a.car.images && a.car.images[0] && a.car.images[0].url) ? a.car.images[0].url : '/public/images/default-car.jpg' %>" alt="Auction" loading="lazy" decoding="async" />
              </div>
              <div class="hm-liveCard__body">
                <div class="hm-liveCard__title">
                  <%= (a.car && (a.car.make || a.car.model)) ? ((a.car.make || '') + ' ' + (a.car.model || '')) : 'Auction' %>
                </div>
                <div class="hm-liveCard__meta">
                  <span><i class="fas fa-clock"></i> Live</span>
                  <span><i class="fas fa-gavel"></i> مزاد</span>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="hm-empty">
          <i class="fas fa-gavel"></i>
          <div>
            <div class="hm-empty__title">لا توجد مزادات مباشرة حالياً</div>
            <div class="hm-empty__text">تابعنا قريباً / Check back soon</div>
          </div>
        </div>
      <% } %>
    </section>

    <!-- Stats Section -->
    <div class="stats-section">
      <h2 class="stats-title">أرقامنا تتحدث</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <i class="fas fa-car"></i>
          <span class="stat-number"><%= (stats && typeof stats.totalCars !== 'undefined') ? stats.totalCars : '500+' %></span>
          <span class="stat-label">سيارة فاخرة</span>
        </div>
        <div class="stat-item">
          <i class="fas fa-gavel"></i>
          <span class="stat-number"><%= (stats && typeof stats.activeAuctions !== 'undefined') ? stats.activeAuctions : '50+' %></span>
          <span class="stat-label">MZاد نشط</span>
        </div>
        <div class="stat-item">
          <i class="fas fa-users"></i>
          <span class="stat-number"><%= (stats && typeof stats.totalUsers !== 'undefined') ? stats.totalUsers : '10K+' %></span>
          <span class="stat-label">مستخدم</span>
        </div>
        <div class="stat-item">
          <i class="fas fa-trophy"></i>
          <span class="stat-number"><%= (stats && typeof stats.completedAuctions !== 'undefined') ? stats.completedAuctions : '200+' %></span>
          <span class="stat-label">MZاد مكتمل</span>
        </div>
      </div>
    </div>

    <!-- Cars Section -->
    <div class="cars-section">
      <h2 class="cars-title">
        <i class="fas fa-star"></i>
        سيارات مميزة
      </h2>
      <div class="cars-grid">
        <% if (cars && cars.length > 0) { %>
          <% cars.slice(0, 3).forEach(car => { %>
            <div class="car-card">
              <div class="car-thumb">
                <img class="car-thumb-img" src="<%= (car.images && car.images[0] && car.images[0].url) ? car.images[0].url : '/images/default-car.jpg' %>" alt="<%= car.make %> <%= car.model %>">
                <div class="car-thumb-badge" title="مميز">
                  <i class="fas fa-crown"></i>
                </div>
              </div>
              <div class="car-info">
                <div class="car-name"><%= car.make %> <%= car.model %></div>
                <div class="car-meta">
                  <span><i class="fas fa-calendar-alt"></i> <%= car.year || '—' %></span>
                  <span><i class="fas fa-tag"></i> <%= (typeof car.startPrice !== 'undefined' && car.startPrice) ? (new Intl.NumberFormat('en-US').format(car.startPrice) + ' $') : (car.price ? (car.price.toLocaleString() + ' ريال') : 'عند الطلب') %></span>
                </div>
                <a class="car-link" href="/cars/<%= car._id %>">
                  <i class="fas fa-arrow-left"></i>
                  عرض التفاصيل
                </a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="no-cars-message">
            <i class="fas fa-car-side"></i>
            <h3>لا توجد سيارات مميزة حالياً</h3>
            <p>سيتم إضافة سيارات جديدة قريباً</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- PWA Installation Script -->
<script>
// PWA Installation
let deferredPrompt;
const installButton = document.createElement('button');
installButton.innerHTML = '<i class="fas fa-download"></i> تثبيت التطبيق';
installButton.className = 'pwa-install-btn';
installButton.style.cssText = `
  position: fixed;
  bottom: 20px;
  left: 20px;
  background: var(--hm-bg-gold);
  color: var(--hm-blue-primary);
  border: 1px solid rgba(255, 255, 255, 0.22);
  padding: 15px 20px;
  border-radius: 15px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  box-shadow: var(--hm-shadow-gold);
  z-index: 1000;
  display: none;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
`;

installButton.addEventListener('click', async () => {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    console.log(`User response to the install prompt: ${outcome}`);
    deferredPrompt = null;
    installButton.style.display = 'none';
  }
});

document.body.appendChild(installButton);

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  installButton.style.display = 'flex';
});

// Hide install button if app is already installed
window.addEventListener('appinstalled', () => {
  installButton.style.display = 'none';
});

// Service Worker Registration
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js')
      .then(registration => {
        console.log('SW registered: ', registration);
        
        // Check for updates
        registration.addEventListener('updatefound', () => {
          const newWorker = registration.installing;
          newWorker.addEventListener('statechange', () => {
            if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
              // Show update notification
              const updateNotification = document.createElement('div');
              updateNotification.innerHTML = `
                <div style="
                  position: fixed;
                  top: 20px;
                  right: 20px;
                  background: var(--hm-bg-gold);
                  color: var(--hm-blue-primary);
                  padding: 15px 20px;
                  border-radius: 15px;
                  font-weight: 700;
                  box-shadow: var(--hm-shadow-gold);
                  z-index: 1001;
                  max-width: 300px;
                ">
                  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                    <i class="fas fa-sync-alt"></i>
                    <span>تحديث متاح!</span>
                  </div>
                  <button onclick="location.reload()" style="
                    background: var(--hm-blue-primary);
                    color: var(--hm-gold-primary);
                    border: 1px solid var(--hm-border-medium);
                    padding: 8px 15px;
                    border-radius: 8px;
                    font-weight: 600;
                    cursor: pointer;
                  ">تحديث الآن</button>
                </div>
              `;
              document.body.appendChild(updateNotification);
              
              setTimeout(() => {
                if (updateNotification.parentNode) {
                  updateNotification.parentNode.removeChild(updateNotification);
                }
              }, 10000);
            }
          });
        });
      })
      .catch(registrationError => {
        console.log('SW registration failed: ', registrationError);
      });
  });
}

// PWA Features
if ('standalone' in window.navigator && window.navigator.standalone) {
  document.body.classList.add('pwa-standalone');
}

// Network Status
function updateNetworkStatus() {
  const networkStatus = document.createElement('div');
  networkStatus.id = 'network-status';
  networkStatus.style.cssText = `
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: ${navigator.onLine ? '#4CAF50' : '#f44336'};
    color: white;
    text-align: center;
    padding: 10px;
    font-weight: 600;
    z-index: 1002;
    display: none;
  `;
  networkStatus.textContent = navigator.onLine ? 'متصل بالإنترنت' : 'غير متصل بالإنترنت';
  
  if (!document.getElementById('network-status')) {
    document.body.appendChild(networkStatus);
  }
  
  networkStatus.style.display = 'block';
  setTimeout(() => {
    networkStatus.style.display = 'none';
  }, 3000);
}

window.addEventListener('online', updateNetworkStatus);
window.addEventListener('offline', updateNetworkStatus);

// App Lifecycle Events
window.addEventListener('DOMContentLoaded', () => {
  // Hide splash screen
  setTimeout(() => {
    const splash = document.querySelector('.splash-screen');
    if (splash) {
      splash.style.opacity = '0';
      setTimeout(() => splash.remove(), 300);
    }
  }, 1000);
});
</script>

<script>
  // Get isLoggedIn from the data attribute on the body
  const isLoggedIn = document.querySelector('.main-container').dataset.isLoggedIn === 'true';
  
  if (!isLoggedIn) {
    const form = document.querySelector('.search-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const fd = new FormData(form);
        const params = new URLSearchParams();
        for (const [k, v] of fd.entries()) {
          if (v !== null && String(v).trim() !== '') params.append(k, String(v));
        }
        const returnTo = '/search' + (params.toString() ? ('?' + params.toString()) : '');
        window.location.href = '/auth/login?returnTo=' + encodeURIComponent(returnTo);
      });
    }
  }
</script>