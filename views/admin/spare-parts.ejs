<% layout('layout') -%>
<link rel="stylesheet" href="/public/css/admin-unified.css" />
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-unified-bg' %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="mb-1">إدارة قطع الغيار</h3>
    <div class="text-muted">أضف القطع وتابع توفرها وأسعارها.</div>
  </div>
  <a href="/admin" class="back-btn">
    <i class="fas fa-arrow-right me-2"></i>عودة للوحة التحكم
  </a>
</div>

<div class="spare-parts-card">
  <div class="spare-parts-header">
    <h5 class="mb-0">
      <i class="fas fa-cogs me-2"></i>
      إدارة قطع الغيار
    </h5>
  </div>
  
  <div class="row g-0">
    <!-- نموذج إضافة قطعة غيار -->
    <div class="col-lg-5">
      <div class="p-4 border-start">
        <h6 class="mb-3">إضافة قطعة غيار جديدة</h6>
        <form method="post" action="/admin/spare-parts" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label">اسم القطعة</label>
            <input name="name" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">الوصف</label>
            <textarea name="description" class="form-control" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">السعر</label>
            <input name="price" type="number" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">الشركة</label>
            <select name="spareBrand" class="form-select">
              <option value="">بدون شركة</option>
              <% (spareBrands || []).forEach(brand => { %>
                <option value="<%= brand._id %>"><%= brand.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">الصور (حتى 5 صور)</label>
            <input name="images" type="file" class="form-control" multiple accept="image/*" />
          </div>
          <button class="btn btn-primary w-100">حفظ</button>
        </form>
      </div>
    </div>

    <!-- قائمة قطع الغيار -->
    <div class="col-lg-7">
      <div class="spare-parts-header fw-semibold d-flex justify-content-between align-items-center">
        <span>قائمة قطع الغيار</span>
        <small class="text-muted"><%= (parts || []).length %> قطعة</small>
      </div>
      <div class="card-body p-0">
        <% if (!parts || !parts.length) { %>
          <!-- لا توجد قطع غيار -->
          <div class="p-4 text-center">
            <div class="h5 mb-1">لا توجد قطع غيار</div>
            <div class="text-muted">أضف قطعة غيار من النموذج على اليمين.</div>
          </div>
        <% } else { %>
          <!-- جدول قطع الغيار -->
          <div class="table-responsive">
            <table class="table table-striped mb-0 align-middle">
              <thead>
                <tr>
                  <th>الصورة</th>
                  <th>الاسم</th>
                  <th>الشركة</th>
                  <th>السعر</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% parts.forEach(part => { %>
                  <tr>
                    <td>
                      <% if (part.images && part.images[0]) { %>
                        <img src="<%= part.images[0] %>" alt="" class="rounded" style="width:56px;height:40px;object-fit:cover" width="56" height="40" loading="lazy" decoding="async" />
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= part.name %></td>
                    <td><%= part.spareBrand ? part.spareBrand.name : '-' %></td>
                    <td><%= part.price ? part.price.toLocaleString() : '-' %></td>
                    <td>
                      <form method="post" action="/admin/spare-parts/<%= part._id %>/delete" onsubmit="return confirm('حذف القطعة؟');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="btn btn-sm btn-outline-danger">حذف</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
