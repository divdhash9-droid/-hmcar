</style>

<script>
// Cars Management
class CarsManager {
  constructor() {
    this.cars = [];
    this.filters = {
      make: '',
      model: '',
      category: '',
      price: '',
      year: ''
    };
    this.pagination = {
      page: 1,
      limit: 12,
      total: 0,
      pages: 0
    };
    this.init();
  }

  async init() {
    await this.loadFilterOptions();
    await this.loadCars();
    this.setupEventListeners();
    this.updateStats();
  }

  async loadFilterOptions() {
    try {
      // Load makes
      const makesResponse = await fetch('/api/cars/makes');
      const makesData = await makesResponse.json();
      if (makesResponse.ok) {
        const makeSelect = document.getElementById('makeFilter');
        makesData.makes.forEach(make => {
          const option = document.createElement('option');
          option.value = make._id;
          option.textContent = make.name;
          makeSelect.appendChild(option);
        });
      }

      // Load categories
      const categoriesResponse = await fetch('/api/cars/categories');
      const categoriesData = await categoriesResponse.json();
      if (categoriesResponse.ok) {
        const categorySelect = document.getElementById('categoryFilter');
        categoriesData.categories.forEach(category => {
          const option = document.createElement('option');
          option.value = category._id;
          option.textContent = category.name;
          categorySelect.appendChild(option);
        });
      }

      // Load years
      const yearSelect = document.getElementById('yearFilter');
      const currentYear = new Date().getFullYear();
      for (let year = currentYear; year >= currentYear - 20; year--) {
        const option = document.createElement('option');
        option.value = year;
        option.textContent = year;
        yearSelect.appendChild(option);
      }
    } catch (error) {
      console.error('Error loading filter options:', error);
    }
  }

  async loadCars() {
    try {
      this.showLoading(true);
      
      const params = new URLSearchParams({
        page: this.pagination.page,
        limit: this.pagination.limit,
        ...this.filters
      });

      const response = await fetch(`/api/cars?${params}`);
      const data = await response.json();
      
      if (response.ok) {
        this.cars = data.cars || [];
        this.pagination = data.pagination || this.pagination;
        this.renderCars();
        this.renderPagination();
      } else {
        throw new Error(data.error || 'Failed to load cars');
      }
    } catch (error) {
      console.error('Error loading cars:', error);
      this.showError('فشل في تحميل السيارات');
    } finally {
      this.showLoading(false);
    }
  }

  renderCars() {
    const grid = document.getElementById('carsGrid');
    const emptyState = document.getElementById('emptyState');

    if (this.cars.length === 0) {
      grid.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    grid.style.display = 'grid';
    emptyState.style.display = 'none';

    const template = document.getElementById('carCardTemplate');
    grid.innerHTML = '';

    this.cars.forEach(car => {
      const card = template.content.cloneNode(true);
      
      // Set car data
      const img = card.querySelector('.hm-car-img');
      img.src = car.images && car.images.length > 0 ? car.images[0] : '/images/car-placeholder.jpg';
      img.alt = `${car.make?.name || ''} ${car.model?.name || ''}`;

      card.querySelector('.hm-car-title').textContent = `${car.make?.name || ''} ${car.model?.name || ''}`;
      card.querySelector('.hm-car-price').textContent = this.formatPrice(car.price);
      
      // Set specs
      card.querySelector('.hm-year').textContent = car.year || 'N/A';
      card.querySelector('.hm-mileage').textContent = this.formatMileage(car.mileage);
      card.querySelector('.hm-fuel').textContent = car.fuelType || 'N/A';
      
      // Set location and auction status
      card.querySelector('.hm-location').textContent = car.location || 'غير محدد';
      card.querySelector('.hm-auction-status').textContent = car.auctionStatus || 'متاح';

      // Set action buttons
      const favoriteBtn = card.querySelector('.hm-btn-favorite');
      const viewBtn = card.querySelector('.hm-btn-view');
      const compareBtn = card.querySelector('.hm-btn-compare');

      favoriteBtn.setAttribute('data-car-id', car._id);
      viewBtn.setAttribute('data-car-id', car._id);
      compareBtn.setAttribute('data-car-id', car._id);

      // Check if favorited
      if (car.isFavorite) {
        favoriteBtn.classList.add('favorited');
      }

      // Set badge
      const badge = card.querySelector('.hm-badge-text');
      if (car.category) {
        badge.textContent = car.category.name;
      }

      grid.appendChild(card);
    });

    this.setupCardEventListeners();
  }

  renderPagination() {
    const pagination = document.getElementById('pagination');
    pagination.innerHTML = '';

    if (this.pagination.pages <= 1) return;

    // Previous button
    const prevBtn = document.createElement('button');
    prevBtn.className = 'hm-page-btn';
    prevBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
    prevBtn.disabled = this.pagination.page === 1;
    prevBtn.addEventListener('click', () => this.goToPage(this.pagination.page - 1));
    pagination.appendChild(prevBtn);

    // Page numbers
    for (let i = 1; i <= this.pagination.pages; i++) {
      if (i === 1 || i === this.pagination.pages || (i >= this.pagination.page - 2 && i <= this.pagination.page + 2)) {
        const pageBtn = document.createElement('button');
        pageBtn.className = `hm-page-btn ${i === this.pagination.page ? 'active' : ''}`;
        pageBtn.textContent = i;
        pageBtn.addEventListener('click', () => this.goToPage(i));
        pagination.appendChild(pageBtn);
      } else if (i === this.pagination.page - 3 || i === this.pagination.page + 3) {
        const dots = document.createElement('span');
        dots.textContent = '...';
        dots.style.padding = '0 0.5rem';
        pagination.appendChild(dots);
      }
    }

    // Next button
    const nextBtn = document.createElement('button');
    nextBtn.className = 'hm-page-btn';
    nextBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
    nextBtn.disabled = this.pagination.page === this.pagination.pages;
    nextBtn.addEventListener('click', () => this.goToPage(this.pagination.page + 1));
    pagination.appendChild(nextBtn);
  }

  setupEventListeners() {
    // Filter changes
    document.getElementById('makeFilter').addEventListener('change', (e) => {
      this.filters.make = e.target.value;
      this.loadModels(e.target.value);
    });

    document.getElementById('modelFilter').addEventListener('change', (e) => {
      this.filters.model = e.target.value;
    });

    document.getElementById('categoryFilter').addEventListener('change', (e) => {
      this.filters.category = e.target.value;
    });

    document.getElementById('priceFilter').addEventListener('change', (e) => {
      this.filters.price = e.target.value;
    });

    document.getElementById('yearFilter').addEventListener('change', (e) => {
      this.filters.year = e.target.value;
    });

    // Search button
    document.getElementById('searchBtn').addEventListener('click', () => {
      this.pagination.page = 1;
      this.loadCars();
    });

    // Clear filters
    document.getElementById('clearFilters').addEventListener('click', () => {
      this.clearFilters();
    });

    // Reset search
    document.getElementById('resetSearch').addEventListener('click', () => {
      this.clearFilters();
    });
  }

  setupCardEventListeners() {
    // Favorite buttons
    document.querySelectorAll('.hm-btn-favorite').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const carId = e.currentTarget.getAttribute('data-car-id');
        await this.toggleFavorite(carId, e.currentTarget);
      });
    });

    // View buttons
    document.querySelectorAll('.hm-btn-view').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const carId = e.currentTarget.getAttribute('data-car-id');
        window.location.href = `/cars/${carId}`;
      });
    });

    // Compare buttons
    document.querySelectorAll('.hm-btn-compare').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const carId = e.currentTarget.getAttribute('data-car-id');
        this.addToComparison(carId);
      });
    });
  }

  async loadModels(makeId) {
    const modelSelect = document.getElementById('modelFilter');
    modelSelect.innerHTML = '<option value="">جميع الموديلات</option>';

    if (!makeId) return;

    try {
      const response = await fetch(`/api/cars/models?make=${makeId}`);
      const data = await response.json();
      
      if (response.ok) {
        data.models.forEach(model => {
          const option = document.createElement('option');
          option.value = model._id;
          option.textContent = model.name;
          modelSelect.appendChild(option);
        });
      }
    } catch (error) {
      console.error('Error loading models:', error);
    }
  }

  async toggleFavorite(carId, button) {
    try {
      const isFavorited = button.classList.contains('favorited');
      const url = isFavorited ? `/favorites/remove/${carId}` : `/favorites/add/${carId}`;
      const method = isFavorited ? 'DELETE' : 'POST';

      const response = await fetch(url, { method });
      const data = await response.json();

      if (response.ok) {
        button.classList.toggle('favorited');
        this.showSuccess(isFavorited ? 'تمت إزالة السيارة من المفضلة' : 'تمت إضافة السيارة للمفضلة');
      } else {
        throw new Error(data.error);
      }
    } catch (error) {
      console.error('Error toggling favorite:', error);
      this.showError('فشل في تحديث المفضلة');
    }
  }

  addToComparison(carId) {
    window.location.href = `/comparisons?add=${carId}`;
  }

  goToPage(page) {
    this.pagination.page = page;
    this.loadCars();
  }

  clearFilters() {
    this.filters = {
      make: '',
      model: '',
      category: '',
      price: '',
      year: ''
    };
    
    document.getElementById('makeFilter').value = '';
    document.getElementById('modelFilter').value = '';
    document.getElementById('categoryFilter').value = '';
    document.getElementById('priceFilter').value = '';
    document.getElementById('yearFilter').value = '';
    
    this.pagination.page = 1;
    this.loadCars();
  }

  updateStats() {
    document.getElementById('totalCars').textContent = this.pagination.total || 0;
    document.getElementById('activeAuctions').textContent = this.cars.filter(car => car.auctionStatus === 'active').length;
  }

  formatPrice(price) {
    return new Intl.NumberFormat('ar-SA', {
      style: 'currency',
      currency: 'SAR',
      minimumFractionDigits: 0
    }).format(price || 0);
  }

  formatMileage(mileage) {
    if (!mileage) return 'N/A';
    return `${mileage.toLocaleString('ar-SA')} كم`;
  }

  showLoading(show) {
    document.getElementById('loadingState').style.display = show ? 'block' : 'none';
  }

  showError(message) {
    console.error(message);
  }

  showSuccess(message) {
    console.log(message);
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  new CarsManager();
});
</script>
