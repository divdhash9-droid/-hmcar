<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideBackButton = true; %>
<% var hideFooter = true; %>
<% var hideSkipLink = true; %>
<% var bodyClass = 'auth-page hm-login-ultimate'; %>

<div class="hm-ultra-login">
  <!-- Animated Background -->
  <div class="hm-ultra-bg">
    <div class="hm-bg-gradient-royal"></div>
    <div class="hm-bg-particles-container">
      <div class="hm-particle hm-particle-1"></div>
      <div class="hm-particle hm-particle-2"></div>
      <div class="hm-particle hm-particle-3"></div>
      <div class="hm-particle hm-particle-4"></div>
      <div class="hm-particle hm-particle-5"></div>
      <div class="hm-particle hm-particle-6"></div>
    </div>
    <div class="hm-bg-glow-effect"></div>
    <div class="hm-bg-lines">
      <div class="hm-line"></div>
      <div class="hm-line"></div>
      <div class="hm-line"></div>
    </div>
  </div>

  <!-- Top Navigation -->
  <div class="hm-ultra-top-nav">
    <a href="/" class="hm-nav-btn-3d hm-back-btn">
      <i class="fas fa-home"></i>
      <span data-ar="الرئيسية" data-en="Home">الرئيسية</span>
    </a>
    <button type="button" class="hm-nav-btn-3d hm-lang-btn" onclick="toggleLanguage()">
      <i class="fas fa-globe-americas"></i>
      <span id="currentLang">English</span>
    </button>
  </div>

  <!-- Main Content - Two Columns -->
  <div class="hm-ultra-main">
    <!-- Left Side: Login Card (Glassmorphism) -->
    <div class="hm-ultra-form-side">
      <div class="hm-glass-card">
        <div class="hm-glass-shine"></div>
        
        <!-- Card Header -->
        <div class="hm-card-top">
          <span class="hm-card-badge" data-ar="صفحة الدخول" data-en="LOGIN PAGE">صفحة الدخول</span>
          <h1 class="hm-card-title" data-ar="تسجيل الدخول" data-en="Log in to your account">تسجيل الدخول</h1>
          <p class="hm-card-subtitle" data-ar="أدخل بياناتك للمتابعة إلى حسابك" data-en="Enter your credentials to continue">أدخل بياناتك للمتابعة إلى حسابك</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="hm-ultra-alert hm-alert-error">
          <i class="fas fa-exclamation-circle"></i>
          <span><%= error %></span>
          <button type="button" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
        </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="hm-ultra-alert hm-alert-success">
          <i class="fas fa-check-circle"></i>
          <span><%= success %></span>
          <button type="button" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
        </div>
        <% } %>

        <!-- Login Form -->
        <form method="POST" action="/auth/login" class="hm-ultra-form" id="loginForm">
          <input type="hidden" name="loginRole" value="<%= isAdminLogin ? 'admin' : 'buyer' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Username/Email Field -->
          <div class="hm-ultra-input-group">
            <div class="hm-input-icon">
              <i class="fas fa-user"></i>
            </div>
            <div class="hm-input-wrapper">
              <input type="text" 
                     id="name" 
                     name="name" 
                     class="hm-ultra-input" 
                     placeholder=" "
                     required
                     autocomplete="username">
              <label for="name" class="hm-floating-label">
                <span data-ar="<%= isAdminLogin ? 'البريد الإلكتروني' : 'الاسم الكامل' %>" data-en="<%= isAdminLogin ? 'Email Address' : 'Full Name' %>">
                  <%= isAdminLogin ? 'البريد الإلكتروني' : 'الاسم الكامل' %>
                </span>
              </label>
              <span class="hm-input-hint" data-ar="<%= isAdminLogin ? 'أدخل بريدك الإلكتروني' : 'اكتب اسمك كما في جواز السفر' %>" data-en="<%= isAdminLogin ? 'Enter your email' : 'Enter your name as in passport' %>">
                <i class="fas fa-info-circle"></i>
                <%= isAdminLogin ? 'أدخل بريدك الإلكتروني' : 'اكتب اسمك كما في جواز السفر' %>
              </span>
            </div>
            <div class="hm-input-glow"></div>
          </div>

          <!-- Password Field -->
          <div class="hm-ultra-input-group">
            <div class="hm-input-icon">
              <i class="fas fa-lock"></i>
            </div>
            <div class="hm-input-wrapper">
              <input type="password" 
                     id="password" 
                     name="password" 
                     class="hm-ultra-input" 
                     placeholder=" "
                     required
                     autocomplete="current-password">
              <label for="password" class="hm-floating-label">
                <span data-ar="كلمة المرور" data-en="Password">كلمة المرور</span>
              </label>
              <button type="button" class="hm-toggle-password" onclick="togglePassword('password')">
                <i class="fas fa-eye"></i>
              </button>
              <span class="hm-input-hint" data-ar="أدخل كلمة المرور الخاصة بك" data-en="Enter your secure password">
                <i class="fas fa-info-circle"></i>
                أدخل كلمة المرور الخاصة بك
              </span>
            </div>
            <div class="hm-input-glow"></div>
          </div>

          <!-- Options Row -->
          <div class="hm-form-options-row">
            <label class="hm-ultra-checkbox">
              <input type="checkbox" name="remember">
              <span class="hm-checkmark"></span>
              <span class="hm-check-label" data-ar="تذكرني" data-en="Remember me">تذكرني</span>
            </label>
            <a href="/auth/forgot-password" class="hm-forgot-link" data-ar="نسيت كلمة المرور؟" data-en="Forgot password?">نسيت كلمة المرور؟</a>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="hm-btn-ultra-3d hm-btn-login">
            <span class="hm-btn-bg"></span>
            <span class="hm-btn-content">
              <i class="fas fa-sign-in-alt"></i>
              <span data-ar="دخول" data-en="LOG IN">دخول</span>
            </span>
            <span class="hm-btn-shine"></span>
          </button>
        </form>

        <!-- User Type Switch -->
        <div class="hm-user-type-switch">
          <% if (!isAdminLogin) { %>
          <a href="/auth/login?admin=true" class="hm-switch-btn">
            <i class="fas fa-user-shield"></i>
            <span data-ar="دخول كمدير" data-en="Admin Login">دخول كمدير</span>
          </a>
          <% } else { %>
          <a href="/auth/login" class="hm-switch-btn">
            <i class="fas fa-user"></i>
            <span data-ar="دخول كعميل" data-en="Customer Login">دخول كعميل</span>
          </a>
          <% } %>
        </div>

        <!-- Register Link -->
        <div class="hm-register-section">
          <span data-ar="ليس لديك حساب؟" data-en="Don't have an account?">ليس لديك حساب؟</span>
          <a href="/auth/register" class="hm-register-link" data-ar="إنشاء حساب جديد" data-en="Create Account">إنشاء حساب جديد</a>
        </div>
      </div>
    </div>

    <!-- Right Side: Logo Card (White) -->
    <div class="hm-ultra-logo-side">
      <div class="hm-white-card">
        <div class="hm-card-inner-glow"></div>
        
        <!-- Logo -->
        <div class="hm-logo-display">
          <div class="hm-logo-frame">
            <img src="/public/images/logo.png" alt="HM CAR" class="hm-main-logo" />
          </div>
        </div>

        <!-- Company Info -->
        <div class="hm-company-info">
          <p class="hm-company-desc-ar">تصدير السيارات وقطع الغيار من كوريا إلى جميع دول العالم</p>
          <p class="hm-company-desc-en">Exporting Cars & Spare Parts from Korea Worldwide</p>
        </div>

        <!-- Quick Service Buttons -->
        <div class="hm-quick-services">
          <h3 class="hm-services-title" data-ar="خدماتنا السريعة" data-en="Quick Services">خدماتنا السريعة</h3>
          <div class="hm-services-grid">
            <a href="/cars" class="hm-service-btn-3d">
              <i class="fas fa-car-side"></i>
              <span data-ar="سيارات" data-en="Cars">سيارات</span>
            </a>
            <a href="/spare-parts" class="hm-service-btn-3d">
              <i class="fas fa-cogs"></i>
              <span data-ar="قطع غيار" data-en="Parts">قطع غيار</span>
            </a>
            <a href="/auctions" class="hm-service-btn-3d">
              <i class="fas fa-gavel"></i>
              <span data-ar="مزاد" data-en="Auction">مزاد</span>
            </a>
            <a href="/about" class="hm-service-btn-3d">
              <i class="fas fa-globe-americas"></i>
              <span data-ar="تصدير عالمي" data-en="Export">تصدير عالمي</span>
            </a>
          </div>
        </div>

        <!-- Features -->
        <div class="hm-features-mini">
          <div class="hm-feature-item">
            <i class="fas fa-shield-alt"></i>
            <span data-ar="ضمان الجودة" data-en="Quality Guarantee">ضمان الجودة</span>
          </div>
          <div class="hm-feature-item">
            <i class="fas fa-shipping-fast"></i>
            <span data-ar="شحن سريع" data-en="Fast Shipping">شحن سريع</span>
          </div>
          <div class="hm-feature-item">
            <i class="fas fa-headset"></i>
            <span data-ar="دعم 24/7" data-en="24/7 Support">دعم 24/7</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Logo (shows only on mobile) -->
  <div class="hm-mobile-logo">
    <img src="/public/images/logo.png" alt="HM CAR" />
    <p>تصدير السيارات وقطع الغيار من كوريا</p>
  </div>
</div>

<style>
/* ============================================
   HM CAR Ultimate Login - Royal Navy & Snow White
   Dual Column Layout with Glassmorphism
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap');

/* CSS Variables */
:root {
  --hm-royal-navy: #0a1628;
  --hm-navy: #001f3f;
  --hm-navy-light: #003366;
  --hm-navy-glow: #0052a3;
  --hm-blue: #007bff;
  --hm-blue-light: #4da3ff;
  --hm-blue-dark: #0056b3;
  --hm-white: #ffffff;
  --hm-snow: #f8fafc;
  --hm-silver: #c0c7d0;
  --hm-silver-light: #e2e8f0;
  --hm-gray: #64748b;
  --hm-glass-bg: rgba(255, 255, 255, 0.08);
  --hm-glass-border: rgba(255, 255, 255, 0.15);
  --hm-shadow-deep: rgba(0, 15, 35, 0.5);
}

/* Reset & Base */
.hm-ultra-login {
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  font-family: 'Cairo', 'Tajawal', sans-serif;
  direction: rtl;
  padding: 1rem;
}

/* ============================================
   Animated Background
   ============================================ */
.hm-ultra-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
}

.hm-bg-gradient-royal {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, 
    var(--hm-royal-navy) 0%, 
    var(--hm-navy) 35%, 
    var(--hm-navy-light) 65%, 
    var(--hm-navy) 100%);
}

.hm-bg-glow-effect {
  position: absolute;
  top: -30%;
  right: -20%;
  width: 80%;
  height: 80%;
  background: radial-gradient(ellipse at center, 
    rgba(0, 123, 255, 0.15) 0%, 
    rgba(0, 82, 163, 0.08) 40%, 
    transparent 70%);
  animation: glowPulse 10s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.5; }
  50% { transform: scale(1.2) rotate(10deg); opacity: 0.8; }
}

/* Particles */
.hm-bg-particles-container {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hm-particle {
  position: absolute;
  border-radius: 50%;
  background: rgba(77, 163, 255, 0.6);
  box-shadow: 0 0 10px rgba(0, 123, 255, 0.5);
  animation: particleFloat 20s infinite ease-in-out;
}

.hm-particle-1 { width: 8px; height: 8px; top: 15%; left: 10%; animation-delay: 0s; }
.hm-particle-2 { width: 6px; height: 6px; top: 25%; right: 15%; animation-delay: 3s; }
.hm-particle-3 { width: 10px; height: 10px; top: 60%; left: 20%; animation-delay: 6s; }
.hm-particle-4 { width: 5px; height: 5px; top: 70%; right: 25%; animation-delay: 9s; }
.hm-particle-5 { width: 7px; height: 7px; top: 40%; left: 5%; animation-delay: 12s; }
.hm-particle-6 { width: 9px; height: 9px; bottom: 20%; right: 10%; animation-delay: 15s; }

@keyframes particleFloat {
  0%, 100% { transform: translateY(0) translateX(0) scale(1); opacity: 0.4; }
  25% { transform: translateY(-50px) translateX(30px) scale(1.2); opacity: 0.8; }
  50% { transform: translateY(-20px) translateX(-20px) scale(0.9); opacity: 0.6; }
  75% { transform: translateY(-70px) translateX(15px) scale(1.1); opacity: 0.9; }
}

/* Lines */
.hm-bg-lines {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hm-line {
  position: absolute;
  width: 1px;
  height: 100%;
  background: linear-gradient(to bottom, 
    transparent 0%, 
    rgba(255, 255, 255, 0.05) 50%, 
    transparent 100%);
}

.hm-line:nth-child(1) { left: 25%; }
.hm-line:nth-child(2) { left: 50%; }
.hm-line:nth-child(3) { left: 75%; }

/* ============================================
   Top Navigation
   ============================================ */
.hm-ultra-top-nav {
  position: fixed;
  top: 1.5rem;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 2rem;
  z-index: 100;
}

.hm-nav-btn-3d {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.05));
  backdrop-filter: blur(20px);
  border: 1px solid var(--hm-glass-border);
  border-radius: 14px;
  color: var(--hm-white);
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.hm-nav-btn-3d:hover {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.08));
  transform: translateY(-3px);
  box-shadow: 
    0 15px 40px rgba(0, 0, 0, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.hm-nav-btn-3d i {
  font-size: 1rem;
  color: var(--hm-blue-light);
}

/* ============================================
   Main Content - Two Columns
   ============================================ */
.hm-ultra-main {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: stretch;
  gap: 0;
  max-width: 1100px;
  width: 100%;
  min-height: 650px;
  animation: mainAppear 0.8s ease-out;
}

@keyframes mainAppear {
  from { opacity: 0; transform: translateY(40px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ============================================
   Left Side: Glass Login Card
   ============================================ */
.hm-ultra-form-side {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hm-glass-card {
  width: 100%;
  max-width: 480px;
  background: var(--hm-glass-bg);
  backdrop-filter: blur(30px);
  border: 1px solid var(--hm-glass-border);
  border-radius: 28px;
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
  box-shadow: 
    0 32px 64px var(--hm-shadow-deep),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.hm-glass-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(255, 255, 255, 0.08), 
    transparent);
  animation: cardShine 5s infinite;
}

@keyframes cardShine {
  0% { left: -100%; }
  50%, 100% { left: 100%; }
}

/* Card Header */
.hm-card-top {
  text-align: center;
  margin-bottom: 2rem;
}

.hm-card-badge {
  display: inline-block;
  padding: 0.35rem 1rem;
  background: rgba(0, 123, 255, 0.2);
  border: 1px solid rgba(0, 123, 255, 0.3);
  border-radius: 20px;
  color: var(--hm-blue-light);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.hm-card-title {
  font-size: 2rem;
  font-weight: 800;
  color: var(--hm-white);
  margin: 0 0 0.5rem;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
}

.hm-card-subtitle {
  font-size: 1rem;
  color: var(--hm-silver);
  margin: 0;
}

/* ============================================
   Ultra Alerts
   ============================================ */
.hm-ultra-alert {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border-radius: 14px;
  margin-bottom: 1.5rem;
  font-weight: 500;
  animation: alertPop 0.4s ease;
}

@keyframes alertPop {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.hm-alert-error {
  background: linear-gradient(135deg, rgba(220, 38, 38, 0.15), rgba(185, 28, 28, 0.1));
  border: 1px solid rgba(220, 38, 38, 0.3);
  color: #fca5a5;
}

.hm-alert-success {
  background: linear-gradient(135deg, rgba(22, 163, 74, 0.15), rgba(21, 128, 61, 0.1));
  border: 1px solid rgba(22, 163, 74, 0.3);
  color: #86efac;
}

.hm-ultra-alert button {
  margin-right: auto;
  background: none;
  border: none;
  cursor: pointer;
  color: inherit;
  opacity: 0.7;
  padding: 0.25rem;
  transition: opacity 0.2s;
}

.hm-ultra-alert button:hover {
  opacity: 1;
}

/* ============================================
   Ultra Input Groups
   ============================================ */
.hm-ultra-input-group {
  position: relative;
  margin-bottom: 1.75rem;
  display: flex;
  align-items: center;
  gap: 0;
}

.hm-input-icon {
  position: absolute;
  right: 0;
  top: 0;
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, var(--hm-blue), var(--hm-blue-light));
  border-radius: 14px 0 0 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hm-white);
  font-size: 1.15rem;
  z-index: 2;
  box-shadow: 
    4px 0 15px rgba(0, 123, 255, 0.3),
    inset 0 2px 0 rgba(255, 255, 255, 0.2);
}

.hm-input-wrapper {
  flex: 1;
  position: relative;
}

.hm-ultra-input {
  width: 100%;
  padding: 1rem 3.5rem 1rem 1.5rem;
  padding-right: 70px;
  background: rgba(255, 255, 255, 0.06);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  font-size: 1rem;
  font-family: inherit;
  color: var(--hm-white);
  transition: all 0.3s ease;
}

.hm-ultra-input::placeholder {
  color: transparent;
}

.hm-ultra-input:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--hm-blue);
  box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.15);
}

.hm-floating-label {
  position: absolute;
  right: 70px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--hm-silver);
  font-size: 1rem;
  pointer-events: none;
  transition: all 0.3s ease;
  background: transparent;
  padding: 0 0.5rem;
}

.hm-ultra-input:focus ~ .hm-floating-label,
.hm-ultra-input:not(:placeholder-shown) ~ .hm-floating-label {
  top: -10px;
  right: 12px;
  font-size: 0.8rem;
  color: var(--hm-blue-light);
  background: linear-gradient(to bottom, transparent 45%, rgba(10, 22, 40, 0.9) 45%);
}

.hm-input-hint {
  position: absolute;
  bottom: -22px;
  right: 0;
  font-size: 0.75rem;
  color: var(--hm-silver);
  opacity: 0;
  transform: translateY(-5px);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.hm-ultra-input:focus ~ .hm-input-hint {
  opacity: 0.8;
  transform: translateY(0);
}

.hm-toggle-password {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--hm-silver);
  cursor: pointer;
  padding: 0.5rem;
  transition: color 0.2s;
  z-index: 2;
}

.hm-toggle-password:hover {
  color: var(--hm-blue-light);
}

.hm-input-glow {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--hm-blue), var(--hm-blue-light));
  border-radius: 3px;
  transition: width 0.3s ease;
}

.hm-ultra-input:focus ~ .hm-input-glow {
  width: 80%;
}

/* ============================================
   Form Options Row
   ============================================ */
.hm-form-options-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.75rem;
}

.hm-ultra-checkbox {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
}

.hm-ultra-checkbox input {
  display: none;
