  .bg-test__performance {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>

<script>
// Background Test JavaScript
let fps = 60;
let lastTime = performance.now();
let frameCount = 0;

function updateFPS() {
  frameCount++;
  const currentTime = performance.now();
  
  if (currentTime >= lastTime + 1000) {
    fps = Math.round((frameCount * 1000) / (currentTime - lastTime));
    document.getElementById('fpsCounter').textContent = fps;
    
    frameCount = 0;
    lastTime = currentTime;
  }
  
  requestAnimationFrame(updateFPS);
}

function updateLoadTime() {
  const loadTime = performance.timing.loadEventEnd - performance.timing.navigationStart;
  document.getElementById('loadTime').textContent = loadTime + 'ms';
}

function updateMemoryUsage() {
  if (performance.memory) {
    const memoryMB = Math.round(performance.memory.usedJSHeapSize / 1048576);
    document.getElementById('memoryUsage').textContent = memoryMB + 'MB';
  }
}

function applyBackground(bgClass) {
  const preview = document.getElementById('bgPreview');
  preview.className = 'bg-test__preview ' + bgClass;
}

function resetBackground() {
  const preview = document.getElementById('bgPreview');
  preview.className = 'bg-test__preview';
}

// Initialize
document.addEventListener('DOMContentLoaded', function() {
  updateFPS();
  updateLoadTime();
  updateMemoryUsage();
  
  // Update memory usage every 2 seconds
  setInterval(updateMemoryUsage, 2000);
});
</script>
