# .env.example
# انسخ هذا الملف إلى `.env` وعبئ القيم المناسبة قبل تشغيل التطبيق

# Server Configuration
PORT=4001
NODE_ENV=development
BASE_URL=http://localhost:4001

# Database Configuration (REQUIRED for persistent data)
# Use 'mongodb://127.0.0.1:27017/car-auction' for local Windows/Docker MongoDB
# Use your Atlas connection string for cloud.
MONGO_URI=mongodb://127.0.0.1:27017/car-auction

# Offline Mode (Not Recommended)
# Set to 'true' ONLY if you want to start the server without a database connection.
# Data will NOT be saved.
# ALLOW_OFFLINE_MODE=false

# Local development admin
# - By default (NODE_ENV=development) the dev admin is auto-created when using local MongoDB.
# - If you point MONGO_URI to a remote/shared database, set FORCE_DEV_ADMIN=true to allow auto-create.
# ENABLE_DEV_ADMIN=true
# FORCE_DEV_ADMIN=true
# DEV_ADMIN_EMAIL=admin@local.test
# DEV_ADMIN_PASSWORD=admin123456
# DEV_ADMIN_NAME=Local Admin

# Session Configuration
SESSION_SECRET=change_me_to_a_very_secure_random_string

# Admin Configuration
ADMIN_NAME=Admin User
ADMIN_PHONE=+966500000000

# Firebase Configuration
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Other Services (Optional)
REDIS_URL=redis://localhost:6379
EMAIL_HOST=smtp.gmail.com
STRIPE_PUBLIC_KEY=pk_test_...

# Feature Flags
ENABLE_CACHE=true
ENABLE_NOTIFICATIONS=true

