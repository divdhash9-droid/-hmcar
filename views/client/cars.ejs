.hm-page-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hm-page-title {
    font-size: 2rem;
  }
  
  .hm-header-stats {
    justify-content: center;
    margin-top: 2rem;
  }
  
  .hm-filters {
    flex-direction: column;
    align-items: stretch;
  }
  
  .hm-filter-actions {
    margin-left: 0;
    margin-top: 1rem;
    justify-content: center;
  }
  
  .hm-cars-grid {
    grid-template-columns: 1fr;
  }
  
  .hm-car-specs {
    flex-wrap: wrap;
  }
