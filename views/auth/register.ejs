<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var bodyClass = 'auth-page'; %>

<!-- HM Design System CSS -->
<link rel="stylesheet" href="/css/design-system.css">

<div class="hm-login2">
  <div class="hm-login2__shell">
    <section class="hm-login2__brand" aria-label="HM CAR">
      <div class="hm-login2__logoWrap">
        <img class="hm-login2__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
      </div>
      <div class="hm-login2__tag">
        <div class="hm-login2__name" data-ar="HM CAR" data-en="HM CAR">HM CAR</div>
        <div class="hm-login2__desc" data-ar="تصدير السيارات وقطع الغيار من كوريا إلى جميع دول العالم" data-en="Exporting cars and spare parts from Korea to all countries of the world">
          تصدير السيارات وقطع الغيار من كوريا إلى جميع دول العالم<br>
          Exporting cars and spare parts from Korea to all countries of the world
        </div>
      </div>
      <div class="hm-login2__chips" aria-label="Highlights">
        <div class="hm-chip hm-chip-gold">
          <i class="fas fa-gavel hm-icon hm-icon-sm"></i>
          <span>مزاد</span>
        </div>
        <div class="hm-chip hm-chip-gold">
          <i class="fas fa-car hm-icon hm-icon-sm"></i>
          <span>سيارات</span>
        </div>
        <div class="hm-chip hm-chip-gold">
          <i class="fas fa-gears hm-icon hm-icon-sm"></i>
          <span>قطع غيار</span>
        </div>
        <div class="hm-chip hm-chip-gold">
          <i class="fas fa-globe hm-icon hm-icon-sm"></i>
          <span>تصدير عالمي</span>
        </div>
      </div>
    </section>

    <section class="hm-login2__card" aria-label="Register">
      <div class="hm-login2__header">
        <h2 class="hm-login2__title" data-ar="انضم إلينا" data-en="Join Us">انضم إلينا</h2>
        <p class="hm-login2__subtitle" data-ar="أنشئ حسابك للمتابعة" data-en="Create an account to continue">أنشئ حسابك للمتابعة</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="hm-alert hm-alert--error">
          <i class="fas fa-exclamation-circle hm-icon hm-icon-sm"></i>
          <span><%= error %></span>
          <button type="button" class="hm-alert__close" onclick="this.parentElement.remove()">
            <i class="fas fa-times"></i>
          </button>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="hm-alert hm-alert--success">
          <i class="fas fa-check-circle hm-icon hm-icon-sm"></i>
          <span><%= success %></span>
          <button type="button" class="hm-alert__close" onclick="this.parentElement.remove()">
            <i class="fas fa-times"></i>
          </button>
        </div>
      <% } %>

      <form method="POST" action="/auth/register" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="hm-form-group">
          <div class="hm-input-wrapper">
            <i class="hm-input-icon fas fa-user hm-icon hm-icon-sm hm-icon-muted"></i>
            <input type="text" 
                   id="name" 
                   name="name" 
                   class="hm-input" 
                   placeholder="<%= __('auth.registerPage.placeholders.fullName') %>" 
                   required>
            <label for="name" class="hm-input-label">
              <%= __('auth.fields.fullName') %>
            </label>
          </div>
        </div>

        <div class="hm-form-group">
          <div class="hm-input-wrapper">
            <i class="hm-input-icon fas fa-envelope hm-icon hm-icon-sm hm-icon-muted"></i>
            <input type="email" 
                   id="email" 
                   name="email" 
                   class="hm-input" 
                   placeholder="<%= __('auth.registerPage.placeholders.email') %>" 
                   required>
            <label for="email" class="hm-input-label">
              <%= __('auth.fields.email') %>
            </label>
          </div>
        </div>

        <div class="hm-form-group">
          <div class="hm-input-wrapper">
            <i class="hm-input-icon fas fa-lock hm-icon hm-icon-sm hm-icon-muted"></i>
            <input type="password" 
                   id="password" 
                   name="password" 
                   class="hm-input" 
                   placeholder="<%= __('auth.registerPage.placeholders.password') %>" 
                   required>
            <button type="button" class="hm-input-toggle" onclick="togglePassword('password')">
              <i class="fas fa-eye hm-icon hm-icon-sm"></i>
            </button>
            <label for="password" class="hm-input-label">
              <%= __('auth.fields.password') %>
            </label>
          </div>
        </div>

        <div class="hm-form-group">
          <div class="hm-input-wrapper">
            <i class="hm-input-icon fas fa-lock hm-icon hm-icon-sm hm-icon-muted"></i>
            <input type="password" 
                   id="passwordConfirm" 
                   name="passwordConfirm" 
                   class="hm-input" 
                   placeholder="<%= __('auth.registerPage.placeholders.confirmPassword') %>" 
                   required>
            <button type="button" class="hm-input-toggle" onclick="togglePassword('passwordConfirm')">
              <i class="fas fa-eye hm-icon hm-icon-sm"></i>
            </button>
            <label for="passwordConfirm" class="hm-input-label">
              <%= __('auth.fields.confirmPassword') %>
            </label>
          </div>
        </div>

        <button type="submit" class="hm-btn hm-btn-primary hm-btn-block">
          <i class="fas fa-user-plus hm-icon hm-icon-sm"></i>
          <span data-ar="إنشاء الحساب" data-en="Create Account"><%= __('auth.createAccount') %></span>
        </button>
      </form>

      <div class="hm-form-footer">
        <p data-ar="لديك حساب بالفعل؟" data-en="Already have an account?">لديك حساب بالفعل؟</p>
        <a href="/auth/login" class="hm-link hm-link--primary" data-ar="تسجيل الدخول" data-en="Sign In">تسجيل الدخول</a>
      </div>
    </section>
  </div>
</div>

<script>
// Password Toggle
function togglePassword(inputId) {
  const input = document.getElementById(inputId);
  const toggle = input.nextElementSibling;
  const icon = toggle.querySelector('i');
  
  if (input.type === 'password') {
    input.type = 'text';
    icon.classList.remove('fa-eye');
    icon.classList.add('fa-eye-slash');
  } else {
    input.type = 'password';
    icon.classList.remove('fa-eye-slash');
    icon.classList.add('fa-eye');
  }
}
</script>

<style>
/* Enhanced Register Page Styles - Integrated with Design System */
.hm-login2 {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, var(--hm-blue-primary) 0%, var(--hm-blue-light) 50%, var(--hm-blue-darker) 100%);
}

/* Language Switcher */
.hm-lang-switcher {
  position: absolute;
  top: 20px;
  right: 20px;
  z-index: 1000;
}

.hm-lang-switcher .hm-btn {
  padding: 0.75rem 1.25rem;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 25px;
  color: var(--hm-gold-primary);
  font-size: 0.9rem;
  font-weight: 500;
  transition: all 0.3s ease;
}

.hm-lang-switcher .hm-btn:hover {
  background: rgba(212, 175, 55, 0.2);
  border-color: var(--hm-gold-primary);
  transform: translateY(-2px);
  box-shadow: var(--hm-shadow-gold);
}

/* Background Particles */
.hm-login2::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: 
    radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 40% 60%, rgba(212, 175, 55, 0.05) 0%, transparent 50%);
  animation: floatParticles 20s ease-in-out infinite;
}

@keyframes floatParticles {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(180deg); }
}

/* Shell Layout */
.hm-login2__shell {
  display: flex;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* Brand Section */
.hm-login2__brand {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem;
  background: rgba(11, 31, 58, 0.5);
  backdrop-filter: blur(10px);
  border-right: 1px solid rgba(212, 175, 55, 0.1);
}

.hm-login2__logoWrap {
  margin-bottom: 2rem;
}

.hm-login2__logo {
  width: 120px;
  height: 120px;
  object-fit: contain;
  filter: drop-shadow(0 8px 30px rgba(212, 175, 55, 0.4));
  transition: transform var(--hm-transition-normal);
}

.hm-login2__logo:hover {
  transform: scale(1.05) rotate(5deg);
}

.hm-login2__tag {
  text-align: center;
  margin-bottom: 3rem;
}

.hm-login2__name {
  font-size: 3.5rem;
  font-weight: 800;
  color: var(--hm-gold-primary);
  margin: 0 0 1rem 0;
  text-shadow: 0 4px 20px rgba(212, 175, 55, 0.5);
  letter-spacing: 2px;
  animation: glowText 2s ease-in-out infinite alternate;
}

@keyframes glowText {
  from { text-shadow: 0 4px 20px rgba(212, 175, 55, 0.5); }
  to { text-shadow: 0 4px 30px rgba(212, 175, 55, 0.8); }
}

.hm-login2__desc {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
  margin: 0;
}

.hm-login2__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
}

.hm-login2__chips .hm-chip {
  padding: 0.75rem 1.25rem;
  border-radius: 25px;
  font-size: 0.9rem;
  font-weight: 500;
  transition: all var(--hm-transition-normal);
  cursor: pointer;
}

.hm-login2__chips .hm-chip:hover {
  transform: translateY(-3px);
  box-shadow: var(--hm-shadow-gold);
}

.hm-chip i {
  font-size: 1rem;
}

/* Card Section */
.hm-login2__card {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
}

.hm-login2__header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.hm-login2__title {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--hm-white);
  margin: 0 0 0.5rem 0;
  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.3);
}

.hm-login2__subtitle {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.7);
  margin: 0;
}

/* Alerts */
.hm-alert {
  display: flex;
  align-items: center;
  padding: 1rem 1.5rem;
  border-radius: 12px;
  margin-bottom: 1.5rem;
  position: relative;
  animation: slideIn 0.3s ease-out;
}

.hm-alert--error {
  background: rgba(220, 53, 69, 0.1);
  border: 1px solid rgba(220, 53, 69, 0.3);
  color: var(--hm-danger);
}

.hm-alert--success {
  background: rgba(40, 167, 69, 0.1);
  border: 1px solid rgba(40, 167, 69, 0.3);
  color: var(--hm-success);
}

.hm-alert i {
  margin-left: 0.75rem;
  font-size: 1.1rem;
}

.hm-alert__close {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.hm-alert__close:hover {
  opacity: 1;
}

@keyframes slideIn {
  from {
    transform: translateY(-10px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* Form Groups */
.hm-form-group {
  margin-bottom: 1.5rem;
}

.hm-input-wrapper {
  position: relative;
}

.hm-input-icon {
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--hm-gold-primary);
  font-size: 1.1rem;
  z-index: 2;
}

.hm-input {
  width: 100%;
  padding: 1rem 3rem 1rem 1rem;
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid rgba(212, 175, 55, 0.2);
  border-radius: 12px;
  color: var(--hm-white);
  font-size: 1rem;
  transition: all var(--hm-transition-normal);
}

.hm-input:focus {
  outline: none;
  border-color: var(--hm-gold-primary);
  background: rgba(255, 255, 255, 0.15);
  box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
  transform: translateY(-2px);
}

.hm-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.hm-input-label {
  position: absolute;
  right: 3rem;
  top: 1rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
  pointer-events: none;
  transition: all var(--hm-transition-normal);
}

.hm-input:focus ~ .hm-input-label,
.hm-input:not(:placeholder-shown) ~ .hm-input-label {
  top: -0.5rem;
  right: 1rem;
  font-size: 0.8rem;
  background: var(--hm-blue-primary);
  padding: 0 0.5rem;
  color: var(--hm-gold-primary);
}

.hm-input-toggle {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: color 0.2s;
}

.hm-input-toggle:hover {
  color: var(--hm-gold-primary);
}

/* Form Footer */
.hm-form-footer {
  text-align: center;
  margin-top: 1.5rem;
}

.hm-form-footer p {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
  margin: 0 0 0.5rem 0;
}

/* Links */
.hm-link {
  color: var(--hm-gold-primary);
  text-decoration: none;
  font-size: 0.9rem;
  transition: all 0.2s ease;
}

.hm-link:hover {
  color: var(--hm-gold-light);
  text-decoration: underline;
  transform: translateY(-1px);
}

.hm-link--primary {
  font-weight: 600;
}

/* Buttons */
.hm-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 2rem;
  border: none;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all var(--hm-transition-normal);
  gap: 0.5rem;
}

.hm-btn--primary {
  background: var(--hm-bg-gold);
  color: var(--hm-blue-primary);
  box-shadow: var(--hm-shadow-gold);
}

.hm-btn--primary:hover {
  transform: translateY(-3px);
  box-shadow: var(--hm-shadow-gold-hover);
  background: linear-gradient(135deg, var(--hm-gold-light), var(--hm-gold-primary));
}

.hm-btn--full {
  width: 100%;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .hm-login2__brand {
    padding: 2rem;
  }
  
  .hm-login2__card {
    padding: 2rem;
  }
  
  .hm-login2__name {
    font-size: 2.5rem;
  }
  
  .hm-login2__title {
    font-size: 2rem;
  }
}

@media (max-width: 768px) {
  .hm-login2__shell {
    flex-direction: column;
  }
  
  .hm-login2__brand {
    padding: 2rem;
    border-right: none;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  }
  
  .hm-login2__card {
    padding: 1.5rem;
  }
  
  .hm-login2__name {
    font-size: 2rem;
  }
  
  .hm-login2__title {
    font-size: 1.8rem;
  }
  
  .hm-login2__chips {
    justify-content: center;
  }
  
  .hm-lang-switcher {
    top: 10px;
    right: 10px;
  }
  
  .hm-lang-switcher .hm-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
  }
}

@media (max-width: 480px) {
  .hm-login2__brand {
    padding: 1.5rem;
  }
  
  .hm-login2__card {
    padding: 1rem;
  }
  
  .hm-login2__name {
    font-size: 1.8rem;
  }
  
  .hm-login2__title {
    font-size: 1.5rem;
  }
  
  .hm-login2__desc {
    font-size: 1rem;
  }
  
  .hm-chip {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
  }
  
  .hm-btn {
    padding: 0.875rem 1.5rem;
  }
  
  .hm-input {
    padding: 0.875rem 2.5rem 0.875rem 0.875rem;
  }
}

/* Performance Optimizations */
.hm-login2 {
  will-change: transform;
  backface-visibility: hidden;
}

.hm-login2__logo,
.hm-chip,
.hm-btn,
.hm-input {
  will-change: transform;
  backface-visibility: hidden;
}

/* Smooth Animations */
* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
</style>
