<% layout('layout') -%>
<% const _brands = brands || []; %>

<!-- صفحة شركات قطع الغيار: عرض الشركات المستخرجة من قطع الغيار مع عدد القطع لكل شركة -->

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
  <div>
    <h3 class="mb-1">قطع الغيار</h3>
    <div class="text-muted">اختر شركة السيارة بالشعار أو الاسم لعرض قطع الغيار المتوفرة.</div>
  </div>
  <a class="btn btn-outline-secondary" href="/cars">السيارات المتوفرة</a>
</div>

<% if (!_brands.length) { %>
  <!-- لا توجد شركات: غالباً لم يتم إضافة قطع غيار بعد -->
  <div class="card border-0 shadow-sm">
    <div class="card-body py-5 text-center">
      <h5 class="mb-2">لا توجد شركات حالياً</h5>
      <div class="text-muted mb-3">أضف قطع غيار من لوحة الأدمن لتظهر الشركات هنا.</div>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a class="btn btn-primary" href="/admin/spare-parts">إضافة قطع الغيار</a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <!-- شبكة الشركات: الضغط ينقلك لصفحة القطع مع فلتر brand -->
  <div class="row g-3">
    <% _brands.forEach(b => { %>
      <div class="col-6 col-md-4 col-lg-3">
        <a class="card border-0 shadow-sm h-100 text-decoration-none" href="/spare-parts?brand=<%= encodeURIComponent(b.key) %>">
          <div class="card-body d-flex align-items-center gap-3">
            <% if (b.logoUrl) { %>
              <img src="<%= b.logoUrl %>" alt="شعار <%= b.name %>" class="hm-brand-logo-img" width="48" height="48" loading="lazy" decoding="async" />
            <% } else { %>
              <div class="rounded-circle bg-body-tertiary d-flex align-items-center justify-content-center hm-brand-logo-fallback">
                <span class="fw-bold text-secondary"><%= String(b.name || '').trim().slice(0, 2).toUpperCase() || 'P' %></span>
              </div>
            <% } %>
            <div class="flex-grow-1">
              <div class="fw-semibold text-dark"><%= b.name %></div>
              <div class="small text-muted"><%= (b.count || 0) %> قطعة</div>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>
