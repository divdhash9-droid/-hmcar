<!-- [[ARABIC_HEADER]] هذا الملف (views/partials/ios-tab-bar.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<!-- iOS Tab Bar -->
<div class="ios-tab-bar ios-text">
  <a href="/" class="ios-tab-item <%= typeof activeTab !== 'undefined' && activeTab === 'home' ? 'active' : '' %>">
    <div class="ios-tab-icon">
      <i class="fas fa-home"></i>
    </div>
    <span class="ios-tab-label">الرئيسية</span>
  </a>
  
  <a href="/cars" class="ios-tab-item <%= typeof activeTab !== 'undefined' && activeTab === 'cars' ? 'active' : '' %>">
    <div class="ios-tab-icon">
      <i class="fas fa-car"></i>
    </div>
    <span class="ios-tab-label">السيارات</span>
  </a>
  
  <a href="/auctions" class="ios-tab-item <%= typeof activeTab !== 'undefined' && activeTab === 'auctions' ? 'active' : '' %>">
    <div class="ios-tab-icon">
      <i class="fas fa-gavel"></i>
    </div>
    <span class="ios-tab-label">المزادات</span>
  </a>
  
  <a href="/spare-parts" class="ios-tab-item <%= typeof activeTab !== 'undefined' && activeTab === 'spare-parts' ? 'active' : '' %>">
    <div class="ios-tab-icon">
      <i class="fas fa-cogs"></i>
    </div>
    <span class="ios-tab-label">قطع الغيار</span>
  </a>
  
  <a href="/profile" class="ios-tab-item <%= typeof activeTab !== 'undefined' && activeTab === 'profile' ? 'active' : '' %>">
    <div class="ios-tab-icon">
      <i class="fas fa-user"></i>
    </div>
    <span class="ios-tab-label">الملف الشخصي</span>
  </a>
</div>

<style>
/* Add padding to body to avoid tab bar overlap */
body {
  padding-bottom: 83px;
}

@media (max-width: 768px) {
  body {
    padding-bottom: 65px;
  }
}

/* Tab bar animations */
.ios-tab-item {
  position: relative;
  overflow: hidden;
}

.ios-tab-item::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.1);
  transform: translate(-50%, -50%);
  transition: width 0.3s ease, height 0.3s ease;
}

.ios-tab-item:active::before {
  width: 100px;
  height: 100px;
}

/* Active tab indicator */
.ios-tab-item.active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 4px;
  height: 4px;
  background: var(--ios-blue);
  border-radius: 50%;
  margin-top: 2px;
}

/* Icon animations */
.ios-tab-icon {
  transition: transform 0.2s ease;
}

.ios-tab-item:active .ios-tab-icon {
  transform: scale(0.9);
}

.ios-tab-item.active .ios-tab-icon {
  color: var(--ios-blue);
}

/* Badge for notifications */
.ios-tab-item .ios-badge {
  position: absolute;
  top: 4px;
  right: 50%;
  transform: translateX(8px);
  font-size: 10px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
}
</style>
