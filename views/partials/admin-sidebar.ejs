<aside class="hm-admin-sidebar" aria-label="قائمة الإدارة">
  <div class="hm-admin-sidebar__brand">
    <a class="hm-admin-sidebar__brand-link" href="/admin" aria-label="HM CAR Admin">
      <img class="hm-admin-sidebar__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
      <div class="hm-admin-sidebar__brand-text">
        <div class="hm-admin-sidebar__brand-title">HM CAR</div>
        <div class="hm-admin-sidebar__brand-subtitle">Admin Panel</div>
      </div>
    </a>
  </div>

  <nav class="hm-admin-sidebar__nav" aria-label="روابط الإدارة">
    <a class="hm-admin-link <%= (currentUrl || '') === '/admin' ? 'is-active' : '' %>" href="/admin">
      <i class="fas fa-tachometer-alt" aria-hidden="true"></i>
      <span>لوحة التحكم</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/cars') ? 'is-active' : '' %>" href="/admin/cars">
      <i class="fas fa-car" aria-hidden="true"></i>
      <span>السيارات</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/orders') ? 'is-active' : '' %>" href="/admin/orders">
      <i class="fas fa-file-invoice" aria-hidden="true"></i>
      <span>الطلبات</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/auctions') ? 'is-active' : '' %>" href="/admin/auctions">
      <i class="fas fa-gavel" aria-hidden="true"></i>
      <span>المزادات</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/notifications') ? 'is-active' : '' %>" href="/admin/notifications">
      <i class="fas fa-bell" aria-hidden="true"></i>
      <span>الإشعارات</span>
      <% if ((adminNewNotificationsCount || 0) > 0) { %>
        <span class="hm-admin-badge" aria-label="إشعارات جديدة"><%= adminNewNotificationsCount %></span>
      <% } %>
    </a>

    <div class="hm-admin-sidebar__divider" role="separator"></div>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/brands') ? 'is-active' : '' %>" href="/admin/brands">
      <i class="fas fa-industry" aria-hidden="true"></i>
      <span>الشركات</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/categories') ? 'is-active' : '' %>" href="/admin/categories">
      <i class="fas fa-tags" aria-hidden="true"></i>
      <span>الفئات</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/spare-parts') ? 'is-active' : '' %>" href="/admin/spare-parts">
      <i class="fas fa-cogs" aria-hidden="true"></i>
      <span>قطع الغيار</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/spare-brands') ? 'is-active' : '' %>" href="/admin/spare-brands">
      <i class="fas fa-warehouse" aria-hidden="true"></i>
      <span>شركات القطع</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/live-auction') ? 'is-active' : '' %>" href="/admin/live-auction">
      <i class="fas fa-satellite-dish" aria-hidden="true"></i>
      <span>مزامنة المزاد</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/support') ? 'is-active' : '' %>" href="/admin/support">
      <i class="fas fa-headset" aria-hidden="true"></i>
      <span>الدعم</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/settings') ? 'is-active' : '' %>" href="/admin/settings">
      <i class="fas fa-sliders-h" aria-hidden="true"></i>
      <span>الإعدادات</span>
    </a>

    <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/users') ? 'is-active' : '' %>" href="/admin/users">
      <i class="fas fa-users" aria-hidden="true"></i>
      <span>المستخدمون</span>
    </a>

    <% if (currentUser && currentUser.role === 'super_admin') { %>
      <a class="hm-admin-link <%= (currentUrl || '').startsWith('/admin/users-management') ? 'is-active' : '' %>" href="/admin/users-management">
        <i class="fas fa-user-shield" aria-hidden="true"></i>
        <span>صلاحيات المشرفين</span>
      </a>
    <% } %>

  </nav>

  <div class="hm-admin-sidebar__footer">
    <div class="hm-admin-sidebar__user">
      <div class="hm-admin-sidebar__user-name"><%= (currentUser && currentUser.name) ? currentUser.name : 'Admin' %></div>
      <div class="hm-admin-sidebar__user-role"><%= (currentUser && currentUser.role) ? currentUser.role : '' %></div>
    </div>
    <a class="hm-admin-logout" href="/auth/logout" aria-label="تسجيل خروج">
      <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
      <span>خروج</span>
    </a>
  </div>
</aside>

<div class="hm-admin-backdrop" data-admin-sidebar-backdrop hidden></div>
