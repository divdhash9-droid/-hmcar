<!-- [[ARABIC_HEADER]] هذا الملف (views/index-ios.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'ios-home-page'; %>

<!-- iOS Navigation Bar -->
<%- include('../partials/ios-navbar', { 
  title: 'HM CAR',
  menuButton: true,
  searchButton: true,
  notifications: true,
  notificationCount: 3
}) %>

<!-- Main Content -->
<div class="ios-home-container">
  <!-- Hero Section -->
  <section class="ios-hero-section">
    <div class="ios-hero-content ios-animate-fade-in">
      <h1 class="ios-title-1 ios-text">مرحباً بك في HM CAR</h1>
      <p class="ios-body ios-text" style="color: var(--ios-secondary-label); margin: 16px 0;">
        منصة مزادات السيارات الفاخرة الأكثر تطوراً في العالم
      </p>
      <div class="ios-hero-buttons">
        <button class="ios-btn ios-btn-primary ios-btn-large ios-haptic ios-ripple-container">
          <i class="fas fa-play ios-icon"></i>
          ابدأ الآن
        </button>
        <button class="ios-btn ios-btn-secondary ios-btn-large ios-haptic">
          <i class="fas fa-info-circle ios-icon"></i>
          تعرف أكثر
        </button>
      </div>
    </div>
    
    <!-- Hero Image -->
    <div class="ios-hero-image ios-animate-slide-up">
      <img src="/public/images/hero-car.png" alt="Luxury Car" style="width: 100%; height: auto; border-radius: 16px;">
    </div>
  </section>

  <!-- Quick Actions -->
  <section class="ios-quick-actions">
    <h2 class="ios-headline ios-text" style="margin-bottom: 20px;">إجراءات سريعة</h2>
    <div class="ios-quick-actions-grid">
      <div class="ios-quick-action-card ios-card ios-hover-lift ios-haptic ios-animate-fade-in">
        <div class="ios-quick-action-icon ios-icon-primary">
          <i class="fas fa-car ios-icon-large"></i>
        </div>
        <h3 class="ios-subhead ios-text">تصفح السيارات</h3>
        <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">اكتشف أحدث السيارات</p>
      </div>
      
      <div class="ios-quick-action-card ios-card ios-hover-lift ios-haptic ios-animate-fade-in" style="animation-delay: 0.1s;">
        <div class="ios-quick-action-icon ios-icon-success">
          <i class="fas fa-gavel ios-icon-large"></i>
        </div>
        <h3 class="ios-subhead ios-text">المزادات المباشرة</h3>
        <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">شارك في المزادات الآن</p>
      </div>
      
      <div class="ios-quick-action-card ios-card ios-hover-lift ios-haptic ios-animate-fade-in" style="animation-delay: 0.2s;">
        <div class="ios-quick-action-icon ios-icon-warning">
          <i class="fas fa-cogs ios-icon-large"></i>
        </div>
        <h3 class="ios-subhead ios-text">قطع الغيار</h3>
        <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">ابحث عن قطع الغيار</p>
      </div>
      
      <div class="ios-quick-action-card ios-card ios-hover-lift ios-haptic ios-animate-fade-in" style="animation-delay: 0.3s;">
        <div class="ios-quick-action-icon ios-icon-danger">
          <i class="fas fa-star ios-icon-large"></i>
        </div>
        <h3 class="ios-subhead ios-text">المفضلة</h3>
        <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">سياراتك المفضلة</p>
      </div>
    </div>
  </section>

  <!-- Featured Cars -->
  <section class="ios-featured-cars">
    <div class="ios-section-header">
      <h2 class="ios-headline ios-text">السيارات المميزة</h2>
      <button class="ios-btn ios-btn-tertiary ios-haptic">
        عرض الكل
        <i class="fas fa-chevron-left ios-icon" style="transform: rotate(180deg);"></i>
      </button>
    </div>
    
    <div class="ios-cars-scroll">
      <div class="ios-car-card ios-card ios-animate-fade-in">
        <div class="ios-car-image">
          <img src="/public/images/car1.jpg" alt="Luxury Car" style="width: 100%; height: 200px; object-fit: cover; border-radius: 12px;">
          <div class="ios-car-badge ios-badge-gold">مميزة</div>
        </div>
        <div class="ios-car-info">
          <h3 class="ios-subhead ios-text">مرسيدس S-Class</h3>
          <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">2024 • 10,000 كم</p>
          <div class="ios-car-price">
            <span class="ios-callout ios-text" style="color: var(--ios-blue);">450,000 ريال</span>
          </div>
        </div>
      </div>
      
      <div class="ios-car-card ios-card ios-animate-fade-in" style="animation-delay: 0.1s;">
        <div class="ios-car-image">
          <img src="/public/images/car2.jpg" alt="Luxury Car" style="width: 100%; height: 200px; object-fit: cover; border-radius: 12px;">
          <div class="ios-car-badge ios-badge-success">جديدة</div>
        </div>
        <div class="ios-car-info">
          <h3 class="ios-subhead ios-text">بي ام دبليو X7</h3>
          <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">2024 • 5,000 كم</p>
          <div class="ios-car-price">
            <span class="ios-callout ios-text" style="color: var(--ios-blue);">380,000 ريال</span>
          </div>
        </div>
      </div>
      
      <div class="ios-car-card ios-card ios-animate-fade-in" style="animation-delay: 0.2s;">
        <div class="ios-car-image">
          <img src="/public/images/car3.jpg" alt="Luxury Car" style="width: 100%; height: 200px; object-fit: cover; border-radius: 12px;">
          <div class="ios-car-badge ios-badge-warning">ساخنة</div>
        </div>
        <div class="ios-car-info">
          <h3 class="ios-subhead ios-text">أودي Q8</h3>
          <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">2023 • 15,000 كم</p>
          <div class="ios-car-price">
            <span class="ios-callout ios-text" style="color: var(--ios-blue);">320,000 ريال</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Auctions -->
  <section class="ios-live-auctions">
    <div class="ios-section-header">
      <h2 class="ios-headline ios-text">المزادات المباشرة</h2>
      <div class="ios-live-indicator">
        <span class="ios-live-dot"></span>
        <span class="ios-caption-1 ios-text">مباشر</span>
      </div>
    </div>
    
    <div class="ios-auction-card ios-card ios-animate-fade-in">
      <div class="ios-auction-header">
        <div class="ios-auction-info">
          <h3 class="ios-subhead ios-text">فيراري 488 GTB</h3>
          <p class="ios-footnote ios-text" style="color: var(--ios-secondary-label);">ينتهي خلال 2 ساعة</p>
        </div>
        <div class="ios-auction-status">
          <span class="ios-badge ios-badge-danger">مباشر</span>
        </div>
      </div>
      
      <div class="ios-auction-image">
        <img src="/public/images/auction-car.jpg" alt="Auction Car" style="width: 100%; height: 180px; object-fit: cover; border-radius: 12px;">
      </div>
      
      <div class="ios-auction-details">
        <div class="ios-auction-price">
          <span class="ios-caption-2 ios-text" style="color: var(--ios-secondary-label);">السعر الحالي</span>
          <span class="ios-title-3 ios-text" style="color: var(--ios-green);">580,000 ريال</span>
        </div>
        <div class="ios-auction-bids">
          <span class="ios-caption-2 ios-text" style="color: var(--ios-secondary-label);">23 عرض</span>
        </div>
      </div>
      
      <button class="ios-btn ios-btn-primary ios-btn-large ios-haptic ios-ripple-container" style="width: 100%; margin-top: 16px;">
        <i class="fas fa-gavel ios-icon"></i>
        المشاركة في المزاد
      </button>
    </div>
  </section>
</div>

<!-- iOS Tab Bar -->
<%- include('../partials/ios-tab-bar', { activeTab: 'home' }) %>

<style>
.ios-home-container {
  padding-top: 88px;
  padding-bottom: 100px;
  background: var(--ios-secondary-background);
  min-height: 100vh;
}

.ios-hero-section {
  padding: 24px 16px;
  background: linear-gradient(135deg, var(--ios-system-background) 0%, var(--ios-secondary-background) 100%);
  border-radius: 0 0 24px 24px;
  margin-bottom: 24px;
}

.ios-hero-content {
  text-align: center;
  margin-bottom: 32px;
}

.ios-hero-buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

.ios-hero-image {
  max-width: 400px;
  margin: 0 auto;
}

.ios-quick-actions {
  padding: 0 16px;
  margin-bottom: 32px;
}

.ios-quick-actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 16px;
}

.ios-quick-action-card {
  text-align: center;
  padding: 20px 16px;
  cursor: pointer;
}

.ios-quick-action-icon {
  width: 60px;
  height: 60px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  background: var(--ios-gray-6);
}

.ios-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding: 0 16px;
}

.ios-live-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
}

.ios-live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--ios-red);
  animation: ios-pulse 2s infinite;
}

.ios-cars-scroll {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding: 0 16px;
  scroll-snap-type: x mandatory;
}

.ios-car-card {
  min-width: 280px;
  scroll-snap-align: start;
  cursor: pointer;
}

.ios-car-image {
  position: relative;
  margin-bottom: 12px;
}

.ios-car-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  font-size: 10px;
  padding: 4px 8px;
}

.ios-car-info h3 {
  margin-bottom: 4px;
}

.ios-car-price {
  margin-top: 8px;
}

.ios-live-auctions {
  padding: 0 16px;
  margin-bottom: 32px;
}

.ios-auction-card {
  cursor: pointer;
}

.ios-auction-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.ios-auction-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
}

/* Responsive */
@media (max-width: 768px) {
  .ios-home-container {
    padding-top: 64px;
  }
  
  .ios-hero-section {
    padding: 16px 12px;
  }
  
  .ios-quick-actions {
    padding: 0 12px;
  }
  
  .ios-section-header {
    padding: 0 12px;
  }
  
  .ios-cars-scroll {
    padding: 0 12px;
  }
  
  .ios-live-auctions {
    padding: 0 12px;
  }
  
  .ios-hero-buttons {
    flex-direction: column;
  }
  
  .ios-quick-actions-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Scrollbar styling */
.ios-cars-scroll::-webkit-scrollbar {
  height: 4px;
}

.ios-cars-scroll::-webkit-scrollbar-track {
  background: var(--ios-gray-6);
  border-radius: 2px;
}

.ios-cars-scroll::-webkit-scrollbar-thumb {
  background: var(--ios-gray);
  border-radius: 2px;
}

.ios-cars-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--ios-gray-2);
}
</style>

<script>
// Add interactive features
document.addEventListener('DOMContentLoaded', function() {
  // Smooth scroll for cars
  const carsScroll = document.querySelector('.ios-cars-scroll');
  if (carsScroll) {
    let isDown = false;
    let startX;
    let scrollLeft;

    carsScroll.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - carsScroll.offsetLeft;
      scrollLeft = carsScroll.scrollLeft;
    });

    carsScroll.addEventListener('mouseleave', () => {
      isDown = false;
    });

    carsScroll.addEventListener('mouseup', () => {
      isDown = false;
    });

    carsScroll.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carsScroll.offsetLeft;
      const walk = (x - startX) * 2;
      carsScroll.scrollLeft = scrollLeft - walk;
    });
  }

  // Animate elements on scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('ios-animate-active');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.ios-animate-fade-in').forEach(el => {
    observer.observe(el);
  });
});
</script>
