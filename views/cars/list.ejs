<% layout('layout') -%>

<div class="hm-page-container">
    <header class="hm-page-header">
        <h1><i class="fas fa-car hm-icon hm-icon-gold hm-icon-lg"></i> مجموعة السيارات</h1>
        <p>اكتشف مجموعتنا الحصرية من السيارات المعروضة للبيع والمزادات.</p>
    </header>

    <div class="hm-cars-layout">
        <!-- Sidebar for Filters -->
        <aside class="hm-filters-sidebar">
            <h3><i class="fas fa-filter hm-icon hm-icon-gold"></i> تصفية النتائج</h3>
            <form method="GET" action="/cars/list" class="hm-filter-form">
                <div class="hm-form-group">
                    <label for="make"><i class="fas fa-building hm-icon hm-icon-sm hm-icon-muted"></i> الشركة المصنعة</label>
                    <select name="make" id="make" class="hm-form-control">
                        <option value="">الكل</option>
                        <% const makes = [...new Set(cars.map(c => c.make))]; %>
                        <% makes.forEach(make => { %>
                            <option value="<%= make %>" <%= (filters && filters.make === make) ? 'selected' : '' %>><%= make %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="hm-form-group">
                    <label for="minPrice"><i class="fas fa-tag hm-icon hm-icon-sm hm-icon-muted"></i> السعر</label>
                    <div class="hm-price-range">
                        <input type="number" name="minPrice" id="minPrice" class="hm-form-control" placeholder="من" value="<%= filters && filters.minPrice ? filters.minPrice : '' %>">
                        <input type="number" name="maxPrice" class="hm-form-control" placeholder="إلى" value="<%= filters && filters.maxPrice ? filters.maxPrice : '' %>">
                    </div>
                </div>
                <div class="hm-form-group">
                    <label for="year"><i class="fas fa-calendar hm-icon hm-icon-sm hm-icon-muted"></i> سنة الصنع</label>
                    <select name="year" id="year" class="hm-form-control">
                        <option value="">الكل</option>
                        <% const years = [...new Set(cars.map(c => c.year))].sort((a, b) => b - a); %>
                        <% years.forEach(year => { %>
                            <option value="<%= year %>" <%= (filters && filters.year == year) ? 'selected' : '' %>><%= year %></option>
                        <% }); %>
                    </select>
                </div>
                <button type="submit" class="hm-btn hm-btn-primary hm-btn-block">
                    <i class="fas fa-search"></i> تطبيق الفلتر
                </button>
            </form>
        </aside>

        <!-- Main Content for Cars Grid -->
        <main class="hm-cars-grid-container">
            <% if (!cars || cars.length === 0) { %>
                <div class="hm-empty-state">
                    <i class="fas fa-car-side hm-icon hm-icon-3xl hm-icon-muted"></i>
                    <h4>لا توجد سيارات تطابق بحثك</h4>
                    <p>حاول تغيير معايير التصفية أو عرض جميع السيارات.</p>
                    <a href="/cars/list" class="hm-btn hm-btn-outline">
                        <i class="fas fa-sync"></i> عرض الكل
                    </a>
                </div>
            <% } else { %>
                <div class="hm-car-grid">
                    <% cars.forEach(car => { %>
                        <%- include('../partials/car-card', { car: car }) %>
                    <% }) %>
                </div>

                <!-- Pagination -->
                <% if (pagination && pagination.totalPages > 1) { %>
                    <nav aria-label="صفحات السيارات" class="hm-pagination-container">
                        <ul class="hm-pagination">
                            <% if (pagination.currentPage > 1) { %>
                                <li class="hm-page-item">
                                    <a class="hm-page-link" href="?page=<%= pagination.currentPage - 1 %>&<%= new URLSearchParams(filters).toString() %>">
                                        <i class="fas fa-chevron-right"></i> السابق
                                    </a>
                                </li>
                            <% } %>
                            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                <li class="hm-page-item <%= i === pagination.currentPage ? 'hm-active' : '' %>">
                                    <a class="hm-page-link" href="?page=<%= i %>&<%= new URLSearchParams(filters).toString() %>"><%= i %></a>
                                </li>
                            <% } %>
                            <% if (pagination.currentPage < pagination.totalPages) { %>
                                <li class="hm-page-item">
                                    <a class="hm-page-link" href="?page=<%= pagination.currentPage + 1 %>&<%= new URLSearchParams(filters).toString() %>">
                                        التالي <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                <% } %>
            <% } %>
        </main>
    </div>
</div>
