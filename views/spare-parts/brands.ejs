<!-- [[ARABIC_HEADER]] هذا الملف (views/spare-parts/brands.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% var hideNavbar = (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'buyer'); %>
<% layout('layout') -%>
<% const _brands = brands || []; %>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="شركات قطع الغيار" style="min-height:auto; padding: 26px 18px;">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title"><i class="fas fa-building" style="margin-left:10px;"></i>شركات قطع الغيار</h1>
            <div class="hm-hero__subtitle">اختر الشركة بالشعار أو الاسم لعرض قطع الغيار المتوفرة.</div>
          </div>
        </div>
        <nav class="hm-hero__actions" aria-label="إجراءات">
          <a class="hm-pill" href="/spare-parts" aria-label="قائمة قطع الغيار"><i class="fas fa-tools"></i><span>قطع الغيار</span></a>
          <a class="hm-pill" href="/cars" aria-label="السيارات المتوفرة"><i class="fas fa-car"></i><span>السيارات</span></a>
          <a class="hm-pill" href="/auctions/live" aria-label="المزاد المباشر"><i class="fas fa-gavel"></i><span>المزاد المباشر</span></a>
        </nav>
      </div>
    </header>

    <section class="hm-section" aria-label="قائمة الشركات" style="margin-top: 16px;">
      <% if (!_brands.length) { %>
        <div class="hm-card" style="padding: 26px; text-align:center;">
          <div style="font-size: 2.5rem; opacity: 0.35; margin-bottom: 10px;"><i class="fas fa-building"></i></div>
          <h3 style="margin:0 0 8px;">لا توجد شركات حالياً</h3>
          <div class="text-muted" style="margin-bottom: 14px;">أضف قطع غيار من لوحة الأدمن لتظهر الشركات هنا.</div>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <a class="btn btn-primary" href="/admin/spare-parts">إضافة قطع الغيار</a>
          <% } %>
        </div>
      <% } else { %>
        <div class="row g-3">
          <% _brands.forEach(b => { %>
            <div class="col-6 col-md-4 col-lg-3">
              <a class="hm-card" href="/spare-parts?brand=<%= encodeURIComponent(b.key) %>" style="display:flex; align-items:center; gap:12px; text-decoration:none; color:inherit; padding: 14px;">
                <% if (b.logoUrl) { %>
                  <img src="<%= b.logoUrl %>" alt="شعار <%= b.name %>" class="hm-brand-logo-img" width="52" height="52" loading="lazy" decoding="async" />
                <% } else { %>
                  <div class="hm-brand-logo-fallback" style="width:52px; height:52px; border-radius:999px; background: rgba(11,31,58,0.06); display:flex; align-items:center; justify-content:center;">
                    <span style="font-weight: 900; color: rgba(11,31,58,0.65);"><%= String(b.name || '').trim().slice(0, 2).toUpperCase() || 'P' %></span>
                  </div>
                <% } %>
                <div style="min-width:0;">
                  <div style="font-weight: 900; color:#0b1f3a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= b.name %></div>
                  <div class="text-muted" style="font-size: 0.95rem; margin-top: 4px;"><%= (b.count || 0) %> قطعة</div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</div>
