<!-- [[ARABIC_HEADER]] هذا الملف (views/search/results.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var bodyClass = 'search-results-page'; %>

<div class="modern-container">
  <div class="page-header">
    <h1>نتائج البحث</h1>
    <p>
      <% if (q) { %>
        بحث عن: <strong><%= q %></strong> — <strong><%= total %></strong> نتيجة
      <% } else { %>
        استخدم البحث للعثور على سيارات وقطع غيار ومزادات
      <% } %>
    </p>
  </div>

  <div class="mt-4">
    <form action="/search" method="GET" class="row g-3 align-items-end">
      <div class="col-12 col-md-5">
        <label class="form-label">كلمة البحث</label>
        <input name="q" class="form-control" value="<%= (query && query.q) ? query.q : '' %>" placeholder="مثال: تويوتا كامري 2022" />
      </div>

      <div class="col-12 col-md-4">
        <label class="form-label">الماركة</label>
        <select name="make" class="form-select">
          <option value="">الكل</option>
          <% (makes || []).forEach(function(m){ %>
            <option value="<%= m %>" <%= (query && (query.make === m || query.brand === m)) ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-6 col-md-1">
        <label class="form-label">من</label>
        <input name="minPrice" type="number" class="form-control" value="<%= (query && query.minPrice) ? query.minPrice : '' %>" />
      </div>

      <div class="col-6 col-md-1">
        <label class="form-label">إلى</label>
        <input name="maxPrice" type="number" class="form-control" value="<%= (query && query.maxPrice) ? query.maxPrice : '' %>" />
      </div>

      <div class="col-6 col-md-1">
        <label class="form-label">سنة</label>
        <input name="year" type="number" class="form-control" value="<%= (query && query.year) ? query.year : '' %>" />
      </div>

      <div class="col-12 col-md-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-search me-1"></i>
          بحث
        </button>
        <a href="/search" class="btn btn-outline-secondary">
          <i class="fas fa-rotate-left me-1"></i>
          تصفير
        </a>
      </div>
    </form>
  </div>

  <div class="mt-4">
    <% if (!results || results.length === 0) { %>
      <div class="alert alert-info">لا توجد نتائج مطابقة.</div>
    <% } else { %>
      <div class="row g-3">
        <% results.forEach(function(item){ %>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: var(--border-radius); box-shadow: var(--shadow-sm);">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <h5 class="card-title mb-1" style="color: var(--primary-color); font-weight: 800;">
                    <%= item.title || item.name || 'عنصر' %>
                  </h5>
                  <span class="badge bg-light text-dark" style="border: 1px solid var(--border-color);">
                    <%= item.resultType === 'car' ? 'سيارة' : (item.resultType === 'sparepart' ? 'قطعة غيار' : 'مزاد') %>
                  </span>
                </div>

                <% if (item.resultType === 'car') { %>
                  <div class="text-muted small mb-2"><%= [item.make, item.model, item.year].filter(Boolean).join(' • ') %></div>
                  <% if (item.price) { %>
                    <div class="mb-3" style="font-weight: 800; color: var(--primary-color);">السعر: <%= item.price %></div>
                  <% } %>
                  <a class="btn btn-primary w-100" href="/cars/<%= item._id %>">
                    <i class="fas fa-car me-1"></i>
                    عرض التفاصيل
                  </a>
                <% } else if (item.resultType === 'sparepart') { %>
                  <div class="text-muted small mb-2"><%= [item.carMake, item.carModel, item.carYear].filter(Boolean).join(' • ') %></div>
                  <% if (item.price) { %>
                    <div class="mb-3" style="font-weight: 800; color: var(--primary-color);">السعر: <%= item.price %></div>
                  <% } %>
                  <a class="btn btn-primary w-100" href="/spare-parts/<%= item._id %>">
                    <i class="fas fa-wrench me-1"></i>
                    عرض التفاصيل
                  </a>
                <% } else { %>
                  <div class="text-muted small mb-2">
                    <% if (item.car && (item.car.make || item.car.model || item.car.year)) { %>
                      <%= [item.car.make, item.car.model, item.car.year].filter(Boolean).join(' • ') %>
                    <% } %>
                  </div>
                  <div class="mb-3" style="font-weight: 800; color: var(--primary-color);">
                    السعر الحالي: <%= item.currentPrice || item.startingPrice || '-' %>
                  </div>
                  <a class="btn btn-primary w-100" href="/auctions/<%= item._id %>">
                    <i class="fas fa-gavel me-1"></i>
                    عرض المزاد
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
