<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-dashboard-luxury'; %>

<div class="hm-dashboard">
    <div class="hm-dashboard__container">
        <header class="hm-hero" aria-label="إدارة الوكالات">
            <div class="hm-hero__top">
                <div class="hm-hero__brand">
                    <h1 class="hm-hero__title">إدارة الوكالات (Brands)</h1>
                    <div class="hm-hero__subtitle">إضافة وتعديل وحذف وكالات السيارات.</div>
                </div>
                <nav class="hm-hero__actions" aria-label="إجراءات">
                    <a class="hm-pill" href="/admin" aria-label="لوحة الإدارة"><i class="fas fa-tachometer-alt"></i><span>لوحة الإدارة</span></a>
                    <button class="hm-pill hm-pill--primary" onclick="openBrandModal()">
                        <i class="fas fa-plus"></i><span>إضافة وكالة</span>
                    </button>
                </nav>
            </div>
        </header>

        <% if (flash && flash.message) { %>
            <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
                <%= flash.message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <section class="hm-section" aria-label="قائمة الوكالات">
            <div class="table-responsive">
                <table class="table modern-table">
                    <thead>
                        <tr>
                            <th>الشعار</th>
                            <th>اسم الوكالة</th>
                            <th>عدد السيارات</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!brands || !brands.length) { %>
                            <tr>
                                <td colspan="4" class="text-center">لا توجد وكالات حالياً.</td>
                            </tr>
                        <% } else { %>
                            <% brands.forEach(brand => { %>
                                <tr>
                                    <td>
                                        <% if (brand.logoUrl) { %>
                                            <img src="<%= brand.logoUrl %>" alt="<%= brand.name %>" class="brand-logo-table">
                                        <% } else { %>
                                            <div class="brand-logo-fallback">-</div>
                                        <% } %>
                                    </td>
                                    <td><%= brand.name %></td>
                                    <td>0</td> <!-- Placeholder for car count -->
                                    <td>
                                        <div class="action-buttons">
                                            <button class="btn btn-sm btn-outline-primary" onclick="openBrandModal('<%= JSON.stringify(brand) %>')">
                                                <i class="fas fa-edit"></i> تعديل
                                            </button>
                                            <form method="post" action="/admin/brands/<%= brand._id %>/delete" onsubmit="return confirm('هل أنت متأكد من حذف هذه الوكالة؟');" style="display: inline;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i> حذف
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<!-- Add/Edit Brand Modal -->
<div class="modal fade" id="brandModal" tabindex="-1" aria-labelledby="brandModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="brandForm" method="post" action="" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="_method" id="formMethod" value="POST">
                <div class="modal-header">
                    <h5 class="modal-title" id="brandModalLabel">إضافة وكالة جديدة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">اسم الوكالة</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="logoUrl" class="form-label">رابط شعار الوكالة (URL)</label>
                        <input type="url" class="form-control" id="logoUrl" name="logoUrl" placeholder="https://example.com/logo.png">
                    </div>
                    <div class="mb-3">
                        <label for="logoFile" class="form-label">أو رفع ملف شعار</label>
                        <input type="file" class="form-control" id="logoFile" name="logo">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .modern-table {
        width: 100%;
        border-collapse: collapse;
    }
    .modern-table th, .modern-table td {
        padding: 1rem;
        text-align: right;
        vertical-align: middle;
        border-bottom: 1px solid var(--border-color);
    }
    .modern-table thead th {
        font-weight: 600;
        background-color: var(--section-bg-color);
    }
    .brand-logo-table {
        width: 60px;
        height: 40px;
        object-fit: contain;
    }
    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }
</style>

<script>
    const brandModal = new bootstrap.Modal(document.getElementById('brandModal'));
    const brandForm = document.getElementById('brandForm');
    const brandModalLabel = document.getElementById('brandModalLabel');
    const formMethod = document.getElementById('formMethod');

    function openBrandModal(brandData) {
        brandForm.reset();
        if (brandData) {
            const brand = JSON.parse(brandData);
            brandModalLabel.textContent = 'تعديل وكالة';
            brandForm.action = `/admin/brands/${brand._id}/edit`;
            formMethod.value = 'PUT';
            document.getElementById('name').value = brand.name;
            document.getElementById('logoUrl').value = brand.logoUrl || '';
        } else {
            brandModalLabel.textContent = 'إضافة وكالة جديدة';
            brandForm.action = '/admin/brands';
            formMethod.value = 'POST';
        }
        brandModal.show();
    }

    brandForm.addEventListener('submit', function(e) {
        // This is to handle PUT method override since HTML forms don't support it directly
        if (formMethod.value === 'PUT') {
            e.preventDefault();
            const formData = new FormData(brandForm);
            fetch(brandForm.action, {
                method: 'POST', // Still POST, but we can add a header or query param if needed by backend
                body: formData,
                headers: {
                    'X-HTTP-Method-Override': 'PUT'
                }
            }).then(res => {
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('حدث خطأ أثناء الحفظ.');
                }
            });
        }
    });
</script>
