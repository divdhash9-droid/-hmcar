<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-dashboard-luxury'; %>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="الإعدادات">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title">إعدادات النظام</h1>
            <div class="hm-hero__subtitle">تحكم فاخر بكل تفاصيل المنصة</div>
          </div>
        </div>

        <nav class="hm-hero__actions" aria-label="روابط">
          <a class="hm-pill" href="/admin" aria-label="لوحة الإدارة"><i class="fas fa-tachometer-alt"></i><span>لوحة الإدارة</span></a>
          <a class="hm-pill" href="/admin/notifications" aria-label="الإشعارات"><i class="fas fa-bell"></i><span>الإشعارات</span></a>
          <a class="hm-pill hm-pill--danger" href="/auth/logout" aria-label="خروج"><i class="fas fa-sign-out-alt"></i><span>خروج</span></a>
        </nav>
      </div>

      <section class="hm-kpis" aria-label="حالة">
        <div class="hm-kpi hm-kpi--security"><div class="hm-kpi__row"><div><div class="hm-kpi__label">الأمان</div><div class="hm-kpi__value">CSRF</div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-shield-alt"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">واجهة</div><div class="hm-kpi__value">LUX</div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-gem"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">التحديثات</div><div class="hm-kpi__value">LIVE</div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-bolt"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">التحكم</div><div class="hm-kpi__value">FULL</div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-cogs"></i></div></div></div>
      </section>
    </header>

    <% if (flash && flash.message) { %>
      <div class="mt-3">
        <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% } %>

    <section class="hm-section" aria-label="خيارات">
      <h2 class="hm-section__title">خيارات الإعدادات</h2>
      <div class="hm-grid">
        <a class="hm-card" href="/admin/settings/whatsapp" aria-label="إعدادات الواتساب"><div class="hm-card__icon" aria-hidden="true"><i class="fab fa-whatsapp" style="font-size:1.6rem"></i></div><div class="hm-card__title">WhatsApp</div><div class="hm-card__subtitle">رقم + رسالة + تفعيل</div></a>
        <a class="hm-card" href="/admin/settings/footer" aria-label="إعدادات الفوتر"><div class="hm-card__icon" aria-hidden="true"><i class="fas fa-grip-lines" style="font-size:1.6rem"></i></div><div class="hm-card__title">Footer</div><div class="hm-card__subtitle">معلومات وروابط</div></a>
        <a class="hm-card" href="/admin/exchange-rate" aria-label="سعر الصرف"><div class="hm-card__icon" aria-hidden="true"><i class="fas fa-dollar-sign" style="font-size:1.6rem"></i></div><div class="hm-card__title">سعر الصرف</div><div class="hm-card__subtitle">USD -> SAR</div></a>
      </div>
    </section>
  </div>
</div>
