<% layout('layout') -%>

<% var bodyClass = (typeof bodyClass !== 'undefined' && bodyClass) ? bodyClass : 'hm-catalog-page hm-cars-available-page'; %>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="السيارات المتاحة" style="min-height:auto; padding: 26px 18px;">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title"><i class="fas fa-car" style="margin-left:10px;"></i><span data-ar="السيارات المتاحة" data-en="Available Cars">السيارات المتاحة</span></h1>
            <div class="hm-hero__subtitle" data-ar="استكشف السيارات المتاحة مع فلاتر سريعة" data-en="Browse available cars with quick filters">استكشف السيارات المتاحة مع فلاتر سريعة</div>
          </div>
        </div>
        <nav class="hm-hero__actions" aria-label="إجراءات">
          <a class="hm-pill" href="/cars" aria-label="السيارات المتوفرة"><i class="fas fa-list"></i><span>السيارات المتوفرة</span></a>
          <a class="hm-pill" href="/auctions/live" aria-label="المزاد المباشر"><i class="fas fa-gavel"></i><span>المزاد المباشر</span></a>
          <a class="hm-pill" href="/spare-parts" aria-label="قطع الغيار"><i class="fas fa-tools"></i><span>قطع الغيار</span></a>
          <div class="hm-pill" role="status" aria-label="إحصائيات" style="cursor:default;">
            <i class="fas fa-chart-bar"></i>
            <span>الإجمالي: <strong id="totalCars">0</strong></span>
            <span style="opacity:.85;">| مزاد نشط: <strong id="activeAuctions">0</strong></span>
          </div>
        </nav>
      </div>
    </header>

    <section class="hm-section" aria-label="الفلاتر" style="margin-top: 16px;">
      <div class="hm-card" style="padding: 16px;">
        <div class="row g-2 align-items-end">
          <div class="col-12 col-md-6 col-lg-3">
            <label class="form-label" data-ar="العلامة التجارية" data-en="Make">العلامة التجارية</label>
            <select class="form-select" id="makeFilter">
              <option value="">جميع العلامات</option>
            </select>
          </div>
          <div class="col-12 col-md-6 col-lg-3">
            <label class="form-label" data-ar="الموديل" data-en="Model">الموديل</label>
            <select class="form-select" id="modelFilter">
              <option value="">جميع الموديلات</option>
            </select>
          </div>
          <div class="col-12 col-md-6 col-lg-2">
            <label class="form-label" data-ar="الفئة" data-en="Category">الفئة</label>
            <select class="form-select" id="categoryFilter">
              <option value="">جميع الفئات</option>
            </select>
          </div>
          <div class="col-12 col-md-6 col-lg-2">
            <label class="form-label" data-ar="السعر" data-en="Price">السعر</label>
            <select class="form-select" id="priceFilter">
              <option value="">جميع الأسعار</option>
              <option value="0-50000">أقل من 50,000</option>
              <option value="50000-100000">50,000 - 100,000</option>
              <option value="100000-200000">100,000 - 200,000</option>
              <option value="200000+">أكثر من 200,000</option>
            </select>
          </div>
          <div class="col-12 col-md-6 col-lg-2">
            <label class="form-label" data-ar="السنة" data-en="Year">السنة</label>
            <select class="form-select" id="yearFilter">
              <option value="">جميع السنوات</option>
            </select>
          </div>

          <div class="col-12 d-flex gap-2 justify-content-end" style="margin-top: 6px;">
            <button class="btn btn-outline-secondary" type="button" id="clearFilters"><i class="fas fa-times"></i><span style="margin-right:8px;" data-ar="مسح الفلاتر" data-en="Clear Filters">مسح الفلاتر</span></button>
            <button class="btn btn-primary" type="button" id="searchBtn"><i class="fas fa-search"></i><span style="margin-right:8px;" data-ar="بحث" data-en="Search">بحث</span></button>
          </div>
        </div>
      </div>
    </section>

    <!-- Cars Grid -->
    <section class="hm-section" aria-label="قائمة السيارات" style="margin-top: 12px;">
      <!-- Loading State -->
      <div class="hm-loading" id="loadingState" style="display: none;">
        <div class="hm-spinner"></div>
        <p data-ar="جاري التحميل..." data-en="Loading...">جاري التحميل...</p>
      </div>

      <!-- Empty State -->
      <div class="hm-empty-state" id="emptyState" style="display: none;">
        <div class="hm-empty-icon">
          <i class="fas fa-car"></i>
        </div>
        <h3 data-ar="لا توجد سيارات متاحة" data-en="No cars available">لا توجد سيارات متاحة</h3>
        <p data-ar="لم يتم العثور على سيارات تطابق معايير البحث" data-en="No cars found matching your search criteria">
          لم يتم العثور على سيارات تطابق معايير البحث
        </p>
        <button class="hm-btn hm-btn-primary" id="resetSearch">
          <i class="fas fa-redo"></i>
          <span data-ar="إعادة تعيين البحث" data-en="Reset Search">إعادة تعيين البحث</span>
        </button>
      </div>

      <!-- Cars Grid -->
      <div class="hm-cars-grid" id="carsGrid">
        <!-- Cars will be loaded here dynamically -->
      </div>

      <!-- Pagination -->
      <div class="hm-pagination" id="pagination">
        <!-- Pagination will be loaded here -->
      </div>
    </section>
  </div>
</div>

<!-- Car Card Template -->
<template id="carCardTemplate">
  <div class="hm-car-card">
    <div class="hm-car-image">
      <img src="" alt="" class="hm-car-img">
      <div class="hm-car-actions">
        <button class="hm-action-btn hm-btn-favorite" data-car-id="">
          <i class="fas fa-heart"></i>
        </button>
        <button class="hm-action-btn hm-btn-view" data-car-id="">
          <i class="fas fa-eye"></i>
        </button>
        <button class="hm-action-btn hm-btn-compare" data-car-id="">
          <i class="fas fa-balance-scale"></i>
        </button>
      </div>
      <div class="hm-car-badge">
        <span class="hm-badge-text"></span>
      </div>
    </div>
    <div class="hm-car-details">
      <div class="hm-car-header">
        <h3 class="hm-car-title"></h3>
        <div class="hm-car-price"></div>
      </div>
      <div class="hm-car-specs">
        <div class="hm-spec">
          <i class="fas fa-calendar"></i>
          <span class="hm-year"></span>
        </div>
        <div class="hm-spec">
          <i class="fas fa-tachometer-alt"></i>
          <span class="hm-mileage"></span>
        </div>
        <div class="hm-spec">
          <i class="fas fa-gas-pump"></i>
          <span class="hm-fuel"></span>
        </div>
      </div>
      <div class="hm-car-footer">
        <div class="hm-car-location">
          <i class="fas fa-map-marker-alt"></i>
          <span class="hm-location"></span>
        </div>
        <div class="hm-car-auction">
          <i class="fas fa-gavel"></i>
          <span class="hm-auction-status"></span>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
/* Cars Page Styles */
.hm-cars-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 50%, #f1f5f9 100%);
}

/* Header Section */
.hm-page-header {
  background: linear-gradient(135deg, #0a192f 0%, #112240 50%, #2366d1 100%);
  color: white;
  padding: 4rem 0 3rem;
  position: relative;
  overflow: hidden;
}

.hm-page-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.03"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.03"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
  opacity: 0.3;
}

.hm-header-content {
  position: relative;
  z-index: 1;
}

.hm-page-title {
  font-size: 3rem;
  font-weight: 900;
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.hm-page-title i {
  color: #ffd700;
}

.hm-page-subtitle {
  font-size: 1.25rem;
  opacity: 0.9;
  margin: 0;
}

.hm-header-stats {
  display: flex;
  gap: 2rem;
  justify-content: flex-end;
}

.hm-stat-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16px;
  padding: 1.5rem;
  text-align: center;
  min-width: 120px;
}

.hm-stat-number {
  display: block;
  font-size: 2rem;
  font-weight: 800;
  color: #ffd700;
  margin-bottom: 0.5rem;
}

.hm-stat-label {
  font-size: 0.875rem;
  opacity: 0.8;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Filters Section */
.hm-filters-section {
  background: white;
  padding: 2rem 0;
  border-bottom: 1px solid #e2e8f0;
  position: sticky;
  top: 0;
