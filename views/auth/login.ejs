<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HM CAR - تسجيل الدخول</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 25%, #0ea5e9 50%, #1e3a8a 75%, #1e293b 100%);
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Background Effects */
        .background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: radial-gradient(ellipse at center, #0ea5e9 0%, #1e3a8a 30%, #f8fafc 60%, #ffffff 100%);
        }

        .neural-network {
            position: absolute;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 50%, rgba(248, 250, 252, 0.4) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(14, 165, 233, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 40% 20%, rgba(255, 255, 255, 0.6) 0%, transparent 50%);
            animation: neuralPulse 8s ease-in-out infinite;
        }

        @keyframes neuralPulse {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.1); }
        }

        .particles {
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(2px 2px at 20px 30px, #0ea5e9, transparent),
                radial-gradient(2px 2px at 40px 70px, #1e3a8a, transparent),
                radial-gradient(1px 1px at 50px 50px, #f8fafc, transparent),
                radial-gradient(1px 1px at 80px 10px, #ffffff, transparent),
                radial-gradient(2px 2px at 130px 80px, #0ea5e9, transparent);
            background-repeat: repeat;
            background-size: 200px 200px;
            animation: particlesFloat 20s linear infinite;
        }

        @keyframes particlesFloat {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-200px, -200px); }
        }

        .grid-lines {
            position: absolute;
            width: 100%;
            height: 100%;
            background: 
                linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 10s linear infinite;
        }

        @keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        .light-beam {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(255, 255, 255, 0.08), transparent);
            animation: beamRotate 20s linear infinite;
        }

        @keyframes beamRotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Container */
        .container {
            display: flex;
            height: 100vh;
            position: relative;
        }

        /* Brand Panel */
        .brand-panel {
            flex: 1;
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.95) 0%, rgba(14, 165, 233, 0.9) 50%, rgba(248, 250, 252, 0.85) 100%);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(248, 250, 252, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .brand-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.08), transparent);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { transform: translateX(-100%); }
            50% { transform: translateX(100%); }
        }

        .brand-content {
            max-width: 500px;
            width: 100%;
            z-index: 1;
            position: relative;
        }

        /* Top Bar */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
        }

        .badge {
            background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 100%);
            color: #0a192f;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.3);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .home-btn, .lang-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            padding: 0.75rem 1rem;
            border-radius: 25px;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .home-btn:hover, .lang-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
            color: #ffffff;
        }

        /* Logo Section */
        .logo-section {
            text-align: center;
            margin-bottom: 3rem;
        }

        .logo-container {
            position: relative;
            display: inline-block;
            margin-bottom: 2rem;
        }

        .logo-ring {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 150px;
            height: 150px;
            border: 2px solid transparent;
            border-radius: 50%;
            background: linear-gradient(45deg, #ffffff, #e2e8f0, #ffffff);
            background-size: 300% 300%;
            animation: ringRotate 3s linear infinite;
            z-index: -1;
        }

        .logo-pulse {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 180px;
            height: 180px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
            z-index: -2;
        }

        @keyframes ringRotate {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }

        @keyframes pulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.3; }
            50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.1; }
        }

        .logo {
            width: 120px;
            height: 120px;
            object-fit: contain;
            filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.5));
        }

        .brand-title {
            font-size: 3rem;
            font-weight: 900;
            color: #ffffff;
            margin-bottom: 1rem;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
            background: linear-gradient(45deg, #ffffff, #e2e8f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-subtitle {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.1rem;
            line-height: 1.6;
        }

        .english-text {
            color: #e2e8f0;
            font-size: 0.9rem;
        }

        /* Features */
        .features {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
            transition: left 0.5s ease;
        }

        .feature-card:hover::before {
            left: 100%;
        }

        .feature-card:hover {
            transform: translateX(10px);
            border-color: rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.15);
        }

        .feature-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 100%);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0a192f;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .feature-content h3 {
            color: #ffffff;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .feature-content p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
        }

        /* Stats */
        .stats {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
        }

        .stat-item {
            text-align: center;
            flex: 1;
        }

        .stat-number {
            display: block;
            font-size: 1.8rem;
            font-weight: 900;
            color: #ffffff;
            margin-bottom: 0.25rem;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Login Panel */
        .login-panel {
            flex: 1;
            background: transparent;
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
        }

        .login-card {
            background: linear-gradient(135deg, rgba(248, 250, 252, 0.95) 0%, rgba(255, 255, 255, 0.9) 50%, rgba(240, 249, 255, 0.95) 100%);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 3rem;
            max-width: 450px;
            width: 100%;
            box-shadow: 
                0 25px 50px rgba(14, 165, 233, 0.15),
                0 15px 35px rgba(30, 58, 138, 0.1),
                0 5px 15px rgba(0, 0, 0, 0.05),
                inset 0 1px 0 rgba(255, 255, 255, 0.9),
                inset 0 -1px 0 rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(248, 250, 252, 0.5);
            transform: perspective(1000px) rotateY(0deg) rotateX(2deg);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(248, 250, 252, 0.8), transparent);
            animation: cardShimmer 3s ease-in-out infinite;
        }

        .login-card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(14, 165, 233, 0.03), transparent);
            animation: cardRotate 20s linear infinite;
            pointer-events: none;
        }

        @keyframes cardShimmer {
            0%, 100% { opacity: 0.3; transform: translateX(-100%); }
            50% { opacity: 0.8; transform: translateX(100%); }
        }

        @keyframes cardRotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .login-card:hover {
            transform: perspective(1000px) rotateY(2deg) rotateX(0deg) translateY(-5px);
            box-shadow: 
                0 35px 70px rgba(14, 165, 233, 0.2),
                0 20px 40px rgba(30, 58, 138, 0.15),
                0 8px 20px rgba(0, 0, 0, 0.08),
                inset 0 1px 0 rgba(255, 255, 255, 0.95),
                inset 0 -1px 0 rgba(0, 0, 0, 0.03);
        }

        .login-content {
            position: relative;
            z-index: 1;
        }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 2.5rem;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.08) 0%, rgba(248, 250, 252, 0.12) 100%);
            padding: 0.75rem;
            border-radius: 20px;
            border: 1px solid rgba(14, 165, 233, 0.15);
            box-shadow: 
                0 4px 15px rgba(14, 165, 233, 0.08),
                inset 0 1px 0 rgba(255, 255, 255, 0.5);
        }

        .tab {
            flex: 1;
            padding: 1.25rem 1rem;
            background: transparent;
            border: none;
            border-radius: 15px;
            color: rgba(30, 58, 138, 0.7);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transform: perspective(50px) rotateX(2deg);
            position: relative;
            overflow: hidden;
        }

        .tab::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(248, 250, 252, 0.3), transparent);
            transition: left 0.5s ease;
        }

        .tab:hover::before {
            left: 100%;
        }

        .tab:hover {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.15) 0%, rgba(248, 250, 252, 0.2) 100%);
            color: #1e3a8a;
            transform: perspective(50px) rotateX(0deg) translateY(-1px);
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1);
        }

        .tab.active {
            background: linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%);
            color: #ffffff;
            box-shadow: 
                0 6px 20px rgba(14, 165, 233, 0.3),
                0 3px 10px rgba(30, 58, 138, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.3),
                inset 0 -1px 0 rgba(0, 0, 0, 0.1);
            transform: perspective(50px) rotateX(0deg) translateY(-2px);
            border: 1px solid rgba(248, 250, 252, 0.3);
        }

        /* Form */
        .form-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .title {
            font-size: 2rem;
            font-weight: 800;
            color: #1e3a8a;
            margin-bottom: 0.5rem;
            background: linear-gradient(45deg, #1e3a8a, #0ea5e9, #64748b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 2px 10px rgba(14, 165, 233, 0.2);
        }

        .subtitle {
            color: rgba(30, 58, 138, 0.7);
            font-size: 1rem;
            line-height: 1.5;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-label {
            display: block;
            color: #1e3a8a;
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .input-wrapper {
            position: relative;
        }

        .input {
            width: 100%;
            padding: 1rem 3rem 1rem 1rem;
            background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%);
            border: 2px solid rgba(14, 165, 233, 0.2);
            border-radius: 15px;
            color: #1e3a8a;
            font-size: 1rem;
            transition: all 0.3s ease;
            box-shadow: 
                0 4px 15px rgba(14, 165, 233, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.8),
                inset 0 -1px 0 rgba(0, 0, 0, 0.05);
            transform: perspective(50px) rotateX(2deg);
        }

        .input::placeholder {
            color: rgba(30, 58, 138, 0.4);
        }

        .input:focus {
            outline: none;
            border-color: #0ea5e9;
            background: linear-gradient(135deg, rgba(248, 250, 252, 0.95) 0%, rgba(255, 255, 255, 0.98) 100%);
            box-shadow: 
                0 0 20px rgba(14, 165, 233, 0.3),
                0 4px 15px rgba(14, 165, 233, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.9),
                inset 0 -1px 0 rgba(0, 0, 0, 0.02);
            transform: perspective(50px) rotateX(0deg);
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(30, 58, 138, 0.4);
            font-size: 1rem;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(30, 58, 138, 0.4);
            cursor: pointer;
            font-size: 1rem;
            transition: color 0.3s ease;
        }

        .password-toggle:hover {
            color: #0ea5e9;
        }

        /* Options */
        .options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #1e3a8a;
            font-size: 0.9rem;
            cursor: pointer;
        }

        .checkbox {
            display: none;
        }

        .checkbox-custom {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(14, 165, 233, 0.3);
            border-radius: 5px;
            position: relative;
            transition: all 0.3s ease;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
        }

        .checkbox:checked + .checkbox-custom {
            background: linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%);
            border-color: #0ea5e9;
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        .checkbox:checked + .checkbox-custom::after {
            content: '✓';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #ffffff;
            font-weight: bold;
        }

        .link {
            color: #1e3a8a;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

        .link:hover {
            color: #0ea5e9;
        }

        /* Buttons */
        .btn {
            width: 100%;
            padding: 1rem 2rem;
            border: none;
            border-radius: 15px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 50%, #0284c7 100%);
            color: #ffffff;
            box-shadow: 
                0 8px 25px rgba(14, 165, 233, 0.4),
                0 4px 15px rgba(30, 58, 138, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.3),
                inset 0 -1px 0 rgba(0, 0, 0, 0.2);
            border: 2px solid rgba(248, 250, 252, 0.3);
            transform: perspective(100px) rotateX(10deg) translateY(0);
            position: relative;
            overflow: hidden;
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(248, 250, 252, 0.4), transparent);
            transition: left 0.5s ease;
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%, rgba(0, 0, 0, 0.1) 100%);
            border-radius: inherit;
        }

        .btn-primary:hover::before {
            left: 100%;
        }

        .btn-primary:hover {
            transform: perspective(100px) rotateX(0deg) translateY(-5px);
            box-shadow: 
                0 15px 35px rgba(14, 165, 233, 0.5),
                0 8px 25px rgba(30, 58, 138, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.4),
                inset 0 -1px 0 rgba(0, 0, 0, 0.1);
            border-color: rgba(248, 250, 252, 0.5);
        }

        .btn-primary:active {
            transform: perspective(100px) rotateX(5deg) translateY(-2px);
            box-shadow: 
                0 5px 15px rgba(14, 165, 233, 0.3),
                0 2px 8px rgba(30, 58, 138, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.2),
                inset 0 -1px 0 rgba(0, 0, 0, 0.3);
        }

        .btn-icon {
            transition: transform 0.3s ease;
        }

        .btn-primary:hover .btn-icon {
            transform: translateX(-5px);
        }

        /* Divider */
        .divider {
            text-align: center;
            margin: 2rem 0;
            position: relative;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(10, 25, 47, 0.1);
        }

        .divider span {
            background: rgba(255, 255, 255, 0.95);
            color: rgba(10, 25, 47, 0.4);
            padding: 0 1rem;
            font-size: 0.9rem;
        }

        /* Social Login */
        .social-login {
            display: flex;
            gap: 0.75rem;
        }

        .social-btn {
            flex: 1;
            padding: 1rem;
            background: linear-gradient(135deg, rgba(248, 250, 252, 0.8) 0%, rgba(255, 255, 255, 0.9) 100%);
            border: 1px solid rgba(14, 165, 233, 0.15);
            border-radius: 15px;
            color: rgba(30, 58, 138, 0.7);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: 
                0 2px 8px rgba(14, 165, 233, 0.08),
                inset 0 1px 0 rgba(255, 255, 255, 0.8);
            transform: perspective(50px) rotateX(2deg);
            position: relative;
            overflow: hidden;
        }

        .social-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(248, 250, 252, 0.4), transparent);
            transition: left 0.5s ease;
        }

        .social-btn:hover::before {
            left: 100%;
        }

        .social-btn:hover {
            transform: perspective(50px) rotateX(0deg) translateY(-2px);
            box-shadow: 
                0 4px 15px rgba(14, 165, 233, 0.15),
                0 2px 8px rgba(30, 58, 138, 0.1),
