<div class="hm-card hm-card-elevated">
    <a href="/cars/<%= car._id %>" class="hm-card-link">
        <div class="hm-card-image-container">
            <% if (car.images && car.images.length > 0) { %>
                <img src="<%= car.images[0] %>" alt="<%= car.title %>" class="hm-card-image" loading="lazy">
            <% } else { %>
                <div class="hm-image-placeholder">
                    <i class="fas fa-car hm-icon hm-icon-xl hm-icon-muted"></i>
                    <span>لا توجد صورة</span>
                </div>
            <% } %>
            <div class="hm-card-overlay">
                <% if (car.isSold) { %>
                    <span class="hm-badge hm-badge-danger">تم البيع</span>
                <% } else if (car.listingType === 'auction') { %>
                    <span class="hm-badge hm-badge-warning">مزاد</span>
                <% } else { %>
                    <span class="hm-badge hm-badge-success">متوفر</span>
                <% } %>
            </div>
        </div>
        <div class="hm-card-content">
            <div class="hm-card-title-make">
                <% if (car.makeLogoUrl) { %>
                    <img src="<%= car.makeLogoUrl %>" alt="<%= car.make %>" class="hm-make-logo">
                <% } %>
                <h3 class="hm-card-title"><%= car.title %></h3>
            </div>
            <p class="hm-card-model"><%= car.make %> <%= car.model %></p>
            <div class="hm-card-specs">
                <span class="hm-spec-item">
                    <i class="fas fa-calendar-alt hm-icon hm-icon-sm hm-icon-muted"></i>
                    <%= car.year || 'N/A' %>
                </span>
                <span class="hm-spec-item">
                    <i class="fas fa-tachometer-alt hm-icon hm-icon-sm hm-icon-muted"></i>
                    <%= car.mileage ? car.mileage.toLocaleString() + ' كم' : 'N/A' %>
                </span>
            </div>
            <div class="hm-card-price">
                <% if (car.priceSar) { %>
                    <strong><%= car.priceSar.toLocaleString() %> ريال</strong>
                <% } else if (car.price) { %>
                    <strong><%= car.price.toLocaleString() %> ريال</strong>
                <% } else { %>
                    <strong>السعر عند الطلب</strong>
                <% } %>
            </div>
        </div>
    </a>
    <div class="hm-card-actions">
        <a href="/cars/<%= car._id %>" class="hm-btn hm-btn-primary hm-btn-sm">
            <i class="fas fa-eye"></i> التفاصيل
        </a>
        <% if (currentUser && currentUser.role === 'buyer' && !car.isSold) { %>
            <button class="hm-btn hm-btn-outline hm-btn-icon" data-car-id="<%= car._id %>" onclick="toggleFavorite(this)">
                <i class="far fa-heart hm-icon hm-icon-sm"></i>
            </button>
        <% } %>
    </div>
</div>

<script>
function toggleFavorite(button) {
    const carId = button.getAttribute('data-car-id');
    const icon = button.querySelector('i');
    
    // تبديل بين أيقونة القلب الممتلئ والفارغ
    if (icon.classList.contains('fa-heart')) {
        icon.className = 'far fa-heart hm-icon hm-icon-sm';
    } else {
        icon.className = 'fas fa-heart hm-icon hm-icon-sm hm-icon-danger';
    }
    
    // في الواقع، يجب إرسال طلب إلى الخادم لحفظ التفضيل
    // هذا فقط للعرض التفاعلي
}
</script>
