<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'hm-admin-page'; %>

<link rel="stylesheet" href="/css/admin-luxury.css">

<div class="hm-admin-layout">
  <!-- Animated Background -->
  <div class="hm-admin-bg">
    <div class="hm-admin-bg-gradient"></div>
    <div class="hm-admin-bg-glow"></div>
  </div>

  <!-- Mobile Toggle -->
  <button class="hm-mobile-toggle" onclick="toggleSidebar()">
    <i class="fas fa-bars"></i>
  </button>

  <!-- Sidebar -->
  <%- include('../partials/admin-sidebar') %>

  <!-- Main Content -->
  <main class="hm-admin-main">
    <!-- Header -->
    <header class="hm-admin-header">
      <div class="hm-header-title">
        <h1>إدارة السيارات</h1>
        <div class="hm-header-breadcrumb">
          <a href="/admin">لوحة التحكم</a>
          <i class="fas fa-chevron-left"></i>
          <span>السيارات</span>
        </div>
      </div>
      <div class="hm-header-actions">
        <a href="/cars/new" class="hm-btn-admin hm-btn-admin-primary">
          <i class="fas fa-plus"></i>
          إضافة سيارة
        </a>
      </div>
    </header>

    <!-- Content -->
    <div class="hm-admin-content">
      <!-- Flash Messages -->
      <% if (flash && flash.message) { %>
      <div class="hm-admin-alert hm-admin-alert-<%= flash.type || 'info' %>">
        <i class="fas <%= flash.type === 'success' ? 'fa-check-circle' : flash.type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle' %>"></i>
        <span><%= flash.message %></span>
      </div>
      <% } %>

      <!-- Stats -->
      <div class="hm-stats-grid">
        <div class="hm-stat-card">
          <div class="hm-stat-icon">
            <i class="fas fa-car"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">إجمالي السيارات</div>
            <div class="hm-stat-value"><%= pagination?.total || (cars ? cars.length : 0) %></div>
          </div>
        </div>
        <div class="hm-stat-card">
          <div class="hm-stat-icon success">
            <i class="fas fa-check-circle"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">متاحة للبيع</div>
            <div class="hm-stat-value"><%= cars ? cars.filter(c => !c.isSold).length : 0 %></div>
          </div>
        </div>
        <div class="hm-stat-card">
          <div class="hm-stat-icon warning">
            <i class="fas fa-shopping-cart"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">تم بيعها</div>
            <div class="hm-stat-value"><%= cars ? cars.filter(c => c.isSold).length : 0 %></div>
          </div>
        </div>
      </div>

      <!-- Filter Card -->
      <div class="hm-admin-card">
        <div class="hm-card-header">
          <h2 class="hm-card-title">
            <i class="fas fa-filter"></i>
            تصفية وبحث
          </h2>
        </div>
        <div class="hm-card-body">
          <form method="GET" action="/admin/cars" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
            <div class="hm-admin-form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
              <label class="hm-admin-label">البحث</label>
              <input type="text" name="q" class="hm-admin-input" placeholder="ابحث بالاسم أو الموديل..." value="<%= filters?.q || '' %>">
            </div>
            <div class="hm-admin-form-group" style="min-width: 150px; margin-bottom: 0;">
              <label class="hm-admin-label">الماركة</label>
              <input type="text" name="make" class="hm-admin-input" placeholder="الماركة" value="<%= filters?.make || '' %>">
            </div>
            <div class="hm-admin-form-group" style="min-width: 150px; margin-bottom: 0;">
              <label class="hm-admin-label">الحالة</label>
              <select name="status" class="hm-admin-input">
                <option value="">الكل</option>
                <option value="available" <%= filters?.status === 'available' ? 'selected' : '' %>>متاحة</option>
                <option value="sold" <%= filters?.status === 'sold' ? 'selected' : '' %>>مباعة</option>
              </select>
            </div>
            <button type="submit" class="hm-btn-admin hm-btn-admin-primary">
              <i class="fas fa-search"></i>
              بحث
            </button>
            <a href="/admin/cars" class="hm-btn-admin hm-btn-admin-secondary">
              <i class="fas fa-redo"></i>
              إعادة تعيين
            </a>
          </form>
        </div>
      </div>

      <!-- Cars List -->
      <div class="hm-admin-card">
        <div class="hm-card-header">
          <h2 class="hm-card-title">
            <i class="fas fa-car"></i>
            قائمة السيارات
          </h2>
          <span class="hm-admin-badge hm-admin-badge-primary">
            <%= pagination?.total || (cars ? cars.length : 0) %> سيارة
          </span>
        </div>
        <div class="hm-card-body" style="padding: 0;">
          <% if (cars && cars.length > 0) { %>
          <table class="hm-admin-table">
            <thead>
              <tr>
                <th>السيارة</th>
                <th>الماركة / الموديل</th>
                <th>السعر</th>
                <th>الحالة</th>
                <th>إجراءات</th>
              </tr>
            </thead>
            <tbody>
              <% cars.forEach(function(car) { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <% if (car.images && car.images.length > 0) { %>
                    <img src="<%= car.images[0] %>" alt="<%= car.title %>" style="width: 60px; height: 45px; object-fit: cover; border-radius: 8px;">
                    <% } else { %>
                    <div style="width: 60px; height: 45px; background: var(--hm-glass-bg); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                      <i class="fas fa-car" style="color: var(--hm-gray);"></i>
                    </div>
                    <% } %>
                    <div>
                      <div style="color: var(--hm-white); font-weight: 600;">
                        <%= car.title || (car.make + ' ' + car.model) %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--hm-gray);">
                        <%= car.year || '-' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div><%= car.make || '-' %></div>
                  <div style="font-size: 0.8rem; color: var(--hm-gray);"><%= car.model || '-' %></div>
                </td>
                <td>
                  <div style="color: var(--hm-blue-light); font-weight: 700;">
                    <% if (car.priceSar) { %>
                      <%= car.priceSar.toLocaleString('ar-SA') %> ريال
                    <% } else if (car.price) { %>
                      <%= car.price.toLocaleString('ar-SA') %> ريال
                    <% } else { %>
                      -
                    <% } %>
                  </div>
                </td>
                <td>
                  <% if (car.isSold) { %>
                  <span class="hm-admin-badge hm-admin-badge-danger">
                    <i class="fas fa-check"></i> مباعة
                  </span>
                  <% } else if (car.isActive === false) { %>
                  <span class="hm-admin-badge hm-admin-badge-warning">
                    <i class="fas fa-eye-slash"></i> غير مفعلة
                  </span>
                  <% } else { %>
                  <span class="hm-admin-badge hm-admin-badge-success">
                    <i class="fas fa-check-circle"></i> متاحة
                  </span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <a href="/cars/<%= car._id %>" class="hm-btn-admin hm-btn-admin-secondary hm-btn-admin-sm" title="عرض">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a href="/cars/<%= car._id %>/edit" class="hm-btn-admin hm-btn-admin-primary hm-btn-admin-sm" title="تعديل">
                      <i class="fas fa-edit"></i>
                    </a>
                    <form method="POST" action="/admin/cars/<%= car._id %>/toggle-active" style="display: inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="hm-btn-admin hm-btn-admin-secondary hm-btn-admin-sm" title="<%= car.isActive ? 'إلغاء التفعيل' : 'تفعيل' %>">
                        <i class="fas fa-<%= car.isActive !== false ? 'eye-slash' : 'eye' %>"></i>
                      </button>
                    </form>
                    <% if (!car.isSold) { %>
                    <form method="POST" action="/cars/<%= car._id %>/delete" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من حذف هذه السيارة؟')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="hm-btn-admin hm-btn-admin-danger hm-btn-admin-sm" title="حذف">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="hm-empty-state">
            <div class="hm-empty-icon">
              <i class="fas fa-car"></i>
            </div>
            <h3 class="hm-empty-title">لا توجد سيارات</h3>
            <p class="hm-empty-text">لم يتم إضافة أي سيارات بعد</p>
            <a href="/cars/new" class="hm-btn-admin hm-btn-admin-primary" style="margin-top: 1rem;">
              <i class="fas fa-plus"></i>
              إضافة سيارة جديدة
            </a>
          </div>
          <% } %>
        </div>

        <% if (pagination && pagination.totalPages > 1) { %>
        <div class="hm-card-footer">
          <div style="display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
            <% if (pagination.currentPage > 1) { %>
            <a href="/admin/cars?page=<%= pagination.currentPage - 1 %>&q=<%= filters?.q || '' %>&make=<%= filters?.make || '' %>&status=<%= filters?.status || '' %>" class="hm-btn-admin hm-btn-admin-secondary hm-btn-admin-sm">
              <i class="fas fa-chevron-right"></i>
            </a>
            <% } %>
            
            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <a href="/admin/cars?page=<%= i %>&q=<%= filters?.q || '' %>&make=<%= filters?.make || '' %>&status=<%= filters?.status || '' %>" 
               class="hm-btn-admin <%= i === pagination.currentPage ? 'hm-btn-admin-primary' : 'hm-btn-admin-secondary' %> hm-btn-admin-sm">
              <%= i %>
            </a>
            <% } %>
            
            <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="/admin/cars?page=<%= pagination.currentPage + 1 %>&q=<%= filters?.q || '' %>&make=<%= filters?.make || '' %>&status=<%= filters?.status || '' %>" class="hm-btn-admin hm-btn-admin-secondary hm-btn-admin-sm">
              <i class="fas fa-chevron-left"></i>
            </a>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script>
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  sidebar.classList.toggle('open');
}

document.addEventListener('click', function(e) {
  const sidebar = document.getElementById('adminSidebar');
  const toggle = document.querySelector('.hm-mobile-toggle');
  
  if (window.innerWidth <= 1024) {
    if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
      sidebar.classList.remove('open');
    }
  }
});
</script>
