<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-dashboard-luxury'; %>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="إدارة المستخدمين">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title">إدارة المستخدمين</h1>
            <div class="hm-hero__subtitle">إدارة جميع الحسابات والصلاحيات بكل فخامة</div>
          </div>
        </div>

        <nav class="hm-hero__actions" aria-label="إجراءات">
          <a class="hm-pill" href="/admin" aria-label="رجوع للوحة الإدارة"><i class="fas fa-arrow-right"></i><span>لوحة الإدارة</span></a>
          <a class="hm-pill" href="/admin/users-management" aria-label="إدارة المشرفين"><i class="fas fa-user-shield"></i><span>المشرفين</span></a>
          <a class="hm-pill hm-pill--danger" href="/auth/logout" aria-label="خروج"><i class="fas fa-sign-out-alt"></i><span>خروج</span></a>
        </nav>
      </div>

      <section class="hm-kpis" aria-label="إحصائيات">
        <div class="hm-kpi">
          <div class="hm-kpi__row">
            <div>
              <div class="hm-kpi__label">عدد المستخدمين</div>
              <div class="hm-kpi__value"><%= Array.isArray(users) ? users.length : 0 %></div>
            </div>
            <div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-users"></i></div>
          </div>
        </div>
        <div class="hm-kpi">
          <div class="hm-kpi__row">
            <div>
              <div class="hm-kpi__label">صلاحيات الأدمن</div>
              <div class="hm-kpi__value">ON</div>
            </div>
            <div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-shield-alt"></i></div>
          </div>
        </div>
        <div class="hm-kpi hm-kpi--security">
          <div class="hm-kpi__row">
            <div>
              <div class="hm-kpi__label">الأمان</div>
              <div class="hm-kpi__value">CSRF</div>
            </div>
            <div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-lock"></i></div>
          </div>
        </div>
        <div class="hm-kpi">
          <div class="hm-kpi__row">
            <div>
              <div class="hm-kpi__label">الإشعارات</div>
              <div class="hm-kpi__value"><%= Number(adminNewNotificationsCount || 0) %></div>
            </div>
            <div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-bell"></i></div>
          </div>
        </div>
      </section>
    </header>

    <% if (flash && flash.message) { %>
      <div class="mt-3">
        <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% } %>

    <section class="hm-section" aria-label="قائمة المستخدمين">
      <h2 class="hm-section__title">قائمة المستخدمين</h2>
      <div class="hm-list">
        <% if (users && users.length) { %>
          <% users.forEach(function(u){ %>
            <div class="hm-list__item">
              <div>
                <h3 class="hm-list__title"><%= u.name || 'مستخدم' %></h3>
                <div class="hm-list__meta"><%= u.email || '' %><%= u.phone ? (' - ' + u.phone) : '' %></div>
              </div>
              <span class="hm-chip"><i class="fas fa-user"></i><span><%= u.role || 'user' %></span></span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="hm-list__item">
            <div>
              <h3 class="hm-list__title">لا يوجد مستخدمون</h3>
              <div class="hm-list__meta">سيظهر المستخدمون هنا بعد التسجيل</div>
            </div>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</div>
