<!-- [[ARABIC_HEADER]] هذا الملف (views/cars/brands.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<!-- صفحة عرض الشركات (الماركات): تعرض قائمة شركات متاحة مع الشعار وتتيح التصفية على قائمة السيارات -->
<% const _brands = brands || []; %>
<% const _banners = customerBanners || []; %>

<% if (_banners.length) { %>
  <!-- بنرات/إعلانات العملاء: Carousel يظهر أعلى الصفحة (إن وُجدت بنرات) -->
  <div id="customerBannersCarousel" class="carousel slide mb-3" data-bs-ride="carousel">
    <div class="carousel-inner rounded overflow-hidden">
      <% _banners.forEach((b, idx) => { %>
        <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
          <% if (b.linkUrl) { %>
            <!-- لو كان للبانر رابط: نجعل الصورة قابلة للنقر -->
            <a href="<%= b.linkUrl %>" class="d-block text-decoration-none">
              <img src="<%= b.imageUrl %>" class="d-block w-100 hm-banner-img" alt="banner" loading="lazy" decoding="async" />
            </a>
          <% } else { %>
            <img src="<%= b.imageUrl %>" class="d-block w-100 hm-banner-img" alt="banner" />
          <% } %>
          <% if (b.title) { %>
            <div class="carousel-caption d-none d-md-block">
              <h5><%= b.title %></h5>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
    <% if (_banners.length > 1) { %>
      <!-- أزرار السابق/التالي تظهر فقط إذا كان هناك أكثر من بانر -->
      <button class="carousel-control-prev" type="button" data-bs-target="#customerBannersCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#customerBannersCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    <% } %>
  </div>
<% } %>

<div class="d-flex flex-column align-items-start gap-1 mb-3">
  <h3 class="mb-0">الشركات</h3>
  <div class="text-muted">اختر شركة السيارة بالشعار أو الاسم لعرض السيارات المتوفرة.</div>
</div>

<% if (!_brands.length) { %>
  <!-- حالة عدم وجود شركات: عادة لأن السيارات لم تُضف بعد أو لا يوجد make محفوظ -->
  <div class="card border-0 shadow-sm">
    <div class="card-body py-5 text-center">
      <h5 class="mb-2">لا توجد شركات حالياً</h5>
      <div class="text-muted mb-3">أضف سيارات من لوحة الأدمن لتظهر الشركات هنا.</div>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a class="btn btn-primary" href="/cars/new">إضافة سيارة</a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <!-- شبكة الشركات: كل مربع يمثل شركة واحدة، والضغط يفتح قائمة السيارات مع فلتر make -->
  <div class="row g-3">
    <% _brands.forEach(b => { %>
      <!-- تجهيز رابط الشعار لاستخدامه كخلفية watermark داخل CSS (مع ترميز آمن) -->
      <% const _logoCssUrl = b.logoUrl ? encodeURI(String(b.logoUrl)).replace(/'/g, '%27') : ''; %>
      <div class="col-6 col-md-4 col-lg-3">
        <a class="hm-brand-tile" href="/cars/list?make=<%= encodeURIComponent(b.make) %>" aria-label="<%= b.make %>">
          <div class="hm-brand-tile__inner" <%- _logoCssUrl ? `style="--hm-brand-watermark: url('${_logoCssUrl}')"` : '' %>>
            <div class="hm-brand-tile__logo" aria-hidden="true">
              <% if (b.logoUrl) { %>
                <!-- إذا توفر شعار: نعرض صورة الشعار -->
                <img src="<%= b.logoUrl %>" alt="" width="48" height="48" loading="lazy" decoding="async" class="hm-brand-logo-img" />
              <% } else { %>
                <!-- بديل الشعار: أول حرفين من اسم الشركة -->
                <span><%= String(b.make || '').trim().slice(0, 2).toUpperCase() || 'C' %></span>
              <% } %>
            </div>
            <div class="hm-brand-tile__name"><%= b.make %></div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>
