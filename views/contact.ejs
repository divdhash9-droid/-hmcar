<% layout('layout') -%>

<section class="contact-hero">
    <div class="container">
        <h1><%= __('contact.title') %></h1>
        <p><%= __('contact.subtitle') %></p>
    </div>
</section>

<section class="contact-content">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-form">
                <h2><%= __('contact.send_message') %></h2>
                <form action="/contact" method="POST">
                    <div class="form-group">
                        <label for="name"><%= __('contact.full_name') %></label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email"><%= __('contact.email') %></label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="subject"><%= __('contact.subject') %></label>
                        <input type="text" id="subject" name="subject" required>
                    </div>
                    <div class="form-group">
                        <label for="message"><%= __('contact.message') %></label>
                        <textarea id="message" name="message" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="cta-button"><%= __('contact.send') %></button>
                </form>
            </div>
            <div class="contact-info">
                <h2><%= __('contact.get_in_touch') %></h2>
                <div class="info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <h4><%= __('contact.address') %></h4>
                        <p>123 Car Auction Street<br>Auto City, AC 12345</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-phone"></i>
                    <div>
                        <h4><%= __('contact.phone') %></h4>
                        <p>+1 (555) 123-4567</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-envelope"></i>
                    <div>
                        <h4>Email</h4>
                        <p>info@caraauction.com</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <h4><%= __('contact.business_hours') %></h4>
                        <p>Mon - Fri: 9:00 AM - 6:00 PM<br>Sat: 10:00 AM - 4:00 PM</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>