  }
  
  .advanced-search-actions {
    padding: 16px 20px;
  }
  
  .popular-searches {
    padding: 16px 20px;
  }
  
  .floating-search-btn {
    width: 48px;
    height: 48px;
    top: 15px;
    right: 15px;
  }
  
  .search-tooltip {
    display: none;
  }
}

