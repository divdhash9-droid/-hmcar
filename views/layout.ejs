<!-- views/layout.ejs -->
<!--
  ملف التخطيط العام (Layout):
  - يحتوي الـ<head> المشترك (خطوط، أنماط، سكربتات) وفتحة الـ<body> العامة.
  - يستخدم لتغليف صفحات التطبيق عبر ejs-mate (layout('layout')).
  - يقدّم متغيرات عامة في `res.locals` مثل `currentUser`, `csrfToken`, و `adminNewNotificationsCount`.
  - ملاحظة: قم بتعديل الأنماط الحساسة هنا بعناية لأن بعضها مضمن inline لأغراض التوافر عند حجب CDN.
-->
<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <!-- SEO Head -->
  <%- include('partials/seo-head-fixed') %>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Montserrat:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <% var isAdminPage = !!(typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'super_admin' || currentUser.role === 'manager') && (
    ((typeof bodyClass !== 'undefined' && bodyClass) && (String(bodyClass).indexOf('admin-dashboard-luxury') !== -1 || String(bodyClass).indexOf('modern-admin-dashboard') !== -1 || String(bodyClass).indexOf('admin-body') !== -1 || String(bodyClass).indexOf('admin-modern-grid') !== -1)) ||
    ((currentUrl || '').startsWith('/admin'))
  )); %>

  <!-- Stylesheets -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/public/css/modern-design.css?v=<%= Date.now() %>" rel="stylesheet">
  <link href="/public/css/header-modern.css?v=<%= Date.now() %>" rel="stylesheet">
  <link href="/public/css/footer-modern.css?v=<%= Date.now() %>" rel="stylesheet">
  <link href="/public/css/rtl-support.css?v=<%= Date.now() %>" rel="stylesheet">
  <link href="/public/css/modern-auth.css?v=<%= Date.now() %>" rel="stylesheet">

  <% if (typeof bodyClass !== 'undefined' && bodyClass === 'admin-modern-grid') { %>
    <link href="/public/css/admin-modern-grid.css?v=<%= Date.now() %>" rel="stylesheet">
    <link href="/public/css/admin-modern-grid-sidebar.css?v=<%= Date.now() %>" rel="stylesheet">
  <% } else if (isAdminPage) { %>
    <link href="/public/css/admin-enhancements.css?v=<%= Date.now() %>" rel="stylesheet">
    <link href="/public/css/admin-ultra.css?v=<%= Date.now() %>" rel="stylesheet">
  <% } %>
  <link rel="manifest" href="/public/manifest.json">
  
</head>

<body class="<%= (typeof bodyClass !== 'undefined' && bodyClass) ? bodyClass : '' %>">
  <a class="skip-link" href="#main-content"><%= __('accessibility.skipToContent') %></a>
  
  <% if (!isAdminPage && !(typeof isEmbed !== 'undefined' && isEmbed) && !(typeof hideNavbar !== 'undefined' && hideNavbar)) { %>
    <%- include('partials/header-modern', { user: typeof currentUser !== 'undefined' ? currentUser : null }) %>
  <% } %>

  <main id="main-content">
      <% if (!(typeof isEmbed !== 'undefined' && isEmbed) && typeof flash !== 'undefined' && flash && flash.message) { %>
        <div class="container mt-4">
          <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
            <%= flash.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      <% } %>
      <%- body %>
  </main>

  <% if (!isAdminPage && !(typeof isEmbed !== 'undefined' && isEmbed)) { %>
    <%- include('partials/footer-modern') %>
  <% } %>

  <!-- Chat Components, Scripts, etc. -->
  <%- include('partials/chat-sidebar') %>
  <%- include('partials/chat-window') %>
  <%- include('partials/notification-center') %>
  <%- include('partials/payment-form') %>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/public/js/chat.js"></script>
  <script src="/public/js/language-switcher.js"></script>
  <script src="/public/js/notifications.js"></script>
  <script src="/public/js/payment.js"></script>
  <script src="/public/js/countdown.js"></script>
  
  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/public/js/admin-dashboard.js"></script>
  <% } %>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/public/sw.js')
          .then(reg => console.log('Service Worker Registered!', reg))
          .catch(err => console.error('Service Worker Registration Failed:', err));
      });
    }
  </script>
</body>
</html>