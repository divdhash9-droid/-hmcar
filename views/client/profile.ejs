<div class="hm-pro-home">
  <!-- Unified Hero and Content Section -->
  <section class="hm-hero-unified">
    <div class="hm-hero__content">
      <!-- Profile Header Card -->
      <div class="profile-header-card">
        <div class="profile-avatar-section">
          <div id="profileAvatarWrap">
            <% if (currentUser.avatar) { %>
              <img id="profileAvatarImg" src="<%= currentUser.avatar %>" alt="صورة الملف الشخصي" style="width:100%; height:100%; object-fit:cover;" />
            <% } else { %>
              <div id="profileAvatarFallback" style="font-size: 2.5rem; color: white; font-weight: bold;">
                <%= currentUser.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
          </div>
          <div class="profile-info">
            <h1>مرحباً، <%= currentUser.name %></h1>
            <p>العضو منذ: <%= new Date(currentUser.createdAt).toLocaleDateString('ar-SA') %></p>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="profile-nav-tabs">
          <button class="hm-tab-btn active" onclick="showTab('profile')">
            <i class="fas fa-user"></i> الملف الشخصي
          </button>
          <button class="hm-tab-btn" onclick="showTab('security')">
            <i class="fas fa-shield-alt"></i> الأمان
          </button>
        </nav>
      </div>

      <!-- Profile Tab Content -->
      <div id="profile-tab" class="hm-tab-content" style="display: block;">
        <h2>
          <i class="fas fa-user-circle"></i>
          <span>معلومات الحساب</span>
        </h2>

        <!-- Profile Picture Section -->
        <div style="text-align: center; margin-bottom: 2rem;">
          <div id="profileAvatarWrap" style="width: 120px; height: 120px; margin: 0 auto 1rem; border-radius: 50%; background: linear-gradient(135deg, #0ea5e9, #1e3a8a); display: flex; align-items: center; justify-content: center; overflow: hidden; box-shadow: 0 8px 25px rgba(14, 165, 233, 0.3), 0 4px 15px rgba(30, 58, 138, 0.2); border: 3px solid rgba(248, 250, 252, 0.5); transition: all 0.3s ease; position: relative;">
            <% if (currentUser.avatar) { %>
              <img id="profileAvatarImg" src="<%= currentUser.avatar %>" alt="صورة الملف الشخصي" style="width:100%; height:100%; object-fit:cover;" />
            <% } else { %>
              <div id="profileAvatarFallback" style="font-size: 3rem; color: white; font-weight: bold;">
                <%= currentUser.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
          </div>
          <h3 style="color: #1e3a8a; font-size: 1.5rem; font-weight: 700; margin: 0.5rem 0;"><%= currentUser.name %></h3>
          <p style="color: rgba(30, 58, 138, 0.7); margin: 0;">العضو منذ: <%= new Date(currentUser.createdAt).toLocaleDateString('ar-SA') %></p>
        </div>

        <form id="profileForm" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
          <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

          <div>
            <label style="display: block; color: #1e3a8a; font-weight: 600; margin-bottom: 0.5rem;">الاسم الكامل</label>
            <input type="text" id="name" value="<%= currentUser.name %>" style="width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%); border: 2px solid rgba(14, 165, 233, 0.2); border-radius: 15px; color: #1e3a8a; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8), inset 0 -1px 0 rgba(0, 0, 0, 0.05); transform: perspective(50px) rotateX(2deg);">
          </div>

          <div>
            <label style="display: block; color: #1e3a8a; font-weight: 600; margin-bottom: 0.5rem;">رقم الهاتف (اختياري)</label>
            <input type="tel" id="phone" value="<%= currentUser.phone || '' %>" placeholder="+966 5X XXX XXXX" style="width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%); border: 2px solid rgba(14, 165, 233, 0.2); border-radius: 15px; color: #1e3a8a; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8), inset 0 -1px 0 rgba(0, 0, 0, 0.05); transform: perspective(50px) rotateX(2deg);">
          </div>
        </form>

        <div style="display: flex; gap: 1rem; margin-top: 2rem; justify-content: flex-end;">
          <button onclick="saveProfile()" class="hm-btn-3d" style="background: linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%); color: #ffffff; padding: 1rem 2rem; font-size: 1.1rem; font-weight: 700; position: relative; overflow: hidden;">
            <span style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.75rem;">
              <i class="fas fa-save"></i> 
              <span>حفظ التغييرات</span>
            </span>
            <div style="position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent); transition: left 0.5s ease;"></div>
          </button>
        </div>
      </div>

      <!-- Security Tab Content -->
      <div id="security-tab" class="hm-tab-content" style="display: none;">
        <h2>
          <i class="fas fa-shield-alt"></i>
          <span>إعدادات الأمان</span>
        </h2>

        <form id="changePasswordForm" style="max-width: 500px;">
          <input type="hidden" id="csrfToken2" value="<%= csrfToken %>">
          
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: #1e3a8a; font-weight: 600; margin-bottom: 0.5rem;">كلمة المرور الحالية</label>
            <input type="password" id="currentPassword" placeholder="أدخل كلمة المرور الحالية" style="width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%); border: 2px solid rgba(14, 165, 233, 0.2); border-radius: 15px; color: #1e3a8a; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8), inset 0 -1px 0 rgba(0, 0, 0, 0.05); transform: perspective(50px) rotateX(2deg);">
          </div>
          
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: #1e3a8a; font-weight: 600; margin-bottom: 0.5rem;">كلمة المرور الجديدة</label>
            <input type="password" id="newPassword" placeholder="أدخل كلمة المرور الجديدة" style="width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%); border: 2px solid rgba(14, 165, 233, 0.2); border-radius: 15px; color: #1e3a8a; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8), inset 0 -1px 0 rgba(0, 0, 0, 0.05); transform: perspective(50px) rotateX(2deg);">
          </div>
          
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: #1e3a8a; font-weight: 600; margin-bottom: 0.5rem;">تأكيد كلمة المرور الجديدة</label>
            <input type="password" id="confirmNewPassword" placeholder="أعد كتابة كلمة المرور الجديدة" style="width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%); border: 2px solid rgba(14, 165, 233, 0.2); border-radius: 15px; color: #1e3a8a; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8), inset 0 -1px 0 rgba(0, 0, 0, 0.05); transform: perspective(50px) rotateX(2deg);">
          </div>
          
          <button type="submit" class="hm-btn-3d" style="background: linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%); color: #ffffff; width: 100%; padding: 1rem; font-size: 1.1rem; font-weight: 700; position: relative; overflow: hidden;">
            <span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
              <i class="fas fa-sync-alt"></i> 
              <span>تغيير كلمة المرور</span>
            </span>
            <div style="position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent); transition: left 0.5s ease;"></div>
          </button>
        </form>
      </div>
    </div>
  </section>
</div>

<script>
function showTab(tabName) {
  document.querySelectorAll('.hm-tab-content').forEach(tab => {
    tab.style.display = 'none';
  });
  
  document.querySelectorAll('.hm-tab-btn').forEach(btn => {
    btn.classList.remove('active');
  });
  
  document.getElementById(tabName + '-tab').style.display = 'block';
  event.target.classList.add('active');
  
  // Add ripple effect to clicked tab
  const ripple = document.createElement('span');
  ripple.style.position = 'absolute';
  ripple.style.borderRadius = '50%';
  ripple.style.background = 'rgba(255, 255, 255, 0.5)';
  ripple.style.width = ripple.style.height = '40px';
  ripple.style.left = '50%';
  ripple.style.top = '50%';
  ripple.style.transform = 'translate(-50%, -50%) scale(0)';
  ripple.style.animation = 'rippleEffect 0.6s ease-out';
  event.target.appendChild(ripple);
  
  setTimeout(() => {
    ripple.remove();
  }, 600);
}

function saveProfile() {
  const formData = {
    name: document.getElementById('name').value,
    phone: document.getElementById('phone').value,
    _csrf: document.getElementById('csrfToken').value
  };
  
  // Show loading state
  const saveBtn = event.target;
  const originalText = saveBtn.innerHTML;
  saveBtn.innerHTML = '<span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;"><i class="fas fa-spinner fa-spin"></i> <span>جاري الحفظ...</span></span>';
  saveBtn.disabled = true;
  
  fetch('/client/profile/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(formData)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Success animation
      saveBtn.innerHTML = '<span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;"><i class="fas fa-check"></i> <span>تم الحفظ!</span></span>';
      saveBtn.style.background = 'linear-gradient(135deg, #28a745 0%, #20c997 100%)';
      
      setTimeout(() => {
        location.reload();
      }, 1500);
    } else {
      // Error state
      saveBtn.innerHTML = '<span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;"><i class="fas fa-exclamation-triangle"></i> <span>فشل!</span></span>';
      saveBtn.style.background = 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)';
      
      setTimeout(() => {
        saveBtn.innerHTML = originalText;
        saveBtn.style.background = 'linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%)';
        saveBtn.disabled = false;
      }, 2000);
      
      alert('حدث خطأ: ' + data.message);
    }
  })
  .catch(error => {
    saveBtn.innerHTML = originalText;
    saveBtn.style.background = 'linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%)';
    saveBtn.disabled = false;
    alert('حدث خطأ في الاتصال');
  });
}

document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const formData = {
    currentPassword: document.getElementById('currentPassword').value,
    newPassword: document.getElementById('newPassword').value,
    confirmNewPassword: document.getElementById('confirmNewPassword').value,
    _csrf: document.getElementById('csrfToken2').value
  };
  
  // Validate passwords
  if (formData.newPassword !== formData.confirmNewPassword) {
    alert('كلم تتطابق كلمة المرور الجديدة مع تأكيدها');
    return;
  }
  
  if (formData.newPassword.length < 8) {
    alert('كلمة المرور يجب أن تكون 8 أحرف على الأقل');
    return;
  }
  
  // Show loading state
  const submitBtn = e.target.querySelector('button[type="submit"]');
  const originalText = submitBtn.innerHTML;
  submitBtn.innerHTML = '<span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;"><i class="fas fa-spinner fa-spin"></i> <span>جاري التغيير...</span></span>';
  submitBtn.disabled = true;
  
  fetch('/client/profile/change-password', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(formData)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Success animation
      submitBtn.innerHTML = '<span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;"><i class="fas fa-check"></i> <span>تم التغيير!</span></span>';
      submitBtn.style.background = 'linear-gradient(135deg, #28a745 0%, #20c997 100%)';
      
      document.getElementById('changePasswordForm').reset();
      
      setTimeout(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.style.background = 'linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%)';
        submitBtn.disabled = false;
      }, 2000);
      
      alert('تم تغيير كلمة المرور بنجاح!');
    } else {
      // Error state
      submitBtn.innerHTML = '<span style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 0.75rem;"><i class="fas fa-exclamation-triangle"></i> <span>فشل!</span></span>';
      submitBtn.style.background = 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)';
      
      setTimeout(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.style.background = 'linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%)';
        submitBtn.disabled = false;
      }, 2000);
      
      alert('حدث خطأ: ' + data.message);
    }
  })
  .catch(error => {
    submitBtn.innerHTML = originalText;
    submitBtn.style.background = 'linear-gradient(135deg, #0ea5e9 0%, #1e3a8a 100%)';
    submitBtn.disabled = false;
    alert('حدث خطأ في الاتصال');
  });
});

// Add ripple effect to all buttons
document.querySelectorAll('.hm-btn-3d').forEach(button => {
  button.addEventListener('click', function(e) {
    const ripple = document.createElement('span');
    ripple.style.position = 'absolute';
    ripple.style.borderRadius = '50%';
    ripple.style.background = 'rgba(255, 255, 255, 0.5)';
    ripple.style.width = ripple.style.height = '40px';
    ripple.style.left = e.offsetX - 20 + 'px';
    ripple.style.top = e.offsetY - 20 + 'px';
    ripple.style.transform = 'scale(0)';
    ripple.style.animation = 'rippleEffect 0.6s ease-out';
    this.appendChild(ripple);
    
    setTimeout(() => {
      ripple.remove();
    }, 600);
  });
});

// Add focus effects to form inputs
document.querySelectorAll('input, select').forEach(input => {
  input.addEventListener('focus', function() {
    this.style.transform = 'perspective(50px) rotateX(0deg)';
    this.style.boxShadow = '0 0 20px rgba(14, 165, 233, 0.3), 0 4px 15px rgba(14, 165, 233, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.9), inset 0 -1px 0 rgba(0, 0, 0, 0.02)';
  });
  
  input.addEventListener('blur', function() {
    this.style.transform = 'perspective(50px) rotateX(2deg)';
    this.style.boxShadow = '0 2px 8px rgba(14, 165, 233, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8), inset 0 -1px 0 rgba(0, 0, 0, 0.05)';
  });
});

// Add CSS animation
const style = document.createElement('style');
style.textContent = `
  @keyframes rippleEffect {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
`;
document.head.appendChild(style);
</script>
