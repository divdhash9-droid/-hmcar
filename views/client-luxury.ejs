  color: var(--client-text-primary);
}

/* Client Section Headers */
.client-section-header {
  text-align: center;
  margin-bottom: 60px;
}

.client-section-header h2 {
  margin-bottom: 16px;
}

.client-section-header p {
  max-width: 600px;
  margin: 0 auto;
}

/* Client Features Grid */
.client-features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 40px;
}

.client-feature-card {
  text-align: center;
  padding: 40px 30px;
  transition: all 0.3s ease;
}

.client-feature-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--client-bg-secondary);
  border-radius: 50%;
  border: 2px solid var(--client-gold);
}

.client-feature-card h3 {
  margin-bottom: 12px;
}

/* Client Cars Showcase */
.client-cars-showcase {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 40px;
}

.client-car-showcase-item {
  background: var(--client-bg-primary);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: var(--client-shadow);
  transition: all 0.3s ease;
}

.client-car-showcase-item:hover {
  transform: translateY(-8px);
  box-shadow: var(--client-shadow-lg);
}

.client-car-image {
  position: relative;
  height: 250px;
  overflow: hidden;
}

.client-car-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.client-car-overlay {
  position: absolute;
  top: 20px;
  right: 20px;
}

.client-car-info {
  padding: 24px;
}

.client-car-info h3 {
  margin-bottom: 8px;
}

.client-car-price {
  margin-top: 16px;
}

/* Client Auction Live */
.client-auction-live {
  max-width: 600px;
  margin: 0 auto;
}

.client-auction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.client-auction-image {
  position: relative;
  height: 300px;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 24px;
}

.client-auction-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.client-auction-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.client-live-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
}

.client-live-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--client-gold);
}

/* Client Stats Grid */
.client-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 40px;
}

.client-stat-item {
  text-align: center;
}

.client-stat-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--client-bg-secondary);
  border-radius: 50%;
