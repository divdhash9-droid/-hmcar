# Example env file (DO NOT put real secrets here)
# Copy needed values to Vercel Environment Variables (Production)

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# Session + JWT secrets (generate strong random values)
SESSION_SECRET=change_me_to_a_secure_random_string
JWT_SECRET=change_me_to_a_secure_random_string

# Environment
NODE_ENV=production

# Optional
BASE_URL=https://your-domain.vercel.app
