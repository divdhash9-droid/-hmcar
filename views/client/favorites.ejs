</style>

<script>
// Favorites Management
class FavoritesManager {
  constructor() {
    this.favorites = [];
    this.filteredFavorites = [];
    this.init();
  }

  async init() {
    await this.loadFavorites();
    this.setupEventListeners();
    this.updateStats();
  }

  async loadFavorites() {
    try {
      this.showLoading(true);
      const response = await fetch('/favorites');
      const data = await response.json();
      
      if (response.ok) {
        this.favorites = data.favorites || [];
        this.filteredFavorites = [...this.favorites];
        this.renderFavorites();
      } else {
        throw new Error(data.error || 'Failed to load favorites');
      }
    } catch (error) {
      console.error('Error loading favorites:', error);
      this.showError('فشل في تحميل المفضلات');
    } finally {
      this.showLoading(false);
    }
  }

  renderFavorites() {
    const grid = document.getElementById('favoritesGrid');
    const emptyState = document.getElementById('emptyState');

    if (this.filteredFavorites.length === 0) {
      grid.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    grid.style.display = 'grid';
    emptyState.style.display = 'none';

    const template = document.getElementById('carCardTemplate');
    grid.innerHTML = '';

    this.filteredFavorites.forEach(favorite => {
      const car = favorite.car;
      if (!car) return;

      const card = template.content.cloneNode(true);
      
      // Set car data
      const img = card.querySelector('.hm-car-img');
      img.src = car.images && car.images.length > 0 ? car.images[0] : '/images/car-placeholder.jpg';
      img.alt = `${car.make?.name || ''} ${car.model?.name || ''}`;

      card.querySelector('.hm-car-title').textContent = `${car.make?.name || ''} ${car.model?.name || ''}`;
      card.querySelector('.hm-car-price').textContent = this.formatPrice(car.price);
      
      // Set specs
      card.querySelector('.hm-year').textContent = car.year || 'N/A';
      card.querySelector('.hm-mileage').textContent = this.formatMileage(car.mileage);
      card.querySelector('.hm-fuel').textContent = car.fuelType || 'N/A';
      
      // Set location and date
      card.querySelector('.hm-location').textContent = car.location || 'غير محدد';
      card.querySelector('.hm-added-date').textContent = this.formatDate(favorite.addedAt);

      // Set action buttons
      const removeBtn = card.querySelector('.hm-btn-remove');
      const viewBtn = card.querySelector('.hm-btn-view');
      const compareBtn = card.querySelector('.hm-btn-compare');

      removeBtn.setAttribute('data-car-id', car._id);
      viewBtn.setAttribute('data-car-id', car._id);
      compareBtn.setAttribute('data-car-id', car._id);

      // Set badge
      const badge = card.querySelector('.hm-badge-text');
      if (car.category) {
        badge.textContent = car.category.name;
      }

      grid.appendChild(card);
    });

    this.setupCardEventListeners();
  }

  setupEventListeners() {
    // Sort select
    document.getElementById('sortSelect').addEventListener('change', (e) => {
      this.sortFavorites(e.target.value);
    });

    // Category filter
    document.getElementById('categoryFilter').addEventListener('change', (e) => {
      this.filterByCategory(e.target.value);
    });

    // Clear filters
    document.getElementById('clearFilters').addEventListener('click', () => {
      this.clearFilters();
    });
  }

  setupCardEventListeners() {
    // Remove from favorites
    document.querySelectorAll('.hm-btn-remove').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const carId = e.currentTarget.getAttribute('data-car-id');
        await this.removeFromFavorites(carId);
      });
    });

    // View car details
    document.querySelectorAll('.hm-btn-view').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const carId = e.currentTarget.getAttribute('data-car-id');
        window.location.href = `/cars/${carId}`;
      });
    });

    // Add to comparison
    document.querySelectorAll('.hm-btn-compare').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const carId = e.currentTarget.getAttribute('data-car-id');
        this.addToComparison(carId);
      });
    });
  }

  async removeFromFavorites(carId) {
    try {
      const response = await fetch(`/favorites/remove/${carId}`, {
        method: 'DELETE'
      });

      const data = await response.json();

      if (response.ok) {
        this.favorites = this.favorites.filter(f => f.car._id !== carId);
        this.filteredFavorites = this.filteredFavorites.filter(f => f.car._id !== carId);
        this.renderFavorites();
        this.updateStats();
        this.showSuccess('تمت إزالة السيارة من المفضلة');
      } else {
        throw new Error(data.error);
      }
    } catch (error) {
      console.error('Error removing from favorites:', error);
      this.showError('فشل في إزالة السيارة من المفضلة');
    }
  }

  sortFavorites(sortBy) {
    switch (sortBy) {
      case 'newest':
        this.filteredFavorites.sort((a, b) => new Date(b.addedAt) - new Date(a.addedAt));
        break;
      case 'price-low':
        this.filteredFavorites.sort((a, b) => (a.car.price || 0) - (b.car.price || 0));
        break;
      case 'price-high':
        this.filteredFavorites.sort((a, b) => (b.car.price || 0) - (a.car.price || 0));
        break;
      case 'name':
        this.filteredFavorites.sort((a, b) => {
          const nameA = `${a.car.make?.name || ''} ${a.car.model?.name || ''}`;
          const nameB = `${b.car.make?.name || ''} ${b.car.model?.name || ''}`;
          return nameA.localeCompare(nameB);
        });
        break;
    }
    this.renderFavorites();
  }

  filterByCategory(category) {
    if (!category) {
      this.filteredFavorites = [...this.favorites];
    } else {
      this.filteredFavorites = this.favorites.filter(f => 
        f.car.category && f.car.category.name === category
      );
    }
    this.renderFavorites();
  }

  clearFilters() {
    document.getElementById('sortSelect').value = 'newest';
    document.getElementById('categoryFilter').value = '';
    this.filteredFavorites = [...this.favorites];
    this.renderFavorites();
  }

  updateStats() {
    const count = this.filteredFavorites.length;
    const totalValue = this.filteredFavorites.reduce((sum, f) => sum + (f.car.price || 0), 0);

    document.getElementById('favoritesCount').textContent = count;
    document.getElementById('totalValue').textContent = this.formatPrice(totalValue);
  }

  addToComparison(carId) {
    // Implementation for adding to comparison
    window.location.href = `/comparisons?add=${carId}`;
  }

  formatPrice(price) {
    return new Intl.NumberFormat('ar-SA', {
      style: 'currency',
      currency: 'SAR',
      minimumFractionDigits: 0
    }).format(price || 0);
  }

  formatMileage(mileage) {
    if (!mileage) return 'N/A';
    return `${mileage.toLocaleString('ar-SA')} كم`;
  }

  formatDate(date) {
    return new Date(date).toLocaleDateString('ar-SA');
  }

  showLoading(show) {
    document.getElementById('loadingState').style.display = show ? 'block' : 'none';
  }

  showError(message) {
    // Show error notification
    console.error(message);
  }

  showSuccess(message) {
    // Show success notification
    console.log(message);
  }
}

