<script>
// Add interactive features for iOS Light Theme
document.addEventListener('DOMContentLoaded', function() {
  // Smooth scroll for cars
  const carsScroll = document.querySelector('.ios-light-cars-scroll');
  if (carsScroll) {
    let isDown = false;
    let startX;
    let scrollLeft;

    carsScroll.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - carsScroll.offsetLeft;
      scrollLeft = carsScroll.scrollLeft;
    });

    carsScroll.addEventListener('mouseleave', () => {
      isDown = false;
    });

    carsScroll.addEventListener('mouseup', () => {
      isDown = false;
    });

    carsScroll.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carsScroll.offsetLeft;
      const walk = (x - startX) * 2;
      carsScroll.scrollLeft = scrollLeft - walk;
    });
  }

  // Animate elements on scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('ios-light-animate-active');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.ios-light-animate-fade-in').forEach(el => {
    observer.observe(el);
  });

  // Add hover effects to cards
  document.querySelectorAll('.ios-light-card-luxury').forEach(card => {
    card.addEventListener('mouseenter', function() {
      this.style.transform = 'translateY(-8px) scale(1.02)';
    });
    
    card.addEventListener('mouseleave', function() {
      this.style.transform = 'translateY(0) scale(1)';
    });
  });

  // Add click effects to buttons
  document.querySelectorAll('.ios-light-btn').forEach(button => {
    button.addEventListener('click', function() {
      // Create ripple effect
      const ripple = document.createElement('span');
      ripple.className = 'ios-light-ripple';
      
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const x = event.clientX - rect.left - size / 2;
      const y = event.clientY - rect.top - size / 2;
      
      ripple.style.width = ripple.style.height = size + 'px';
      ripple.style.left = x + 'px';
      ripple.style.top = y + 'px';
      
      this.appendChild(ripple);
      
      setTimeout(() => {
        ripple.remove();
      }, 600);
    });
  });
});

// Add ripple effect styles
const style = document.createElement('style');
style.textContent = `
  .ios-light-ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(0, 122, 255, 0.3);
    transform: scale(0);
    animation: ios-light-ripple-animation 0.6s ease-out;
    pointer-events: none;
  }
  
  @keyframes ios-light-ripple-animation {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
  
  .ios-light-animate-fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease-out;
  }
  
  .ios-light-animate-fade-in.ios-light-animate-active {
    opacity: 1;
    transform: translateY(0);
  }
`;
document.head.appendChild(style);

// Sidebar function
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  if (sidebar) {
    sidebar.classList.toggle('open');
  }
}
