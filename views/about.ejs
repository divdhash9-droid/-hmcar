<% layout('layout') -%>

<section class="about-hero">
    <div class="container">
        <h1><%= __('about.title') %></h1>
        <p><%= __('about.subtitle') %></p>
    </div>
</section>

<section class="about-content">
    <div class="container">
        <div class="about-grid">
            <div class="about-text">
                <h2><%= __('about.our_story') %></h2>
                <p>Founded with a passion for automobiles and a vision to revolutionize the car auction industry, CarAuction has become the trusted platform for buying and selling premium vehicles.</p>
                <p>We connect car enthusiasts, dealers, and collectors from around the world, providing a transparent, secure, and exciting auction experience.</p>
            </div>
            <div class="about-image">
                <img src="/images/about-car.jpg" alt="Luxury car" onerror="this.src='/images/default-car.jpg'">
            </div>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <i class="fas fa-shield-alt"></i>
                <h3><%= __('about.secure_transactions') %></h3>
                <p><%= __('about.secure_desc') %></p>
            </div>
            <div class="feature-card">
                <i class="fas fa-globe"></i>
                <h3><%= __('about.global_reach') %></h3>
                <p><%= __('about.global_desc') %></p>
            </div>
            <div class="feature-card">
                <i class="fas fa-clock"></i>
                <h3><%= __('about.support') %></h3>
                <p><%= __('about.support_desc') %></p>
            </div>
            <div class="feature-card">
                <i class="fas fa-star"></i>
                <h3><%= __('about.quality') %></h3>
                <p><%= __('about.quality_desc') %></p>
            </div>
        </div>
    </div>
</section>