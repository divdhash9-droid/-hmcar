# Example env file for Vercel import (NO REAL SECRETS HERE)
#
# How to use:
# 1) Copy this file locally to a new file named .env (do NOT commit it)
# 2) Replace <DB_PASSWORD> with your real Atlas DB user's password (URL-encode if needed)
# 3) Replace SESSION_SECRET / JWT_SECRET with strong random values
# 4) In Vercel: Settings -> Environment Variables -> Import .env

# Environment
NODE_ENV=production

# Optional but recommended
BASE_URL=https://car-auction-sand.vercel.app

# MongoDB Atlas connection string (replace <DB_PASSWORD>)
# IMPORTANT: Keep it as ONE LINE with no spaces.
MONGO_URI=mongodb+srv://divdhash9_db_user:<DB_PASSWORD>@cluster0.tirfqnb.mongodb.net/car-auction?retryWrites=true&w=majority&appName=Cluster0

# Secrets (replace values)
SESSION_SECRET=change_me_to_a_secure_random_string
JWT_SECRET=change_me_to_a_secure_random_string
