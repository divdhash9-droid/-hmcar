<% layout('layout') -%>

<div class="modern-container car-details-page">
    <header class="page-header">
        <h1><%= car.title %></h1>
        <p><%= car.make %> <%= car.model %> - <%= car.year %></p>
    </header>

    <div class="details-layout">
        <!-- Image Gallery -->
        <div class="gallery-container">
            <div class="main-image">
                <img src="<%= (car.images && car.images.length > 0) ? car.images[0] : '/images/placeholder.png' %>" alt="<%= car.title %>" id="mainImage">
            </div>
            <% if (car.images && car.images.length > 1) { %>
                <div class="thumbnail-strip">
                    <% car.images.forEach(image => { %>
                        <img src="<%= image %>" alt="Thumbnail" class="thumbnail" onclick="changeImage('<%= image %>')">
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Car Info and Actions -->
        <div class="info-container">
            <div class="price-section">
                <span class="price">
                    <% if (car.priceSar) { %>
                        <%= car.priceSar.toLocaleString() %> ريال
                    <% } else if (car.price) { %>
                        <%= car.price.toLocaleString() %> ريال
                    <% } else { %>
                        السعر عند الطلب
                    <% } %>
                </span>
                <% if (car.isSold) { %>
                    <span class="badge sold">تم البيع</span>
                <% } else if (car.listingType === 'auction') { %>
                    <span class="badge auction">متوفر في مزاد</span>
                <% } else { %>
                    <span class="badge available">متوفر للبيع</span>
                <% } %>
            </div>

            <div class="specs-grid">
                <div class="spec-item">
                    <i class="fas fa-car"></i>
                    <span><strong>الشركة:</strong> <%= car.make %></span>
                </div>
                <div class="spec-item">
                    <i class="fas fa-cogs"></i>
                    <span><strong>الموديل:</strong> <%= car.model %></span>
                </div>
                <div class="spec-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span><strong>السنة:</strong> <%= car.year %></span>
                </div>
                <div class="spec-item">
                    <i class="fas fa-tachometer-alt"></i>
                    <span><strong>الممشى:</strong> <%= car.mileage ? car.mileage.toLocaleString() + ' كم' : 'N/A' %></span>
                </div>
                <div class="spec-item">
                    <i class="fas fa-gas-pump"></i>
                    <span><strong>الوقود:</strong> <%= car.fuelType || 'غير محدد' %></span>
                </div>
                <div class="spec-item">
                    <i class="fas fa-palette"></i>
                    <span><strong>اللون:</strong> <%= car.color || 'غير محدد' %></span>
                </div>
            </div>

            <div class="description-section">
                <h4>وصف السيارة</h4>
                <p><%= car.description || 'لا يوجد وصف متوفر لهذه السيارة.' %></p>
            </div>

            <div class="action-buttons">
                <% if (car.listingType === 'auction' && auctionUrl) { %>
                    <a href="<%= auctionUrl %>" class="btn btn-primary btn-lg"><i class="fas fa-gavel"></i> عرض المزاد</a>
                <% } else if (!car.isSold) { %>
                    <form action="/cars/buy/<%= car._id %>" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-shopping-cart"></i> شراء الآن</button>
                    </form>
                    <button class="btn btn-secondary btn-lg favorite-btn" data-car-id="<%= car._id %>">
                        <i class="far fa-heart"></i> أضف للمفضلة
                    </button>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    function changeImage(newSrc) {
        document.getElementById('mainImage').src = newSrc;
    }
</script>
