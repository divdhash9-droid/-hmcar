<% layout('layout') -%>
<link rel="stylesheet" href="/public/css/admin-unified.css" />
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-unified-bg' %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="mb-1">رسائل خدمة العملاء</h3>
    <div class="text-muted">تابع الرسائل الواردة وغيّر حالتها عند الرد.</div>
  </div>
  <a href="/admin" class="back-btn">
    <i class="fas fa-arrow-right me-2"></i>عودة للوحة التحكم
  </a>
</div>

<div class="support-card">
  <div class="support-header">
    <h5 class="mb-0">
      <i class="fas fa-headset me-2"></i>
      رسائل خدمة العملاء
    </h5>
  </div>
  
  <div class="card-body p-0">
    <% if (!messages || !messages.length) { %>
      <!-- لا توجد رسائل -->
      <div class="p-4 text-center">
        <div class="h5 mb-1">لا توجد رسائل</div>
        <div class="text-muted">لم يتم استلام أي رسائل من العملاء بعد.</div>
      </div>
    <% } else { %>
      <!-- جدول الرسائل -->
      <div class="table-responsive">
        <table class="table table-striped mb-0 align-middle">
          <thead>
            <tr>
              <th>التاريخ</th>
              <th>الاسم</th>
              <th>البريد</th>
              <th>الهاتف</th>
              <th>الرسالة</th>
            </tr>
          </thead>
          <tbody>
            <% messages.forEach(msg => { %>
              <tr>
                <td><small class="text-muted"><%= new Date(msg.createdAt).toLocaleDateString('ar-SA') %></small></td>
                <td><%= msg.name %></td>
                <td><%= msg.email %></td>
                <td><%= msg.phone %></td>
                <td><small class="text-muted"><%= msg.message.substring(0, 50) %>...</small></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
