<!-- [[ARABIC_HEADER]] هذا الملف (views/auth/login.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>

<div class="hm-luxury-login">
  <!-- خلفية متحركة وأنيقة -->
  <div class="hm-background">
    <div class="hm-gradient-orb hm-orb-1"></div>
    <div class="hm-gradient-orb hm-orb-2"></div>
    <div class="hm-gradient-orb hm-orb-3"></div>
    <div class="hm-grid-pattern"></div>
  </div>

  <!-- الحاوية الرئيسية -->
  <div class="hm-container">
    <!-- اللوحة اليسرى - العلامة التجارية -->
    <div class="hm-brand-panel">
      <div class="hm-brand-content">
        <!-- شريط العلوي -->
        <div class="hm-top-bar">
          <div class="hm-badge">
            <i class="fas fa-crown"></i>
            <span>إصدار 2026</span>
          </div>
          <div class="hm-top-actions">
            <a href="/" class="hm-home-btn" title="العودة إلى الصفحة الرئيسية">
              <i class="fas fa-home"></i>
              <span>الرئيسية</span>
            </a>
            <button class="hm-lang-btn" onclick="toggleLanguage()">
              <i class="fas fa-globe"></i>
              <span id="currentLang">العربية</span>
            </button>
          </div>
        </div>

        <!-- الشعار -->
        <div class="hm-logo-section">
          <div class="hm-logo-container">
            <img class="hm-logo" src="/public/images/logo-classic.svg" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo-signature.svg';" />
          </div>
          <h1 class="hm-brand-title" data-ar="HM CAR" data-en="HM CAR">HM CAR</h1>
          <p class="hm-brand-subtitle" data-ar="منصة مزادات السيارات الفاخرة" data-en="Luxury Car Auction Platform">
            منصة مزادات السيارات الفاخرة<br>
            <span class="hm-english-text">Luxury Car Auction Platform</span>
          </p>
        </div>

        <!-- المميزات -->
        <div class="hm-features">
          <div class="hm-feature-card">
            <div class="hm-feature-icon">
              <i class="fas fa-shield-alt"></i>
            </div>
            <div class="hm-feature-content">
              <h3 data-ar="أمان متقدم" data-en="Advanced Security">أمان متقدم</h3>
              <p data-ar="تشفير AES-256" data-en="AES-256 Encryption">تشفير AES-256</p>
            </div>
          </div>
          <div class="hm-feature-card">
            <div class="hm-feature-icon">
              <i class="fas fa-bolt"></i>
            </div>
            <div class="hm-feature-content">
              <h3 data-ar="سرعة فائقة" data-en="Ultra Fast">سرعة فائقة</h3>
              <p data-ar="استجابة 180ms" data-en="180ms Response">استجابة 180ms</p>
            </div>
          </div>
          <div class="hm-feature-card">
            <div class="hm-feature-icon">
              <i class="fas fa-gem"></i>
            </div>
            <div class="hm-feature-content">
              <h3 data-ar="تجربة فاخرة" data-en="Premium Experience">تجربة فاخرة</h3>
              <p data-ar="واجهة عصرية" data-en="Modern Interface">واجهة عصرية</p>
            </div>
          </div>
        </div>

        <!-- الإحصائيات -->
        <div class="hm-stats">
          <div class="hm-stat-item">
            <span class="hm-stat-number">+1.2M</span>
            <span class="hm-stat-label" data-ar="مستخدم" data-en="Users">مستخدم</span>
          </div>
          <div class="hm-stat-item">
            <span class="hm-stat-number">99.97%</span>
            <span class="hm-stat-label" data-ar="جاهزية" data-en="Uptime">جاهزية</span>
          </div>
          <div class="hm-stat-item">
            <span class="hm-stat-number">24/7</span>
            <span class="hm-stat-label" data-ar="دعم" data-en="Support">دعم</span>
          </div>
        </div>
      </div>
    </div>

    <!-- اللوحة اليمنى - نموذج تسجيل الدخول -->
    <div class="hm-login-panel">
      <div class="hm-login-content">
        <!-- التبويبات -->
        <div class="hm-tabs">
          <a href="/auth/login" class="hm-tab <%= !isAdminLogin ? 'active' : '' %>">
            <i class="fas fa-user"></i>
            <span data-ar="دخول العملاء" data-en="Client Login">دخول العملاء</span>
          </a>
          <a href="/auth/login?admin=true" class="hm-tab <%= isAdminLogin ? 'active' : '' %>">
            <i class="fas fa-crown"></i>
            <span data-ar="دخول الأدمن" data-en="Admin Login">دخول الأدمن</span>
          </a>
        </div>

        <!-- العنوان -->
        <div class="hm-header">
          <h2 class="hm-title" data-ar="مرحباً بعودتك" data-en="Welcome Back">مرحباً بعودتك</h2>
          <p class="hm-subtitle" data-ar="سجل دخولك للمتابعة في عالم السيارات الفاخرة" data-en="Sign in to continue in the luxury car world">
            سجل دخولك للمتابعة في عالم السيارات الفاخرة
          </p>
        </div>

        <!-- الرسائل -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="hm-alert hm-alert-error">
            <i class="fas fa-exclamation-circle"></i>
            <span><%= error %></span>
            <button type="button" class="hm-alert-close" onclick="this.parentElement.remove()">
              <i class="fas fa-times"></i>
            </button>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="hm-alert hm-alert-success">
            <i class="fas fa-check-circle"></i>
            <span><%= success %></span>
            <button type="button" class="hm-alert-close" onclick="this.parentElement.remove()">
              <i class="fas fa-times"></i>
            </button>
          </div>
        <% } %>

        <!-- النموذج -->
        <form method="POST" action="/auth/login" class="hm-form">
          <input type="hidden" name="loginRole" value="<%= isAdminLogin ? 'admin' : 'buyer' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="hm-input-group">
            <div class="hm-input-wrapper">
              <i class="hm-input-icon fas fa-user"></i>
              <input type="<%= isAdminLogin ? 'email' : 'text' %>" 
                     id="<%= isAdminLogin ? 'email' : 'username' %>" 
                     name="<%= isAdminLogin ? 'email' : 'name' %>" 
                     class="hm-input" 
                     placeholder="<%= isAdminLogin ? 'البريد الإلكتروني' : 'اسم المستخدم' %>" 
                     required>
              <label for="<%= isAdminLogin ? 'email' : 'username' %>" class="hm-input-label">
                <%= isAdminLogin ? 'البريد الإلكتروني' : 'اسم المستخدم' %>
              </label>
            </div>
          </div>

          <div class="hm-input-group">
            <div class="hm-input-wrapper">
              <i class="hm-input-icon fas fa-lock"></i>
              <input type="password" 
                     id="password" 
                     name="password" 
                     class="hm-input" 
                     placeholder="كلمة المرور" 
                     required>
              <button type="button" class="hm-password-toggle" onclick="togglePassword('password')">
                <i class="fas fa-eye"></i>
              </button>
              <label for="password" class="hm-input-label">كلمة المرور</label>
            </div>
          </div>

          <div class="hm-options">
            <div class="hm-checkbox-wrapper">
              <input type="checkbox" id="remember" name="remember" class="hm-checkbox">
              <label for="remember" class="hm-checkbox-label">
                <span class="hm-checkbox-custom"></span>
                <span data-ar="تذكرني" data-en="Remember me">تذكرني</span>
              </label>
            </div>
            <a href="/auth/forgot-password" class="hm-link" data-ar="نسيت كلمة المرور؟" data-en="Forgot password?">نسيت كلمة المرور؟</a>
          </div>

          <button type="submit" class="hm-btn hm-btn-3d">
            <i class="fas fa-sign-in-alt"></i>
            <span data-ar="تسجيل الدخول" data-en="Sign In">تسجيل الدخول</span>
          </button>
        </form>

        <!-- التذييل -->
        <div class="hm-footer">
          <p class="hm-no-account" data-ar="ليس لديك حساب؟" data-en="Don't have an account?">ليس لديك حساب؟</p>
          <a href="/auth/register" class="hm-register-link" data-ar="إنشاء حساب جديد" data-en="Create new account">إنشاء حساب جديد</a>
        </div>

        <div class="hm-switch">
          <% if (!isAdminLogin) { %>
            <p data-ar="مسؤول؟" data-en="Admin?">مسؤول؟ <a href="/auth/login?admin=true" class="hm-switch-link" data-ar="دخول الأدمن" data-en="Admin Login">دخول الأدمن</a></p>
          <% } else { %>
            <p data-ar="عميل؟" data-en="Client?">عميل؟ <a href="/auth/login" class="hm-switch-link" data-ar="دخول العميل" data-en="Client Login">دخول العميل</a></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<link rel="stylesheet" href="/css/luxury-auth.css" />
<script>
  // Language Toggle
  let currentLanguage = "ar";

  function toggleLanguage() {
    currentLanguage = currentLanguage === "ar" ? "en" : "ar";
    updateLanguage();
    localStorage.setItem("preferredLanguage", currentLanguage);
  }

  function updateLanguage() {
    const elements = document.querySelectorAll("[data-ar][data-en]");
    const langBtn = document.getElementById("currentLang");

    elements.forEach((element) => {
      const text = element.getAttribute(`data-${currentLanguage}`);
      if (element.tagName === "INPUT" || element.tagName === "TEXTAREA") {
        element.placeholder = text;
      } else {
        element.textContent = text;
      }
    });

    langBtn.textContent = currentLanguage === "ar" ? "English" : "العربية";

    // Update text direction
    document.documentElement.dir = currentLanguage === "ar" ? "rtl" : "ltr";
    document.documentElement.lang = currentLanguage;
  }

  // Password Toggle (legacy handler removed; using inline togglePassword in form)

  // Initialize language
  document.addEventListener("DOMContentLoaded", function () {
    const savedLang = localStorage.getItem("preferredLanguage");
    if (savedLang && savedLang !== currentLanguage) {
      currentLanguage = savedLang;
      updateLanguage();
    }
  });

  // Form validation enhancements
  (function () {
    const form = document.querySelector(".auth-form");
    if (!form) return;
    form.addEventListener("submit", function () {
      const submitBtn = this.querySelector('button[type="submit"]');
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تسجيل الدخول...';
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> <span>تسجيل الدخول</span>';
      }, 3000);
    });
  })();

  // Add input animations
  document.querySelectorAll(".hm-input").forEach((input) => {
    input.addEventListener("focus", function () {
      this.parentElement.classList.add("focused");
    });

    input.addEventListener("blur", function () {
      if (!this.value) {
        this.parentElement.classList.remove("focused");
      }
    });
  });
</script>
