<!-- [[ARABIC_HEADER]] هذا الملف (views/partials/admin-dashboard.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<div class="admin-dashboard">
  <!-- Dashboard Header -->
  <div class="dashboard-header">
    <h2><i class="fas fa-tachometer-alt"></i> لوحة التحكم</h2>
    <div class="header-actions">
      <div class="date-range-selector">
        <select class="form-select" id="periodSelector">
          <option value="7">آخر 7 أيام</option>
          <option value="30" selected>آخر 30 يوم</option>
          <option value="90">آخر 90 يوم</option>
          <option value="365">آخر سنة</option>
        </select>
      </div>
      <button class="btn btn-primary" id="refreshStats">
        <i class="fas fa-sync-alt"></i>
        تحديث
      </button>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="stats-grid" id="statsGrid">
    <!-- Sales Stats -->
    <div class="stat-card sales">
      <div class="stat-icon">
        <i class="fas fa-shopping-cart"></i>
      </div>
      <div class="stat-content">
        <h3 id="totalSales">0 ريال</h3>
        <p>إجمالي المبيعات</p>
        <div class="stat-change positive">
          <i class="fas fa-arrow-up"></i>
          <span id="salesChange">0%</span>
        </div>
      </div>
    </div>

    <!-- Orders Stats -->
    <div class="stat-card orders">
      <div class="stat-icon">
        <i class="fas fa-file-invoice"></i>
      </div>
      <div class="stat-content">
        <h3 id="totalOrders">0</h3>
        <p>إجمالي الطلبات</p>
        <div class="stat-change positive">
          <i class="fas fa-arrow-up"></i>
          <span id="ordersChange">0%</span>
        </div>
      </div>
    </div>

    <!-- Users Stats -->
    <div class="stat-card users">
      <div class="stat-icon">
        <i class="fas fa-users"></i>
      </div>
      <div class="stat-content">
        <h3 id="totalUsers">0</h3>
        <p>إجمالي المستخدمين</p>
        <div class="stat-change positive">
          <i class="fas fa-arrow-up"></i>
          <span id="usersChange">0%</span>
        </div>
      </div>
    </div>

    <!-- Auctions Stats -->
    <div class="stat-card auctions">
      <div class="stat-icon">
        <i class="fas fa-gavel"></i>
      </div>
      <div class="stat-content">
        <h3 id="activeAuctions">0</h3>
        <p>المزادات النشطة</p>
        <div class="stat-change neutral">
          <i class="fas fa-minus"></i>
          <span id="auctionsChange">0%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="charts-section">
    <div class="chart-container">
      <div class="chart-header">
        <h5><i class="fas fa-chart-line"></i> المبيعات خلال الفترة</h5>
        <div class="chart-actions">
          <select class="form-select" id="salesChartType">
            <option value="revenue">الإيرادات</option>
            <option value="orders">الطلبات</option>
            <option value="avg">متوسط الطلب</option>
          </select>
        </div>
      </div>
      <div class="chart-wrapper">
        <canvas id="salesChart"></canvas>
      </div>
    </div>

    <div class="chart-container">
      <div class="chart-header">
        <h5><i class="fas fa-chart-pie"></i> توزيع الدفعات</h5>
      </div>
      <div class="chart-wrapper">
        <canvas id="paymentChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="activity-section">
    <div class="section-header">
      <h5><i class="fas fa-history"></i> النشاط الحديث</h5>
      <button class="btn btn-sm btn-outline-secondary" id="refreshActivity">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
    <div class="activity-list" id="activityList">
      <div class="activity-item">
        <div class="activity-icon order">
          <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="activity-content">
          <div class="activity-title">طلب جديد #12345</div>
          <div class="activity-desc">سيارة تويوتا كامري - 45,000 ريال</div>
          <div class="activity-time">منذ 5 دقائق</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon auction">
          <i class="fas fa-gavel"></i>
        </div>
        <div class="activity-content">
          <div class="activity-title">مزاد جديد</div>
          <div class="activity-desc">هونداي اكسنت 2022 - 25,000 ريال</div>
          <div class="activity-time">منذ 15 دقيقة</div>
        </div>
      </div>
      <div class="activity-item">
        <div class="activity-icon user">
          <i class="fas fa-user-plus"></i>
        </div>
        <div class="activity-content">
          <div class="activity-title">مستخدم جديد</div>
          <div class="activity-desc">أحمد محمد - مشتري</div>
          <div class="activity-time">منذ 30 دقيقة</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions">
    <h5><i class="fas fa-bolt"></i> إجراءات سريعة</h5>
    <div class="actions-grid">
      <button class="action-btn" onclick="window.location.href='/cars/new'">
        <i class="fas fa-plus"></i>
        <span>إضافة سيارة</span>
      </button>
      <button class="action-btn" onclick="window.location.href='/auctions/new'">
        <i class="fas fa-gavel"></i>
        <span>إنشاء مزاد</span>
      </button>
      <button class="action-btn" onclick="showReportsModal()">
        <i class="fas fa-chart-bar"></i>
        <span>تقارير</span>
      </button>
      <button class="action-btn" onclick="window.location.href='/users'">
        <i class="fas fa-users"></i>
        <span>المستخدمين</span>
      </button>
    </div>
  </div>
</div>

<!-- Reports Modal -->
<div class="modal fade" id="reportsModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-chart-bar"></i> التقارير</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="reports-grid">
          <div class="report-card" onclick="generateReport('sales')">
            <div class="report-icon">
              <i class="fas fa-shopping-cart"></i>
            </div>
            <div class="report-info">
              <h6>تقرير المبيعات</h6>
              <p>تحليل المبيعات والطلبات</p>
            </div>
          </div>
          <div class="report-card" onclick="generateReport('auctions')">
            <div class="report-icon">
              <i class="fas fa-gavel"></i>
            </div>
            <div class="report-info">
              <h6>تقرير المزادات</h6>
              <p>تحليل أداء المزادات</p>
            </div>
          </div>
          <div class="report-card" onclick="generateReport('users')">
            <div class="report-icon">
              <i class="fas fa-users"></i>
            </div>
            <div class="report-info">
              <h6>تقرير المستخدمين</h6>
              <p>إحصائيات المستخدمين</p>
            </div>
          </div>
          <div class="report-card" onclick="generateReport('financial')">
            <div class="report-icon">
              <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="report-info">
              <h6>تقرير مالي</h6>
              <p>تحليل الإيرادات</p>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
      </div>
    </div>
  </div>
</div>

