    gap: 16px;
    text-align: center;
  }
}

/* Client Text Utilities */
.client-text-center {
  text-align: center;
}

.client-text-left {
  text-align: left;
}

.client-text-right {
  text-align: right;
}

/* Client Spacing Utilities */
.client-mt-1 { margin-top: 8px; }
.client-mt-2 { margin-top: 16px; }
.client-mt-3 { margin-top: 24px; }
.client-mt-4 { margin-top: 32px; }
.client-mt-5 { margin-top: 40px; }

.client-mb-1 { margin-bottom: 8px; }
.client-mb-2 { margin-bottom: 16px; }
.client-mb-3 { margin-bottom: 24px; }
.client-mb-4 { margin-bottom: 32px; }
.client-mb-5 { margin-bottom: 40px; }

.client-p-1 { padding: 8px; }
.client-p-2 { padding: 16px; }
.client-p-3 { padding: 24px; }
.client-p-4 { padding: 32px; }
.client-p-5 { padding: 40px; }
</style>

<script>
// Client Luxury Animations
document.addEventListener('DOMContentLoaded', function() {
  // Trigger animations on scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('client-animate-active');
      }
    });
  }, observerOptions);

  // Observe all animated elements
  document.querySelectorAll('.client-stagger-item').forEach(el => {
    observer.observe(el);
  });

  // Add interactive hover effects
  document.querySelectorAll('.client-hover-lift').forEach(element => {
    element.addEventListener('mouseenter', function() {
      this.style.transform = 'translateY(-12px) scale(1.02)';
    });
    
    element.addEventListener('mouseleave', function() {
      this.style.transform = 'translateY(0) scale(1)';
    });
  });

  // Add click effects to buttons
  document.querySelectorAll('.client-btn').forEach(button => {
    button.addEventListener('click', function(e) {
      // Create ripple effect
      const ripple = document.createElement('span');
      ripple.className = 'client-ripple';
      
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const x = e.clientX - rect.left - size / 2;
      const y = e.clientY - rect.top - size / 2;
      
      ripple.style.width = ripple.style.height = size + 'px';
      ripple.style.left = x + 'px';
      ripple.style.top = y + 'px';
      
      this.appendChild(ripple);
      
      setTimeout(() => {
        ripple.remove();
      }, 600);
    });
  });

  // Add parallax effect to hero section
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    const parallax = document.querySelector('.client-hero-background');
    if (parallax) {
      parallax.style.transform = `translateY(${scrolled * 0.5}px)`;
    }
  });

  // Add typing effect to hero title
  const heroTitle = document.querySelector('.client-hero-title');
  if (heroTitle) {
    const text = heroTitle.textContent;
    heroTitle.textContent = '';
    heroTitle.classList.add('client-typewriter');
    
    let index = 0;
    const typeWriter = () => {
      if (index < text.length) {
        heroTitle.textContent += text.charAt(index);
        index++;
        setTimeout(typeWriter, 100);
      }
    };
    
    setTimeout(typeWriter, 1000);
  }
});

// Add ripple effect styles
const style = document.createElement('style');
style.textContent = `
  .client-ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 215, 0, 0.3);
    transform: scale(0);
    animation: client-ripple-animation 0.6s ease-out;
    pointer-events: none;
  }
  
  @keyframes client-ripple-animation {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
  
  .client-stagger-item {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease-out;
  }
  
  .client-stagger-item.client-animate-active {
    opacity: 1;
    transform: translateY(0);
  }
`;
document.head.appendChild(style);
</script>
