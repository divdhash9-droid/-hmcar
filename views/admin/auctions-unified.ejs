<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/auctions-unified.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'admin-dashboard-luxury'; %>

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="إدارة المزادات">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title">إدارة المزادات</h1>
            <div class="hm-hero__subtitle">مزادات فخمة — تحكم شامل ومتابعة مباشرة</div>
          </div>
        </div>

        <nav class="hm-hero__actions" aria-label="إجراءات">
          <a class="hm-pill" href="/admin" aria-label="لوحة الإدارة"><i class="fas fa-tachometer-alt"></i><span>لوحة الإدارة</span></a>
          <a class="hm-pill" href="/admin/auctions/new" aria-label="إنشاء مزاد"><i class="fas fa-gavel"></i><span>إنشاء مزاد</span></a>
          <a class="hm-pill hm-pill--danger" href="/auth/logout" aria-label="خروج"><i class="fas fa-sign-out-alt"></i><span>خروج</span></a>
        </nav>
      </div>

      <section class="hm-kpis" aria-label="إحصائيات">
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">إجمالي السيارات</div><div class="hm-kpi__value"><%= Number(stats?.totalCars || 0) %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-car"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">المزادات النشطة</div><div class="hm-kpi__value"><%= Number(stats?.activeAuctions || 0) %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-gavel"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">إجمالي المستخدمين</div><div class="hm-kpi__value"><%= Number(stats?.totalUsers || 0) %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-users"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">إجمالي الطلبات</div><div class="hm-kpi__value"><%= Number(stats?.totalOrders || 0) %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-file-invoice"></i></div></div></div>
      </section>
    </header>

    <% if (flash && flash.message) { %>
      <div class="mt-3">
        <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% } %>

    <section class="hm-section" aria-label="قائمة المزادات">
      <h2 class="hm-section__title">قائمة المزادات</h2>
      <div class="hm-list">
        <% if (auctions && auctions.length) { %>
          <% auctions.forEach(function(a){ %>
            <div class="hm-list__item">
              <div>
                <h3 class="hm-list__title"><%= (a.car && a.car.title) ? a.car.title : 'مزاد' %></h3>
                <div class="hm-list__meta">
                  <%= a.currency ? ('العملة: ' + a.currency) : '' %>
                  <%= (a.startsAt) ? (' - يبدأ: ' + new Date(a.startsAt).toLocaleString('ar')) : '' %>
                  <%= (a.endsAt) ? (' - ينتهي: ' + new Date(a.endsAt).toLocaleString('ar')) : '' %>
                </div>
              </div>
              <span class="hm-chip <%= (a.status === 'running') ? 'hm-chip--new' : '' %>"><i class="fas fa-gavel"></i><span><%= a.status || 'scheduled' %></span></span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="hm-list__item">
            <div>
              <h3 class="hm-list__title">لا توجد مزادات</h3>
              <div class="hm-list__meta">أنشئ مزاداً جديداً من زر "إنشاء مزاد"</div>
            </div>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</div>
