<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/support.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'hm-admin-page'; %>

<link rel="stylesheet" href="/css/admin-luxury.css">

<div class="hm-admin-layout">
  <!-- Animated Background -->
  <div class="hm-admin-bg">
    <div class="hm-admin-bg-gradient"></div>
    <div class="hm-admin-bg-glow"></div>
  </div>

  <!-- Mobile Toggle -->
  <button class="hm-mobile-toggle" onclick="toggleSidebar()">
    <i class="fas fa-bars"></i>
  </button>

  <!-- Sidebar -->
  <%- include('../partials/admin-sidebar') %>

  <!-- Main Content -->
  <main class="hm-admin-main">
    <!-- Header -->
    <header class="hm-admin-header">
      <div class="hm-header-title">
        <h1>الدعم الفني</h1>
        <div class="hm-header-breadcrumb">
          <a href="/admin">لوحة التحكم</a>
          <i class="fas fa-chevron-left"></i>
          <span>الدعم الفني</span>
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="hm-admin-content">
      <!-- Flash Messages -->
      <% if (flash && flash.message) { %>
      <div class="hm-admin-alert hm-admin-alert-<%= flash.type || 'info' %>">
        <i class="fas <%= flash.type === 'success' ? 'fa-check-circle' : flash.type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle' %>"></i>
        <span><%= flash.message %></span>
      </div>
      <% } %>

      <!-- Stats -->
      <div class="hm-stats-grid">
        <div class="hm-stat-card">
          <div class="hm-stat-icon">
            <i class="fas fa-headset"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">إجمالي الرسائل</div>
            <div class="hm-stat-value"><%= (messages || []).length %></div>
          </div>
        </div>
        <div class="hm-stat-card">
          <div class="hm-stat-icon warning">
            <i class="fas fa-clock"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">في انتظار الرد</div>
            <div class="hm-stat-value"><%= messages ? messages.filter(m => m.status === 'pending').length : 0 %></div>
          </div>
        </div>
      </div>

      <!-- Messages List -->
      <div class="hm-admin-card">
        <div class="hm-card-header">
          <h2 class="hm-card-title">
            <i class="fas fa-envelope"></i>
            رسائل العملاء
          </h2>
          <span class="hm-admin-badge hm-admin-badge-primary">
            <%= (messages || []).length %> رسالة
          </span>
        </div>
        <div class="hm-card-body" style="padding: 0;">
          <% if (messages && messages.length > 0) { %>
          <table class="hm-admin-table">
            <thead>
              <tr>
                <th>التاريخ</th>
                <th>الاسم</th>
                <th>البريد الإلكتروني</th>
                <th>الهاتف</th>
                <th>الرسالة</th>
                <th>إجراءات</th>
              </tr>
            </thead>
            <tbody>
              <% messages.forEach(msg => { %>
              <tr>
                <td>
                  <small style="color: var(--hm-gray);">
                    <%= new Date(msg.createdAt).toLocaleDateString('ar-SA') %>
                  </small>
                </td>
                <td style="color: var(--hm-white); font-weight: 600;"><%= msg.name %></td>
                <td>
                  <a href="mailto:<%= msg.email %>" style="color: var(--hm-blue-light); text-decoration: none;">
                    <%= msg.email %>
                  </a>
                </td>
                <td>
                  <% if (msg.phone) { %>
                  <a href="tel:<%= msg.phone %>" style="color: var(--hm-blue-light); text-decoration: none;">
                    <%= msg.phone %>
                  </a>
                  <% } else { %>
                  <span style="color: var(--hm-gray);">-</span>
                  <% } %>
                </td>
                <td>
                  <small style="color: var(--hm-silver);">
                    <%= msg.message ? msg.message.substring(0, 50) + (msg.message.length > 50 ? '...' : '') : '-' %>
                  </small>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <button class="hm-btn-admin hm-btn-admin-primary hm-btn-admin-sm" data-id="<%= msg._id %>" data-name="<%= msg.name %>" data-email="<%= msg.email %>" data-phone="<%= msg.phone || '' %>" data-message="<%= msg.message ? msg.message.replace(/"/g, '&quot;') : '' %>" onclick="showMessageFromBtn(this)" title="عرض">
                      <i class="fas fa-eye"></i>
                    </button>
                    <% if (msg.email) { %>
                    <a href="mailto:<%= msg.email %>" class="hm-btn-admin hm-btn-admin-success hm-btn-admin-sm" title="رد بالبريد">
                      <i class="fas fa-reply"></i>
                    </a>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
          <div class="hm-empty-state">
            <div class="hm-empty-icon">
              <i class="fas fa-inbox"></i>
            </div>
            <h3 class="hm-empty-title">لا توجد رسائل</h3>
            <p class="hm-empty-text">لم يتم استلام أي رسائل من العملاء بعد</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Message Modal -->
<div class="hm-modal-overlay" id="messageModal" onclick="closeMessageModal(event)">
  <div class="hm-modal" onclick="event.stopPropagation()">
    <div class="hm-modal-header">
      <h3 class="hm-modal-title" id="modalTitle">تفاصيل الرسالة</h3>
      <button class="hm-modal-close" onclick="closeMessageModal()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="hm-modal-body">
      <div class="hm-admin-form-group">
        <label class="hm-admin-label">الاسم</label>
        <div id="modalName" style="color: var(--hm-white);"></div>
      </div>
      <div class="hm-admin-form-group">
        <label class="hm-admin-label">البريد الإلكتروني</label>
        <div id="modalEmail" style="color: var(--hm-blue-light);"></div>
      </div>
      <div class="hm-admin-form-group">
        <label class="hm-admin-label">الهاتف</label>
        <div id="modalPhone" style="color: var(--hm-silver);"></div>
      </div>
      <div class="hm-admin-form-group">
        <label class="hm-admin-label">الرسالة</label>
        <div id="modalMessage" style="color: var(--hm-silver); white-space: pre-wrap; padding: 1rem; background: var(--hm-glass-bg); border-radius: 8px;"></div>
      </div>
    </div>
    <div class="hm-modal-footer">
      <button class="hm-btn-admin hm-btn-admin-secondary" onclick="closeMessageModal()">إغلاق</button>
      <a id="modalReplyBtn" href="" class="hm-btn-admin hm-btn-admin-primary">
        <i class="fas fa-reply"></i>
        رد بالبريد
      </a>
    </div>
  </div>
</div>

<style>
.hm-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
}

.hm-modal-overlay.show {
  display: flex;
}

.hm-modal {
  width: 100%;
  max-width: 600px;
  background: var(--hm-royal-navy);
  border: 1px solid var(--hm-glass-border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
  animation: modalAppear 0.3s ease;
}

@keyframes modalAppear {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.hm-modal-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--hm-glass-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hm-modal-title {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--hm-white);
  margin: 0;
}

.hm-modal-close {
  width: 36px;
  height: 36px;
  background: var(--hm-glass-bg);
  border: none;
  border-radius: 10px;
  color: var(--hm-silver);
  cursor: pointer;
  transition: all 0.2s;
}

.hm-modal-close:hover {
  background: rgba(239, 68, 68, 0.2);
  color: #fca5a5;
}

.hm-modal-body {
  padding: 1.5rem;
}

.hm-modal-footer {
  padding: 1rem 1.5rem;
  border-top: 1px solid var(--hm-glass-border);
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
}
</style>

<script>
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  sidebar.classList.toggle('open');
}

document.addEventListener('click', function(e) {
  const sidebar = document.getElementById('adminSidebar');
  const toggle = document.querySelector('.hm-mobile-toggle');
  
  if (window.innerWidth <= 1024) {
    if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
      sidebar.classList.remove('open');
    }
  }
});

function showMessageFromBtn(btn) {
  const name = btn.dataset.name;
  const email = btn.dataset.email;
  const phone = btn.dataset.phone;
  const message = btn.dataset.message.replace(/&quot;/g, '"');
  showMessage(name, email, phone, message);
}

function showMessage(name, email, phone, message) {
  document.getElementById('modalName').textContent = name;
  document.getElementById('modalEmail').textContent = email;
  document.getElementById('modalPhone').textContent = phone || '-';
  document.getElementById('modalMessage').textContent = message || '-';
  document.getElementById('modalReplyBtn').href = 'mailto:' + email;
  document.getElementById('messageModal').classList.add('show');
}

function closeMessageModal(e) {
  if (e && e.target !== e.currentTarget) return;
  document.getElementById('messageModal').classList.remove('show');
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeMessageModal();
  }
});
</script>
