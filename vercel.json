{
  "version": 2,
  "name": "hm-car-auction",
  "builds": [
    {
      "src": "vercel-server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "vercel-server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "vercel-server.js": {
      "maxDuration": 30
    }
  }
}
