# .env.example
# انسخ هذا الملف إلى `.env` وعبئ القيم المناسبة قبل تشغيل التطبيق

# Server Configuration
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/car-auction

# Session Configuration
SESSION_SECRET=change_me_to_a_very_secure_random_string

# Admin Configuration
ADMIN_NAME=Admin User
ADMIN_PHONE=+966500000000

# Firebase Configuration
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Cloudinary Configuration (Optional - for image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Payment Configuration (Optional - for payment processing)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# SMS Configuration (Optional - for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics Configuration (Optional - for tracking)
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# CDN Configuration (Optional - for static assets)
CDN_URL=https://your-cdn-domain.com

# Security Configuration
JWT_SECRET=your_jwt_secret_key
BCRYPT_ROUNDS=12

# Feature Flags
ENABLE_CACHE=true
ENABLE_ANALYTICS=false
ENABLE_PWA=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
# SMTP_PASS=secret

# ملاحظات:
# - لا تقم برفع ملف `.env` إلى المستودع.
# - احتفظ بالقيم الحساسة (مثل SESSION_SECRET وMONGO_URI) آمنة في بيئة الإنتاج.
