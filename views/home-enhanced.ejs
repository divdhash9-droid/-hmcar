<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>

<link href="/public/css/home-v3.css" rel="stylesheet">

<style>
/* Enhanced Home Page Styles */
.hm-home {
  min-height: 100vh;
  background: linear-gradient(135deg, #0b1f3a 0%, #1a3a52 50%, #0d2339 100%);
  position: relative;
  overflow: hidden;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Background Particles */
.hm-home::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: 
    radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 40% 60%, rgba(212, 175, 55, 0.05) 0%, transparent 50%);
  animation: floatParticles 20s ease-in-out infinite;
}

@keyframes floatParticles {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(180deg); }
}

/* Top Navigation */
.hm-home__top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 2rem;
  background: rgba(11, 31, 58, 0.3);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(212, 175, 55, 0.1);
}

.hm-home__brand {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.hm-home__logo {
  width: 60px;
  height: 60px;
  object-fit: contain;
  filter: drop-shadow(0 4px 15px rgba(212, 175, 55, 0.4));
  transition: transform 0.3s ease;
}

.hm-home__logo:hover {
  transform: scale(1.05) rotate(5deg);
}

.hm-home__topRight {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.hm-home__langBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 50%;
  color: #d4af37;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.hm-home__langBtn:hover {
  background: rgba(212, 175, 55, 0.2);
  border-color: #d4af37;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.hm-home__login {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, #d4af37, #ffd700);
  color: #0b1f3a;
  text-decoration: none;
  border-radius: 25px;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.hm-home__login:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 35px rgba(212, 175, 55, 0.4);
  background: linear-gradient(135deg, #ffd700, #d4af37);
}

.hm-home__login i {
  font-size: 1.1rem;
}

/* Hero Section */
.hm-home__hero {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 2rem;
  text-align: center;
}

.hm-home__title {
  font-size: 4rem;
  font-weight: 800;
  color: #d4af37;
  margin: 0 0 1rem 0;
  text-shadow: 0 4px 20px rgba(212, 175, 55, 0.5);
  letter-spacing: 2px;
  animation: glowText 2s ease-in-out infinite alternate;
}

@keyframes glowText {
  from { text-shadow: 0 4px 20px rgba(212, 175, 55, 0.5); }
  to { text-shadow: 0 4px 30px rgba(212, 175, 55, 0.8); }
}

.hm-home__subtitle {
  font-size: 1.5rem;
  color: rgba(255, 255, 255, 0.9);
  margin: 0 0 3rem 0;
  max-width: 600px;
  line-height: 1.6;
}

/* Search Section */
.hm-home__search {
  width: 100%;
  max-width: 800px;
  margin-bottom: 3rem;
}

.hm-search__form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  padding: 2rem;
}

.hm-search__row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.hm-search__group {
  flex: 1;
  min-width: 200px;
  position: relative;
}

.hm-search__icon {
  position: absolute;
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: #d4af37;
  font-size: 1.1rem;
  z-index: 2;
}

.hm-search__input,
.hm-search__select {
  width: 100%;
  padding: 1rem 3rem 1rem 1rem;
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid rgba(212, 175, 55, 0.2);
  border-radius: 12px;
  color: #fff;
  font-size: 1rem;
  transition: all 0.3s ease;
}

.hm-search__input:focus,
.hm-search__select:focus {
  outline: none;
  border-color: #d4af37;
  background: rgba(255, 255, 255, 0.15);
  box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
  transform: translateY(-2px);
}

.hm-search__input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.hm-search__select option {
  background: #0b1f3a;
  color: #fff;
}

.hm-search__button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1rem 2rem;
  background: linear-gradient(135deg, #d4af37, #ffd700);
  color: #0b1f3a;
  border: none;
  border-radius: 12px;
  font-size: 1.1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.hm-search__button:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 35px rgba(212, 175, 55, 0.4);
  background: linear-gradient(135deg, #ffd700, #d4af37);
}

/* Features Section */
.hm-home__features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  width: 100%;
  max-width: 1200px;
  margin-bottom: 3rem;
}

.hm-feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  transition: all 0.3s ease;
}

.hm-feature:hover {
  transform: translateY(-5px);
  background: rgba(255, 255, 255, 0.1);
  border-color: #d4af37;
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.3);
}

.hm-feature__icon {
  font-size: 3rem;
  color: #d4af37;
  margin-bottom: 1rem;
}

.hm-feature__title {
  font-size: 1.3rem;
  font-weight: 600;
  color: #fff;
  margin: 0 0 0.5rem 0;
}

.hm-feature__desc {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  line-height: 1.5;
}

/* Stats Section */
.hm-home__stats {
  display: flex;
  justify-content: center;
  gap: 3rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

.hm-stat {
  text-align: center;
}

.hm-stat__number {
  font-size: 2.5rem;
  font-weight: 700;
  color: #d4af37;
  margin: 0 0 0.5rem 0;
  text-shadow: 0 2px 10px rgba(212, 175, 55, 0.5);
}

.hm-stat__label {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
}

/* CTA Section */
.hm-home__cta {
  text-align: center;
  margin-bottom: 3rem;
}

.hm-home__ctaButton {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.25rem 2.5rem;
  background: linear-gradient(135deg, #d4af37, #ffd700);
  color: #0b1f3a;
  text-decoration: none;
  border-radius: 30px;
  font-size: 1.2rem;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

.hm-home__ctaButton:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.5);
  background: linear-gradient(135deg, #ffd700, #d4af37);
}

/* Responsive Design */
@media (max-width: 768px) {
  .hm-home__top {
    padding: 1rem;
  }
  
  .hm-home__logo {
    width: 50px;
    height: 50px;
  }
  
  .hm-home__title {
    font-size: 2.5rem;
  }
  
  .hm-home__subtitle {
    font-size: 1.2rem;
  }
  
  .hm-search__form {
    padding: 1.5rem;
  }
  
  .hm-search__row {
    flex-direction: column;
  }
  
  .hm-home__features {
    grid-template-columns: 1fr;
  }
  
  .hm-home__stats {
    gap: 2rem;
  }
  
  .hm-stat__number {
    font-size: 2rem;
  }
}

@media (max-width: 480px) {
  .hm-home__top {
    padding: 0.75rem;
  }
  
  .hm-home__logo {
    width: 40px;
    height: 40px;
  }
  
  .hm-home__topRight {
    gap: 1rem;
  }
  
  .hm-home__login {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }
  
  .hm-home__title {
    font-size: 2rem;
  }
  
  .hm-home__subtitle {
    font-size: 1rem;
  }
  
  .hm-search__form {
    padding: 1rem;
  }
  
  .hm-feature {
    padding: 1.5rem;
  }
  
  .hm-feature__icon {
    font-size: 2.5rem;
  }
}

/* Performance Optimizations */
.hm-home {
  will-change: transform;
  backface-visibility: hidden;
}

.hm-home__logo,
.hm-home__login,
.hm-search__button,
.hm-feature {
  will-change: transform;
  backface-visibility: hidden;
}

/* Smooth Animations */
* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
</style>

<% const isLoggedIn = !!(typeof currentUser !== 'undefined' && currentUser); %>
<% const loginWithReturnTo = (path) => `/auth/login?returnTo=${encodeURIComponent(path)}`; %>

<div class="hm-home">
  <header class="hm-home__top">
    <a class="hm-home__brand" href="/" aria-label="HM CAR">
      <img class="hm-home__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
    </a>

    <div class="hm-home__topRight">
      <div class="hm-home__lang">
        <% if (typeof locale !== 'undefined' && locale === 'ar') { %>
          <a class="hm-home__langBtn" href="?lang=en" title="English">EN</a>
        <% } else { %>
          <a class="hm-home__langBtn" href="?lang=ar" title="العربية">عر</a>
        <% } %>
      </div>

      <a class="hm-home__login" href="/auth/login">
        <i class="fas fa-right-to-bracket"></i>
        <span>تسجيل الدخول / Login</span>
      </a>
    </div>
  </header>

  <main class="hm-home__hero">
    <h1 class="hm-home__title">HM CAR</h1>
    <p class="hm-home__subtitle">
      مزادات السيارات الفاخرة في المملكة العربية السعودية<br>
      Luxury Car Auctions in Saudi Arabia
    </p>

    <div class="hm-home__search">
      <form class="hm-search__form" action="/search" method="GET">
        <div class="hm-search__row">
          <div class="hm-search__group">
            <i class="hm-search__icon fas fa-search"></i>
            <input type="text" name="q" class="hm-search__input" placeholder="ابحث عن سيارتك أحلامك...">
          </div>
          <div class="hm-search__group">
            <i class="hm-search__icon fas fa-car"></i>
            <select name="brand" class="hm-search__select">
              <option value="">جميع الماركات</option>
              <option value="toyota">تويوتا</option>
              <option value="mercedes">مرسيدس</option>
              <option value="bmw">بي إم دبليو</option>
              <option value="audi">أودي</option>
              <option value="lexus">لكزس</option>
            </select>
          </div>
          <div class="hm-search__group">
            <i class="hm-search__icon fas fa-money-bill-wave"></i>
            <select name="minPrice" class="hm-search__select">
              <option value="">السعر الأدنى</option>
              <option value="50000">50,000 ريال</option>
              <option value="100000">100,000 ريال</option>
              <option value="200000">200,000 ريال</option>
              <option value="300000">300,000 ريال</option>
            </select>
          </div>
          <div class="hm-search__group">
            <i class="hm-search__icon fas fa-money-bill-wave"></i>
            <select name="maxPrice" class="hm-search__select">
              <option value="">السعر الأعلى</option>
              <option value="100000">100,000 ريال</option>
              <option value="200000">200,000 ريال</option>
              <option value="300000">300,000 ريال</option>
              <option value="500000">500,000 ريال</option>
            </select>
          </div>
        </div>
        <button type="submit" class="hm-search__button">
          <i class="fas fa-search"></i>
          <span>بحث</span>
        </button>
      </form>
    </div>

    <div class="hm-home__features">
      <div class="hm-feature">
        <i class="hm-feature__icon fas fa-gavel"></i>
        <h3 class="hm-feature__title">مزادات حية</h3>
        <p class="hm-feature__desc">شارك في مزادات سيارات فاخرة في الوقت الفعلي</p>
      </div>
      <div class="hm-feature">
        <i class="hm-feature__icon fas fa-shield-alt"></i>
        <h3 class="hm-feature__title">آمن وموثوق</h3>
        <p class="hm-feature__desc">منصة آمنة للمعاملات المالية وتبادل المعلومات</p>
      </div>
      <div class="hm-feature">
        <i class="hm-feature__icon fas fa-globe"></i>
        <h3 class="hm-feature__title">تصدير عالمي</h3>
        <p class="hm-feature__desc">تصدير السيارات وقطع الغيار إلى جميع دول العالم</p>
      </div>
    </div>

    <% if (stats) { %>
    <div class="hm-home__stats">
      <div class="hm-stat">
        <div class="hm-stat__number"><%= stats.totalCars || 0 %></div>
        <div class="hm-stat__label">سيارة متاحة</div>
      </div>
      <div class="hm-stat">
        <div class="hm-stat__number"><%= stats.activeAuctions || 0 %></div>
        <div class="hm-stat__label">مزاد نشط</div>
      </div>
      <div class="hm-stat">
        <div class="hm-stat__number"><%= stats.happyCustomers || 0 %></div>
        <div class="hm-stat__label">عميل سعيد</div>
      </div>
    </div>
    <% } %>

    <div class="hm-home__cta">
      <a href="/cars" class="hm-home__ctaButton">
        <i class="fas fa-car"></i>
        <span>استكشف السيارات</span>
      </a>
    </div>
  </main>
</div>

<script>
// Enhanced Home Page Interactions
document.addEventListener('DOMContentLoaded', function() {
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // Form validation
  const searchForm = document.querySelector('.hm-search__form');
  if (searchForm) {
    searchForm.addEventListener('submit', function(e) {
      const searchInput = this.querySelector('.hm-search__input');
      if (searchInput && searchInput.value.trim() === '') {
        e.preventDefault();
        searchInput.focus();
        searchInput.style.borderColor = '#ff6b6b';
        setTimeout(() => {
          searchInput.style.borderColor = '';
        }, 2000);
      }
    });
  }

  // Add loading states
  const buttons = document.querySelectorAll('.hm-search__button, .hm-home__ctaButton');
  buttons.forEach(button => {
    button.addEventListener('click', function() {
      if (!this.classList.contains('loading')) {
        this.classList.add('loading');
        const originalContent = this.innerHTML;
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>جاري التحميل...</span>';
        
        setTimeout(() => {
          this.classList.remove('loading');
          this.innerHTML = originalContent;
        }, 2000);
      }
    });
  });

  // Performance optimizations
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (prefersReducedMotion.matches) {
    document.querySelectorAll('*').forEach(el => {
      el.style.animation = 'none';
      el.style.transition = 'none';
    });
  }

  // Lazy load images
  const images = document.querySelectorAll('img[loading="lazy"]');
  images.forEach(img => {
    if (img.dataset.src) {
      img.src = img.dataset.src;
    }
  });

  // Add smooth scrolling
  document.documentElement.style.scrollBehavior = 'smooth';
});

// Add hover effects dynamically
document.querySelectorAll('.hm-feature').forEach(feature => {
  feature.addEventListener('mouseenter', function() {
    this.style.transform = 'translateY(-5px) scale(1.02)';
  });
  
  feature.addEventListener('mouseleave', function() {
    this.style.transform = 'translateY(0) scale(1)';
  });
});
</script>
