<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/users.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'hm-admin-page'; %>

<link rel="stylesheet" href="/css/admin-luxury.css">

<div class="hm-admin-layout">
  <!-- Animated Background -->
  <div class="hm-admin-bg">
    <div class="hm-admin-bg-gradient"></div>
    <div class="hm-admin-bg-glow"></div>
  </div>

  <!-- Mobile Toggle -->
  <button class="hm-mobile-toggle" onclick="toggleSidebar()">
    <i class="fas fa-bars"></i>
  </button>

  <!-- Sidebar -->
  <%- include('../partials/admin-sidebar') %>

  <!-- Main Content -->
  <main class="hm-admin-main">
    <!-- Header -->
    <header class="hm-admin-header">
      <div class="hm-header-title">
        <h1>إدارة العملاء</h1>
        <div class="hm-header-breadcrumb">
          <a href="/admin">لوحة التحكم</a>
          <i class="fas fa-chevron-left"></i>
          <span>العملاء</span>
        </div>
      </div>
      <div class="hm-header-actions">
        <a href="/admin/users-management" class="hm-btn-admin hm-btn-admin-primary">
          <i class="fas fa-user-shield"></i>
          إدارة المشرفين
        </a>
      </div>
    </header>

    <!-- Content -->
    <div class="hm-admin-content">
      <!-- Flash Messages -->
      <% if (flash && flash.message) { %>
      <div class="hm-admin-alert hm-admin-alert-<%= flash.type || 'info' %>">
        <i class="fas <%= flash.type === 'success' ? 'fa-check-circle' : flash.type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle' %>"></i>
        <span><%= flash.message %></span>
      </div>
      <% } %>

      <!-- Stats -->
      <div class="hm-stats-grid">
        <div class="hm-stat-card">
          <div class="hm-stat-icon">
            <i class="fas fa-users"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">إجمالي المستخدمين</div>
            <div class="hm-stat-value"><%= users ? users.length : 0 %></div>
          </div>
        </div>
        <div class="hm-stat-card">
          <div class="hm-stat-icon success">
            <i class="fas fa-user-check"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">عملاء نشطون</div>
            <div class="hm-stat-value"><%= users ? users.filter(u => u.role === 'buyer').length : 0 %></div>
          </div>
        </div>
        <div class="hm-stat-card">
          <div class="hm-stat-icon warning">
            <i class="fas fa-user-shield"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">المشرفون</div>
            <div class="hm-stat-value"><%= users ? users.filter(u => ['admin', 'super_admin', 'manager'].includes(u.role)).length : 0 %></div>
          </div>
        </div>
      </div>

      <!-- Users List -->
      <div class="hm-admin-card">
        <div class="hm-card-header">
          <h2 class="hm-card-title">
            <i class="fas fa-users"></i>
            قائمة المستخدمين
          </h2>
          <span class="hm-admin-badge hm-admin-badge-primary">
            <%= users ? users.length : 0 %> مستخدم
          </span>
        </div>
        <div class="hm-card-body" style="padding: 0;">
          <% if (users && users.length > 0) { %>
          <table class="hm-admin-table">
            <thead>
              <tr>
                <th>المستخدم</th>
                <th>البريد الإلكتروني</th>
                <th>الهاتف</th>
                <th>الدور</th>
                <th>تاريخ التسجيل</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--hm-blue), var(--hm-blue-light)); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700;">
                      <%= u.name ? u.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                      <div style="color: var(--hm-white); font-weight: 600;"><%= u.name || 'مستخدم' %></div>
                    </div>
                  </div>
                </td>
                <td><%= u.email || '-' %></td>
                <td><%= u.phone || '-' %></td>
                <td>
                  <% if (u.role === 'super_admin') { %>
                  <span class="hm-admin-badge hm-admin-badge-danger">
                    <i class="fas fa-crown"></i> مدير عام
                  </span>
                  <% } else if (u.role === 'admin') { %>
                  <span class="hm-admin-badge hm-admin-badge-warning">
                    <i class="fas fa-user-shield"></i> مدير
                  </span>
                  <% } else if (u.role === 'manager') { %>
                  <span class="hm-admin-badge hm-admin-badge-primary">
                    <i class="fas fa-user-tie"></i> مشرف
                  </span>
                  <% } else { %>
                  <span class="hm-admin-badge hm-admin-badge-success">
                    <i class="fas fa-user"></i> عميل
                  </span>
                  <% } %>
                </td>
                <td>
                  <small style="color: var(--hm-gray);">
                    <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('ar-SA') : '-' %>
                  </small>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="hm-empty-state">
            <div class="hm-empty-icon">
              <i class="fas fa-users"></i>
            </div>
            <h3 class="hm-empty-title">لا يوجد مستخدمون</h3>
            <p class="hm-empty-text">سيظهر المستخدمون هنا بعد التسجيل</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  sidebar.classList.toggle('open');
}

document.addEventListener('click', function(e) {
  const sidebar = document.getElementById('adminSidebar');
  const toggle = document.querySelector('.hm-mobile-toggle');
  
  if (window.innerWidth <= 1024) {
    if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
      sidebar.classList.remove('open');
    }
  }
});
</script>
