}

/* Content Section */
.hm-favorites-content {
  padding: 3rem 0;
}

/* Loading State */
.hm-loading {
  text-align: center;
  padding: 4rem 0;
}

.hm-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #e2e8f0;
  border-top: 4px solid #2366d1;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 1rem;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
