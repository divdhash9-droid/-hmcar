<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var bodyClass = 'auth-page modern-auth hm-login-v2'; %>

<% const isAdmin = !!(typeof isAdminLogin !== 'undefined' && isAdminLogin); %>
<% const returnToSafe = (typeof returnTo !== 'undefined' && returnTo) ? String(returnTo) : ''; %>
<% const adminSwitchHref = returnToSafe ? ('/auth/login?admin=true&returnTo=' + encodeURIComponent(returnToSafe)) : '/auth/login?admin=true'; %>
<% const buyerSwitchHref = returnToSafe ? ('/auth/login?returnTo=' + encodeURIComponent(returnToSafe)) : '/auth/login'; %>

<div class="hm-login2">
  <div class="hm-login2__shell">
    <section class="hm-login2__brand" aria-label="HM CAR">
      <div class="hm-login2__logoWrap">
        <img class="hm-login2__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
      </div>
      <div class="hm-login2__tag">
        <div class="hm-login2__name">HM CAR</div>
        <div class="hm-login2__desc">
          تصدير السيارات وقطع الغيار من كوريا إلى جميع دول العالم<br>
          Exporting cars and spare parts from Korea to all countries of the world
        </div>
      </div>

      <div class="hm-login2__chips" aria-label="Highlights">
        <div class="hm-chip"><i class="fas fa-gavel"></i><span>مزاد</span></div>
        <div class="hm-chip"><i class="fas fa-car"></i><span>سيارات</span></div>
        <div class="hm-chip"><i class="fas fa-gears"></i><span>قطع غيار</span></div>
        <div class="hm-chip"><i class="fas fa-globe"></i><span>تصدير عالمي</span></div>
      </div>
    </section>

    <section class="hm-login2__card" aria-label="Login">
      <div class="hm-login2__header">
        <h2 class="hm-login2__title"><%= isAdmin ? 'دخول الأدمن' : 'تسجيل الدخول' %></h2>
        <p class="hm-login2__subtitle"><%= isAdmin ? 'استخدم البريد وكلمة المرور' : 'أدخل اسمك الكامل للمتابعة' %></p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert"><%= success %></div>
      <% } %>

      <form method="POST" action="/auth/login" class="auth-form">
        <input type="hidden" name="loginRole" value="<%= isAdmin ? 'admin' : 'buyer' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <% if (isAdmin) { %>
          <div class="mb-3">
            <label class="form-label">البريد الإلكتروني</label>
            <input type="email" name="email" class="form-control" placeholder="admin@example.com" autocomplete="email" required>
          </div>

          <div class="mb-3">
            <label class="form-label">كلمة المرور</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required>
          </div>
        <% } else { %>
          <div class="mb-3">
            <label class="form-label">اسم المستخدم</label>
            <input type="text" name="name" class="form-control" placeholder="الاسم الكامل (اسمين على الأقل)" autocomplete="name" required>
            <div class="form-text">مثال: محمد أحمد</div>
          </div>
        <% } %>

        <div class="d-flex align-items-center justify-content-between mb-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="remember" name="remember">
            <label class="form-check-label" for="remember">تذكرني</label>
          </div>
        </div>

        <button type="submit" class="btn btn-gold w-100">
          <i class="fas fa-right-to-bracket"></i>
          <span>دخول</span>
        </button>
      </form>

      <div class="hm-login2__switch">
        <% if (!isAdmin) { %>
          <span>تسجيل دخول كـ</span>
          <a class="hm-link" href="<%= adminSwitchHref %>">مدير</a>
        <% } else { %>
          <span>تسجيل دخول كـ</span>
          <a class="hm-link" href="<%= buyerSwitchHref %>">عميل</a>
        <% } %>
      </div>

      <div class="hm-login2__footer">
        <a class="hm-link" href="/">العودة للرئيسية</a>
      </div>
    </section>
  </div>
</div>
