<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/spare-brands.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'hm-admin-page'; %>

<link rel="stylesheet" href="/css/admin-luxury.css">

<div class="hm-admin-layout">
  <!-- Animated Background -->
  <div class="hm-admin-bg">
    <div class="hm-admin-bg-gradient"></div>
    <div class="hm-admin-bg-glow"></div>
  </div>

  <!-- Mobile Toggle -->
  <button class="hm-mobile-toggle" onclick="toggleSidebar()">
    <i class="fas fa-bars"></i>
  </button>

  <!-- Sidebar -->
  <%- include('../partials/admin-sidebar') %>

  <!-- Main Content -->
  <main class="hm-admin-main">
    <!-- Header -->
    <header class="hm-admin-header">
      <div class="hm-header-title">
        <h1>شركات قطع الغيار</h1>
        <div class="hm-header-breadcrumb">
          <a href="/admin">لوحة التحكم</a>
          <i class="fas fa-chevron-left"></i>
          <a href="/admin/spare-parts">قطع الغيار</a>
          <i class="fas fa-chevron-left"></i>
          <span>الشركات</span>
        </div>
      </div>
      <div class="hm-header-actions">
        <a href="/admin/spare-parts" class="hm-btn-admin hm-btn-admin-secondary">
          <i class="fas fa-cogs"></i>
          قطع الغيار
        </a>
      </div>
    </header>

    <!-- Content -->
    <div class="hm-admin-content">
      <!-- Flash Messages -->
      <% if (flash && flash.message) { %>
      <div class="hm-admin-alert hm-admin-alert-<%= flash.type || 'info' %>">
        <i class="fas <%= flash.type === 'success' ? 'fa-check-circle' : flash.type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle' %>"></i>
        <span><%= flash.message %></span>
      </div>
      <% } %>

      <!-- Stats -->
      <div class="hm-stats-grid">
        <div class="hm-stat-card">
          <div class="hm-stat-icon">
            <i class="fas fa-industry"></i>
          </div>
          <div class="hm-stat-info">
            <div class="hm-stat-label">إجمالي الشركات</div>
            <div class="hm-stat-value"><%= (brands || []).length %></div>
          </div>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
        <!-- Add Form -->
        <div class="hm-admin-card">
          <div class="hm-card-header">
            <h2 class="hm-card-title">
              <i class="fas fa-plus-circle"></i>
              إضافة شركة جديدة
            </h2>
          </div>
          <div class="hm-card-body">
            <form method="post" action="/admin/spare-brands" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              
              <div class="hm-admin-form-group">
                <label class="hm-admin-label">اسم الشركة</label>
                <input type="text" name="name" class="hm-admin-input" required placeholder="أدخل اسم الشركة">
              </div>
              
              <div class="hm-admin-form-group">
                <label class="hm-admin-label">شعار الشركة</label>
                <input type="file" name="logo" class="hm-admin-input" accept="image/*">
              </div>
              
              <button type="submit" class="hm-btn-admin hm-btn-admin-primary" style="width: 100%;">
                <i class="fas fa-save"></i>
                حفظ الشركة
              </button>
            </form>
          </div>
        </div>

        <!-- Brands List -->
        <div class="hm-admin-card">
          <div class="hm-card-header">
            <h2 class="hm-card-title">
              <i class="fas fa-list"></i>
              قائمة الشركات
            </h2>
            <span class="hm-admin-badge hm-admin-badge-primary">
              <%= (brands || []).length %> شركة
            </span>
          </div>
          <div class="hm-card-body" style="padding: 0;">
            <% if (brands && brands.length > 0) { %>
            <table class="hm-admin-table">
              <thead>
                <tr>
                  <th>الشعار</th>
                  <th>اسم الشركة</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody>
                <% brands.forEach(brand => { %>
                <tr>
                  <td>
                    <% if (brand.logo) { %>
                    <img src="<%= brand.logo %>" alt="<%= brand.name %>" style="width: 56px; height: 40px; object-fit: contain; background: white; border-radius: 8px; padding: 4px;">
                    <% } else { %>
                    <div style="width: 56px; height: 40px; background: var(--hm-glass-bg); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                      <i class="fas fa-building" style="color: var(--hm-gray);"></i>
                    </div>
                    <% } %>
                  </td>
                  <td style="color: var(--hm-white); font-weight: 600;"><%= brand.name %></td>
                  <td>
                    <div style="display: flex; gap: 0.5rem;">
                      <form method="post" action="/admin/spare-brands/<%= brand._id %>/delete" style="display: inline;" onsubmit="return confirm('هل تريد حذف هذه الشركة؟');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="hm-btn-admin hm-btn-admin-danger hm-btn-admin-sm" title="حذف">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <% } else { %>
            <div class="hm-empty-state">
              <div class="hm-empty-icon">
                <i class="fas fa-industry"></i>
              </div>
              <h3 class="hm-empty-title">لا توجد شركات</h3>
              <p class="hm-empty-text">أضف شركة من النموذج على اليمين</p>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<style>
@media (max-width: 1024px) {
  div[style*="grid-template-columns: 1fr 2fr"] {
    grid-template-columns: 1fr !important;
  }
}
</style>

<script>
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  sidebar.classList.toggle('open');
}

document.addEventListener('click', function(e) {
  const sidebar = document.getElementById('adminSidebar');
  const toggle = document.querySelector('.hm-mobile-toggle');
  
  if (window.innerWidth <= 1024) {
    if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
      sidebar.classList.remove('open');
    }
  }
});
</script>
