<footer class="footer-luxury">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4">
        <h5 class="mb-3">HM CAR</h5>
        <p class="text-muted">
          <%= __('footer.luxuryDescription') %>
        </p>
      </div>
      <div class="col-lg-2 col-md-6">
        <h5 class="mb-3"><%= __('footer.quickLinksTitle') %></h5>
        <ul class="list-unstyled">
          <li><a href="/cars"><%= __('navigation.cars') %></a></li>
          <li><a href="/spare-parts"><%= __('footer.links.spareParts') %></a></li>
