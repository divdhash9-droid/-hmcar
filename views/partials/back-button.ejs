<%
  const safeUrl = (typeof currentUrl !== 'undefined') ? currentUrl : '';
  const pathOnly = String(safeUrl || '').split('?')[0];
  const isHome = pathOnly === '/' || pathOnly === '';
  const role = (typeof currentUser !== 'undefined' && currentUser && currentUser.role) ? String(currentUser.role) : '';
  const isAdminHome = pathOnly === '/admin';
  const isBuyerHome = pathOnly === '/cars' && role === 'buyer';
  const shouldShow = !isHome && !isAdminHome && !isBuyerHome;
  const iconClass = (typeof locale !== 'undefined' && locale === 'ar') ? 'fa-arrow-right' : 'fa-arrow-left';
%>

<% if (shouldShow) { %>
  <div class="hm-backbar" role="navigation" aria-label="رجوع">
    <button type="button" class="hm-btn hm-btn-3d hm-btn-back" data-hm-back="1">
      <i class="fas <%= iconClass %>" aria-hidden="true"></i>
      <span>رجوع</span>
    </button>
  </div>
<% } %>
