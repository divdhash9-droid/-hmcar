<div class="chat-window" id="chatWindow">
  <div class="chat-header">
    <div class="chat-user-info">
      <div class="user-avatar" id="chatUserAvatar">
        <i class="fas fa-user"></i>
      </div>
      <div class="user-details">
        <h6 id="chatUserName">اختر محادثة</h6>
        <small id="chatUserStatus">متصل</small>
      </div>
    </div>
    <div class="chat-actions">
      <button class="btn btn-sm btn-outline-secondary" id="minimizeChat">
        <i class="fas fa-minus"></i>
      </button>
      <button class="btn btn-sm btn-outline-secondary" id="closeChat">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
  
  <div class="chat-messages" id="chatMessages">
    <div class="no-conversation-selected">
      <i class="fas fa-comments fa-3x text-muted"></i>
      <p class="text-muted">اختر محادثة لبدء الدردشة</p>
    </div>
  </div>
  
  <div class="chat-input-container" id="chatInputContainer" style="display: none;">
    <div class="chat-input-actions">
      <button class="btn btn-sm btn-outline-secondary" id="attachFile">
        <i class="fas fa-paperclip"></i>
      </button>
      <button class="btn btn-sm btn-outline-secondary" id="sendImage">
        <i class="fas fa-image"></i>
      </button>
    </div>
    <div class="chat-input-wrapper">
      <textarea 
        class="form-control" 
        id="messageInput" 
        placeholder="اكتب رسالتك..."
        rows="1"
      ></textarea>
      <button class="btn btn-primary" id="sendMessage">
        <i class="fas fa-paper-plane"></i>
      </button>
    </div>
  </div>
</div>

<style>
