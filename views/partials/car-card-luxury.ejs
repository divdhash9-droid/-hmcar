<!-- [[ARABIC_HEADER]] هذا الملف (views/partials/car-card-luxury.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->
<!-- بطاقة سيارة فاخرة مع صور محسّنة وتأثيرات تفاعلية -->

<div class="luxury-card-container" data-car-id="<%= car._id %>">
    <div class="luxury-card">
        <!-- رأس البطاقة مع الصورة المحسّنة -->
        <div class="luxury-card-header">
            <a href="/cars/<%= car._id %>" class="luxury-image-link">
                <div class="luxury-image-wrapper">
                    <% if (car.images && car.images.length > 0) { %>
                        <% if (car.processedImages && car.processedImages[0] && car.processedImages[0].thumbnail) { %>
                            <!-- استخدام الصورة المصغرة المحسّنة -->
                            <img src="<%= car.processedImages[0].thumbnail %>" 
                                 alt="<%= car.title %>" 
                                 class="luxury-main-image"
                                 loading="lazy"
                                 onerror="this.src='<%= car.images[0] %>'">
                        <% } else { %>
                            <!-- الصورة الأصلية كنسخة احتياطية -->
                            <img src="<%= car.images[0] %>" 
                                 alt="<%= car.title %>" 
                                 class="luxury-main-image"
                                 loading="lazy">
                        <% } %>
                        
                        <!-- معرض الصور المصغرة -->
                        <% if (car.images.length > 1) { %>
                            <div class="luxury-thumbnails">
                                <% car.images.slice(1, 4).forEach((image, index) => { %>
                                    <div class="luxury-thumbnail">
                                        <% if (car.processedImages && car.processedImages[index + 1] && car.processedImages[index + 1].icon) { %>
                                            <img src="<%= car.processedImages[index + 1].icon %>" 
                                                 alt="صورة <%= index + 2 %>"
                                                 loading="lazy">
                                        <% } else { %>
                                            <img src="<%= image %>" 
                                                 alt="صورة <%= index + 2 %>"
                                                 loading="lazy">
                                        <% } %>
                                    </div>
                                <% }); %>
                                <% if (car.images.length > 4) { %>
                                    <div class="luxury-thumbnail more-images">
                                        +<%= car.images.length - 4 %>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <!-- صورة نائبة فاخرة -->
                        <div class="luxury-placeholder">
                            <div class="luxury-placeholder-content">
                                <i class="fas fa-car luxury-placeholder-icon"></i>
                                <h4>سيارة فاخرة</h4>
                                <p>لا توجد صور متاحة</p>
                            </div>
                        </div>
                    <% } %>
                    
                    <!-- شارات الحالة -->
                    <div class="luxury-badges">
                        <% if (car.isSold) { %>
                            <span class="luxury-badge luxury-badge-sold">
                                <i class="fas fa-check-circle"></i>
                                تم البيع
                            </span>
                        <% } else if (car.listingType === 'auction') { %>
                            <span class="luxury-badge luxury-badge-auction">
                                <i class="fas fa-gavel"></i>
                                مزاد
                            </span>
                        <% } else if (car.isActive) { %>
                            <span class="luxury-badge luxury-badge-available">
                                <i class="fas fa-check"></i>
                                متوفر
                            </span>
                        <% } %>
                        
                        <% if (car.condition === 'excellent') { %>
                            <span class="luxury-badge luxury-badge-condition">
                                <i class="fas fa-star"></i>
                                ممتازة
                            </span>
                        <% } %>
                    </div>
                    
                    <!-- تأثيرات التفاعل -->
                    <div class="luxury-overlay">
                        <div class="luxury-overlay-content">
                            <button class="luxury-overlay-btn">
                                <i class="fas fa-search-plus"></i>
                                عرض سريع
                            </button>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        
        <!-- محتوى البطاقة -->
        <div class="luxury-card-body">
            <!-- العنوان والشعار -->
            <div class="luxury-title-section">
                <div class="luxury-brand">
                    <% if (car.makeLogoUrl) { %>
                        <img src="<%= car.makeLogoUrl %>" 
                             alt="<%= car.make %>" 
                             class="luxury-brand-logo"
                             loading="lazy">
                    <% } else { %>
                        <div class="luxury-brand-placeholder">
                            <i class="fas fa-crown"></i>
                        </div>
                    <% } %>
                </div>
                <div class="luxury-title-info">
                    <h3 class="luxury-title">
                        <a href="/cars/<%= car._id %>"><%= car.title %></a>
                    </h3>
                    <p class="luxury-subtitle">
                        <%= car.make %> <%= car.model %> <%= car.year %>
                    </p>
                </div>
            </div>
            
            <!-- المواصفات -->
            <div class="luxury-specs">
                <div class="luxury-spec-item">
                    <div class="luxury-spec-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div class="luxury-spec-info">
                        <span class="luxury-spec-label">سنة الصنع</span>
                        <span class="luxury-spec-value"><%= car.year || 'N/A' %></span>
                    </div>
                </div>
                
                <div class="luxury-spec-item">
                    <div class="luxury-spec-icon">
                        <i class="fas fa-tachometer-alt"></i>
                    </div>
                    <div class="luxury-spec-info">
                        <span class="luxury-spec-label">المسافة</span>
                        <span class="luxury-spec-value">
                            <%= car.mileage ? car.mileage.toLocaleString() + ' كم' : 'N/A' %>
                        </span>
                    </div>
                </div>
                
                <div class="luxury-spec-item">
                    <div class="luxury-spec-icon">
                        <i class="fas fa-cog"></i>
                    </div>
                    <div class="luxury-spec-info">
                        <span class="luxury-spec-label">الحالة</span>
                        <span class="luxury-spec-value">
                            <% 
                            const conditionMap = {
                                'excellent': 'ممتازة',
                                'good': 'جيدة',
                                'fair': 'متوسطة',
                                'poor': 'سيئة'
                            };
                            %>
                            <%= conditionMap[car.condition] || car.condition || 'N/A' %>
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- السعر -->
            <div class="luxury-price-section">
                <div class="luxury-price-main">
                    <% if (car.priceSar) { %>
                        <span class="luxury-price-amount"><%= car.priceSar.toLocaleString() %></span>
                        <span class="luxury-price-currency">ريال سعودي</span>
                    <% } else if (car.price) { %>
                        <span class="luxury-price-amount"><%= car.price.toLocaleString() %></span>
                        <span class="luxury-price-currency">ريال</span>
                    <% } else { %>
                        <span class="luxury-price-contact">السعر عند الطلب</span>
                    <% } %>
                </div>
                
                <% if (car.priceUsd) { %>
                    <div class="luxury-price-secondary">
                        ≈ <%= car.priceUsd.toLocaleString() %> USD
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- أزرار الإجراءات -->
        <div class="luxury-card-footer">
            <a href="/cars/<%= car._id %>" class="luxury-btn luxury-btn-primary">
                <i class="fas fa-eye"></i>
                <span>التفاصيل</span>
            </a>
            
            <% if (currentUser && (currentUser.role === 'buyer' || currentUser.role === 'user')) { %>
                <button class="luxury-btn luxury-btn-favorite" 
                        data-car-id="<%= car._id %>" 
                        onclick="toggleLuxuryFavorite(this)">
                    <i class="far fa-heart"></i>
                </button>
            <% } %>
            
            <% if (currentUser && currentUser.role === 'admin') { %>
                <a href="/cars/<%= car._id %>/edit" class="luxury-btn luxury-btn-edit">
                    <i class="fas fa-edit"></i>
                </a>
            <% } %>
        </div>
    </div>
</div>

<script>
function toggleLuxuryFavorite(button) {
    const carId = button.getAttribute('data-car-id');
    const icon = button.querySelector('i');
    const isActive = button.classList.contains('active');
    
    // تبديل الحالة المرئية
    if (isActive) {
        button.classList.remove('active');
        icon.className = 'far fa-heart';
    } else {
        button.classList.add('active');
        icon.className = 'fas fa-heart';
        
        // تأثير نابض
        button.style.transform = 'scale(1.2)';
        setTimeout(() => {
            button.style.transform = 'scale(1)';
        }, 200);
    }
    
    // إرسال طلب إلى الخادم
    fetch('/api/favorites/toggle', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
        },
        body: JSON.stringify({ carId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            console.log('Favorite updated successfully');
        }
    })
    .catch(error => {
        console.error('Error updating favorite:', error);
    });
}

// تأثيرات حركية عند التمرير
document.addEventListener('DOMContentLoaded', function() {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('luxury-card-visible');
            }
        });
    }, {
        threshold: 0.1
    });
    
    document.querySelectorAll('.luxury-card-container').forEach(card => {
        observer.observe(card);
    });
});
</script>

