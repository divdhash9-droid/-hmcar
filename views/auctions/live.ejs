<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero hm-bg-gold" aria-label="المزادات المباشرة">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title hm-text-white">المزادات المباشرة</h1>
            <div class="hm-hero__subtitle hm-text-white">شاهد المزادات الحية وشارك فيها</div>
          </div>
        </div>
      </div>
    </header>
    
    <!-- Live Auction Content -->
    <div class="hm-section">
      <% if (isEnded) { %>
        <div class="hm-card text-center py-5">
          <div class="hm-icon-container hm-icon-container-light mx-auto mb-3">
            <i class="fas fa-clock hm-icon-2xl hm-icon-muted"></i>
          </div>
          <h5 class="hm-text-blue">المزاد انتهى</h5>
          <div class="hm-text-muted">هذا المزاد قد انتهى. يمكنك مشاهدة النتائج.</div>
        </div>
      <% } else if (!liveAuctionUrl) { %>
        <div class="hm-card text-center py-5">
          <div class="hm-icon-container hm-icon-container-light mx-auto mb-3">
            <i class="fas fa-exclamation-triangle hm-icon-2xl hm-icon-muted"></i>
          </div>
          <h5 class="hm-text-blue">المزاد غير متاح</h5>
          <div class="hm-text-muted">المزاد غير متاح حالياً. يرجى المحاولة لاحقاً.</div>
        </div>
      <% } else { %>
        <div class="hm-card p-3 mb-4">
          <iframe 
            src="<%= liveAuctionUrl %>" 
            class="w-100"
            style="height: 600px; border: none; border-radius: var(--hm-radius-lg);"
            frameborder="0"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>

        <div class="mb-4">
          <a href="<%= liveAuctionUrl %>" target="_blank" rel="noopener" class="hm-btn hm-btn-outline w-100">
            <i class="fas fa-external-link-alt"></i> <%= liveAuctionUrl %>
          </a>
        </div>

        <!-- Snapshot Info -->
        <% if (snapshot && snapshot.updatedAt) { %>
          <div class="hm-card p-3 mb-3">
            <i class="fas fa-sync me-2"></i> آخر تحديث: <%= new Date(snapshot.updatedAt).toLocaleString('en-US') %>
          </div>
        <% } %>

        <% if (snapshot && snapshot.error) { %>
          <div class="hm-card p-3 mb-3">
            <i class="fas fa-exclamation-triangle me-2"></i> <%= snapshot.error %>
          </div>
        <% } %>

        <!-- Cars from Snapshot -->
        <% if (snapshot && snapshot.cars && snapshot.cars.length) { %>
          <div class="hm-grid hm-grid--responsive">
            <% snapshot.cars.forEach((c, idx) => { %>
              <div class="hm-card">
                <% if (c.imageUrl) { %>
                  <img src="<%= c.imageUrl %>" class="w-100" style="height: 200px; object-fit: cover; border-radius: var(--hm-radius-lg) var(--hm-radius-lg) 0 0;" alt="<%= c.title || 'سيارة' %>" loading="lazy" decoding="async" />
                <% } %>
                
                <div class="p-3">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0"><%= c.title || 'سيارة' %></h6>
                    <span class="hm-text-muted small">#<%= idx + 1 %></span>
                  </div>
                  
                  <% if (c.currentPriceText) { %>
                    <div class="hm-text-muted small mb-2">السعر الحالي: <%= c.currentPriceText %></div>
                  <% } %>
                  
                  <div class="d-flex flex-wrap gap-2">
                    <% if (c.externalUrl) { %>
                      <a class="hm-btn hm-btn-sm hm-btn-outline" href="<%= c.externalUrl %>" target="_blank" rel="noopener">
                        <i class="fas fa-external-link-alt"></i> عرض في Lotte
                      </a>
                    <% } %>

                    <% if (waNumber) { %>
                      <% 
                        const lines = [
                          'طلب سيارة من مزاد كوريا (Lotte) عبر HM CAR',
                          `السيارة: ${c.title || ''}`,
                          c.currentPriceText ? `السعر الحالي: ${c.currentPriceText}` : '',
                          c.externalUrl ? `رابط السيارة في Lotte: ${c.externalUrl}` : '',
                          `رابط المزاد داخل HM CAR: ${pageUrl}`
                        ].filter(Boolean); 
                      %>
                      <a class="hm-btn hm-btn-sm hm-btn-success" href="https://wa.me/<%= waNumber %>?text=<%= encodeURIComponent(lines.join('\\n')) %>" target="_blank" rel="noopener">
                        <i class="fab fa-whatsapp"></i> واتساب للإدارة
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- Loading State -->
    <% if (!snapshot && !isEnded && liveAuctionUrl) { %>
      <div class="hm-card text-center py-5">
        <div class="hm-icon-container hm-icon-container-light mx-auto mb-3">
          <i class="fas fa-spinner hm-icon-2xl hm-icon-muted"></i>
        </div>
        <h5 class="hm-text-blue">جاري تحميل سيارات المزاد</h5>
        <div class="hm-text-muted">إذا كان هذا أول تشغيل اليوم، انتظر قليلاً ثم أعد تحديث الصفحة.</div>
      </div>
    <% } %>
  </div>
</div>
