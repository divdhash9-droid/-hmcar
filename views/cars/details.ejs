<!-- [[ARABIC_HEADER]] هذا الملف (views/cars/details.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% var hideNavbar = (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'buyer'); %>
<% layout('layout') -%>

<!-- HM Design System CSS -->
<link rel="stylesheet" href="/css/design-system.css">

<div class="hm-dashboard">
  <div class="hm-dashboard__container">
    <header class="hm-hero hm-bg-gold" aria-label="تفاصيل السيارة">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title hm-text-white"><%= car.title %></h1>
            <div class="hm-hero__subtitle hm-text-white"><%= car.make %> <%= car.model %> - <%= car.year %></div>
          </div>
        </div>
      </div>
    </header>
    
    <div class="hm-grid hm-grid--responsive">
      <!-- Image Gallery -->
      <div class="col-md-6">
        <div class="hm-card">
          <div class="main-image mb-3">
            <img src="<%= (car.images && car.images.length > 0) ? car.images[0] : '/images/placeholder.png' %>" alt="<%= car.title %>" id="mainImage" style="width: 100%; height: auto; border-radius: var(--hm-radius-lg);">
          </div>
          <% if (car.images && car.images.length > 1) { %>
            <div class="thumbnail-strip d-flex gap-2" style="overflow-x: auto; padding: 10px 0;">
              <% car.images.forEach(image => { %>
                <img src="<%= image %>" alt="Thumbnail" class="thumbnail" style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--hm-radius-md); cursor: pointer; border: 2px solid transparent;" onclick="changeImage('<%= image %>')" onmouseover="this.style.borderColor='var(--hm-gold-primary)'" onmouseout="this.style.borderColor='transparent'">
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Car Info and Actions -->
      <div class="col-md-6">
        <div class="hm-card">
          <div class="price-section d-flex justify-content-between align-items-center mb-4">
            <span class="hm-text-gold fs-3 fw-bold">
              <% if (car.priceSar) { %>
                <%= car.priceSar.toLocaleString() %> ريال
              <% } else if (car.price) { %>
                <%= car.price.toLocaleString() %> ريال
              <% } else { %>
                السعر عند الطلب
              <% } %>
            </span>
            <span class="hm-chip <%= car.isSold ? 'hm-chip-light' : (car.listingType === 'auction' ? 'hm-chip-gold' : 'hm-chip-gold') %>">
              <% if (car.isSold) { %>
                <i class="fas fa-check"></i>
                <span>تم البيع</span>
              <% } else if (car.listingType === 'auction') { %>
                <i class="fas fa-gavel"></i>
                <span>متوفر في مزاد</span>
              <% } else { %>
                <i class="fas fa-check-circle"></i>
                <span>متوفر للبيع</span>
              <% } %>
            </span>
          </div>

          <div class="specs-grid mb-4">
            <div class="d-flex justify-content-between py-2 border-bottom">
              <div class="d-flex align-items-center">
                <i class="fas fa-car hm-icon hm-icon-sm hm-icon-gold me-2"></i>
                <span class="hm-text-muted">الشركة</span>
              </div>
              <span><%= car.make %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <div class="d-flex align-items-center">
                <i class="fas fa-cogs hm-icon hm-icon-sm hm-icon-gold me-2"></i>
                <span class="hm-text-muted">الموديل</span>
              </div>
              <span><%= car.model %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <div class="d-flex align-items-center">
                <i class="fas fa-calendar-alt hm-icon hm-icon-sm hm-icon-gold me-2"></i>
                <span class="hm-text-muted">السنة</span>
              </div>
              <span><%= car.year %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <div class="d-flex align-items-center">
                <i class="fas fa-tachometer-alt hm-icon hm-icon-sm hm-icon-gold me-2"></i>
                <span class="hm-text-muted">الممشى</span>
              </div>
              <span><%= car.mileage ? car.mileage.toLocaleString() + ' كم' : 'N/A' %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <div class="d-flex align-items-center">
                <i class="fas fa-gas-pump hm-icon hm-icon-sm hm-icon-gold me-2"></i>
                <span class="hm-text-muted">الوقود</span>
              </div>
              <span><%= car.fuelType || 'غير محدد' %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <div class="d-flex align-items-center">
                <i class="fas fa-palette hm-icon hm-icon-sm hm-icon-gold me-2"></i>
                <span class="hm-text-muted">اللون</span>
              </div>
              <span><%= car.color || 'غير محدد' %></span>
            </div>
          </div>

          <div class="description-section mb-4">
            <h4 class="hm-text-blue mb-3">وصف السيارة</h4>
            <p><%= car.description || 'لا يوجد وصف متوفر لهذه السيارة.' %></p>
          </div>

          <div class="action-buttons">
            <% if (car.listingType === 'auction' && auctionUrl) { %>
              <a href="<%= auctionUrl %>" class="hm-btn hm-btn-primary w-100 mb-2">
                <i class="fas fa-gavel"></i> عرض المزاد
              </a>
            <% } else if (!car.isSold) { %>
              <form action="/cars/buy/<%= car._id %>" method="POST" class="mb-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="hm-btn hm-btn-primary w-100">
                  <i class="fas fa-shopping-cart"></i> شراء الآن
                </button>
              </form>
              <button class="hm-btn hm-btn-outline w-100 favorite-btn" data-car-id="<%= car._id %>">
                <i class="far fa-heart"></i> أضف للمفضلة
              </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    function changeImage(newSrc) {
        document.getElementById('mainImage').src = newSrc;
    }
</script>
