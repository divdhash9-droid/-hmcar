<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var bodyClass = 'auth-page modern-auth'; %>

<div class="auth-wrapper">
    <div class="auth-left">
        <div class="auth-left-inner">
            <div class="logo-container">
                <i class="fas fa-car-side logo-icon"></i>
                <h1 class="logo-text"><%= __('auth.brand') %></h1>
            </div>
            <h2><%- String(__('auth.loginPage.sideTitle')).replace(/\n/g, '<br>') %></h2>
            <p><%= __('auth.loginPage.sideDescription') %></p>
            <div class="features">
                <div class="feature">
                    <i class="fas fa-gavel"></i>
                    <span><%= __('auth.loginPage.features.liveAuctions') %></span>
                </div>
                <div class="feature">
                    <i class="fas fa-shield-alt"></i>
                    <span><%= __('auth.loginPage.features.verifiedSellers') %></span>
                </div>
                <div class="feature">
                    <i class="fas fa-globe-americas"></i>
                    <span><%= __('auth.loginPage.features.globalBidding') %></span>
                </div>
            </div>
        </div>
    </div>
    <div class="auth-right">
        <div class="auth-form-container">
            <div class="auth-header">
                <h2><%= __('auth.loginPage.title') %></h2>
                <p><%= __('auth.loginPage.subtitle') %></p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <form method="POST" action="/auth/login" class="auth-form">
                <input type="hidden" name="loginRole" value="<%= isAdminLogin ? 'admin' : 'buyer' %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <div class="form-floating mb-3">
                    <input type="text" id="name" name="name" class="form-control" 
                           placeholder="<%= isAdminLogin ? __('auth.fields.email') : __('auth.fields.username') %>" required>
                    <label for="name"><%= isAdminLogin ? __('auth.fields.email') : __('auth.fields.username') %></label>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" id="password" name="password" class="form-control" 
                           placeholder="<%= __('auth.fields.password') %>" required>
                    <label for="password"><%= __('auth.fields.password') %></label>
                </div>

                <div class="form-options">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="remember" name="remember">
                        <label class="form-check-label" for="remember">
                            <%= __('auth.rememberMe') %>
                        </label>
                    </div>
                    <a href="/auth/forgot-password" class="forgot-password-link"><%= __('auth.forgotPassword') %></a>
                </div>

                <button type="submit" class="btn btn-primary btn-gold w-100"><%= __('auth.loginPage.button') %></button>
            </form>

            <div class="social-login-divider">
                <span><%= __('common.or') %></span>
            </div>

            <div class="social-login-buttons">
                <button class="btn btn-outline-secondary w-100 mb-2"><i class="fab fa-google me-2"></i> <%= __('auth.continueWithGoogle') %></button>
                <button class="btn btn-outline-secondary w-100"><i class="fab fa-facebook me-2"></i> <%= __('auth.continueWithFacebook') %></button>
            </div>

            <div class="auth-switch">
                                <p><%= __('auth.noAccount') %> <a href="/auth/register"><%= __('auth.signUpNow') %></a></p>
                <% if (!isAdminLogin) { %>
                                    <p><a href="/auth/login?admin=true"><%= __('auth.loginAsAdmin') %></a></p>
                <% } else { %>
                                    <p><a href="/auth/login"><%= __('auth.loginAsCustomer') %></a></p>
                <% } %>
            </div>
        </div>
        <div class="auth-footer">
            <p>&copy; <%= new Date().getFullYear() %> <%= __('auth.brand') %>. <%= __('auth.copyright') %></p>
        </div>
    </div>
</div>

