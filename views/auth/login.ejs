<script>
// Language Toggle - Apply site-wide
let currentLanguage = localStorage.getItem('preferredLanguage') || 'ar';

function toggleLanguage() {
  const newLang = currentLanguage === 'ar' ? 'en' : 'ar';
  localStorage.setItem('preferredLanguage', newLang);
  
  // Reload page with new language parameter to apply site-wide
  const url = new URL(window.location.href);
  url.searchParams.set('lang', newLang);
  window.location.href = url.toString();
}

function updateLanguageUI() {
  const elements = document.querySelectorAll('[data-ar][data-en]');
  const langBtn = document.getElementById('currentLang');
  
  elements.forEach(element => {
    const text = element.getAttribute(`data-${currentLanguage}`);
    if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
      element.placeholder = text;
    } else {
      element.textContent = text;
    }
  });
  
  if (langBtn) {
    langBtn.textContent = currentLanguage === 'ar' ? 'English' : 'العربية';
  }
  document.documentElement.dir = currentLanguage === 'ar' ? 'rtl' : 'ltr';
  document.documentElement.lang = currentLanguage;
}

// Initialize Language on page load
document.addEventListener('DOMContentLoaded', function() {
  // Check URL param first, then localStorage
  const urlParams = new URLSearchParams(window.location.search);
  const urlLang = urlParams.get('lang');
  
  if (urlLang && ['ar', 'en'].includes(urlLang)) {
    currentLanguage = urlLang;
    localStorage.setItem('preferredLanguage', urlLang);
  }
  
  updateLanguageUI();
});

// Password Toggle
function togglePassword(inputId) {
  const input = document.getElementById(inputId);
  const icon = input.parentElement.querySelector('.hm-toggle-password i');
  
  if (input.type === 'password') {
    input.type = 'text';
    icon.classList.replace('fa-eye', 'fa-eye-slash');
  } else {
    input.type = 'password';
    icon.classList.replace('fa-eye-slash', 'fa-eye');
  }
}

// Form Submit Animation
document.getElementById('loginForm').addEventListener('submit', function(e) {
  const btn = this.querySelector('.hm-btn-login');
  const btnContent = btn.querySelector('.hm-btn-content');
  
  btnContent.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>جاري الدخول...</span>';
  btn.disabled = true;
  btn.style.opacity = '0.8';
  
  // Reset after 5 seconds if form doesn't submit
  setTimeout(() => {
    btnContent.innerHTML = '<i class="fas fa-sign-in-alt"></i> <span data-ar="دخول" data-en="LOG IN">دخول</span>';
    btn.disabled = false;
    btn.style.opacity = '1';
  }, 5000);
});

// Input Focus Effects
document.querySelectorAll('.hm-ultra-input').forEach(input => {
  input.addEventListener('focus', function() {
    this.closest('.hm-ultra-input-group').classList.add('focused');
  });
  
  input.addEventListener('blur', function() {
    this.closest('.hm-ultra-input-group').classList.remove('focused');
  });
});

// Parallax effect on mouse move
document.addEventListener('mousemove', function(e) {
  const cards = document.querySelectorAll('.hm-glass-card, .hm-white-card');
  const x = (window.innerWidth / 2 - e.pageX) / 50;
  const y = (window.innerHeight / 2 - e.pageY) / 50;
  
  cards.forEach(card => {
    card.style.transform = `perspective(1000px) rotateY(${x * 0.3}deg) rotateX(${-y * 0.3}deg)`;
  });
});

// Reset transform on mouse leave
document.querySelector('.hm-ultra-main').addEventListener('mouseleave', function() {
  const cards = document.querySelectorAll('.hm-glass-card, .hm-white-card');
  cards.forEach(card => {
    card.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
  });
});
</script>
