<div class="payment-modal" id="paymentModal">
  <div class="payment-modal-content">
    <div class="payment-header">
      <h5><i class="fas fa-credit-card"></i> إتمام الدفع</h5>
      <button class="btn-close" id="closePaymentModal">&times;</button>
    </div>

    <div class="payment-body">
      <!-- Order Summary -->
      <div class="order-summary">
        <h6>ملخص الطلب</h6>
        <div class="summary-item">
          <span>رقم الطلب:</span>
          <span id="orderNumber">#12345</span>
        </div>
        <div class="summary-item">
          <span>المبلغ الإجمالي:</span>
          <span id="totalAmount" class="amount">0 ريال</span>
        </div>
      </div>

      <!-- Payment Methods -->
      <div class="payment-methods">
        <h6>اختر طريقة الدفع</h6>
        <div class="method-options">
          <div class="method-option active" data-method="credit_card">
            <div class="method-icon">
              <i class="fas fa-credit-card"></i>
            </div>
            <div class="method-info">
              <div class="method-name">بطاقة ائتمان/خصم مباشر</div>
              <div class="method-desc">فيزا، ماستر كارد، مادا</div>
            </div>
            <div class="method-fees">2.9%</div>
          </div>

          <div class="method-option" data-method="apple_pay">
            <div class="method-icon">
              <i class="fab fa-apple"></i>
            </div>
            <div class="method-info">
              <div class="method-name">Apple Pay</div>
              <div class="method-desc">دفع آمن وسريع</div>
            </div>
            <div class="method-fees">2.9%</div>
          </div>

          <div class="method-option" data-method="google_pay">
            <div class="method-icon">
              <i class="fab fa-google"></i>
            </div>
            <div class="method-info">
              <div class="method-name">Google Pay</div>
              <div class="method-desc">دفع آمن وسريع</div>
            </div>
            <div class="method-fees">2.9%</div>
          </div>

          <div class="method-option" data-method="bank_transfer">
            <div class="method-icon">
              <i class="fas fa-university"></i>
            </div>
            <div class="method-info">
              <div class="method-name">تحويل بنكي</div>
              <div class="method-desc">تحويل مباشر للحساب البنكي</div>
            </div>
            <div class="method-fees">مجاني</div>
          </div>

          <div class="method-option" data-method="cash_on_delivery">
            <div class="method-icon">
              <i class="fas fa-truck"></i>
            </div>
            <div class="method-info">
              <div class="method-name">الدفع عند الاستلام</div>
              <div class="method-desc">الدفع نقداً عند استلام الطلب</div>
            </div>
            <div class="method-fees">مجاني</div>
          </div>
        </div>
      </div>

      <!-- Payment Form -->
      <div class="payment-form" id="paymentForm">
        <!-- Card Payment Form -->
        <div class="card-form" id="cardForm">
          <div class="form-row">
            <div class="form-group col-12">
              <label for="cardNumber">رقم البطاقة</label>
              <input type="text" id="cardNumber" class="form-control" placeholder="1234 5678 9012 3456" maxlength="19">
              <div class="card-icons">
                <i class="fab fa-cc-visa" title="Visa"></i>
                <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                <i class="fab fa-cc-amex" title="American Express"></i>
              </div>
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group col-6">
              <label for="cardExpiry">تاريخ الانتهاء</label>
              <input type="text" id="cardExpiry" class="form-control" placeholder="MM/YY" maxlength="5">
            </div>
            <div class="form-group col-6">
              <label for="cardCvv">رمز الأمان</label>
              <input type="text" id="cardCvv" class="form-control" placeholder="123" maxlength="4">
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group col-12">
              <label for="cardholderName">الاسم على البطاقة</label>
              <input type="text" id="cardholderName" class="form-control" placeholder="الاسم الكامل">
            </div>
          </div>
        </div>

        <!-- Bank Transfer Form -->
        <div class="bank-transfer-form" id="bankTransferForm" style="display: none;">
          <div class="bank-details">
            <h6>تفاصيل التحويل البنكي</h6>
            <div class="detail-item">
              <span>اسم الحساب:</span>
              <span>HM CAR Auction</span>
            </div>
            <div class="detail-item">
              <span>رقم الحساب:</span>
              <span>SA1234567890123456</span>
            </div>
            <div class="detail-item">
              <span>البنك:</span>
              <span>Riyad Bank</span>
            </div>
            <div class="detail-item">
              <span>الآيبان:</span>
              <span>SA8910000001234567890123</span>
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group col-12">
              <label for="transferReference">رقم التحويل</label>
              <input type="text" id="transferReference" class="form-control" placeholder="أدخل رقم التحويل">
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group col-12">
              <label for="transferDate">تاريخ التحويل</label>
              <input type="date" id="transferDate" class="form-control">
            </div>
          </div>
        </div>

        <!-- Digital Wallet Forms (Apple Pay, Google Pay) -->
        <div class="digital-wallet-form" id="digitalWalletForm" style="display: none;">
          <div class="wallet-info">
            <p>سيتم توجيهك إلى بوابة الدفع الآمنة لإتمام عملية الدفع.</p>
            <button class="btn btn-primary wallet-btn" id="walletPayBtn">
              <i class="fab fa-apple" id="walletIcon"></i>
              <span id="walletText">الدفع بـ Apple Pay</span>
            </button>
          </div>
        </div>

        <!-- Cash on Delivery Form -->
        <div class="cod-form" id="codForm" style="display: none;">
          <div class="cod-info">
            <div class="alert alert-info">
              <i class="fas fa-info-circle"></i>
              <strong>ملاحظات الدفع عند الاستلام:</strong>
              <ul>
                <li>الدفع نقداً عند استلام الطلب</li>
                <li>الرجاء التأكد من توفر المبلغ النقدي</li>
                <li>سيتم تأكيد الطلب بعد استلام الدفع</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Billing Address -->
      <div class="billing-address">
        <h6>عنوان الفوترة</h6>
        <div class="form-row">
          <div class="form-group col-12">
            <label for="billingName">الاسم الكامل</label>
            <input type="text" id="billingName" class="form-control" placeholder="الاسم الكامل">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group col-6">
            <label for="billingPhone">رقم الهاتف</label>
            <input type="tel" id="billingPhone" class="form-control" placeholder="05xxxxxxxx">
          </div>
          <div class="form-group col-6">
            <label for="billingEmail">البريد الإلكتروني</label>
            <input type="email" id="billingEmail" class="form-control" placeholder="example@email.com">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group col-12">
            <label for="billingAddress">العنوان</label>
            <input type="text" id="billingAddress" class="form-control" placeholder="الشارع، المبنى، رقم الشقة">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group col-4">
            <label for="billingCity">المدينة</label>
            <input type="text" id="billingCity" class="form-control" placeholder="الرياض">
          </div>
          <div class="form-group col-4">
            <label for="billingCountry">الدولة</label>
            <select id="billingCountry" class="form-select">
              <option value="SA">المملكة العربية السعودية</option>
              <option value="AE">الإمارات العربية المتحدة</option>
              <option value="KW">الكويت</option>
              <option value="BH">البحرين</option>
              <option value="QA">قطر</option>
              <option value="OM">عمان</option>
            </select>
          </div>
          <div class="form-group col-4">
            <label for="billingPostal">الرمز البريدي</label>
            <input type="text" id="billingPostal" class="form-control" placeholder="12345">
          </div>
        </div>
      </div>

      <!-- Installment Option -->
      <div class="installment-option">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="installmentPlan">
          <label class="form-check-label" for="installmentPlan">
            التقسيط على 3 أشهر (بفائدة 5%)
          </label>
        </div>
        <div class="installment-details" id="installmentDetails" style="display: none;">
          <div class="detail-item">
            <span>القسط الشهري:</span>
            <span id="monthlyInstallment">0 ريال</span>
          </div>
          <div class="detail-item">
            <span>إجمالي الفوائد:</span>
            <span id="totalInterest">0 ريال</span>
          </div>
        </div>
      </div>
    </div>

    <div class="payment-footer">
      <div class="payment-security">
        <i class="fas fa-lock"></i>
        <span>دفع آمن ومشفر</span>
      </div>
      <div class="payment-actions">
        <button class="btn btn-secondary" id="cancelPayment">إلغاء</button>
        <button class="btn btn-primary" id="confirmPayment">
          <i class="fas fa-lock"></i>
          تأكيد الدفع
        </button>
      </div>
    </div>
  </div>
</div>

