<!-- [[ARABIC_HEADER]] هذا الملف (views/admin/settings/footer.ejs) جزء من مشروع HM CAR ويحتوي تعليقات عربية لضمان الوضوح. -->

<% layout('layout') -%>
<% var hideNavbar = true; %>
<% var hideSearch = true; %>
<% var fullWidth = true; %>
<% var bodyClass = 'hm-admin-page'; %>

<link rel="stylesheet" href="/css/admin-luxury.css">
<link rel="stylesheet" href="/css/dashboard-luxury.css">

<div class="hm-admin-layout">
  <div class="hm-dashboard__container">
    <header class="hm-hero" aria-label="إعدادات الفوتر">
      <div class="hm-hero__top">
        <div class="hm-hero__brand">
          <img class="hm-hero__logo" src="/public/images/navbar-logo.png" alt="HM CAR" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/public/images/logo.png';" />
          <div class="hm-hero__titles">
            <h1 class="hm-hero__title">إعدادات الشريط السفلي</h1>
            <div class="hm-hero__subtitle">معلومات الشركة + روابط + تواصل — تظهر للعميل مباشرة</div>
          </div>
        </div>

        <nav class="hm-hero__actions" aria-label="روابط">
          <a class="hm-pill" href="/admin/settings" aria-label="الإعدادات"><i class="fas fa-cogs"></i><span>الإعدادات</span></a>
          <a class="hm-pill" href="/admin" aria-label="لوحة الإدارة"><i class="fas fa-tachometer-alt"></i><span>لوحة الإدارة</span></a>
          <a class="hm-pill hm-pill--danger" href="/auth/logout" aria-label="خروج"><i class="fas fa-sign-out-alt"></i><span>خروج</span></a>
        </nav>
      </div>

      <section class="hm-kpis" aria-label="حالة">
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">العنوان</div><div class="hm-kpi__value"><%= footer && footer.title ? 'OK' : '-' %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-heading"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">البريد</div><div class="hm-kpi__value"><%= footer && footer.contactInfo && footer.contactInfo.email ? 'OK' : '-' %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-envelope"></i></div></div></div>
        <div class="hm-kpi"><div class="hm-kpi__row"><div><div class="hm-kpi__label">الهاتف</div><div class="hm-kpi__value"><%= footer && footer.contactInfo && footer.contactInfo.phone ? 'OK' : '-' %></div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-phone"></i></div></div></div>
        <div class="hm-kpi hm-kpi--security"><div class="hm-kpi__row"><div><div class="hm-kpi__label">الأمان</div><div class="hm-kpi__value">CSRF</div></div><div class="hm-kpi__icon" aria-hidden="true"><i class="fas fa-shield-alt"></i></div></div></div>
      </section>
    </header>

    <% if (flash && flash.message) { %>
      <div class="mt-3">
        <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% } %>

    <section class="hm-section" aria-label="تحديث الفوتر">
      <h2 class="hm-section__title">تحديث الفوتر</h2>
      <div class="hm-list">
        <div class="hm-list__item">
          <form class="w-100" method="POST" action="/admin/settings/footer">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label text-light">العنوان</label>
                <input class="form-control" name="title" value="<%= footer && footer.title ? footer.title : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light">البريد</label>
                <input class="form-control" name="email" value="<%= footer && footer.contactInfo && footer.contactInfo.email ? footer.contactInfo.email : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light">الهاتف</label>
                <input class="form-control" name="phone" value="<%= footer && footer.contactInfo && footer.contactInfo.phone ? footer.contactInfo.phone : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light">العنوان (العنوان البريدي)</label>
                <input class="form-control" name="address" value="<%= footer && footer.contactInfo && footer.contactInfo.address ? footer.contactInfo.address : '' %>">
              </div>
              <div class="col-12">
                <label class="form-label text-light">الوصف</label>
                <textarea class="form-control" name="description" rows="3"><%= footer && footer.description ? footer.description : '' %></textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label text-light">الروابط السريعة (JSON)</label>
                <textarea class="form-control" name="links" rows="4" placeholder='[{"name":"السيارات","url":"/cars"}]'><%= footer && footer.links ? JSON.stringify(footer.links, null, 2) : '[]' %></textarea>
              </div>
              
              <!-- روابط التواصل الاجتماعي -->
              <div class="col-12 mt-4">
                <h5 class="text-light mb-3"><i class="fas fa-share-alt me-2"></i>روابط التواصل الاجتماعي</h5>
              </div>
              <div class="col-md-6">
                <label class="form-label text-light"><i class="fab fa-facebook text-primary me-2"></i>رابط فيسبوك</label>
                <input class="form-control" name="facebookUrl" placeholder="https://facebook.com/yourpage" value="<%= footer && footer.facebookUrl ? footer.facebookUrl : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light"><i class="fab fa-twitter text-info me-2"></i>رابط تويتر</label>
                <input class="form-control" name="twitterUrl" placeholder="https://twitter.com/yourpage" value="<%= footer && footer.twitterUrl ? footer.twitterUrl : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light"><i class="fab fa-instagram text-danger me-2"></i>رابط انستقرام</label>
                <input class="form-control" name="instagramUrl" placeholder="https://instagram.com/yourpage" value="<%= footer && footer.instagramUrl ? footer.instagramUrl : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light"><i class="fab fa-whatsapp text-success me-2"></i>رقم الواتساب (بدون +)</label>
                <input class="form-control" name="whatsappNumber" placeholder="821012345678" value="<%= footer && footer.whatsappNumber ? footer.whatsappNumber : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light"><i class="fab fa-youtube text-danger me-2"></i>رابط يوتيوب</label>
                <input class="form-control" name="youtubeUrl" placeholder="https://youtube.com/yourchannel" value="<%= footer && footer.youtubeUrl ? footer.youtubeUrl : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label text-light"><i class="fab fa-tiktok me-2"></i>رابط تيك توك</label>
                <input class="form-control" name="tiktokUrl" placeholder="https://tiktok.com/@yourpage" value="<%= footer && footer.tiktokUrl ? footer.tiktokUrl : '' %>">
              </div>
              <div class="col-12">
                <button class="hm-embed__close" type="submit">حفظ</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>
