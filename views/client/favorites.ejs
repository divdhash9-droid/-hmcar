  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.hm-btn-remove {
  background: rgba(239, 68, 68, 0.9);
  color: white;
}

.hm-btn-remove:hover {
  background: #dc2626;
  transform: scale(1.1);
}

.hm-btn-view {
  background: rgba(35, 102, 209, 0.9);
  color: white;
}

.hm-btn-view:hover {
  background: #1e40af;
  transform: scale(1.1);
}

.hm-btn-compare {
  background: rgba(34, 197, 94, 0.9);
  color: white;
}

.hm-btn-compare:hover {
  background: #16a34a;
  transform: scale(1.1);
}

.hm-car-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(255, 215, 0, 0.9);
  color: #0a192f;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.hm-car-details {
  padding: 1.5rem;
}

.hm-car-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 1rem;
}

.hm-car-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #0a192f;
  margin: 0;
  line-height: 1.3;
}

.hm-car-price {
  font-size: 1.5rem;
  font-weight: 800;
  color: #2366d1;
}

.hm-car-specs {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
}

.hm-spec {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: #64748b;
}

.hm-spec i {
  color: #94a3b8;
}

.hm-car-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1rem;
  border-top: 1px solid #e2e8f0;
  font-size: 0.875rem;
  color: #64748b;
}

.hm-car-location,
.hm-car-date {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Responsive Design */
