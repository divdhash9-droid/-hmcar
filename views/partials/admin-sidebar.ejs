<!-- Admin Sidebar Partial -->
<aside class="hm-admin-sidebar" id="adminSidebar">
  <!-- Sidebar Header -->
  <div class="hm-sidebar-header">
    <div class="hm-sidebar-logo">
      <img src="/images/logo.png" alt="HM CAR" onerror="this.onerror=null;this.src='/public/images/logo.png';">
    </div>
    <div class="hm-sidebar-brand">
      <h1>HM CAR</h1>
      <p>لوحة الإدارة</p>
    </div>
  </div>

  <!-- Sidebar Navigation -->
  <nav class="hm-sidebar-nav">
    <!-- Main Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">الرئيسية</div>
      <a href="/admin" class="hm-nav-item" data-page="dashboard">
        <i class="fas fa-gauge-high"></i>
        <span>لوحة التحكم</span>
      </a>
      <a href="/" class="hm-nav-item" data-page="home">
        <i class="fas fa-home"></i>
        <span>الموقع الرئيسي</span>
      </a>
    </div>

    <!-- Products Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">المنتجات</div>
      <a href="/admin/cars" class="hm-nav-item" data-page="cars">
        <i class="fas fa-car"></i>
        <span>السيارات</span>
      </a>
      <a href="/admin/spare-parts" class="hm-nav-item" data-page="spare-parts">
        <i class="fas fa-cogs"></i>
        <span>قطع الغيار</span>
      </a>
      <a href="/admin/spare-brands" class="hm-nav-item" data-page="spare-brands">
        <i class="fas fa-industry"></i>
        <span>ماركات القطع</span>
      </a>
    </div>

    <!-- Auctions Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">المزادات</div>
      <a href="/admin/auctions" class="hm-nav-item" data-page="auctions">
        <i class="fas fa-gavel"></i>
        <span>إدارة المزادات</span>
      </a>
      <a href="/admin/auctions/new" class="hm-nav-item" data-page="auctions-new">
        <i class="fas fa-plus"></i>
        <span>إنشاء مزاد</span>
      </a>
      <a href="/admin/live-auction" class="hm-nav-item" data-page="live-auction">
        <i class="fas fa-broadcast-tower"></i>
        <span>المزاد المباشر</span>
      </a>
    </div>

    <!-- Orders & Users Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">الطلبات والعملاء</div>
      <a href="/admin/orders" class="hm-nav-item" data-page="orders">
        <i class="fas fa-shopping-cart"></i>
        <span>الطلبات</span>
      </a>
      <a href="/admin/users" class="hm-nav-item" data-page="users">
        <i class="fas fa-users"></i>
        <span>العملاء</span>
      </a>
      <a href="/admin/users-management" class="hm-nav-item" data-page="users-management">
        <i class="fas fa-user-shield"></i>
        <span>إدارة المشرفين</span>
      </a>
    </div>

    <!-- Categories Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">التصنيفات</div>
      <a href="/admin/brands" class="hm-nav-item" data-page="brands">
        <i class="fas fa-copyright"></i>
        <span>الماركات</span>
      </a>
      <a href="/admin/categories" class="hm-nav-item" data-page="categories">
        <i class="fas fa-tags"></i>
        <span>الفئات</span>
      </a>
    </div>

    <!-- Communication Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">التواصل</div>
      <a href="/admin/notifications" class="hm-nav-item" data-page="notifications">
        <i class="fas fa-bell"></i>
        <span>الإشعارات</span>
      </a>
      <a href="/admin/support" class="hm-nav-item" data-page="support">
        <i class="fas fa-headset"></i>
        <span>الدعم الفني</span>
      </a>
    </div>

    <!-- Settings Section -->
    <div class="hm-nav-section">
      <div class="hm-nav-section-title">الإعدادات</div>
      <a href="/admin/settings" class="hm-nav-item" data-page="settings">
        <i class="fas fa-cog"></i>
        <span>الإعدادات العامة</span>
      </a>
      <a href="/admin/settings/whatsapp" class="hm-nav-item" data-page="settings-whatsapp">
        <i class="fab fa-whatsapp"></i>
        <span>الواتساب</span>
      </a>
      <a href="/admin/settings/footer" class="hm-nav-item" data-page="settings-footer">
        <i class="fas fa-window-maximize"></i>
        <span>الشريط السفلي</span>
      </a>
      <a href="/admin/exchange-rate" class="hm-nav-item" data-page="exchange-rate">
        <i class="fas fa-dollar-sign"></i>
        <span>سعر الصرف</span>
      </a>
    </div>
  </nav>

  <!-- Sidebar Footer -->
  <div class="hm-sidebar-footer">
    <div class="hm-sidebar-user">
      <div class="hm-sidebar-avatar">
        <%= currentUser?.name ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="hm-sidebar-user-info">
        <p class="hm-sidebar-user-name"><%= currentUser?.name || 'المدير' %></p>
        <p class="hm-sidebar-user-role"><%= currentUser?.role === 'super_admin' ? 'مدير عام' : 'مدير' %></p>
      </div>
    </div>
    <a href="/auth/logout" class="hm-sidebar-logout">
      <i class="fas fa-sign-out-alt"></i>
      <span>تسجيل الخروج</span>
    </a>
  </div>
</aside>

<script>
// Highlight active nav item
(function() {
  const currentPath = window.location.pathname;
  const navItems = document.querySelectorAll('.hm-nav-item');
  
  navItems.forEach(item => {
    item.classList.remove('active');
    const href = item.getAttribute('href');
    
    // Exact match or starts with (for sub-pages)
    if (href === currentPath || 
        (currentPath.startsWith(href) && href !== '/' && href.length > 1)) {
      item.classList.add('active');
    }
  });
  
  // Special case for /admin dashboard
  if (currentPath === '/admin' || currentPath === '/admin/') {
    navItems.forEach(item => item.classList.remove('active'));
    const dashboardLink = document.querySelector('.hm-nav-item[data-page="dashboard"]');
    if (dashboardLink) dashboardLink.classList.add('active');
  }
})();
</script>
