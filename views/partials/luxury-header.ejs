}

.luxury-mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
}

.luxury-mobile-menu-btn span {
    width: 25px;
